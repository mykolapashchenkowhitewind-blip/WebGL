: #333; margin: 20px 0;\&quot;\u003e\n289|            \n290|            \u003ch3\u003eMesh Granularity\u003c/h3\u003e\n291|            \u003cdiv class\u003d\&quot;slider-container\&quot;\u003e\n292|                \u003cspan class\u003d\&quot;slider-label\&quot;\u003eU Segments:\u003c/span\u003e\n293|                \u003cinput type\u003d\&quot;range\&quot; min\u003d\&quot;10\&quot; max\u003d\&quot;200\&quot; value\u003d\&quot;80\&quot; class\u003d\&quot;slider\&quot; id\u003d\&quot;u-granularity\&quot;\u003e\n294|                \u003cspan class\u003d\&quot;slider-value\&quot; id\u003d\&quot;u-gran-value\&quot;\u003e80\u003c/span\u003e\n295|            \u003c/div\u003e\n296|            \u003cdiv class\u003d\&quot;slider-container\&quot;\u003e\n297|                \u003cspan class\u003d\&quot;slider-label\&quot;\u003eV Segments:\u003c/span\u003e\n298|                \u003cinput type\u003d\&quot;range\&quot; min\u003d\&quot;10\&quot; max\u003d\&quot;100\&quot; value\u003d\&quot;40\&quot; class\u003d\&quot;slider\&quot; id\u003d\&quot;v-granularity\&quot;\u003e\n299|                \u003cspan class\u003d\&quot;slider-value\&quot; id\u003d\&quot;v-gran-value\&quot;\u003e40\u003c/span\u003e\n300|            \u003c/div\u003e\n301|        \u003c/div\u003e\n302|        \n303|        \u003cdiv class\u003d\&quot;info-panel\&quot;\u003e\n304|            \u003ch2\u003eImplementation Details\u003c/h2\u003e\n305|            \u003cp\u003eThis implementation includes:\u003c/p\u003e\n306|            \u003cul\u003e\n307|                \u003cli\u003e\u003cstrong\u003ePhong Shading:\u003c/strong\u003e Realistic lighting with ambient, diffuse, and specular components\u003c/li\u003e\n308|                \u003cli\u003e\u003cstrong\u003eFacet Average Normal:\u003c/strong\u003e Normals are calculated by averaging adjacent facet normals\u003c/li\u003e\n309|                \u003cli\u003e\u003cstrong\u003eRotating Light Source:\u003c/strong\u003e A moving light that circles around the model\u003c/li\u003e\n310|                \u003cli\u003e\u003cstrong\u003eTriangle Mesh:\u003c/strong\u003e The surface is rendered with filled triangles using VBO with indices\u003c/li\u003e\n311|                \u003cli\u003e\u003cstrong\u003eAdjustable Granularity:\u003c/strong\u003e U and V segment sliders allow controlling the mesh density\u003c/li\u003e\n312|            \u003c/ul\u003e\n313|        \u003c/div\u003e\n314|        \n315|        \u003cdiv class\u003d\&quot;student-info\&quot;\u003e\n316|            \u003ch2\u003eStudent Information\u003c/h2\u003e\n317|            \u003cp\u003e\u003cstrong\u003eName:\u003c/strong\u003e Pashchenko Mykola\u003c/p\u003e\n318|            \u003cp\u003e\u003cstrong\u003eGroup:\u003c/strong\u003e TR-51mp\u003c/p\u003e\n319|            \u003cp\u003e\u003cstrong\u003eCourse:\u003c/strong\u003e WebGL Visualization\u003c/p\u003e\n320|            \u003cp\u003e\u003cstrong\u003eAssignment:\u003c/strong\u003e PA#2 - Cornucopia Surface with Phong Shading\u003c/p\u003e\n321|            \u003cp\u003e\u003cstrong\u003eVariant:\u003c/strong\u003e 23 (Phong Shading, Facet Average Normals)\u003c/p\u003e\n322|        \u003c/div\u003e\n323|        \n324|        \u003cdiv class\u003d\&quot;footer\&quot;\u003e\n325|            \u003cp\u003eInteractive WebGL Visualization - Created using JavaScript and WebGL\u003c/p\u003e\n326|            \u003cp\u003eDrag your mouse on the model to rotate it. On a touch screen, you can use your finger.\u003c/p\u003e\n327|        \u003c/div\u003e\n328|    \u003c/div\u003e\n329|\u003c/body\u003e\n330|\u003c/html\u003e&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;I found the issue! The problem is that while we\u0027ve correctly set up the event listeners for the granularity sliders, we need to ensure they trigger a redraw after updating the granularity values. Let me fix this issue:&quot;}],&quot;tool_calls&quot;:[{&quot;id&quot;:&quot;toolu_01U6NyKh2KmegLwGFTg7AJ6m&quot;,&quot;type&quot;:&quot;function&quot;,&quot;function&quot;:{&quot;name&quot;:&quot;write&quot;,&quot;arguments&quot;:&quot;{\&quot;file_path\&quot;: \&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL2/cornucopia3.js\&quot;, \&quot;content\&quot;: \&quot;\u0027use strict\u0027;\\n\\n/**\\n * Cornucopia Surface - Parametric Surface Implementation with Phong Shading\\n * \\n * Parameters:\\n * p \u003d 0.15; m \u003d 0.1\\n * 0 ≤ u ≤ 5π; 0 ≤ v ≤ 2π\\n * \\n * Parametric equations:\\n * x(u,v) \u003d [e^(mu) + e^(pu)cos(v)]cos(u)\\n * y(u,v) \u003d [e^(mu) + e^(pu)cos(v)]sin(u)\\n * z(u,v) \u003d e^(pu)sin(v)\\n */\\n\\n// Global variables\\nlet gl;                 // WebGL context\\nlet surface;            // Cornucopia surface model\\nlet shProgram;          // Shader program\\nlet spaceball;          // Trackball rotator\\nlet lightAngle \u003d 0;     // Angle for rotating light\\nlet lightRadius \u003d 60;   // Distance of light from origin\\n\\n/**\\n * CornucopiaModel class to create and render the surface\\n */\\nfunction CornucopiaModel() {\\n    // Surface parameters - exactly as shown in Fig. 2\\n    this.p \u003d 0.15;\\n    this.m \u003d 0.1;\\n    this.uMin \u003d 0;\\n    this.uMax \u003d 5 * Math.PI;\\n    this.vMin \u003d 0;\\n    this.vMax \u003d 2 * Math.PI;\\n    \\n    // Number of segments for the grid (adjustable via sliders)\\n    this.uSegments \u003d 80;\\n    this.vSegments \u003d 40;\\n    \\n    // Buffers for the triangular mesh\\n    this.vertexBuffer \u003d null;\\n    this.normalBuffer \u003d null;\\n    this.indexBuffer \u003d null;\\n    this.numVertices \u003d 0;\\n    this.numIndices \u003d 0;\\n\\n    // Array to store vertex positions for normal calculation\\n    this.vertices \u003d [];\\n    this.normals \u003d [];\\n    this.indices \u003d [];\\n    \\n    /**\\n     * Calculate a point on the surface using the parametric equations\\n     */\\n    this.computePoint \u003d function(u, v) {\\n        const ePu \u003d Math.exp(this.p * u); // e^(pu)\\n        const eMu \u003d Math.exp(this.m * u); // e^(mu)\\n        \\n        return {\\n            x: (eMu + ePu * Math.cos(v)) * Math.cos(u),\\n            y: (eMu + ePu * Math.cos(v)) * Math.sin(u),\\n            z: ePu * Math.sin(v)\\n        };\\n    };\\n    \\n    /**\\n     * Calculate the analytical normal at a point by computing the cross product\\n     * of the tangent vectors along u and v directions\\n     */\\n    this.computeAnalyticalNormal \u003d function(u, v) {\\n        const ePu \u003d Math.exp(this.p * u);\\n        const eMu \u003d Math.exp(this.m * u);\\n        \\n        // Partial derivative with respect to u\\n        const dxdu \u003d -1 * (eMu + ePu * Math.cos(v)) * Math.sin(u) \\n                   + (this.m * eMu + this.p * ePu * Math.cos(v)) * Math.cos(u);\\n        const dydu \u003d (eMu + ePu * Math.cos(v)) * Math.cos(u) \\n                   + (this.m * eMu + this.p * ePu * Math.cos(v)) * Math.sin(u);\\n        const dzdu \u003d this.p * ePu * Math.sin(v);\\n        \\n        // Partial derivative with respect to v\\n        const dxdv \u003d -1 * ePu * Math.sin(v) * Math.cos(u);\\n        const dydv \u003d -1 * ePu * Math.sin(v) * Math.sin(u);\\n        const dzdv \u003d ePu * Math.cos(v);\\n        \\n        // Cross product to find normal vector\\n        const nx \u003d dydu * dzdv - dzdu * dydv;\\n        const ny \u003d dzdu * dxdv - dxdu * dzdv;\\n        const nz \u003d dxdu * dydv - dydu * dxdv;\\n        \\n        // Normalize the normal vector\\n        const length \u003d Math.sqrt(nx*nx + ny*ny + nz*nz);\\n        return {\\n            x: nx / length,\\n            y: ny / length,\\n            z: nz / length\\n        };\\n    };\\n    \\n    /**\\n     * Generate the triangular mesh vertices and indices\\n     */\\n    this.generateMesh \u003d function() {\\n        this.vertices \u003d [];\\n        this.indices \u003d [];\\n        \\n        // Generate vertices\\n        for (let uIndex \u003d 0; uIndex \u003c\u003d this.uSegments; uIndex++) {\\n            const u \u003d this.uMin + (uIndex / this.uSegments) * (this.uMax - this.uMin);\\n            \\n            for (let vIndex \u003d 0; vIndex \u003c\u003d this.vSegments; vIndex++) {\\n                const v \u003d this.vMin + (vIndex / this.vSegments) * (this.vMax - this.vMin);\\n                const point \u003d this.computePoint(u, v);\\n                \\n                // Store vertex\\n                this.vertices.push(point.x, point.y, point.z);\\n                \\n                // Calculate analytical normal for now (will be replaced with facet average)\\n                const normal \u003d this.computeAnalyticalNormal(u, v);\\n                this.normals.push(normal.x, normal.y, normal.z);\\n            }\\n        }\\n        \\n        // Generate indices for triangle strips\\n        for (let uIndex \u003d 0; uIndex \u003c this.uSegments; uIndex++) {\\n            for (let vIndex \u003d 0; vIndex \u003c this.vSegments; vIndex++) {\\n                const vertexIndex \u003d uIndex * (this.vSegments + 1) + vIndex;\\n                \\n                // First triangle\\n                this.indices.push(vertexIndex);\\n                this.indices.push(vertexIndex + 1);\\n                this.indices.push(vertexIndex + this.vSegments + 1);\\n                \\n                // Second triangle\\n                this.indices.push(vertexIndex + 1);\\n                this.indices.push(vertexIndex + this.vSegments + 2);\\n                this.indices.push(vertexIndex + this.vSegments + 1);\\n            }\\n        }\\n        \\n        this.numVertices \u003d this.vertices.length / 3;\\n        this.numIndices \u003d this.indices.length;\\n    };\\n    \\n    /**\\n     * Calculate facet normals for each triangle\\n     */\\n    this.calculateFacetNormals \u003d function() {\\n        const facetNormals \u003d [];\\n        \\n        // Initialize facet normals array\\n        for (let i \u003d 0; i \u003c this.numIndices / 3; i++) {\\n            facetNormals.push({ x: 0, y: 0, z: 0 });\\n        }\\n        \\n        // Calculate normal for each triangle\\n        for (let i \u003d 0; i \u003c this.numIndices; i +\u003d 3) {\\n            const idx1 \u003d this.indices[i];\\n            const idx2 \u003d this.indices[i + 1];\\n            const idx3 \u003d this.indices[i + 2];\\n            \\n            const v1x \u003d this.vertices[idx1 * 3];\\n            const v1y \u003d this.vertices[idx1 * 3 + 1];\\n            const v1z \u003d this.vertices[idx1 * 3 + 2];\\n            \\n            const v2x \u003d this.vertices[idx2 * 3];\\n            const v2y \u003d this.vertices[idx2 * 3 + 1];\\n            const v2z \u003d this.vertices[idx2 * 3 + 2];\\n            \\n            const v3x \u003d this.vertices[idx3 * 3];\\n            const v3y \u003d this.vertices[idx3 * 3 + 1];\\n            const v3z \u003d this.vertices[idx3 * 3 + 2];\\n            \\n            // Calculate vectors for two sides of the triangle\\n            const ax \u003d v2x - v1x;\\n            const ay \u003d v2y - v1y;\\n            const az \u003d v2z - v1z;\\n            \\n            const bx \u003d v3x - v1x;\\n            const by \u003d v3y - v1y;\\n            const bz \u003d v3z - v1z;\\n            \\n            // Cross product to get normal\\n            const nx \u003d ay * bz - az * by;\\n            const ny \u003d az * bx - ax * bz;\\n            const nz \u003d ax * by - ay * bx;\\n            \\n            // Normalize\\n            const length \u003d Math.sqrt(nx*nx + ny*ny + nz*nz);\\n            \\n            facetNormals[i/3] \u003d {\\n                x: nx / length,\\n                y: ny / length,\\n                z: nz / length\\n            };\\n        }\\n        \\n        return facetNormals;\\n    };\\n    \\n    /**\\n     * Calculate vertex normals using facet average method\\n     */\\n    this.calculateFacetAverageNormals \u003d function() {\\n        // Reset normals array\\n        this.normals \u003d new Array(this.numVertices * 3).fill(0);\\n        \\n        // Get facet normals\\n        const facetNormals \u003d this.calculateFacetNormals();\\n        \\n        // Map to track which facets are adjacent to each vertex\\n        const vertexFacets \u003d new Array(this.numVertices).fill().map(() \u003d\u003e []);\\n        \\n        // Associate each facet with its vertices\\n        for (let i \u003d 0; i \u003c this.numIndices; i +\u003d 3) {\\n            const faceIndex \u003d i / 3;\\n            const idx1 \u003d this.indices[i];\\n            const idx2 \u003d this.indices[i + 1];\\n            const idx3 \u003d this.indices[i + 2];\\n            \\n            vertexFacets[idx1].push(faceIndex);\\n            vertexFacets[idx2].push(faceIndex);\\n            vertexFacets[idx3].push(faceIndex);\\n        }\\n        \\n        // Calculate average normal for each vertex\\n        for (let i \u003d 0; i \u003c this.numVertices; i++) {\\n            let sumX \u003d 0, sumY \u003d 0, sumZ \u003d 0;\\n            \\n            // Sum normals of all adjacent facets\\n            for (const facetIdx of vertexFacets[i]) {\\n                sumX +\u003d facetNormals[facetIdx].x;\\n                sumY +\u003d facetNormals[facetIdx].y;\\n                sumZ +\u003d facetNormals[facetIdx].z;\\n            }\\n            \\n            // Normalize the result\\n            const length \u003d Math.sqrt(sumX*sumX + sumY*sumY + sumZ*sumZ);\\n            if (length \u003e 0) {\\n                this.normals[i * 3] \u003d sumX / length;\\n                this.normals[i * 3 + 1] \u003d sumY / length;\\n                this.normals[i * 3 + 2] \u003d sumZ / length;\\n            }\\n        }\\n    };\\n    \\n    /**\\n     * Initialize the model by generating the mesh and setting up buffers\\n     */\\n    this.initialize \u003d function() {\\n        console.log(\\\&quot;Initializing Cornucopia with parameters:\\\&quot;);\\n        console.log(\\\&quot;p \u003d\\\&quot;, this.p, \\\&quot;m \u003d\\\&quot;, this.m);\\n        console.log(\\\&quot;uMax \u003d\\\&quot;, this.uMax/Math.PI + \\\&quot;π\\\&quot;, \\\&quot;vMax \u003d\\\&quot;, this.vMax/Math.PI + \\\&quot;π\\\&quot;);\\n        console.log(\\\&quot;uSegments \u003d\\\&quot;, this.uSegments, \\\&quot;vSegments \u003d\\\&quot;, this.vSegments);\\n        \\n        // Generate the mesh data\\n        this.generateMesh();\\n        \\n        // Calculate facet average normals\\n        this.calculateFacetAverageNormals();\\n        \\n        // Create and populate the vertex buffer\\n        this.vertexBuffer \u003d gl.createBuffer();\\n        gl.bindBuffer(gl.ARRAY_BUFFER, this.vertexBuffer);\\n        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(this.vertices), gl.STATIC_DRAW);\\n        \\n        // Create and populate the normal buffer\\n        this.normalBuffer \u003d gl.createBuffer();\\n        gl.bindBuffer(gl.ARRAY_BUFFER, this.normalBuffer);\\n        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(this.normals), gl.STATIC_DRAW);\\n        \\n        // Create and populate the index buffer\\n        this.indexBuffer \u003d gl.createBuffer();\\n        gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, this.indexBuffer);\\n        gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, new Uint16Array(this.indices), gl.STATIC_DRAW);\\n    };\\n    \\n    /**\\n     * Draw the model\\n     */\\n    this.draw \u003d function(shaderProgram) {\\n        // Bind vertex buffer and set attribute pointer\\n        gl.bindBuffer(gl.ARRAY_BUFFER, this.vertexBuffer);\\n        gl.vertexAttribPointer(shaderProgram.iAttribVertex, 3, gl.FLOAT, false, 0, 0);\\n        gl.enableVertexAttribArray(shaderProgram.iAttribVertex);\\n        \\n        // Bind normal buffer and set attribute pointer\\n        gl.bindBuffer(gl.ARRAY_BUFFER, this.normalBuffer);\\n        gl.vertexAttribPointer(shaderProgram.iAttribNormal, 3, gl.FLOAT, false, 0, 0);\\n        gl.enableVertexAttribArray(shaderProgram.iAttribNormal);\\n        \\n        // Bind index buffer\\n        gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, this.indexBuffer);\\n        \\n        // Set material properties\\n        gl.uniform3fv(shaderProgram.iMaterialAmbient, [0.2, 0.2, 0.2]);\\n        gl.uniform3fv(shaderProgram.iMaterialDiffuse, [0.0, 0.8, 0.0]);\\n        gl.uniform3fv(shaderProgram.iMaterialSpecular, [0.8, 0.8, 0.8]);\\n        gl.uniform1f(shaderProgram.iShininess, 30.0);\\n        \\n        // Draw the triangles\\n        gl.drawElements(gl.TRIANGLES, this.numIndices, gl.UNSIGNED_SHORT, 0);\\n    };\\n}\\n\\n/**\\n * Shader Program constructor\\n */\\nfunction ShaderProgram(name, program) {\\n    this.name \u003d name;\\n    this.prog \u003d program;\\n    this.iAttribVertex \u003d -1;\\n    this.iAttribNormal \u003d -1;\\n    this.iModelViewProjectionMatrix \u003d -1;\\n    this.iModelViewMatrix \u003d -1;\\n    this.iNormalMatrix \u003d -1;\\n    this.iLightPosition \u003d -1;\\n    this.iMaterialAmbient \u003d -1;\\n    this.iMaterialDiffuse \u003d -1;\\n    this.iMaterialSpecular \u003d -1;\\n    this.iShininess \u003d -1;\\n    \\n    this.use \u003d function() {\\n        gl.useProgram(this.prog);\\n    };\\n}\\n\\n/**\\n * Calculate the normal matrix from the model-view matrix\\n * Normal matrix is the transpose of the inverse of the top-left 3x3 of the model-view matrix\\n */\\nfunction calculateNormalMatrix(modelViewMatrix, resultMatrix) {\\n    // Extract the 3x3 portion\\n    let a00 \u003d modelViewMatrix[0], a01 \u003d modelViewMatrix[1], a02 \u003d modelViewMatrix[2];\\n    let a10 \u003d modelViewMatrix[4], a11 \u003d modelViewMatrix[5], a12 \u003d modelViewMatrix[6];\\n    let a20 \u003d modelViewMatrix[8], a21 \u003d modelViewMatrix[9], a22 \u003d modelViewMatrix[10];\\n    \\n    // Calculate the determinant\\n    let det \u003d a00 * (a11 * a22 - a12 * a21) -\\n              a01 * (a10 * a22 - a12 * a20) +\\n              a02 * (a10 * a21 - a11 * a20);\\n    \\n    if (!det) {\\n        return null;\\n    }\\n    \\n    det \u003d 1.0 / det;\\n    \\n    // Calculate the inverse\\n    resultMatrix[0] \u003d (a11 * a22 - a12 * a21) * det;\\n    resultMatrix[1] \u003d (a02 * a21 - a01 * a22) * det;\\n    resultMatrix[2] \u003d (a01 * a12 - a02 * a11) * det;\\n    resultMatrix[3] \u003d (a12 * a20 - a10 * a22) * det;\\n    resultMatrix[4] \u003d (a00 * a22 - a02 * a20) * det;\\n    resultMatrix[5] \u003d (a02 * a10 - a00 * a12) * det;\\n    resultMatrix[6] \u003d (a10 * a21 - a11 * a20) * det;\\n    resultMatrix[7] \u003d (a01 * a20 - a00 * a21) * det;\\n    resultMatrix[8] \u003d (a00 * a11 - a01 * a10) * det;\\n    \\n    return resultMatrix;\\n}\\n\\n/**\\n * Update the light position for animation\\n */\\nfunction updateLightPosition() {\\n    // Rotate light around the surface\\n    lightAngle +\u003d 0.01;\\n    if (lightAngle \u003e 2 * Math.PI) {\\n        lightAngle -\u003d 2 * Math.PI;\\n    }\\n    \\n    // Calculate light position (circular orbit)\\n    const lightX \u003d lightRadius * Math.cos(lightAngle);\\n    const lightY \u003d lightRadius * Math.sin(lightAngle);\\n    const lightZ \u003d 20; // Height of the light\\n    \\n    return [lightX, lightY, lightZ];\\n}\\n\\n/**\\n * Draw function\\n */\\nfunction draw() {\\n    gl.clearColor(0, 0, 0, 1);\\n    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);\\n    \\n    // Set up viewport\\n    gl.viewport(0, 0, gl.canvas.width, gl.canvas.height);\\n    \\n    // Create custom transformation matrices\\n    const aspect \u003d gl.canvas.width/gl.canvas.height;\\n    const znear \u003d 1;\\n    const zfar \u003d 200;\\n    const fov \u003d Math.PI/3; // 60 degrees field of view\\n    \\n    // Create a projection matrix\\n    const projectionMatrix \u003d m4.perspective(fov, aspect, znear, zfar);\\n    \\n    // Get user rotation from trackball\\n    let modelViewMatrix \u003d spaceball.getViewMatrix();\\n    \\n    // Translate back to see the whole structure\\n    const moveBack \u003d m4.translation(0, 0, -50);\\n    \\n    // Update light position for animation\\n    const lightPosition \u003d updateLightPosition();\\n    \\n    // Apply transformations (right to left)\\n    modelViewMatrix \u003d m4.multiply(moveBack, modelViewMatrix);\\n    \\n    // Calculate the combined model-view-projection matrix\\n    const mvpMatrix \u003d m4.multiply(projectionMatrix, modelViewMatrix);\\n    \\n    // Calculate normal matrix (for transforming normals)\\n    const normalMatrix \u003d calculateNormalMatrix(modelViewMatrix, []);\\n    \\n    // Set shader uniforms\\n    gl.uniformMatrix4fv(shProgram.iModelViewProjectionMatrix, false, mvpMatrix);\\n    gl.uniformMatrix4fv(shProgram.iModelViewMatrix, false, modelViewMatrix);\\n    gl.uniformMatrix3fv(shProgram.iNormalMatrix, false, normalMatrix);\\n    gl.uniform3fv(shProgram.iLightPosition, lightPosition);\\n    \\n    // Draw the model\\n    surface.draw(shProgram);\\n    \\n    // Request next frame for animation\\n    requestAnimationFrame(draw);\\n}\\n\\n/**\\n * Create shader program\\n */\\nfunction createProgram(gl, vertexShaderSource, fragmentShaderSource) {\\n    // Create and compile vertex shader\\n    let vsh \u003d gl.createShader(gl.VERTEX_SHADER);\\n    gl.shaderSource(vsh, vertexShaderSource);\\n    gl.compileShader(vsh);\\n    if (!gl.getShaderParameter(vsh, gl.COMPILE_STATUS)) {\\n        throw new Error(\\\&quot;Error in vertex shader: \\\&quot; + gl.getShaderInfoLog(vsh));\\n    }\\n    \\n    // Create and compile fragment shader\\n    let fsh \u003d gl.createShader(gl.FRAGMENT_SHADER);\\n    gl.shaderSource(fsh, fragmentShaderSource);\\n    gl.compileShader(fsh);\\n    if (!gl.getShaderParameter(fsh, gl.COMPILE_STATUS)) {\\n        throw new Error(\\\&quot;Error in fragment shader: \\\&quot; + gl.getShaderInfoLog(fsh));\\n    }\\n    \\n    // Create program and link shaders\\n    let prog \u003d gl.createProgram();\\n    gl.attachShader(prog, vsh);\\n    gl.attachShader(prog, fsh);\\n    gl.linkProgram(prog);\\n    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {\\n        throw new Error(\\\&quot;Link error in program: \\\&quot; + gl.getProgramInfoLog(prog));\\n    }\\n    \\n    return prog;\\n}\\n\\n/**\\n * Initialize WebGL\\n */\\nfunction initGL() {\\n    // Create shader program\\n    let prog \u003d createProgram(gl, vertexShaderSource, fragmentShaderSource);\\n    \\n    // Create shader program object\\n    shProgram \u003d new ShaderProgram(\\\&quot;Basic\\\&quot;, prog);\\n    shProgram.use();\\n    \\n    // Get attribute and uniform locations\\n    shProgram.iAttribVertex \u003d gl.getAttribLocation(prog, \\\&quot;vertex\\\&quot;);\\n    shProgram.iAttribNormal \u003d gl.getAttribLocation(prog, \\\&quot;normal\\\&quot;);\\n    shProgram.iModelViewProjectionMatrix \u003d gl.getUniformLocation(prog, \\\&quot;ModelViewProjectionMatrix\\\&quot;);\\n    shProgram.iModelViewMatrix \u003d gl.getUniformLocation(prog, \\\&quot;ModelViewMatrix\\\&quot;);\\n    shProgram.iNormalMatrix \u003d gl.getUniformLocation(prog, \\\&quot;NormalMatrix\\\&quot;);\\n    shProgram.iLightPosition \u003d gl.getUniformLocation(prog, \\\&quot;lightPosition\\\&quot;);\\n    shProgram.iMaterialAmbient \u003d gl.getUniformLocation(prog, \\\&quot;materialAmbient\\\&quot;);\\n    shProgram.iMaterialDiffuse \u003d gl.getUniformLocation(prog, \\\&quot;materialDiffuse\\\&quot;);\\n    shProgram.iMaterialSpecular \u003d gl.getUniformLocation(prog, \\\&quot;materialSpecular\\\&quot;);\\n    shProgram.iShininess \u003d gl.getUniformLocation(prog, \\\&quot;shininess\\\&quot;);\\n    \\n    // Create model\\n    surface \u003d new CornucopiaModel();\\n    surface.initialize();\\n    \\n    // Enable depth testing\\n    gl.enable(gl.DEPTH_TEST);\\n}\\n\\n/**\\n * Update surface granularity\\n */\\nfunction updateSurfaceGranularity(uSegments, vSegments) {\\n    if (surface) {\\n        surface.uSegments \u003d uSegments;\\n        surface.vSegments \u003d vSegments;\\n        surface.initialize();\\n        // Request a redraw\\n        draw();\\n    }\\n}\\n\\n/**\\n * Main initialization function\\n */\\nfunction init() {\\n    try {\\n        // Get the canvas and initialize WebGL\\n        let canvas \u003d document.getElementById(\\\&quot;webglcanvas\\\&quot;);\\n        gl \u003d canvas.getContext(\\\&quot;webgl\\\&quot;) || canvas.getContext(\\\&quot;experimental-webgl\\\&quot;);\\n        if (!gl) {\\n            throw \\\&quot;Browser doesn\u0027t support WebGL\\\&quot;;\\n        }\\n        \\n        // Initialize GL and create the scene\\n        initGL();\\n        \\n        // Create trackball for rotation\\n        spaceball \u003d new TrackballRotator(canvas, draw, 0);\\n        \\n        // Add UI slider listeners\\n        const uGranSlider \u003d document.getElementById(\\\&quot;u-granularity\\\&quot;);\\n        const vGranSlider \u003d document.getElementById(\\\&quot;v-granularity\\\&quot;);\\n        \\n        if (uGranSlider \u0026\u0026 vGranSlider) {\\n            // Initialize display values\\n            document.getElementById(\\\&quot;u-gran-value\\\&quot;).textContent \u003d uGranSlider.value;\\n            document.getElementById(\\\&quot;v-gran-value\\\&quot;).textContent \u003d vGranSlider.value;\\n            \\n            // Define update function\\n            const updateGranularity \u003d function() {\\n                const uSegments \u003d parseInt(uGranSlider.value);\\n                const vSegments \u003d parseInt(vGranSlider.value);\\n                \\n                // Update the display values\\n                document.getElementById(\\\&quot;u-gran-value\\\&quot;).textContent \u003d uSegments;\\n                document.getElementById(\\\&quot;v-gran-value\\\&quot;).textContent \u003d vSegments;\\n                \\n                // Log the change for debugging\\n                console.log(`Updating granularity - U: ${uSegments}, V: ${vSegments}`);\\n                \\n                // Update the surface\\n                updateSurfaceGranularity(uSegments, vSegments);\\n            };\\n            \\n            // Use change event instead of input for better performance\\n            uGranSlider.addEventListener(\\\&quot;input\\\&quot;, updateGranularity);\\n            vGranSlider.addEventListener(\\\&quot;input\\\&quot;, updateGranularity);\\n            \\n            console.log(\\\&quot;Granularity slider event listeners initialized\\\&quot;);\\n        } else {\\n            console.warn(\\\&quot;Could not find granularity sliders!\\\&quot;);\\n        }\\n        \\n        // Initial drawing of the scene\\n        draw();\\n        \\n        console.log(\\\&quot;3D Cornucopia surface initialized successfully with Phong shading and Facet Average normals!\\\&quot;);\\n    } catch (e) {\\n        console.error(\\\&quot;ERROR: \\\&quot; + e);\\n        document.getElementById(\\\&quot;canvas-holder\\\&quot;).innerHTML \u003d \\n            \\\&quot;\u003cp style\u003d\u0027color:red\u0027\u003e\u003cb\u003eError:\u003c/b\u003e \\\&quot; + e + \\\&quot;\u003c/p\u003e\\\&quot;;\\n    }\\n}\&quot;}&quot;}}]},{&quot;role&quot;:&quot;tool&quot;,&quot;name&quot;:&quot;write&quot;,&quot;tool_call_id&quot;:&quot;toolu_01U6NyKh2KmegLwGFTg7AJ6m&quot;,&quot;content&quot;:&quot;Wrote contents to D:\\PROJECT_ME\\project_SHAME\\INSTITUTKA\\Visualisation\\WebGL2\\cornucopia3.js.\n\nWhen you\u0027re done with your current set of changes to this file, you should call the read_lints tool with the specific file path and fix any newly introduced errors.&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[],&quot;tool_calls&quot;:[{&quot;id&quot;:&quot;toolu_01Nj7U2zTTFxqaspM9EzUQT6&quot;,&quot;type&quot;:&quot;function&quot;,&quot;function&quot;:{&quot;name&quot;:&quot;read_lints&quot;,&quot;arguments&quot;:&quot;{\&quot;paths\&quot;: [\&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL2/cornucopia3.js\&quot;]}&quot;}}]},{&quot;role&quot;:&quot;tool&quot;,&quot;name&quot;:&quot;read_lints&quot;,&quot;tool_call_id&quot;:&quot;toolu_01Nj7U2zTTFxqaspM9EzUQT6&quot;,&quot;content&quot;:&quot;No linter errors found in 1 checked files.&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;I\u0027ve fixed the issue with the U and V segment sliders not updating the model. Here are the key changes I made:\n\n### Fixes for the U and V segment sliders:\n\n1. **Added redraw call in updateSurfaceGranularity function**\n   - Added a call to the `draw()` function after updating the surface granularity and reinitializing the model\n   - This ensures the scene is redrawn with the new mesh resolution\n\n2. **Improved slider initialization**\n   - Added code to initialize the displayed values for U and V segments at startup\n   - Added debug logging to help track when granularity values change\n\n3. **Enhanced event listener handling**\n   - Switched from using \&quot;change\&quot; to \&quot;input\&quot; events for more responsive updates\n   - Added console logging to verify the sliders are triggering events correctly\n\n4. **Fixed error checking**\n   - Added a warning message if the sliders can\u0027t be found in the DOM\n\nThese changes should make the U and V segment sliders work correctly. When you drag the sliders now, they should immediately update the surface mesh density.\n\nThe sliders now:\n1. Update the displayed values in real-time\n2. Apply the new granularity values to the surface model\n3. Trigger a redraw of the scene to show the changes\n4. Log information to the console for debugging\n\nTry adjusting the sliders now and you should see the surface mesh density change accordingly.&quot;}]},{&quot;role&quot;:&quot;user&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;Mesh Granularity\ndo not update anithing \nand i can not see my render now&quot;}],&quot;context&quot;:[{&quot;file_path&quot;:&quot;cornucopia3.js&quot;,&quot;code_text&quot;:&quot;\u0027use strict\u0027;\r\n\r\n/**\r\n * Cornucopia Surface - Parametric Surface Implementation with Phong Shading\r\n * \r\n * Parameters:\r\n * p \u003d 0.15; m \u003d 0.1\r\n * 0 ≤ u ≤ 5π; 0 ≤ v ≤ 2π\r\n * \r\n * Parametric equations:\r\n * x(u,v) \u003d [e^(mu) + e^(pu)cos(v)]cos(u)\r\n * y(u,v) \u003d [e^(mu) + e^(pu)cos(v)]sin(u)\r\n * z(u,v) \u003d e^(pu)sin(v)\r\n */\r\n\r\n// Global variables\r\nlet gl;                 // WebGL context\r\nlet surface;            // Cornucopia surface model\r\nlet shProgram;          // Shader program\r\nlet spaceball;          // Trackball rotator\r\nlet lightAngle \u003d 0;     // Angle for rotating light\r\nlet lightRadius \u003d 60;   // Distance of light from origin\r\n\r\n/**\r\n * CornucopiaModel class to create and render the surface\r\n */\r\nfunction CornucopiaModel() {\r\n    // Surface parameters - exactly as shown in Fig. 2\r\n    this.p \u003d 0.15;\r\n    this.m \u003d 0.1;\r\n    this.uMin \u003d 0;\r\n    this.uMax \u003d 5 * Math.PI;\r\n    this.vMin \u003d 0;\r\n    this.vMax \u003d 2 * Math.PI;\r\n    \r\n    // Number of segments for the grid (adjustable via sliders)\r\n    this.uSegments \u003d 80;\r\n    this.vSegments \u003d 40;\r\n    \r\n    // Buffers for the triangular mesh\r\n    this.vertexBuffer \u003d null;\r\n    this.normalBuffer \u003d null;\r\n    this.indexBuffer \u003d null;\r\n    this.numVertices \u003d 0;\r\n    this.numIndices \u003d 0;\r\n\r\n    // Array to store vertex positions for normal calculation\r\n    this.vertices \u003d [];\r\n    this.normals \u003d [];\r\n    this.indices \u003d [];\r\n    \r\n    /**\r\n     * Calculate a point on the surface using the parametric equations\r\n     */\r\n    this.computePoint \u003d function(u, v) {\r\n        const ePu \u003d Math.exp(this.p * u); // e^(pu)\r\n        const eMu \u003d Math.exp(this.m * u); // e^(mu)\r\n        \r\n        return {\r\n            x: (eMu + ePu * Math.cos(v)) * Math.cos(u),\r\n            y: (eMu + ePu * Math.cos(v)) * Math.sin(u),\r\n            z: ePu * Math.sin(v)\r\n        };\r\n    };\r\n    \r\n    /**\r\n     * Calculate the analytical normal at a point by computing the cross product\r\n     * of the tangent vectors along u and v directions\r\n     */\r\n    this.computeAnalyticalNormal \u003d function(u, v) {\r\n        const ePu \u003d Math.exp(this.p * u);\r\n        const eMu \u003d Math.exp(this.m * u);\r\n        \r\n        // Partial derivative with respect to u\r\n        const dxdu \u003d -1 * (eMu + ePu * Math.cos(v)) * Math.sin(u) \r\n                   + (this.m * eMu + this.p * ePu * Math.cos(v)) * Math.cos(u);\r\n        const dydu \u003d (eMu + ePu * Math.cos(v)) * Math.cos(u) \r\n                   + (this.m * eMu + this.p * ePu * Math.cos(v)) * Math.sin(u);\r\n        const dzdu \u003d this.p * ePu * Math.sin(v);\r\n        \r\n        // Partial derivative with respect to v\r\n        const dxdv \u003d -1 * ePu * Math.sin(v) * Math.cos(u);\r\n        const dydv \u003d -1 * ePu * Math.sin(v) * Math.sin(u);\r\n        const dzdv \u003d ePu * Math.cos(v);\r\n        \r\n        // Cross product to find normal vector\r\n        const nx \u003d dydu * dzdv - dzdu * dydv;\r\n        const ny \u003d dzdu * dxdv - dxdu * dzdv;\r\n        const nz \u003d dxdu * dydv - dydu * dxdv;\r\n        \r\n        // Normalize the normal vector\r\n        const length \u003d Math.sqrt(nx*nx + ny*ny + nz*nz);\r\n        return {\r\n            x: nx / length,\r\n            y: ny / length,\r\n            z: nz / length\r\n        };\r\n    };\r\n    \r\n    /**\r\n     * Generate the triangular mesh vertices and indices\r\n     */\r\n    this.generateMesh \u003d function() {\r\n        this.vertices \u003d [];\r\n        this.indices \u003d [];\r\n        \r\n        // Generate vertices\r\n        for (let uIndex \u003d 0; uIndex \u003c\u003d this.uSegments; uIndex++) {\r\n            const u \u003d this.uMin + (uIndex / this.uSegments) * (this.uMax - this.uMin);\r\n            \r\n            for (let vIndex \u003d 0; vIndex \u003c\u003d this.vSegments; vIndex++) {\r\n                const v \u003d this.vMin + (vIndex / this.vSegments) * (this.vMax - this.vMin);\r\n                const point \u003d this.computePoint(u, v);\r\n                \r\n                // Store vertex\r\n                this.vertices.push(point.x, point.y, point.z);\r\n                \r\n                // Calculate analytical normal for now (will be replaced with facet average)\r\n                const normal \u003d this.computeAnalyticalNormal(u, v);\r\n                this.normals.push(normal.x, normal.y, normal.z);\r\n            }\r\n        }\r\n        \r\n        // Generate indices for triangle strips\r\n        for (let uIndex \u003d 0; uIndex \u003c this.uSegments; uIndex++) {\r\n            for (let vIndex \u003d 0; vIndex \u003c this.vSegments; vIndex++) {\r\n                const vertexIndex \u003d uIndex * (this.vSegments + 1) + vIndex;\r\n                \r\n                // First triangle\r\n                this.indices.push(vertexIndex);\r\n                this.indices.push(vertexIndex + 1);\r\n                this.indices.push(vertexIndex + this.vSegments + 1);\r\n                \r\n                // Second triangle\r\n                this.indices.push(vertexIndex + 1);\r\n                this.indices.push(vertexIndex + this.vSegments + 2);\r\n                this.indices.push(vertexIndex + this.vSegments + 1);\r\n            }\r\n        }\r\n        \r\n        this.numVertices \u003d this.vertices.length / 3;\r\n        this.numIndices \u003d this.indices.length;\r\n    };\r\n    \r\n    /**\r\n     * Calculate facet normals for each triangle\r\n     */\r\n    this.calculateFacetNormals \u003d function() {\r\n        const facetNormals \u003d [];\r\n        \r\n        // Initialize facet normals array\r\n        for (let i \u003d 0; i \u003c this.numIndices / 3; i++) {\r\n            facetNormals.push({ x: 0, y: 0, z: 0 });\r\n        }\r\n        \r\n        // Calculate normal for each triangle\r\n        for (let i \u003d 0; i \u003c this.numIndices; i +\u003d 3) {\r\n            const idx1 \u003d this.indices[i];\r\n            const idx2 \u003d this.indices[i + 1];\r\n            const idx3 \u003d this.indices[i + 2];\r\n            \r\n            const v1x \u003d this.vertices[idx1 * 3];\r\n            const v1y \u003d this.vertices[idx1 * 3 + 1];\r\n            const v1z \u003d this.vertices[idx1 * 3 + 2];\r\n            \r\n            const v2x \u003d this.vertices[idx2 * 3];\r\n            const v2y \u003d this.vertices[idx2 * 3 + 1];\r\n            const v2z \u003d this.vertices[idx2 * 3 + 2];\r\n            \r\n            const v3x \u003d this.vertices[idx3 * 3];\r\n            const v3y \u003d this.vertices[idx3 * 3 + 1];\r\n            const v3z \u003d this.vertices[idx3 * 3 + 2];\r\n            \r\n            // Calculate vectors for two sides of the triangle\r\n            const ax \u003d v2x - v1x;\r\n            const ay \u003d v2y - v1y;\r\n            const az \u003d v2z - v1z;\r\n            \r\n            const bx \u003d v3x - v1x;\r\n            const by \u003d v3y - v1y;\r\n            const bz \u003d v3z - v1z;\r\n            \r\n            // Cross product to get normal\r\n            const nx \u003d ay * bz - az * by;\r\n            const ny \u003d az * bx - ax * bz;\r\n            const nz \u003d ax * by - ay * bx;\r\n            \r\n            // Normalize\r\n            const length \u003d Math.sqrt(nx*nx + ny*ny + nz*nz);\r\n            \r\n            facetNormals[i/3] \u003d {\r\n                x: nx / length,\r\n                y: ny / length,\r\n                z: nz / length\r\n            };\r\n        }\r\n        \r\n        return facetNormals;\r\n    };\r\n    \r\n    /**\r\n     * Calculate vertex normals using facet average method\r\n     */\r\n    this.calculateFacetAverageNormals \u003d function() {\r\n        // Reset normals array\r\n        this.normals \u003d new Array(this.numVertices * 3).fill(0);\r\n        \r\n        // Get facet normals\r\n        const facetNormals \u003d this.calculateFacetNormals();\r\n        \r\n        // Map to track which facets are adjacent to each vertex\r\n        const vertexFacets \u003d new Array(this.numVertices).fill().map(() \u003d\u003e []);\r\n        \r\n        // Associate each facet with its vertices\r\n        for (let i \u003d 0; i \u003c this.numIndices; i +\u003d 3) {\r\n            const faceIndex \u003d i / 3;\r\n            const idx1 \u003d this.indices[i];\r\n            const idx2 \u003d this.indices[i + 1];\r\n            const idx3 \u003d this.indices[i + 2];\r\n            \r\n            vertexFacets[idx1].push(faceIndex);\r\n            vertexFacets[idx2].push(faceIndex);\r\n            vertexFacets[idx3].push(faceIndex);\r\n        }\r\n        \r\n        // Calculate average normal for each vertex\r\n        for (let i \u003d 0; i \u003c this.numVertices; i++) {\r\n            let sumX \u003d 0, sumY \u003d 0, sumZ \u003d 0;\r\n            \r\n            // Sum normals of all adjacent facets\r\n            for (const facetIdx of vertexFacets[i]) {\r\n                sumX +\u003d facetNormals[facetIdx].x;\r\n                sumY +\u003d facetNormals[facetIdx].y;\r\n                sumZ +\u003d facetNormals[facetIdx].z;\r\n            }\r\n            \r\n            // Normalize the result\r\n            const length \u003d Math.sqrt(sumX*sumX + sumY*sumY + sumZ*sumZ);\r\n            if (length \u003e 0) {\r\n                this.normals[i * 3] \u003d sumX / length;\r\n                this.normals[i * 3 + 1] \u003d sumY / length;\r\n                this.normals[i * 3 + 2] \u003d sumZ / length;\r\n            }\r\n        }\r\n    };\r\n    \r\n    /**\r\n     * Initialize the model by generating the mesh and setting up buffers\r\n     */\r\n    this.initialize \u003d function() {\r\n        console.log(\&quot;Initializing Cornucopia with parameters:\&quot;);\r\n        console.log(\&quot;p \u003d\&quot;, this.p, \&quot;m \u003d\&quot;, this.m);\r\n        console.log(\&quot;uMax \u003d\&quot;, this.uMax/Math.PI + \&quot;π\&quot;, \&quot;vMax \u003d\&quot;, this.vMax/Math.PI + \&quot;π\&quot;);\r\n        console.log(\&quot;uSegments \u003d\&quot;, this.uSegments, \&quot;vSegments \u003d\&quot;, this.vSegments);\r\n        \r\n        // Generate the mesh data\r\n        this.generateMesh();\r\n        \r\n        // Calculate facet average normals\r\n        this.calculateFacetAverageNormals();\r\n        \r\n        // Create and populate the vertex buffer\r\n        this.vertexBuffer \u003d gl.createBuffer();\r\n        gl.bindBuffer(gl.ARRAY_BUFFER, this.vertexBuffer);\r\n        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(this.vertices), gl.STATIC_DRAW);\r\n        \r\n        // Create and populate the normal buffer\r\n        this.normalBuffer \u003d gl.createBuffer();\r\n        gl.bindBuffer(gl.ARRAY_BUFFER, this.normalBuffer);\r\n        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(this.normals), gl.STATIC_DRAW);\r\n        \r\n        // Create and populate the index buffer\r\n        this.indexBuffer \u003d gl.createBuffer();\r\n        gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, this.indexBuffer);\r\n        gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, new Uint16Array(this.indices), gl.STATIC_DRAW);\r\n    };\r\n    \r\n    /**\r\n     * Draw the model\r\n     */\r\n    this.draw \u003d function(shaderProgram) {\r\n        // Bind vertex buffer and set attribute pointer\r\n        gl.bindBuffer(gl.ARRAY_BUFFER, this.vertexBuffer);\r\n        gl.vertexAttribPointer(shaderProgram.iAttribVertex, 3, gl.FLOAT, false, 0, 0);\r\n        gl.enableVertexAttribArray(shaderProgram.iAttribVertex);\r\n        \r\n        // Bind normal buffer and set attribute pointer\r\n        gl.bindBuffer(gl.ARRAY_BUFFER, this.normalBuffer);\r\n        gl.vertexAttribPointer(shaderProgram.iAttribNormal, 3, gl.FLOAT, false, 0, 0);\r\n        gl.enableVertexAttribArray(shaderProgram.iAttribNormal);\r\n        \r\n        // Bind index buffer\r\n        gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, this.indexBuffer);\r\n        \r\n        // Set material properties\r\n        gl.uniform3fv(shaderProgram.iMaterialAmbient, [0.2, 0.2, 0.2]);\r\n        gl.uniform3fv(shaderProgram.iMaterialDiffuse, [0.0, 0.8, 0.0]);\r\n        gl.uniform3fv(shaderProgram.iMaterialSpecular, [0.8, 0.8, 0.8]);\r\n        gl.uniform1f(shaderProgram.iShininess, 30.0);\r\n        \r\n        // Draw the triangles\r\n        gl.drawElements(gl.TRIANGLES, this.numIndices, gl.UNSIGNED_SHORT, 0);\r\n    };\r\n}\r\n\r\n/**\r\n * Shader Program constructor\r\n */\r\nfunction ShaderProgram(name, program) {\r\n    this.name \u003d name;\r\n    this.prog \u003d program;\r\n    this.iAttribVertex \u003d -1;\r\n    this.iAttribNormal \u003d -1;\r\n    this.iModelViewProjectionMatrix \u003d -1;\r\n    this.iModelViewMatrix \u003d -1;\r\n    this.iNormalMatrix \u003d -1;\r\n    this.iLightPosition \u003d -1;\r\n    this.iMaterialAmbient \u003d -1;\r\n    this.iMaterialDiffuse \u003d -1;\r\n    this.iMaterialSpecular \u003d -1;\r\n    this.iShininess \u003d -1;\r\n    \r\n    this.use \u003d function() {\r\n        gl.useProgram(this.prog);\r\n    };\r\n}\r\n\r\n/**\r\n * Calculate the normal matrix from the model-view matrix\r\n * Normal matrix is the transpose of the inverse of the top-left 3x3 of the model-view matrix\r\n */\r\nfunction calculateNormalMatrix(modelViewMatrix, resultMatrix) {\r\n    // Extract the 3x3 portion\r\n    let a00 \u003d modelViewMatrix[0], a01 \u003d modelViewMatrix[1], a02 \u003d modelViewMatrix[2];\r\n    let a10 \u003d modelViewMatrix[4], a11 \u003d modelViewMatrix[5], a12 \u003d modelViewMatrix[6];\r\n    let a20 \u003d modelViewMatrix[8], a21 \u003d modelViewMatrix[9], a22 \u003d modelViewMatrix[10];\r\n    \r\n    // Calculate the determinant\r\n    let det \u003d a00 * (a11 * a22 - a12 * a21) -\r\n              a01 * (a10 * a22 - a12 * a20) +\r\n              a02 * (a10 * a21 - a11 * a20);\r\n    \r\n    if (!det) {\r\n        return null;\r\n    }\r\n    \r\n    det \u003d 1.0 / det;\r\n    \r\n    // Calculate the inverse\r\n    resultMatrix[0] \u003d (a11 * a22 - a12 * a21) * det;\r\n    resultMatrix[1] \u003d (a02 * a21 - a01 * a22) * det;\r\n    resultMatrix[2] \u003d (a01 * a12 - a02 * a11) * det;\r\n    resultMatrix[3] \u003d (a12 * a20 - a10 * a22) * det;\r\n    resultMatrix[4] \u003d (a00 * a22 - a02 * a20) * det;\r\n    resultMatrix[5] \u003d (a02 * a10 - a00 * a12) * det;\r\n    resultMatrix[6] \u003d (a10 * a21 - a11 * a20) * det;\r\n    resultMatrix[7] \u003d (a01 * a20 - a00 * a21) * det;\r\n    resultMatrix[8] \u003d (a00 * a11 - a01 * a10) * det;\r\n    \r\n    return resultMatrix;\r\n}\r\n\r\n/**\r\n * Update the light position for animation\r\n */\r\nfunction updateLightPosition() {\r\n    // Rotate light around the surface\r\n    lightAngle +\u003d 0.01;\r\n    if (lightAngle \u003e 2 * Math.PI) {\r\n        lightAngle -\u003d 2 * Math.PI;\r\n    }\r\n    \r\n    // Calculate light position (circular orbit)\r\n    const lightX \u003d lightRadius * Math.cos(lightAngle);\r\n    const lightY \u003d lightRadius * Math.sin(lightAngle);\r\n    const lightZ \u003d 20; // Height of the light\r\n    \r\n    return [lightX, lightY, lightZ];\r\n}\r\n\r\n/**\r\n * Draw function\r\n */\r\nfunction draw() {\r\n    gl.clearColor(0, 0, 0, 1);\r\n    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);\r\n    \r\n    // Set up viewport\r\n    gl.viewport(0, 0, gl.canvas.width, gl.canvas.height);\r\n    \r\n    // Create custom transformation matrices\r\n    const aspect \u003d gl.canvas.width/gl.canvas.height;\r\n    const znear \u003d 1;\r\n    const zfar \u003d 200;\r\n    const fov \u003d Math.PI/3; // 60 degrees field of view\r\n    \r\n    // Create a projection matrix\r\n    const projectionMatrix \u003d m4.perspective(fov, aspect, znear, zfar);\r\n    \r\n    // Get user rotation from trackball\r\n    let modelViewMatrix \u003d spaceball.getViewMatrix();\r\n    \r\n    // Translate back to see the whole structure\r\n    const moveBack \u003d m4.translation(0, 0, -50);\r\n    \r\n    // Update light position for animation\r\n    const lightPosition \u003d updateLightPosition();\r\n    \r\n    // Apply transformations (right to left)\r\n    modelViewMatrix \u003d m4.multiply(moveBack, modelViewMatrix);\r\n    \r\n    // Calculate the combined model-view-projection matrix\r\n    const mvpMatrix \u003d m4.multiply(projectionMatrix, modelViewMatrix);\r\n    \r\n    // Calculate normal matrix (for transforming normals)\r\n    const normalMatrix \u003d calculateNormalMatrix(modelViewMatrix, []);\r\n    \r\n    // Set shader uniforms\r\n    gl.uniformMatrix4fv(shProgram.iModelViewProjectionMatrix, false, mvpMatrix);\r\n    gl.uniformMatrix4fv(shProgram.iModelViewMatrix, false, modelViewMatrix);\r\n    gl.uniformMatrix3fv(shProgram.iNormalMatrix, false, normalMatrix);\r\n    gl.uniform3fv(shProgram.iLightPosition, lightPosition);\r\n    \r\n    // Draw the model\r\n    surface.draw(shProgram);\r\n    \r\n    // Request next frame for animation\r\n    requestAnimationFrame(draw);\r\n}\r\n\r\n/**\r\n * Create shader program\r\n */\r\nfunction createProgram(gl, vertexShaderSource, fragmentShaderSource) {\r\n    // Create and compile vertex shader\r\n    let vsh \u003d gl.createShader(gl.VERTEX_SHADER);\r\n    gl.shaderSource(vsh, vertexShaderSource);\r\n    gl.compileShader(vsh);\r\n    if (!gl.getShaderParameter(vsh, gl.COMPILE_STATUS)) {\r\n        throw new Error(\&quot;Error in vertex shader: \&quot; + gl.getShaderInfoLog(vsh));\r\n    }\r\n    \r\n    // Create and compile fragment shader\r\n    let fsh \u003d gl.createShader(gl.FRAGMENT_SHADER);\r\n    gl.shaderSource(fsh, fragmentShaderSource);\r\n    gl.compileShader(fsh);\r\n    if (!gl.getShaderParameter(fsh, gl.COMPILE_STATUS)) {\r\n        throw new Error(\&quot;Error in fragment shader: \&quot; + gl.getShaderInfoLog(fsh));\r\n    }\r\n    \r\n    // Create program and link shaders\r\n    let prog \u003d gl.createProgram();\r\n    gl.attachShader(prog, vsh);\r\n    gl.attachShader(prog, fsh);\r\n    gl.linkProgram(prog);\r\n    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {\r\n        throw new Error(\&quot;Link error in program: \&quot; + gl.getProgramInfoLog(prog));\r\n    }\r\n    \r\n    return prog;\r\n}\r\n\r\n/**\r\n * Initialize WebGL\r\n */\r\nfunction initGL() {\r\n    // Create shader program\r\n    let prog \u003d createProgram(gl, vertexShaderSource, fragmentShaderSource);\r\n    \r\n    // Create shader program object\r\n    shProgram \u003d new ShaderProgram(\&quot;Basic\&quot;, prog);\r\n    shProgram.use();\r\n    \r\n    // Get attribute and uniform locations\r\n    shProgram.iAttribVertex \u003d gl.getAttribLocation(prog, \&quot;vertex\&quot;);\r\n    shProgram.iAttribNormal \u003d gl.getAttribLocation(prog, \&quot;normal\&quot;);\r\n    shProgram.iModelViewProjectionMatrix \u003d gl.getUniformLocation(prog, \&quot;ModelViewProjectionMatrix\&quot;);\r\n    shProgram.iModelViewMatrix \u003d gl.getUniformLocation(prog, \&quot;ModelViewMatrix\&quot;);\r\n    shProgram.iNormalMatrix \u003d gl.getUniformLocation(prog, \&quot;NormalMatrix\&quot;);\r\n    shProgram.iLightPosition \u003d gl.getUniformLocation(prog, \&quot;lightPosition\&quot;);\r\n    shProgram.iMaterialAmbient \u003d gl.getUniformLocation(prog, \&quot;materialAmbient\&quot;);\r\n    shProgram.iMaterialDiffuse \u003d gl.getUniformLocation(prog, \&quot;materialDiffuse\&quot;);\r\n    shProgram.iMaterialSpecular \u003d gl.getUniformLocation(prog, \&quot;materialSpecular\&quot;);\r\n    shProgram.iShininess \u003d gl.getUniformLocation(prog, \&quot;shininess\&quot;);\r\n    \r\n    // Create model\r\n    surface \u003d new CornucopiaModel();\r\n    surface.initialize();\r\n    \r\n    // Enable depth testing\r\n    gl.enable(gl.DEPTH_TEST);\r\n}\r\n\r\n/**\r\n * Update surface granularity\r\n */\r\nfunction updateSurfaceGranularity(uSegments, vSegments) {\r\n    if (surface) {\r\n        surface.uSegments \u003d uSegments;\r\n        surface.vSegments \u003d vSegments;\r\n        surface.initialize();\r\n        // Request a redraw\r\n        draw();\r\n    }\r\n}\r\n\r\n/**\r\n * Main initialization function\r\n */\r\nfunction init() {\r\n    try {\r\n        // Get the canvas and initialize WebGL\r\n        let canvas \u003d document.getElementById(\&quot;webglcanvas\&quot;);\r\n        gl \u003d canvas.getContext(\&quot;webgl\&quot;) || canvas.getContext(\&quot;experimental-webgl\&quot;);\r\n        if (!gl) {\r\n            throw \&quot;Browser doesn\u0027t support WebGL\&quot;;\r\n        }\r\n        \r\n        // Initialize GL and create the scene\r\n        initGL();\r\n        \r\n        // Create trackball for rotation\r\n        spaceball \u003d new TrackballRotator(canvas, draw, 0);\r\n        \r\n        // Add UI slider listeners\r\n        const uGranSlider \u003d document.getElementById(\&quot;u-granularity\&quot;);\r\n        const vGranSlider \u003d document.getElementById(\&quot;v-granularity\&quot;);\r\n        \r\n        if (uGranSlider \u0026\u0026 vGranSlider) {\r\n            // Initialize display values\r\n            document.getElementById(\&quot;u-gran-value\&quot;).textContent \u003d uGranSlider.value;\r\n            document.getElementById(\&quot;v-gran-value\&quot;).textContent \u003d vGranSlider.value;\r\n            \r\n            // Define update function\r\n            const updateGranularity \u003d function() {\r\n                const uSegments \u003d parseInt(uGranSlider.value);\r\n                const vSegments \u003d parseInt(vGranSlider.value);\r\n                \r\n                // Update the display values\r\n                document.getElementById(\&quot;u-gran-value\&quot;).textContent \u003d uSegments;\r\n                document.getElementById(\&quot;v-gran-value\&quot;).textContent \u003d vSegments;\r\n                \r\n                // Log the change for debugging\r\n                console.log(`Updating granularity - U: ${uSegments}, V: ${vSegments}`);\r\n                \r\n                // Update the surface\r\n                updateSurfaceGranularity(uSegments, vSegments);\r\n            };\r\n            \r\n            // Use change event instead of input for better performance\r\n            uGranSlider.addEventListener(\&quot;input\&quot;, updateGranularity);\r\n            vGranSlider.addEventListener(\&quot;input\&quot;, updateGranularity);\r\n            \r\n            console.log(\&quot;Granularity slider event listeners initialized\&quot;);\r\n        } else {\r\n            console.warn(\&quot;Could not find granularity sliders!\&quot;);\r\n        }\r\n        \r\n        // Initial drawing of the scene\r\n        draw();\r\n        \r\n        console.log(\&quot;3D Cornucopia surface initialized successfully with Phong shading and Facet Average normals!\&quot;);\r\n    } catch (e) {\r\n        console.error(\&quot;ERROR: \&quot; + e);\r\n        document.getElementById(\&quot;canvas-holder\&quot;).innerHTML \u003d \r\n            \&quot;\u003cp style\u003d\u0027color:red\u0027\u003e\u003cb\u003eError:\u003c/b\u003e \&quot; + e + \&quot;\u003c/p\u003e\&quot;;\r\n    }\r\n}&quot;,&quot;ranges&quot;:[],&quot;type&quot;:&quot;current_file&quot;},{&quot;file_path&quot;:&quot;index.html&quot;,&quot;code_text&quot;:&quot;\u003c!DOCTYPE html\u003e\r\n\u003chtml\u003e\r\n\u003chead\u003e\r\n    \u003cmeta http-equiv\u003d\&quot;Content-Type\&quot; content\u003d\&quot;text/html; charset\u003dUTF-8\&quot;\u003e\r\n    \u003ctitle\u003eCornucopia Surface - WebGL Visualization with Phong Shading\u003c/title\u003e\r\n    \u003cstyle\u003e\r\n        body {\r\n            background-color: #111;\r\n            font-family: Arial, sans-serif;\r\n            color: #fff;\r\n            text-align: center;\r\n            margin: 0;\r\n            padding: 20px;\r\n        }\r\n        h1, h2 {\r\n            color: #0f0;\r\n        }\r\n        h1 {\r\n            margin-top: 10px;\r\n            font-size: 28px;\r\n        }\r\n        h2 {\r\n            font-size: 22px;\r\n            margin-top: 25px;\r\n        }\r\n        .container {\r\n            max-width: 1000px;\r\n            margin: 0 auto;\r\n            padding: 20px;\r\n        }\r\n        #canvas-holder {\r\n            margin: 20px auto;\r\n            width: 800px;\r\n        }\r\n        canvas {\r\n            border: 1px solid #0f0;\r\n            display: block;\r\n            margin: 0 auto;\r\n        }\r\n        .info-panel {\r\n            text-align: left;\r\n            background-color: rgba(0, 50, 0, 0.3);\r\n            border: 1px solid #0f0;\r\n            padding: 20px;\r\n            border-radius: 5px;\r\n            margin: 20px auto;\r\n            max-width: 800px;\r\n        }\r\n        .controls-panel {\r\n            margin: 20px auto;\r\n            display: inline-block;\r\n            background-color: rgba(0, 30, 0, 0.7);\r\n            padding: 15px;\r\n            border-radius: 5px;\r\n            text-align: left;\r\n            width: 90%;\r\n            box-sizing: border-box;\r\n        }\r\n        .math-formula {\r\n            background-color: rgba(0, 30, 0, 0.5);\r\n            padding: 15px;\r\n            border-radius: 5px;\r\n            margin: 15px 0;\r\n            font-family: \&quot;Courier New\&quot;, monospace;\r\n        }\r\n        .footer {\r\n            margin-top: 30px;\r\n            font-size: 14px;\r\n            color: #aaa;\r\n            border-top: 1px solid #333;\r\n            padding-top: 15px;\r\n        }\r\n        .student-info {\r\n            text-align: left;\r\n            background-color: rgba(0, 40, 0, 0.3);\r\n            border-left: 3px solid #0f0;\r\n            padding: 10px 20px;\r\n            margin: 25px auto;\r\n            max-width: 600px;\r\n        }\r\n        .slider-container {\r\n            margin: 15px 0;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: space-between;\r\n        }\r\n        .slider-label {\r\n            width: 150px;\r\n            text-align: right;\r\n            margin-right: 15px;\r\n        }\r\n        .slider {\r\n            flex-grow: 1;\r\n            height: 5px;\r\n            background: #333;\r\n            outline: none;\r\n            -webkit-appearance: none;\r\n        }\r\n        .slider::-webkit-slider-thumb {\r\n            -webkit-appearance: none;\r\n            appearance: none;\r\n            width: 15px;\r\n            height: 15px;\r\n            background: #0f0;\r\n            border-radius: 50%;\r\n            cursor: pointer;\r\n        }\r\n        .slider::-moz-range-thumb {\r\n            width: 15px;\r\n            height: 15px;\r\n            background: #0f0;\r\n            border-radius: 50%;\r\n            cursor: pointer;\r\n        }\r\n        .slider-value {\r\n            width: 40px;\r\n            margin-left: 15px;\r\n            text-align: center;\r\n        }\r\n        .parameter-row {\r\n            margin-bottom: 8px;\r\n            display: flex;\r\n            align-items: center;\r\n        }\r\n        .parameter-label {\r\n            display: inline-block;\r\n            width: 80px;\r\n        }\r\n        .parameter-input {\r\n            width: 80px;\r\n            background-color: #111;\r\n            color: #0f0;\r\n            border: 1px solid #0f0;\r\n            padding: 4px;\r\n        }\r\n        h3 {\r\n            margin-top: 0;\r\n            color: #0f0;\r\n        }\r\n        ul {\r\n            padding-left: 20px;\r\n        }\r\n        li {\r\n            margin-bottom: 8px;\r\n        }\r\n    \u003c/style\u003e\r\n\r\n    \u003c!-- Core libraries --\u003e\r\n    \u003cscript src\u003d\&quot;./Utils/m4.js\&quot;\u003e\u003c/script\u003e\r\n    \u003cscript src\u003d\&quot;./Utils/trackball-rotator.js\&quot;\u003e\u003c/script\u003e\r\n    \u003cscript src\u003d\&quot;./shaders.js\&quot;\u003e\u003c/script\u003e\r\n    \u003cscript src\u003d\&quot;./cornucopia3.js\&quot;\u003e\u003c/script\u003e\r\n        \r\n    \u003cscript\u003e\r\n        // Add event listener for the refresh button after the page loads\r\n        window.addEventListener(\u0027load\u0027, function() {\r\n            const refreshButton \u003d document.getElementById(\u0027refresh-button\u0027);\r\n            const paramP \u003d document.getElementById(\u0027param-p\u0027);\r\n            const paramM \u003d document.getElementById(\u0027param-m\u0027);\r\n            const paramU \u003d document.getElementById(\u0027param-u\u0027);\r\n            const paramV \u003d document.getElementById(\u0027param-v\u0027);\r\n            \r\n            // Set initial values directly from the mathematical definition\r\n            // These values match exactly what\u0027s shown in the Mathematical Definition section\r\n            paramP.value \u003d 0.15; // p \u003d 0.15\r\n            paramM.value \u003d 0.1;  // m \u003d 0.1\r\n            paramU.value \u003d 5;    // u ≤ 5π\r\n            paramV.value \u003d 2;    // v ≤ 2π\r\n            \r\n            // Also ensure the model uses these exact values\r\n            setTimeout(function() {\r\n                if (surface) {\r\n                    // Verify that the model parameters match the HTML definition\r\n                    if (surface.p !\u003d 0.15 || surface.m !\u003d 0.1 || \r\n                        surface.uMax !\u003d 5 * Math.PI || surface.vMax !\u003d 2 * Math.PI) {\r\n                        console.log(\&quot;Correcting model parameters to match Mathematical Definition\&quot;);\r\n                        surface.p \u003d 0.15;\r\n                        surface.m \u003d 0.1;\r\n                        surface.uMax \u003d 5 * Math.PI;\r\n                        surface.vMax \u003d 2 * Math.PI;\r\n                        surface.initialize();\r\n                        draw();\r\n                    }\r\n                }\r\n            }, 500);\r\n            \r\n            if (refreshButton) {\r\n                refreshButton.addEventListener(\u0027click\u0027, function() {\r\n                    // Get values from inputs\r\n                    if (surface) {\r\n                        // Update parameters\r\n                        surface.p \u003d parseFloat(paramP.value);\r\n                        surface.m \u003d parseFloat(paramM.value);\r\n                        surface.uMax \u003d parseFloat(paramU.value) * Math.PI;\r\n                        surface.vMax \u003d parseFloat(paramV.value) * Math.PI;\r\n                        \r\n                        console.log(\&quot;Applying new parameters:\&quot;);\r\n                        console.log(\&quot;p \u003d\&quot;, surface.p, \&quot;m \u003d\&quot;, surface.m, \&quot;uMax \u003d\&quot;, surface.uMax/Math.PI + \&quot;π\&quot;, \&quot;vMax \u003d\&quot;, surface.vMax/Math.PI + \&quot;π\&quot;);\r\n                        \r\n                        // Update formula display in the info panel\r\n                        const mathFormula \u003d document.querySelector(\u0027.math-formula\u0027);\r\n                        if (mathFormula) {\r\n                            // Find the part after the parametric equations\r\n                            const whereSection \u003d mathFormula.innerHTML.split(\u0027\u003cstrong\u003eWhere:\u003c/strong\u003e\u0027);\r\n                            if (whereSection.length \u003e 1) {\r\n                                mathFormula.innerHTML \u003d whereSection[0] + \r\n                                    \u0027\u003cstrong\u003eWhere:\u003c/strong\u003e\u003cbr\u003e\u0027 +\r\n                                    \u0027- p \u003d \u0027 + surface.p + \u0027 (parameter p)\u003cbr\u003e\u0027 +\r\n                                    \u0027- m \u003d \u0027 + surface.m + \u0027 (parameter m)\u003cbr\u003e\u0027 +\r\n                                    \u0027- 0 ≤ u ≤ \u0027 + (surface.uMax/Math.PI) + \u0027π (lengthwise parameter)\u003cbr\u003e\u0027 +\r\n                                    \u0027- 0 ≤ v ≤ \u0027 + (surface.vMax/Math.PI) + \u0027π (cross-section parameter)\u0027;\r\n                            }\r\n                        }\r\n                        \r\n                        // Reinitialize the model\r\n                        surface.initialize();\r\n                        \r\n                        // Redraw\r\n                        draw();\r\n                        \r\n                        console.log(\&quot;Model updated with new parameters!\&quot;);\r\n                        \r\n                        // Flash confirmation message\r\n                        const button \u003d document.getElementById(\u0027refresh-button\u0027);\r\n                        button.textContent \u003d \&quot;Parameters Applied!\&quot;;\r\n                        button.style.backgroundColor \u003d \&quot;#00ff99\&quot;;\r\n                        setTimeout(function() {\r\n                            button.textContent \u003d \&quot;Apply Parameters\&quot;;\r\n                            button.style.backgroundColor \u003d \&quot;#0f0\&quot;;\r\n                        }, 1500);\r\n                    }\r\n                });\r\n            }\r\n        });\r\n    \u003c/script\u003e\r\n\u003c/head\u003e\r\n\u003cbody onload\u003d\&quot;init()\&quot;\u003e\r\n    \u003cdiv class\u003d\&quot;container\&quot;\u003e\r\n        \u003ch1\u003eCornucopia Surface - WebGL Visualization with Phong Shading\u003c/h1\u003e\r\n        \r\n        \u003cdiv class\u003d\&quot;info-panel\&quot;\u003e\r\n            \u003ch2\u003eProject Description\u003c/h2\u003e\r\n            \u003cp\u003eThis visualization demonstrates a 3D model of a \&quot;Cornucopia\&quot; surface rendered using WebGL with Phong shading and Facet Average normal calculation.\u003c/p\u003e\r\n            \u003cp\u003eThe Cornucopia is a special case of a spiral-shaped surface \&quot;Shell without vertex\&quot;. It\u0027s a cyclic surface with generatrix circles of variable radius that creates the distinctive horn-like shape.\u003c/p\u003e\r\n            \r\n            \u003ch2\u003eMathematical Definition\u003c/h2\u003e\r\n            \u003cp\u003eThe Cornucopia surface is defined by the following parametric equations:\u003c/p\u003e\r\n            \r\n            \u003cdiv class\u003d\&quot;math-formula\&quot;\u003e\r\n                \u003cstrong\u003eParametric Equations:\u003c/strong\u003e\u003cbr\u003e\r\n                x(u,v) \u003d [e\u003csup\u003emu\u003c/sup\u003e + e\u003csup\u003epu\u003c/sup\u003ecos(v)]cos(u)\u003cbr\u003e\r\n                y(u,v) \u003d [e\u003csup\u003emu\u003c/sup\u003e + e\u003csup\u003epu\u003c/sup\u003ecos(v)]sin(u)\u003cbr\u003e\r\n                z(u,v) \u003d e\u003csup\u003epu\u003c/sup\u003esin(v)\u003cbr\u003e\u003cbr\u003e\r\n                \r\n                \u003cstrong\u003eWhere:\u003c/strong\u003e\u003cbr\u003e\r\n                - p \u003d 0.15 (parameter p)\u003cbr\u003e\r\n                - m \u003d 0.1 (parameter m)\u003cbr\u003e\r\n                - 0 ≤ u ≤ 5π (lengthwise parameter)\u003cbr\u003e\r\n                - 0 ≤ v ≤ 2π (cross-section parameter)\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv id\u003d\&quot;canvas-holder\&quot;\u003e\r\n            \u003ccanvas width\u003d\&quot;800\&quot; height\u003d\&quot;600\&quot; id\u003d\&quot;webglcanvas\&quot; style\u003d\&quot;background-color:black\&quot;\u003e\u003c/canvas\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv class\u003d\&quot;controls-panel\&quot;\u003e\r\n            \u003ch3\u003eSurface Parameters\u003c/h3\u003e\r\n            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\r\n                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-p\&quot;\u003ep value:\u003c/label\u003e\r\n                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-p\&quot; value\u003d\&quot;0.15\&quot; step\u003d\&quot;0.01\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\r\n                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-m\&quot;\u003em value:\u003c/label\u003e\r\n                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-m\&quot; value\u003d\&quot;0.1\&quot; step\u003d\&quot;0.01\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\r\n                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-u\&quot;\u003eu max (π):\u003c/label\u003e\r\n                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-u\&quot; value\u003d\&quot;5\&quot; step\u003d\&quot;0.5\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\r\n                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-v\&quot;\u003ev max (π):\u003c/label\u003e\r\n                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-v\&quot; value\u003d\&quot;2\&quot; step\u003d\&quot;0.5\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\r\n            \u003c/div\u003e\r\n            \r\n            \u003cbutton id\u003d\&quot;refresh-button\&quot; style\u003d\&quot;margin-top: 10px; padding: 8px 16px; background-color: #0f0; color: black; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;\&quot;\u003eApply Parameters\u003c/button\u003e\r\n            \r\n            \u003chr style\u003d\&quot;border-color: #333; margin: 20px 0;\&quot;\u003e\r\n            \r\n            \u003ch3\u003eMesh Granularity\u003c/h3\u003e\r\n            \u003cdiv class\u003d\&quot;slider-container\&quot;\u003e\r\n                \u003cspan class\u003d\&quot;slider-label\&quot;\u003eU Segments:\u003c/span\u003e\r\n                \u003cinput type\u003d\&quot;range\&quot; min\u003d\&quot;10\&quot; max\u003d\&quot;200\&quot; value\u003d\&quot;80\&quot; class\u003d\&quot;slider\&quot; id\u003d\&quot;u-granularity\&quot;\u003e\r\n                \u003cspan class\u003d\&quot;slider-value\&quot; id\u003d\&quot;u-gran-value\&quot;\u003e80\u003c/span\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class\u003d\&quot;slider-container\&quot;\u003e\r\n                \u003cspan class\u003d\&quot;slider-label\&quot;\u003eV Segments:\u003c/span\u003e\r\n                \u003cinput type\u003d\&quot;range\&quot; min\u003d\&quot;10\&quot; max\u003d\&quot;100\&quot; value\u003d\&quot;40\&quot; class\u003d\&quot;slider\&quot; id\u003d\&quot;v-granularity\&quot;\u003e\r\n                \u003cspan class\u003d\&quot;slider-value\&quot; id\u003d\&quot;v-gran-value\&quot;\u003e40\u003c/span\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv class\u003d\&quot;info-panel\&quot;\u003e\r\n            \u003ch2\u003eImplementation Details\u003c/h2\u003e\r\n            \u003cp\u003eThis implementation includes:\u003c/p\u003e\r\n            \u003cul\u003e\r\n                \u003cli\u003e\u003cstrong\u003ePhong Shading:\u003c/strong\u003e Realistic lighting with ambient, diffuse, and specular components\u003c/li\u003e\r\n                \u003cli\u003e\u003cstrong\u003eFacet Average Normal:\u003c/strong\u003e Normals are calculated by averaging adjacent facet normals\u003c/li\u003e\r\n                \u003cli\u003e\u003cstrong\u003eRotating Light Source:\u003c/strong\u003e A moving light that circles around the model\u003c/li\u003e\r\n                \u003cli\u003e\u003cstrong\u003eTriangle Mesh:\u003c/strong\u003e The surface is rendered with filled triangles using VBO with indices\u003c/li\u003e\r\n                \u003cli\u003e\u003cstrong\u003eAdjustable Granularity:\u003c/strong\u003e U and V segment sliders allow controlling the mesh density\u003c/li\u003e\r\n            \u003c/ul\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv class\u003d\&quot;student-info\&quot;\u003e\r\n            \u003ch2\u003eStudent Information\u003c/h2\u003e\r\n            \u003cp\u003e\u003cstrong\u003eName:\u003c/strong\u003e Pashchenko Mykola\u003c/p\u003e\r\n            \u003cp\u003e\u003cstrong\u003eGroup:\u003c/strong\u003e TR-51mp\u003c/p\u003e\r\n            \u003cp\u003e\u003cstrong\u003eCourse:\u003c/strong\u003e WebGL Visualization\u003c/p\u003e\r\n            \u003cp\u003e\u003cstrong\u003eAssignment:\u003c/strong\u003e PA#2 - Cornucopia Surface with Phong Shading\u003c/p\u003e\r\n            \u003cp\u003e\u003cstrong\u003eVariant:\u003c/strong\u003e 23 (Phong Shading, Facet Average Normals)\u003c/p\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv class\u003d\&quot;footer\&quot;\u003e\r\n            \u003cp\u003eInteractive WebGL Visualization - Created using JavaScript and WebGL\u003c/p\u003e\r\n            \u003cp\u003eDrag your mouse on the model to rotate it. On a touch screen, you can use your finger.\u003c/p\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n\u003c/body\u003e\r\n\u003c/html\u003e&quot;,&quot;timestamp&quot;:1766676322978,&quot;ranges&quot;:[],&quot;type&quot;:&quot;recent_file&quot;},{&quot;mode&quot;:&quot;Write&quot;,&quot;plan_file_path&quot;:&quot;C:\\