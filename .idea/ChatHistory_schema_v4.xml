 Math.PI;\n105|                            surface.initialize();\n106|                            draw();\n107|                        }\n108|                    }\n109|                }, 500);\n110|                \n111|                if (refreshButton) {\n112|                    refreshButton.addEventListener(\u0027click\u0027, function() {\n113|                        // Get values from inputs\n114|                        if (surface) {\n115|                            // Update parameters\n116|                            surface.p \u003d parseFloat(paramP.value);\n117|                            surface.m \u003d parseFloat(paramM.value);\n118|                            surface.uMax \u003d parseFloat(paramU.value) * Math.PI;\n119|                            surface.vMax \u003d parseFloat(paramV.value) * Math.PI;\n120|                            \n121|                            console.log(\&quot;Applying new parameters:\&quot;);\n122|                            console.log(\&quot;p \u003d\&quot;, surface.p, \&quot;m \u003d\&quot;, surface.m, \&quot;uMax \u003d\&quot;, surface.uMax/Math.PI + \&quot;π\&quot;, \&quot;vMax \u003d\&quot;, surface.vMax/Math.PI + \&quot;π\&quot;);\n123|                            \n124|                            // Update formula display in the info panel\n125|                            const mathFormula \u003d document.querySelector(\u0027.math-formula\u0027);\n126|                            if (mathFormula) {\n127|                                // Find the part after the parametric equations\n128|                                const whereSection \u003d mathFormula.innerHTML.split(\u0027\u003cstrong\u003eWhere:\u003c/strong\u003e\u0027);\n129|                                if (whereSection.length \u003e 1) {\n130|                                    mathFormula.innerHTML \u003d whereSection[0] + \n131|                                        \u0027\u003cstrong\u003eWhere:\u003c/strong\u003e\u003cbr\u003e\u0027 +\n132|                                        \u0027- p \u003d \u0027 + surface.p + \u0027 (parameter p)\u003cbr\u003e\u0027 +\n133|                                        \u0027- m \u003d \u0027 + surface.m + \u0027 (parameter m)\u003cbr\u003e\u0027 +\n134|                                        \u0027- 0 ≤ u ≤ \u0027 + (surface.uMax/Math.PI) + \u0027π (lengthwise parameter)\u003cbr\u003e\u0027 +\n135|                                        \u0027- 0 ≤ v ≤ \u0027 + (surface.vMax/Math.PI) + \u0027π (cross-section parameter)\u0027;\n136|                                }\n137|                            }\n138|                            \n139|                            // Reinitialize the model\n140|                            surface.initialize();\n141|                            \n142|                            // Redraw\n143|                            draw();\n144|                            \n145|                            console.log(\&quot;Model updated with new parameters!\&quot;);\n146|                            \n147|                            // Flash confirmation message\n148|                            const button \u003d document.getElementById(\u0027refresh-button\u0027);\n149|                            button.textContent \u003d \&quot;Parameters Applied!\&quot;;\n150|                            button.style.backgroundColor \u003d \&quot;#00ff99\&quot;;\n151|                            setTimeout(function() {\n152|                                button.textContent \u003d \&quot;Apply Parameters\&quot;;\n153|                                button.style.backgroundColor \u003d \&quot;#0f0\&quot;;\n154|                            }, 1500);\n155|                        }\n156|                    });\n157|                }\n158|            });\n159|            \n160|            // No helper functions needed\n161|        \u003c/script\u003e\n162|\u003c/head\u003e\n163|\u003cbody onload\u003d\&quot;init()\&quot;\u003e\n164|    \u003cdiv class\u003d\&quot;container\&quot;\u003e\n165|        \u003ch1\u003eCornucopia Surface - WebGL Visualization\u003c/h1\u003e\n166|        \n167|        \u003cdiv class\u003d\&quot;info-panel\&quot;\u003e\n168|            \u003ch2\u003eProject Description\u003c/h2\u003e\n169|            \u003cp\u003eThis visualization demonstrates a 3D wireframe model of a \&quot;Cornucopia\&quot; surface rendered using WebGL.\u003c/p\u003e\n170|            \u003cp\u003eThe Cornucopia is a special case of a spiral-shaped surface \&quot;Shell without vertex\&quot;. It\u0027s a cyclic surface with generatrix circles of variable radius that creates the distinctive horn-like shape.\u003c/p\u003e\n171|            \n172|            \u003ch2\u003eMathematical Definition\u003c/h2\u003e\n173|            \u003cp\u003eThe Cornucopia surface is defined by the following parametric equations:\u003c/p\u003e\n174|            \n175|            \u003cdiv class\u003d\&quot;math-formula\&quot;\u003e\n176|                \u003cstrong\u003eParametric Equations:\u003c/strong\u003e\u003cbr\u003e\n177|                x(u,v) \u003d [e\u003csup\u003emu\u003c/sup\u003e + e\u003csup\u003epu\u003c/sup\u003ecos(v)]cos(u)\u003cbr\u003e\n178|                y(u,v) \u003d [e\u003csup\u003emu\u003c/sup\u003e + e\u003csup\u003epu\u003c/sup\u003ecos(v)]sin(u)\u003cbr\u003e\n179|                z(u,v) \u003d e\u003csup\u003epu\u003c/sup\u003esin(v)\u003cbr\u003e\u003cbr\u003e\n180|                \n181|                \u003cstrong\u003eWhere:\u003c/strong\u003e\u003cbr\u003e\n182|                - p \u003d 0.15 (parameter p)\u003cbr\u003e\n183|                - m \u003d 0.1 (parameter m)\u003cbr\u003e\n184|                - 0 ≤ u ≤ 5π (lengthwise parameter)\u003cbr\u003e\n185|                - 0 ≤ v ≤ 2π (cross-section parameter)\n186|            \u003c/div\u003e\n187|        \u003c/div\u003e\n188|        \n189|        \u003cdiv id\u003d\&quot;canvas-holder\&quot;\u003e\n190|            \u003ccanvas width\u003d\&quot;800\&quot; height\u003d\&quot;600\&quot; id\u003d\&quot;webglcanvas\&quot; style\u003d\&quot;background-color:black\&quot;\u003e\u003c/canvas\u003e\n191|            \u003cdiv style\u003d\&quot;margin-top: 10px; text-align: center;\&quot;\u003e\n192|                \u003cdiv style\u003d\&quot;margin-bottom: 10px; display: inline-block; background-color: rgba(0, 30, 0, 0.7); padding: 10px; border-radius: 5px; text-align: left;\&quot;\u003e\n193|                    \u003cdiv style\u003d\&quot;margin-bottom: 8px;\&quot;\u003e\n194|                        \u003clabel for\u003d\&quot;param-p\&quot; style\u003d\&quot;display: inline-block; width: 80px;\&quot;\u003ep value:\u003c/label\u003e\n195|                        \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-p\&quot; value\u003d\&quot;0.15\&quot; step\u003d\&quot;0.01\&quot; style\u003d\&quot;width: 80px; background-color: #111; color: #0f0; border: 1px solid #0f0; padding: 4px;\&quot;\u003e\n196|                    \u003c/div\u003e\n197|                    \u003cdiv style\u003d\&quot;margin-bottom: 8px;\&quot;\u003e\n198|                        \u003clabel for\u003d\&quot;param-m\&quot; style\u003d\&quot;display: inline-block; width: 80px;\&quot;\u003em value:\u003c/label\u003e\n199|                        \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-m\&quot; value\u003d\&quot;0.1\&quot; step\u003d\&quot;0.01\&quot; style\u003d\&quot;width: 80px; background-color: #111; color: #0f0; border: 1px solid #0f0; padding: 4px;\&quot;\u003e\n200|                    \u003c/div\u003e\n201|                    \u003cdiv style\u003d\&quot;margin-bottom: 8px;\&quot;\u003e\n202|                        \u003clabel for\u003d\&quot;param-u\&quot; style\u003d\&quot;display: inline-block; width: 80px;\&quot;\u003eu max (π):\u003c/label\u003e\n203|                        \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-u\&quot; value\u003d\&quot;5\&quot; step\u003d\&quot;0.5\&quot; style\u003d\&quot;width: 80px; background-color: #111; color: #0f0; border: 1px solid #0f0; padding: 4px;\&quot;\u003e\n204|                    \u003c/div\u003e\n205|                    \u003cdiv style\u003d\&quot;margin-bottom: 8px;\&quot;\u003e\n206|                        \u003clabel for\u003d\&quot;param-v\&quot; style\u003d\&quot;display: inline-block; width: 80px;\&quot;\u003ev max (π):\u003c/label\u003e\n207|                        \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-v\&quot; value\u003d\&quot;2\&quot; step\u003d\&quot;0.5\&quot; style\u003d\&quot;width: 80px; background-color: #111; color: #0f0; border: 1px solid #0f0; padding: 4px;\&quot;\u003e\n208|                    \u003c/div\u003e\n209|                \u003c/div\u003e\n210|                \u003cdiv style\u003d\&quot;margin-top: 10px;\&quot;\u003e\n211|                    \u003cbutton id\u003d\&quot;refresh-button\&quot; style\u003d\&quot;padding: 8px 16px; background-color: #0f0; color: black; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;\&quot;\u003eApply Parameters\u003c/button\u003e\n212|                \u003c/div\u003e\n213|            \u003c/div\u003e\n214|        \u003c/div\u003e\n215|        \n216|        \u003cdiv style\u003d\&quot;height: 180px;\&quot;\u003e\u003c/div\u003e\n217|        \u003cdiv class\u003d\&quot;student-info\&quot;\u003e\n218|            \u003ch2\u003eStudent Information\u003c/h2\u003e\n219|            \u003cp\u003e\u003cstrong\u003eName:\u003c/strong\u003e Pashchenko Mykola\u003c/p\u003e\n220|            \u003cp\u003e\u003cstrong\u003eGroup:\u003c/strong\u003e TR-51mp\u003c/p\u003e\n221|            \u003cp\u003e\u003cstrong\u003eCourse:\u003c/strong\u003e WebGL Visualization\u003c/p\u003e\n222|            \u003cp\u003e\u003cstrong\u003eAssignment:\u003c/strong\u003e PA#1 - Cornucopia Surface Rendering\u003c/p\u003e\n223|        \u003c/div\u003e\n224|        \n225|        \u003cdiv class\u003d\&quot;footer\&quot;\u003e\n226|            \u003cp\u003eInteractive WebGL Visualization - Created using JavaScript and WebGL\u003c/p\u003e\n227|            \u003cp\u003eDrag your mouse on the model to rotate it. On a touch screen, you can use your finger.\u003c/p\u003e\n228|        \u003c/div\u003e\n229|    \u003c/div\u003e\n230|\u003c/body\u003e\n231|\u003c/html\u003e&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;Let\u0027s check the cornucopia3.js file to understand the surface implementation:&quot;}],&quot;tool_calls&quot;:[{&quot;id&quot;:&quot;toolu_01GTBbgUocnF4C5Q7pjXqrrY&quot;,&quot;type&quot;:&quot;function&quot;,&quot;function&quot;:{&quot;name&quot;:&quot;read_file&quot;,&quot;arguments&quot;:&quot;{\&quot;target_file\&quot;: \&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL2/cornucopia3.js\&quot;}&quot;}}]},{&quot;role&quot;:&quot;tool&quot;,&quot;name&quot;:&quot;read&quot;,&quot;tool_call_id&quot;:&quot;toolu_01GTBbgUocnF4C5Q7pjXqrrY&quot;,&quot;content&quot;:&quot;  1|\u0027use strict\u0027;\n  2|\n  3|/**\n  4| * Cornucopia Surface - Fig. 2 Implementation\n  5| * \n  6| * Parameters:\n  7| * p \u003d 0.15; m \u003d 0.1\n  8| * 0 ≤ u ≤ 5π; 0 ≤ v ≤ 2π\n  9| * \n 10| * Parametric equations:\n 11| * x(u,v) \u003d [e^(mu) + e^(pu)cos(v)]cos(u)\n 12| * y(u,v) \u003d [e^(mu) + e^(pu)cos(v)]sin(u)\n 13| * z(u,v) \u003d e^(pu)sin(v)\n 14| */\n 15|\n 16|// Global variables\n 17|let gl;                 // WebGL context\n 18|let surface;            // Cornucopia surface model\n 19|let shProgram;          // Shader program\n 20|let spaceball;          // Trackball rotator\n 21|\n 22|/**\n 23| * CornucopiaModel class to create and render the surface\n 24| */\n 25|function CornucopiaModel() {\n 26|    // Surface parameters - exactly as shown in Fig. 2\n 27|    this.p \u003d 0.15;\n 28|    this.m \u003d 0.1;\n 29|    this.uMin \u003d 0;\n 30|    this.uMax \u003d 5 * Math.PI;\n 31|    this.vMin \u003d 0;\n 32|    this.vMax \u003d 2 * Math.PI;\n 33|    \n 34|    // Number of segments for the grid\n 35|    this.uSegments \u003d 80;\n 36|    this.vSegments \u003d 40;\n 37|    \n 38|    // Buffers for drawing the grid lines\n 39|    this.uLinesBuffer \u003d null;\n 40|    this.vLinesBuffer \u003d null;\n 41|\n 42|    /**\n 43|     * Calculate a point on the surface using the parametric equations\n 44|     */\n 45|    this.computePoint \u003d function(u, v) {\n 46|        const ePu \u003d Math.exp(this.p * u); // e^(pu)\n 47|        const eMu \u003d Math.exp(this.m * u); // e^(mu)\n 48|        \n 49|        return {\n 50|            x: (eMu + ePu * Math.cos(v)) * Math.cos(u),\n 51|            y: (eMu + ePu * Math.cos(v)) * Math.sin(u),\n 52|            z: ePu * Math.sin(v)\n 53|        };\n 54|    };\n 55|    \n 56|    /**\n 57|     * Generate the U-polylines (lines of constant v)\n 58|     */\n 59|    this.generateULines \u003d function() {\n 60|        let vertices \u003d [];\n 61|        \n 62|        // Create lines for each v value\n 63|        for (let vIndex \u003d 0; vIndex \u003c\u003d this.vSegments; vIndex++) {\n 64|            const v \u003d this.vMin + (vIndex / this.vSegments) * (this.vMax - this.vMin);\n 65|            \n 66|            // Generate points along u for this v value\n 67|            for (let uIndex \u003d 0; uIndex \u003c\u003d this.uSegments; uIndex++) {\n 68|                const u \u003d this.uMin + (uIndex / this.uSegments) * (this.uMax - this.uMin);\n 69|                const point \u003d this.computePoint(u, v);\n 70|                vertices.push(point.x, point.y, point.z);\n 71|            }\n 72|        }\n 73|        \n 74|        // Create buffer\n 75|        this.uLinesBuffer \u003d gl.createBuffer();\n 76|        gl.bindBuffer(gl.ARRAY_BUFFER, this.uLinesBuffer);\n 77|        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(vertices), gl.STATIC_DRAW);\n 78|        this.uLinesCount \u003d vertices.length / 3;\n 79|    };\n 80|    \n 81|    /**\n 82|     * Generate the V-polylines (circular cross-sections)\n 83|     */\n 84|    this.generateVLines \u003d function() {\n 85|        let vertices \u003d [];\n 86|        const numCircles \u003d 40; // Number of circular cross-sections\n 87|        \n 88|        // Create circles at different u values\n 89|        for (let uIndex \u003d 0; uIndex \u003c numCircles; uIndex++) {\n 90|            // Distribute circles evenly\n 91|            const u \u003d this.uMin + (uIndex / (numCircles - 1)) * (this.uMax - this.uMin);\n 92|            \n 93|            // Generate points around the circle at this u value\n 94|            for (let vIndex \u003d 0; vIndex \u003c\u003d this.vSegments; vIndex++) {\n 95|                const v \u003d this.vMin + (vIndex / this.vSegments) * (this.vMax - this.vMin);\n 96|                const point \u003d this.computePoint(u, v);\n 97|                vertices.push(point.x, point.y, point.z);\n 98|            }\n 99|        }\n100|        \n101|        // Create buffer\n102|        this.vLinesBuffer \u003d gl.createBuffer();\n103|        gl.bindBuffer(gl.ARRAY_BUFFER, this.vLinesBuffer);\n104|        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(vertices), gl.STATIC_DRAW);\n105|        this.vLinesCount \u003d vertices.length / 3;\n106|        this.numCircles \u003d numCircles;\n107|    };\n108|    \n109|    /**\n110|     * Initialize the model by generating all vertices\n111|     */\n112|    this.initialize \u003d function() {\n113|        console.log(\&quot;Initializing Cornucopia with parameters:\&quot;);\n114|        console.log(\&quot;p \u003d\&quot;, this.p, \&quot;m \u003d\&quot;, this.m);\n115|        console.log(\&quot;uMax \u003d\&quot;, this.uMax/Math.PI + \&quot;π\&quot;, \&quot;vMax \u003d\&quot;, this.vMax/Math.PI + \&quot;π\&quot;);\n116|        \n117|        this.generateULines();\n118|        this.generateVLines();\n119|    };\n120|    \n121|    /**\n122|     * Draw the model\n123|     */\n124|    this.draw \u003d function(shaderProgram) {\n125|        // Set color to green\n126|        gl.uniform4fv(shaderProgram.iColor, [0.0, 1.0, 0.0, 1.0]);\n127|        \n128|        // Draw U-polylines\n129|        gl.bindBuffer(gl.ARRAY_BUFFER, this.uLinesBuffer);\n130|        gl.vertexAttribPointer(shaderProgram.iAttribVertex, 3, gl.FLOAT, false, 0, 0);\n131|        gl.enableVertexAttribArray(shaderProgram.iAttribVertex);\n132|        \n133|        // Draw each U-polyline\n134|        const pointsPerULine \u003d this.uSegments + 1;\n135|        for (let i \u003d 0; i \u003c\u003d this.vSegments; i++) {\n136|            gl.drawArrays(gl.LINE_STRIP, i * pointsPerULine, pointsPerULine);\n137|        }\n138|        \n139|        // Draw V-polylines (circular cross-sections)\n140|        gl.bindBuffer(gl.ARRAY_BUFFER, this.vLinesBuffer);\n141|        gl.vertexAttribPointer(shaderProgram.iAttribVertex, 3, gl.FLOAT, false, 0, 0);\n142|        gl.enableVertexAttribArray(shaderProgram.iAttribVertex);\n143|        \n144|        // Draw each circular cross-section\n145|        const pointsPerVLine \u003d this.vSegments + 1;\n146|        for (let i \u003d 0; i \u003c this.numCircles; i++) {\n147|            gl.drawArrays(gl.LINE_LOOP, i * pointsPerVLine, pointsPerVLine);\n148|        }\n149|    };\n150|}\n151|\n152|/**\n153| * Shader Program constructor\n154| */\n155|function ShaderProgram(name, program) {\n156|    this.name \u003d name;\n157|    this.prog \u003d program;\n158|    this.iAttribVertex \u003d -1;\n159|    this.iModelViewProjectionMatrix \u003d -1;\n160|    this.iColor \u003d -1;\n161|    \n162|    this.use \u003d function() {\n163|        gl.useProgram(this.prog);\n164|    };\n165|}\n166|\n167|/**\n168| * Draw function\n169| */\n170|function draw() {\n171|    gl.clearColor(0, 0, 0, 1);\n172|    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);\n173|    \n174|    // Set up viewport\n175|    gl.viewport(0, 0, gl.canvas.width, gl.canvas.height);\n176|    \n177|    // Create custom transformation matrices\n178|    const aspect \u003d gl.canvas.width/gl.canvas.height;\n179|    const znear \u003d 1;\n180|    const zfar \u003d 200;\n181|    const fov \u003d Math.PI/3; // 60 degrees field of view\n182|    \n183|    // Create a projection matrix\n184|    const projection \u003d m4.perspective(fov, aspect, znear, zfar);\n185|    \n186|    // Get user rotation from trackball\n187|    let modelView \u003d spaceball.getViewMatrix();\n188|    \n189|    // Create our custom view matrix to position the camera\n190|    // Start with identity matrix\n191|    const viewMatrix \u003d [\n192|        1, 0, 0, 0,\n193|        0, 1, 0, 0,\n194|        0, 0, 1, 0,\n195|        0, 0, 0, 1\n196|    ];\n197|    \n198|    // Translate back to see the whole structure\n199|    const moveBack \u003d m4.translation(0, 0, -50);\n200|    \n201|    // Apply transformations (right to left)\n202|    const combinedMatrix \u003d m4.multiply(projection, moveBack);\n203|    const finalMatrix \u003d m4.multiply(combinedMatrix, modelView);\n204|    \n205|    // Send matrix to shader\n206|    gl.uniformMatrix4fv(shProgram.iModelViewProjectionMatrix, false, finalMatrix);\n207|    \n208|    // Draw the model\n209|    surface.draw(shProgram);\n210|}\n211|\n212|/**\n213| * Create shader program\n214| */\n215|function createProgram(gl, vertexShaderSource, fragmentShaderSource) {\n216|    // Create and compile vertex shader\n217|    let vsh \u003d gl.createShader(gl.VERTEX_SHADER);\n218|    gl.shaderSource(vsh, vertexShaderSource);\n219|    gl.compileShader(vsh);\n220|    if (!gl.getShaderParameter(vsh, gl.COMPILE_STATUS)) {\n221|        throw new Error(\&quot;Error in vertex shader: \&quot; + gl.getShaderInfoLog(vsh));\n222|    }\n223|    \n224|    // Create and compile fragment shader\n225|    let fsh \u003d gl.createShader(gl.FRAGMENT_SHADER);\n226|    gl.shaderSource(fsh, fragmentShaderSource);\n227|    gl.compileShader(fsh);\n228|    if (!gl.getShaderParameter(fsh, gl.COMPILE_STATUS)) {\n229|        throw new Error