|    this.vertices \u003d [];\n 50|    this.normals \u003d [];\n 51|    this.indices \u003d [];\n 52|    \n 53|    /**\n 54|     * Calculate a point on the surface using the parametric equations\n 55|     */\n 56|    this.computePoint \u003d function(u, v) {\n 57|        const ePu \u003d Math.exp(this.p * u); // e^(pu)\n 58|        const eMu \u003d Math.exp(this.m * u); // e^(mu)\n 59|        \n 60|        return {\n 61|            x: (eMu + ePu * Math.cos(v)) * Math.cos(u),\n 62|            y: (eMu + ePu * Math.cos(v)) * Math.sin(u),\n 63|            z: ePu * Math.sin(v)\n 64|        };\n 65|    };\n 66|    \n 67|    /**\n 68|     * Calculate the analytical normal at a point by computing the cross product\n 69|     * of the tangent vectors along u and v directions\n 70|     */\n 71|    this.computeAnalyticalNormal \u003d function(u, v) {\n 72|        const ePu \u003d Math.exp(this.p * u);\n 73|        const eMu \u003d Math.exp(this.m * u);\n 74|        \n 75|        // Partial derivative with respect to u\n 76|        const dxdu \u003d -1 * (eMu + ePu * Math.cos(v)) * Math.sin(u) \n 77|                   + (this.m * eMu + this.p * ePu * Math.cos(v)) * Math.cos(u);\n 78|        const dydu \u003d (eMu + ePu * Math.cos(v)) * Math.cos(u) \n 79|                   + (this.m * eMu + this.p * ePu * Math.cos(v)) * Math.sin(u);\n 80|        const dzdu \u003d this.p * ePu * Math.sin(v);\n 81|        \n 82|        // Partial derivative with respect to v\n 83|        const dxdv \u003d -1 * ePu * Math.sin(v) * Math.cos(u);\n 84|        const dydv \u003d -1 * ePu * Math.sin(v) * Math.sin(u);\n 85|        const dzdv \u003d ePu * Math.cos(v);\n 86|        \n 87|        // Cross product to find normal vector\n 88|        const nx \u003d dydu * dzdv - dzdu * dydv;\n 89|        const ny \u003d dzdu * dxdv - dxdu * dzdv;\n 90|        const nz \u003d dxdu * dydv - dydu * dxdv;\n 91|        \n 92|        // Normalize the normal vector\n 93|        const length \u003d Math.sqrt(nx*nx + ny