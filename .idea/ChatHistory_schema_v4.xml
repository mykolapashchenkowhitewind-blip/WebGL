rtexAttribPointer(shaderProgram.iAttribVertex, 3, gl.FLOAT, false, 0, 0);\n240|        gl.enableVertexAttribArray(shaderProgram.iAttribVertex);\n241|        \n242|        const verticesPerULine \u003d this.uSegments + 1;\n243|        for (let i \u003d 0; i \u003c this.uLinesCount / verticesPerULine; i++) {\n244|            // Set color based on position in spiral\n245|            const normalizedI \u003d i / this.vSegments;\n246|            const u \u003d this.uMin + (this.uMax - this.uMin) * 0.5; // Middle of u range\n247|            const v \u003d this.vMin + normalizedI * (this.vMax - this.vMin);\n248|            const color \u003d this.getColorForPoint(u, v);\n249|            gl.uniform4fv(shaderProgram.iColor, color);\n250|            \n251|            gl.drawArrays(gl.LINE_STRIP, i * verticesPerULine, verticesPerULine);\n252|        }\n253|        \n254|        // Second pass: Draw V polylines\n255|        gl.bindBuffer(gl.ARRAY_BUFFER, this.vLinesBuffer);\n256|        gl.vertexAttribPointer(shaderProgram.iAttribVertex, 3, gl.FLOAT, false, 0, 0);\n257|        gl.enableVertexAttribArray(shaderProgram.iAttribVertex);\n258|        \n259|        const verticesPerVLine \u003d this.vSegments + 1;\n260|        for (let i \u003d 0; i \u003c this.vLinesCount / verticesPerVLine; i++) {\n261|            // Set color based on position in spiral\n262|            const normalizedI \u003d i / this.uSegments;\n263|            const u \u003d this.uMin + normalizedI * (this.uMax - this.uMin);\n264|            const v \u003d this.vMin + (this.vMax - this.vMin) * 0.5; // Middle of v range\n265|            const color \u003d this.getColorForPoint(u, v);\n266|            gl.uniform4fv(shaderProgram.iColor, color);\n267|            \n268|            gl.drawArrays(gl.LINE_STRIP, i * verticesPerVLine, verticesPerVLine);\n269|        }\n270|    };\n271|}&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;The iss