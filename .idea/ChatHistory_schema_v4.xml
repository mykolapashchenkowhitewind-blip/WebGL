e\u003d\&quot;number\&quot; id\u003d\&quot;param-m\&quot; value\u003d\&quot;0.2\&quot; step\u003d\&quot;0.01\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\n338|            \u003c/div\u003e\n339|            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\n340|                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-u\&quot;\u003eu max (π):\u003c/label\u003e\n341|                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-u\&quot; value\u003d\&quot;4\&quot; step\u003d\&quot;0.5\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\n342|            \u003c/div\u003e\n343|            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\n344|                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-v\&quot;\u003ev max (π):\u003c/label\u003e\n345|                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-v\&quot; value\u003d\&quot;2\&quot; step\u003d\&quot;0.5\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\n346|            \u003c/div\u003e\n347|\n348|            \u003cbutton id\u003d\&quot;refresh-button\&quot; style\u003d\&quot;margin-top: 10px; padding: 8px 16px; background-color: #0f0; color: black; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;\&quot;\u003eApply Parameters\u003c/button\u003e\n349|\n350|            \u003cdiv class\u003d\&quot;granularity-section\&quot;\u003e\n351|                \u003ch3\u003eMesh Granularity\u003c/h3\u003e\n352|                \u003cdiv class\u003d\&quot;slider-container\&quot;\u003e\n353|                    \u003cspan class\u003d\&quot;slider-label\&quot;\u003eU Segments:\u003c/span\u003e\n354|                    \u003cinput type\u003d\&quot;range\&quot; min\u003d\&quot;10\&quot; max\u003d\&quot;200\&quot; value\u003d\&quot;80\&quot; class\u003d\&quot;slider\&quot; id\u003d\&quot;u-granularity\&quot; oninput\u003d\&quot;updateMeshGranularity()\&quot;\u003e\n355|                    \u003cspan class\u003d\&quot;slider-value\&quot; id\u003d\&quot;u-gran-value\&quot;\u003e80\u003c/span\u003e\n356|                \u003c/div\u003e\n357|                \u003cdiv class\u003d\&quot;slider-container\&quot;\u003e\n358|                    \u003cspan class\u003d\&quot;slider-label\&quot;\u003eV Segments:\u003c/span\u003e\n359|                    \u003cinput type\u003d\&quot;range\&quot; min\u003d\&quot;10\&quot; max\u003d\&quot;100\&quot; value\u003d\&quot;40\&quot; class\u003d\&quot;slider\&quot; id\u003d\&quot;v-granularity\&quot; oninput\u003d\&quot;updateMeshGranularity()\&quot;\u003e\n360|                    \u003cspan class\u003d\&quot;slider-value\&quot; id\u003d\&quot;v-gran-value\&quot;\u003e40\u003c/span\u003e\n361|                \u003c/div\u003e\n362|            \u003c/div\u003e\n363|        \u003c/div\u003e\n364|        \n365|        \u003cdiv class\u003d\&quot;info-panel\&quot;\u003e\n366|            \u003ch2\u003eImplementation Details\u003c/h2\u003e\n367|            \u003cp\u003eThis implementation includes:\u003c/p\u003e\n368|            \u003cul\u003e\n369|                \u003cli\u003e\u003cstrong\u003eNormal Mapping:\u003c/strong\u003e Per-pixel normal data from normal texture for enhanced surface detail\u003c/li\u003e\n370|                \u003cli\u003e\u003cstrong\u003eThree Textures:\u003c/strong\u003e Diffuse texture modulates diffuse lighting, specular texture modulates specular lighting, and normal texture provides per-pixel normals\u003c/li\u003e\n371|                \u003cli\u003e\u003cstrong\u003eTexture Transformation:\u003c/strong\u003e Scale and rotate textures around a user-specified point, controllable with keyboard (WASD to move point, QE for scaling, ZC for rotation)\u003c/li\u003e\n372|                \u003cli\u003e\u003cstrong\u003eGram-Schmidt Orthogonalization:\u003c/strong\u003e Tangent space basis is constructed with priority given to the tangent vector (Variant 23)\u003c/li\u003e\n373|                \u003cli\u003e\u003cstrong\u003eTBN Matrix:\u003c/strong\u003e Tangent, Bitangent, and Normal vectors transform normals from tangent space to view space\u003c/li\u003e\n374|                \u003cli\u003e\u003cstrong\u003ePhong Shading:\u003c/strong\u003e Realistic lighting with ambient, diffuse, and specular components\u003c/li\u003e\n375|                \u003cli\u003e\u003cstrong\u003eRotating Light Source:\u003c/strong\u003e A moving light that circles around the model\u003c/li\u003e\n376|                \u003cli\u003e\u003cstrong\u003eTriangle Mesh:\u003c/strong\u003e The surface is rendered with filled triangles using VBO with indices\u003c/li\u003e\n377|                \u003cli\u003e\u003cstrong\u003eAdjustable Granularity:\u003c/strong\u003e U and V segment sliders allow controlling the mesh density\u003c/li\u003e\n378|            \u003c/ul\u003e\n379|        \u003c/div\u003e\n380|        \n381|        \u003cdiv class\u003d\&quot;student-info\&quot;\u003e\n382|            \u003ch2\u003eStudent Information\u003c/h2\u003e\n383|            \u003cp\u003e\u003cstrong\u003eName:\u003c/strong\u003e Pashchenko Mykola\u003c/p\u003e\n384|            \u003cp\u003e\u003cstrong\u003eGroup:\u003c/strong\u003e TR-51mp\u003c/p\u003e\n385|            \u003cp\u003e\u003cstrong\u003eCourse:\u003c/strong\u003e WebGL Visualization\u003c/p\u003e\n386|            \u003cp\u003e\u003cstrong\u003eAssignment:\u003c/strong\u003e PA#4 - Normal Mapping with Three Textures POINTING\u003c/p\u003e\n387|            \u003cp\u003e\u003cstrong\u003eVariant:\u003c/strong\u003e 23 (Prioritize Tangent in Gram-Schmidt Orthogonalization)\u003c/p\u003e\n388|        \u003c/div\u003e\n389|        \n390|        \u003cdiv class\u003d\&quot;footer\&quot;\u003e\n391|            \u003cp\u003eInteractive WebGL Visualization - Created using JavaScript and WebGL\u003c/p\u003e\n392|            \u003cp\u003eDrag your mouse on the model to rotate it. On a touch screen, you can use your finger.\u003c/p\u003e\n393|        \u003c/div\u003e\n394|    \u003c/div\u003e\n395|\u003c/body\u003e\n396|\u003c/html\u003e&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;Now, let\u0027s look at the cornucopia3.js file which likely contains the keyboard input handling logic and scale factor implementation:&quot;}],&quot;tool_calls&quot;:[{&quot;id&quot;:&quot;toolu_01Xt47tuGKSSthUw5FkXBtFP&quot;,&quot;type&quot;:&quot;function&quot;,&quot;function&quot;:{&quot;name&quot;:&quot;read_file&quot;,&quot;arguments&quot;:&quot;{\&quot;target_file\&quot;: \&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL2/cornucopia3.js\&quot;}&quot;}}]},{&quot;role&quot;:&quot;tool&quot;,&quot;name&quot;:&quot;read&quot;,&quot;tool_call_id&quot;:&quot;toolu_01Xt47tuGKSSthUw5FkXBtFP&quot;,&quot;content&quot;:&quot;   1|\u0027use strict\u0027;\n   2|\n   3|/**\n   4| * Cornucopia Surface - Parametric Surface Implementation with Phong Shading\n   5| * \n   6| * Parameters:\n   7| * p \u003d 0.15; m \u003d 0.1\n   8| * 0 ≤ u ≤ 5π; 0 ≤ v ≤ 2π\n   9| * \n  10| * Parametric equations:\n  11| * x(u,v) \u003d [e^(mu) + e^(pu)cos(v)]cos(u)\n  12| * y(u,v) \u003d [e^(mu) + e^(pu)cos(v)]sin(u)\n  13| * z(u,v) \u003d e^(pu)sin(v)\n  14| */\n  15|\n  16|// Global variables\n  17|let gl;                 // WebGL context\n  18|let surface;            // Cornucopia surface model\n  19|let lightSource;        // Light source object\n  20|let shProgram;          // Shader program\n  21|let spaceball;          // Trackball rotator\n  22|let lightAngle \u003d 0;     // Angle for rotating light\n  23|let lightRotationSpeed \u003d 0.002; // Speed of light rotation (reduced for slower movement)\n  24|let lightRadius \u003d 20;   // Distance of light from origin (moved even closer to the model)\n  25|let meshUpdateNeeded \u003d false;  // Flag to indicate if the mesh needs to be updated\n  26|let lastTime \u003d 0;       // Last frame timestamp for constant movement\n  27|\n  28|// Texture transformation variables\n  29|let texReferencePoint \u003d [0.5, 0.5]; // Reference point for texture transformations (u, v)\n  30|let texScaleFactor \u003d 1.0;           // Texture scaling factor\n  31|let texRotationAngle \u003d 0.0;         // Texture rotation angle in radians\n  32|let texMoveSpeed \u003d 0.01;            // Speed for moving reference point\n  33|\n  34|/**\n  35| * CornucopiaModel class to create and render the surface\n  36| */\n  37|/**\n  38| * LightSourceModel class for creating and rendering a visible light source\n  39| */\n  40|function LightSourceModel() {\n  41|    this.vertexBuffer \u003d null;\n  42|    this.indexBuffer \u003d null;\n  43|    this.normalBuffer \u003d null;\n  44|    this.vertices \u003d [];\n  45|    this.indices \u003d [];\n  46|    this.normals \u003d [];\n  47|    this.numVertices \u003d 0;\n  48|    this.numIndices \u003d 0;\n  49|    this.position \u003d [0, 0, 0]; // Current position of the light\n  50|    this.radius \u003d .5; // Smaller radius for the light sphere\n  51|    \n  52|    /**\n  53|     * Generate a sphere mesh for the light source\n  54|     */\n  55|    this.generateSphere \u003d function() {\n  56|        // Sphere parameters\n  57|        const segments \u003d 16;\n  58|        const rings \u003d 16;\n  59|        \n  60|        this.vertices \u003d [];\n  61|        this.indices \u003d [];\n  62|        this.normals \u003d [];\n  63|        \n  64|        // Generate vertices\n  65|        for (let ring \u003d 0; ring \u003c\u003d rings; ring++) {\n  66|            const theta \u003d ring * Math.PI / rings;\n  67|            const sinTheta \u003d Math.sin(theta);\n  68|            const cosTheta \u003d Math.cos(theta);\n  69|            \n  70|            for (let segment \u003d 0; segment \u003c\u003d segments; segment++) {\n  71|                const phi \u003d segment * 2 * Math.PI / segments;\n  72|                const sinPhi \u003d Math.sin(phi);\n  73| 