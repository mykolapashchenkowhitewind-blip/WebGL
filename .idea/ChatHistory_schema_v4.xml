er(shaderProgram.iAttribVertex, 3, gl.FLOAT, false, 0, 0);\n315|        gl.enableVertexAttribArray(shaderProgram.iAttribVertex);\n316|        \n317|        // Bind normal buffer and set attribute pointer\n318|        gl.bindBuffer(gl.ARRAY_BUFFER, this.normalBuffer);\n319|        gl.vertexAttribPointer(shaderProgram.iAttribNormal, 3, gl.FLOAT, false, 0, 0);&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[],&quot;tool_calls&quot;:[{&quot;id&quot;:&quot;toolu_01EerhtjfcNypsEaZK54Ccf5&quot;,&quot;type&quot;:&quot;function&quot;,&quot;function&quot;:{&quot;name&quot;:&quot;read_file&quot;,&quot;arguments&quot;:&quot;{\&quot;target_file\&quot;: \&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL2/cornucopia3.js\&quot;, \&quot;offset\&quot;: 320, \&quot;limit\&quot;: 30}&quot;}}]},{&quot;role&quot;:&quot;tool&quot;,&quot;name&quot;:&quot;read&quot;,&quot;tool_call_id&quot;:&quot;toolu_01EerhtjfcNypsEaZK54Ccf5&quot;,&quot;content&quot;:&quot;320|        gl.enableVertexAttribArray(shaderProgram.iAttribNormal);\n321|        \n322|        // Bind index buffer\n323|        gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, this.indexBuffer);\n324|        \n325|        // Set material properties\n326|        gl.uniform3fv(shaderProgram.iMaterialAmbient, [0.2, 0.2, 0.2]);\n327|        gl.uniform3fv(shaderProgram.iMaterialDiffuse, [0.0, 0.8, 0.0]);\n328|        gl.uniform3fv(shaderProgram.iMaterialSpecular, [0.8, 0.8, 0.8]);\n329|        gl.uniform1f(shaderProgram.iShininess, 30.0);\n330|        \n331|        // Draw the triangles\n332|        gl.drawElements(gl.TRIANGLES, this.numIndices, gl.UNSIGNED_SHORT, 0);\n333|    };\n334|}\n335|\n336|/**\n337| * Shader Program constructor\n338| */\n339|function ShaderProgram(name, program) {\n340|    this.name \u003d name;\n341|    this.prog \u003d program;\n342|    this.iAttribVertex \u003d -1;\n343|    this.iAttribNormal \u003d -1;\n344|    this.iModelViewProjectionMatrix \u003d -1;\n345|    this.iModelViewMatrix \