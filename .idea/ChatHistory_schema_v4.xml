   /**\n237|     * Calculate the analytical normal at a point by computing the cross product\n238|     * of the tangent vectors along u and v directions\n239|     */\n240|    this.computeAnalyticalNormal \u003d function(u, v) {\n241|        const ePu \u003d Math.exp(this.p * u);\n242|        const eMu \u003d Math.exp(this.m * u);\n243|        \n244|        // Partial derivative with respect to u\n245|        const dxdu \u003d -1 * (eMu + ePu * Math.cos(v)) * Math.sin(u) \n246|                   + (this.m * eMu + this.p * ePu * Math.cos(v)) * Math.cos(u);\n247|        const dydu \u003d (eMu + ePu * Math.cos(v)) * Math.cos(u) \n248|                   + (this.m * eMu + this.p * ePu * Math.cos(v)) * Math.sin(u);\n249|        const dzdu \u003d this.p * ePu * Math.sin(v);\n250|        \n251|        // Partial derivative with respect to v\n252|        const dxdv \u003d -1 * ePu * Math.sin(v) * Math.cos(u);\n253|        const dydv \u003d -1 * ePu * Math.sin(v) * Math.sin(u);\n254|        const dzdv \u003d ePu * Math.cos(v);\n255|        \n256|        // Cross product to find normal vector\n257|        const nx \u003d dydu * dzdv - dzdu * dydv;\n258|        const ny \u003d dzdu * dxdv - dxdu * dzdv;\n259|        const nz \u003d dxdu * dydv - dydu * dxdv;\n260|        \n261|        // Normalize the normal vector\n262|        const length \u003d Math.sqrt(nx*nx + ny*ny + nz*nz);\n263|        return {\n264|            x: nx / length,\n265|            y: ny / length,\n266|            z: nz / length\n267|        };\n268|    };\n269|    \n270|    /**\n271|     * Generate the triangular mesh vertices and indices\n272|     */\n273|    this.generateMesh \u003d function() {\n274|        console.log(\&quot;Generating mesh with segments: U\u003d\&quot; + this.uSegments + \&quot;, V\u003d\&quot; + this.vSegments);\n275|        \n276|        this.vertices \u003d [];\n277|        this.normals \u003d [];\n278|        this.indices \u003d [];\n279|        \n280|        // Generate vertices\n2