  paramU.value \u003d surface.uMax / Math.PI;\n 93|                        paramV.value \u003d surface.vMax / Math.PI;\n 94|                    }\n 95|                }, 500);\n 96|                \n 97|                if (refreshButton) {\n 98|                    refreshButton.addEventListener(\u0027click\u0027, function() {\n 99|                        // Get values from inputs\n100|                        if (surface) {\n101|                            // Update parameters\n102|                            surface.p \u003d parseFloat(paramP.value);\n103|                            surface.m \u003d parseFloat(paramM.value);\n104|                            surface.uMax \u003d parseFloat(paramU.value) * Math.PI;\n105|                            surface.vMax \u003d parseFloat(paramV.value) * Math.PI;\n106|                            \n107|                            console.log(\&quot;Applying new parameters:\&quot;);\n108|                            console.log(\&quot;p \u003d\&quot;, surface.p, \&quot;m \u003d\&quot;, surface.m, \&quot;uMax \u003d\&quot;, surface.uMax/Math.PI + \&quot;π\&quot;, \&quot;vMax \u003d\&quot;, surface.vMax/Math.PI + \&quot;π\&quot;);\n109|                            \n110|                            // Update formula display in the info panel\n111|                            const mathFormula \u003d document.querySelector(\u0027.math-formula\u0027);\n112|                            if (mathFormula) {\n113|                                // Find the part after the parametric equations\n114|                                const whereSection \u003d mathFormula.innerHTML.split(\u0027\u003cstrong\u003eWhere:\u003c/strong\u003e\u0027);\n115|                                if (whereSection.length \u003e 1) {\n116|                                    mathFormula.innerHTML \u003d whereSection[0] + \n117|                                        \u0027\u003cstrong\u003eWhere:\u003c/strong\u003e\u003cbr\u003e\u0027 +\n118|                                        \u0027- p \u003d \u0027 + surface.p + \u0027 (parameter p)\u003cbr\u003e\u0027 +\n119|                                        \u0027- m \u003d \u0027 + surface.m + \u0027 (parameter m)\u003cbr\u003e\u0027 +\n120|                                        \u0027- 0 ≤ u ≤ \u0027 + (surface.uMax/Math.PI) + \u0027π (lengthwise parameter)\u003cbr\u003e\u0027 +\n121|                                        \u0027- 0 ≤ v ≤ \u0027 + (surface.vMax/Math.PI) + \u0027π (cross-section parameter)\u0027;\n122|                                }\n123|                            }\n124|                            \n125|                            // Reinitialize the model\n126|                            surface.initialize();\n127|                            \n128|                            // Redraw\n129|                            draw();\n130|                            \n131|                            console.log(\&quot;Model updated with new parameters!\&quot;);\n132|                            \n133|                            // Flash confirmation message\n134|                            const button \u003d document.getElementById(\u0027refresh-button\u0027);\n135|                            button.textContent \u003d \&quot;Parameters Applied!\&quot;;\n136|                            button.style.backgroundColor \u003d \&quot;#00ff99\&quot;;\n137|                            setTimeout(function() {\n138|                                button.textContent \u003d \&quot;Apply Parameters\&quot;;\n139|                                button.style.backgroundColor \u003d \&quot;#0f0\&quot;;\n140|                            }, 1500);\n141|                        }\n142|                    });\n143|                }\n144|            });\n145|            \n146|            // No helper functions needed\n147|        \u003c/script\u003e\n148|\u003c/head\u003e\n149|\u003cbody onload\u003d\&quot;init()\&quot;\u003e\n150|    \u003cdiv class\u003d\&quot;container\&quot;\u003e\n151|        \u003ch1\u003eCornucopia Surface - WebGL Visualization\u003c/h1\u003e\n152|        \n153|        \u003cdiv class\u003d\&quot;info-panel\&quot;\u003e\n154|            \u003ch2\u003eProject Description\u003c/h2\u003e\n155|            \u003cp\u003eThis visualization demonstrates a 3D wireframe model of a \&quot;Cornucopia\&quot; surface rendered using WebGL.\u003c/p\u003e\n156|            \u003cp\u003eThe Cornucopia is a special case of a spiral-shaped surface \&quot;Shell without vertex\&quot;. It\u0027s a cyclic surface with generatrix circles of variable radius that creates the distinctive horn-like shape.\u003c/p\u003e\n157|            \n158|            \u003ch2\u003eMathematical Definition\u003c/h2\u003e\n159|            \u003cp\u003eThe Cornucopia surface is defined by the following parametric equations:\u003c/p\u003e\n160|            \n161|            \u003cdiv class\u003d\&quot;math-formula\&quot;\u003e\n162|                \u003cstrong\u003eParametric Equations:\u003c/strong\u003e\u003cbr\u003e\n163|                x(u,v) \u003d [e\u003csup\u003emu\u003c/sup\u003e + e\u003csup\u003epu\u003c/sup\u003ecos(v)]cos(u)\u003cbr\u003e\n164|                y(u,v) \u003d [e\u003csup\u003emu\u003c/sup\u003e + e\u003csup\u003epu\u003c/sup\u003ecos(v)]sin(u)\u003cbr\u003e\n165|                z(u,v) \u003d e\u003csup\u003epu\u003c/sup\u003esin(v)\u003cbr\u003e\u003cbr\u003e\n166|                \n167|                \u003cstrong\u003eWhere:\u003c/strong\u003e\u003cbr\u003e\n168|                - p \u003d 0.15 (parameter p)\u003cbr\u003e\n169|                - m \u003d 0.1 (parameter m)\u003cbr\u003e\n170|                - 0 ≤ u ≤ 5π (lengthwise parameter)\u003cbr\u003e\n171|                - 0 ≤ v ≤ 2π (cross-section parameter)\n172|            \u003c/div\u003e\n173|            \n174|            \u003ch2\u003eVisualization Features\u003c/h2\u003e\n175|            \u003cul\u003e\n176|                \u003cli\u003e60 circular cross-sections for detailed rendering\u003c/li\