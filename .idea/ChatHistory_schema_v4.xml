 * Parameters:\n  7| * p \u003d 0.15; m \u003d 0.1\n  8| * 0 ≤ u ≤ 5π; 0 ≤ v ≤ 2π\n  9| * \n 10| * Parametric equations:\n 11| * x(u,v) \u003d [e^(mu) + e^(pu)cos(v)]cos(u)\n 12| * y(u,v) \u003d [e^(mu) + e^(pu)cos(v)]sin(u)\n 13| * z(u,v) \u003d e^(pu)sin(v)\n 14| */\n 15|\n 16|// Global variables\n 17|let gl;                 // WebGL context\n 18|let surface;            // Cornucopia surface model\n 19|let shProgram;          // Shader program\n 20|let spaceball;          // Trackball rotator\n 21|\n 22|/**\n 23| * CornucopiaModel class to create and render the surface\n 24| */\n 25|function CornucopiaModel() {\n 26|    // Surface parameters - exactly as shown in Fig. 2\n 27|    this.p \u003d 0.15;\n 28|    this.m \u003d 0.1;\n 29|    this.uMin \u003d 0;\n 30|    this.uMax \u003d 5 * Math.PI;\n 31|    this.vMin \u003d 0;\n 32|    this.vMax \u003d 2 * Math.PI;\n 33|    \n 34|    // Number of segments for the grid\n 35|    this.uSegments \u003d 80;\n 36|    this.vSegments \u003d 40;\n 37|    \n 38|    // Buffers for drawing the grid lines\n 39|    this.uLinesBuffer \u003d null;\n 40|    this.vLinesBuffer \u003d null;\n 41|    this.uLinesCount \u003d 0;\n 42|    this.vLinesCount \u003d 0;\n 43|    \n 44|    /**\n 45|     * Calculate a point on the surface using the parametric equations\n 46|     */\n 47|    this.computePoint \u003d function(u, v) {\n 48|        const ePu \u003d Math.exp(this.p * u); // e^(pu)\n 49|        const eMu \u003d Math.exp(this.m * u); // e^(mu)\n 50|        \n 51|        // Use the exact formula from Fig. 2\n 52|        return {\n 53|            x: (eMu + ePu * Math.cos(v)) * Math.cos(u),\n 54|            y: (eMu + ePu * Math.cos(v)) * Math.sin(u),\n 55|            z: ePu * Math.sin(v)\n 56|        };\n 57|    };\n 58|    \n 59|    /**\n 60|     * Generate the U-polylines (lines of constant v)\n 61|     */\n 62|    this.generateULines \u003d function() {\n 63|        let vertices \u003d [];\n 64|        \n 65|        // Create lines for each v value\n 66|        for (let vIndex \u003d 0; vIndex \u003c\u003d this.vSegments; vIndex++) {\n 67|            const v \u003d this.vMin + (vIndex / this.vSegments) * (this.vMax - this.vMin);\n 68|            \n 69|            // Generate points along u for this v value\n 70|            for (let uIndex \u003d 0; uIndex \u003c\u003d this.uSegments; uIndex++) {\n 71|                const u \u003d this.uMin + (uIndex / this.uSegments) * (this.uMax - this.uMin);\n 72|                const point \u003d this.computePoint(u, v);\n 73|                vertices.push(point.x, point.y, point.z);\n 74|            }\n 75|        }\n 76|        \n 77|        // Create buffer\n 78|        this.uLinesBuffer \u003d gl.createBuffer();\n 79|        gl.bindBuffer(gl.ARRAY_BUFFER, this.uLinesBuffer);\n 80|        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(vertices), gl.STATIC_DRAW);\n 81|        this.uLinesCount \u003d vertices.length / 3;\n 82|    };\n 83|    \n 84|    /**\n 85|     * Generate the V-polylines (circular cross-sections)\n 86|     */\n 87|    this.generateVLines \u003d function() {\n 88|        let vertices \u003d [];\n 89|        const numCircles \u003d 40; // Number of circular cross-sections\n 90|        \n 91|        // Create circles at different u values\n 92|        for (let uIndex \u003d 0; uIndex \u003c numCircles; uIndex++) {\n 93|            // Distribute circles evenly\n 94|            const u \u003d this.uMin + (uIndex / (numCircles - 1)) * (this.uMax - this.uMin);\n 95|            \n 96|            // Generate points around the circle at this u value\n 97|            for (let vIndex \u003d 0; vIndex \u003c\u003d this.vSegments; vIndex++) {\n 98|                const v \u003d this.vMin + (vIndex / this.vSegments) * (this.vMax - this.vMin);\n 99|                const point \u003d this.computePoint(u, v);\n100|                vertices.push(point.x, point.y, point.z);\n101|            }\n102|        }\n103|        \n104|        // Create buffer\n105|        this.vLinesBuffer \u003d gl.createBuffer();\n106|        gl.bindBuffer(gl.ARRAY_BUFFER, this.vLinesBuffer);\n107|        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(vertices), gl.STATIC_DRAW);\n108|        this.vLinesCount \u003d vertices.length / 3;\n109|        this.numCircles \u003d numCircles;\n110|    };\n111|    \n112|    /**\n113|     * Initialize the model by generating all vertices\n114|     */\n115|    this.initialize \u003d function() {\n116|        console.log(\&quot;Initializing Cornucopia with parameters:\&quot;);\n117|        console.log(\&quot;p \u003d\&quot;, this.p, \&quot;m \u003d\&quot;, this.m);\n118|        console.log(\&quot;uMax \u003d\&quot;, this.uMax/Math.PI + \&quot;π\&quot;, \&quot;vMax \u003d\&quot;, this.vMax/Math.PI + \&quot;π\&quot;);\n119|        \n120|        this.generateULines();\n121|        this.generateVLines();\n122|    };\n123|    \n124|    /**\n125|     * Draw the model\n126|     */\n127|    this.draw \u003d function(shaderProgram) {\n128|        // Set color to green\n129|        gl.uniform4fv(shaderProgram.iColor, [0.0, 1.0, 0.0, 1.0]);\n130|        \n131|        // Draw U-polylines\n132|        gl.bindBuffer(gl.ARRAY_BUFFER, this.uLinesBuffer);\n133|        gl.vertexAttribPointer(shaderProgram.iAttribVertex, 3, gl.FLOAT, false, 0, 0);\n134|        gl.enableVertexAttribArray(shaderProgram.iAttribVertex);\n135|        \n136|        // Draw each U-polyline\n137|        const pointsPerULine \u003d this.uSegments + 1;\n138|        for (let i \u003d 0; i \u003c\u003d this.vSegments; i++) {\n139|            gl.drawArrays(gl.LINE_STRIP, i * pointsPerULine, pointsPerULine);\n140|        }\n141|        \n142|        // Draw V-polylines (circular cross-sections)\n143|        gl.bindBuffer(gl.ARRAY_BUFFER, this.vLinesBuffer);\n144|        gl.vertexAttribPointer(shaderProgram.iAttribVertex, 3, gl.FLOAT, false, 0, 0);\n145|        gl.enableVertexAttribArray(shaderProgram.iAttribVertex);\n146|        \n147|        // Draw each circular cross-section\n148|        const pointsPerVLine \u003d this.vSegments + 1;\n149|        for (let i \u003d 0; i \u003c this.numCircles; i++) {\n150|            gl.drawArrays(gl.LINE_LOOP, i * pointsPerVLine, pointsPerVLine);\n151|        }\n152|    };\n153|}\n154|\n155|/**\n156| * Shader Program constructor\n157| */\n158|function ShaderProgram(name, program) {\n159|    this.name \u003d name;\n160|    this.prog \u003d program;\n161|    this.iAttribVertex \u003d -1;\n162|    this.iModelViewProjectionMatrix \u003d -1;\n163|    this.iColor \u003d -1;\n164|    \n165|    this.use \u003d function() {\n166|        gl.useProgram(this.prog);\n167|    };\n168|}\n169|\n170|/**\n171| * Draw function\n172| */\n173|function draw() {\n174|    gl.clearColor(0, 0, 0, 1);\n175|    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);\n176|    \n177|    // Set up viewport\n178|    gl.viewport(0, 0, gl.canvas.width, gl.canvas.height);\n179|    \n180|    // Create projection matrix - set up to match Fig. 2 view\n181|    let projection \u003d m4.perspective(Math.PI/4, gl.canvas.width/gl.canvas.height, 1, 100);\n182|    \n183|    // Get modelview matrix from trackball\n184|    let modelView \u003d spaceball.getViewMatrix();\n185|    \n186|    // Position the camera to view the bulbous shape from the side (as in Fig. 2)\n187|    let rotateToPointZero \u003d m4.axisRotation([0, 1, 0], Math.PI/2);\n188|    let translateToPointZero \u003d m4.translation(0, 0, -15);\n189|    \n190|    // Combine matrices\n191|    let matAccum0 \u003d m4.multiply(rotateToPointZero, modelView);\n192|    let matAccum1 \u003d m4.multiply(translateToPointZero, matAccum0);\n193|    let modelViewProjection \u003d m4.multiply(projection, matAccum1);\n194|    \n195|    // Send matrices to shader\n196|    gl.uniformMatrix4fv(shProgram.iModelViewProjectionMatrix, false, modelViewProjection);\n197|    \n198|    // Draw the model\n199|    surface.draw(shProgram);\n200|}\n201|\n202|/**\n203| * Create shader program\n204| */\n205|function createProgram(gl, vertexShaderSource, fragmentShaderSource) {\n206|    // Create and compile vertex shader\n207|    let vsh \u003d gl.createShader(gl.VERTEX_SHADER);\n208|    gl.shaderSource(vsh, vertexShaderSource);\n209|    gl.compileShader(vsh);\n210|    if (!gl.getShaderParameter(vsh, gl.COMPILE_STATUS)) {\n211|        throw new Error(\&quot;Error in vertex shader: \&quot; + gl.getShaderInfoLog(vsh));\n212|    }\n213|    \n214|    // Create and compile fragment shader\n215|    let fsh \u003d gl.createShader(gl.FRAGMENT_SHADER);\n216|    gl.shaderSource(fsh, fragmentShaderSource);\n217|    gl.compileShader(fsh);\n218|    if (!gl.getShaderParameter(fsh, gl.COMPILE_STATUS)) {\n219|        throw new Error(\&quot;Error in fragment shader: \&quot; + gl.getShaderInfoLog(fsh));\n220|    }\n221|    \n222|    // Create program and link shaders\n223|    let prog \u003d gl.createProgram();\n224|    gl.attachShader(prog, vsh);\n225|    gl.attachShader(prog, fsh);\n226|    gl.linkProgram(prog);\n227|    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {\n228|        throw new Error(\&quot;Link error in program: \&quot; + gl.getProgramInfoLog(prog));\n229|    }\n230|    \n231|    return prog;\n232|}\n233|\n234|/**\n235| * Initialize WebGL\n236| */\n237|function initGL() {\n238|    // Create shader program\n239|    let prog \u003d createProgram(gl, vertexShaderSource, fragmentShaderSource);\n240|    \n241|    // Create shader program object\n242|    shProgram \u003d new ShaderProgram(\&quot;Basic\&quot;, prog);\n243|    shProgram.use();\n244|    \n245|    // Get attribute and uniform locations\n246|    shProgram.iAttribVertex \u003d gl.getAttribLocation(prog, \&quot;vertex\&quot;);\n247|    shProgram.iModelViewProjectionMatrix \u003d gl.getUniformLocation(prog, \&quot;ModelViewProjectionMatrix\&quot;);\n248|    shProgram.iColor \u003d gl.getUniformLocation(prog, \&quot;color\&quot;);\n249|    \n250|    // Create model\n251|    surface \u003d new CornucopiaModel();\n252|    surface.initialize();\n253|    \n254|    // Enable depth testing\n255|    gl.enable(gl.DEPTH_TEST);\n256|}\n257|\n258|/**\n259| * Main initialization function\n260| */\n261|function init() {\n262|    try {\n263|        // Get the canvas and initialize WebGL\n264|        let canvas \u003d document.getElementById(\&quot;webglcanvas\&quot;);\n265|        gl \u003d canvas.getContext(\&quot;webgl\&quot;) || canvas.getContext(\&quot;experimental-webgl\&quot;);\n266|        if (!gl) {\n267|            throw \&quot;Browser doesn\u0027t support WebGL\&quot;;\n268|        }\n269|        \n270|        // Initialize GL and create the scene\n271|        initGL();\n272|        \n273|        // Create trackball for rotation\n274|        spaceball \u003d new TrackballRotator(canvas, draw, 0);\n275|        \n276|        // Initial drawing of the scene\n277|        draw();\n278|    } catch (e) {\n279|        console.error(\&quot;ERROR: \&quot; + e);\n280|        document.getElementById(\&quot;canvas-holder\&quot;).innerHTML \u003d \n281|            \&quot;\u003cp style\u003d\u0027color:red\u0027\u003e\u003cb\u003eError:\u003c/b\u003e \&quot; + e + \&quot;\u003c/p\u003e\&quot;;\n282|    }\n283|}&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;Now I\u0027ll adjust the camera parameters to make sure the entire structure is visible:&quot;}],&quot;tool_calls&quot;:[{&quot;id&quot;:&quot;toolu_01K3gyZoELCjgQxWaGkC4htX&quot;,&quot;type&quot;:&quot;function&quot;,&quot;function&quot;:{&quot;name&quot;:&quot;edit&quot;,&quot;arguments&quot;:&quot;{\&quot;file_path\&quot;: \&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL/cornucopia2.js\&quot;, \&quot;old_string\&quot;: \&quot;    // Position the camera to view the bulbous shape from the side (as in Fig. 2)\\n    let rotateToPointZero \u003d m4.axisRotation([0, 1, 0], Math.PI/2);\\n    let translateToPointZero \u003d m4.translation(0, 