&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;Finally, let\u0027s adjust the initial view a bit to make sure we can see the whole structure from a good angle:&quot;}],&quot;tool_calls&quot;:[{&quot;id&quot;:&quot;toolu_012bffqguE2CbaHkw2z7kvDz&quot;,&quot;type&quot;:&quot;function&quot;,&quot;function&quot;:{&quot;name&quot;:&quot;edit&quot;,&quot;arguments&quot;:&quot;{\&quot;file_path\&quot;: \&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL/cornucopia2.js\&quot;, \&quot;old_string\&quot;: \&quot;        // Create trackball for rotation\\n        spaceball \u003d new TrackballRotator(canvas, draw, 0);\&quot;, \&quot;new_string\&quot;: \&quot;        // Create trackball for rotation with initial rotations for better view\\n        spaceball \u003d new TrackballRotator(canvas, draw, 0);\\n        \\n        // Set initial rotation to better show the entire structure\\n        spaceball.setView([-0.2, 0.3, 0], [0, 1, 0]);\&quot;}&quot;}}]},{&quot;role&quot;:&quot;tool&quot;,&quot;name&quot;:&quot;edit&quot;,&quot;tool_call_id&quot;:&quot;toolu_012bffqguE2CbaHkw2z7kvDz&quot;,&quot;content&quot;:&quot;The file D:\\PROJECT_ME\\project_SHAME\\INSTITUTKA\\Visualisation\\WebGL\\cornucopia2.js has been updated.\n\nWhen you\u0027re done with your current set of changes to this file, you should call the read_lints tool with the specific file path and fix any newly introduced errors.&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;Let\u0027s check for any linting errors in the file:&quot;}],&quot;tool_calls&quot;:[{&quot;id&quot;:&quot;toolu_01Wmf4nA7KcRy6TGVg8hvLdj&quot;,&quot;type&quot;:&quot;function&quot;,&quot;function&quot;:{&quot;name&quot;:&quot;read_lints&quot;,&quot;arguments&quot;:&quot;{\&quot;paths\&quot;: [\&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL/cornucopia2.js\&quot;]}&quot;}}]},{&quot;role&quot;:&quot;tool&quot;,&quot;name&quot;:&quot;read_lints&quot;,&quot;tool_call_id&quot;:&quot;toolu_01Wmf4nA7KcRy6TGVg8hvLdj&quot;,&quot;content&quot;:&quot;No linter errors found in 1 checked files.&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;I\u0027ve made several adjustments to the camera settings to ensure you can see the entire Cornucopia structure:\n\n1. **Increased Camera Distance**: \n   - Moved the camera from z\u003d-15 to z\u003d-30, pulling back to see the entire structure\n   - This gives a more complete view of the entire shape\n\n2. **Widened Field of View**:\n   - Changed from Math.PI/4 (45 degrees) to Math.PI/3.5 (about 51 degrees)\n   - This allows more of the structure to fit into the viewport\n   - Also increased the far clipping plane from 100 to 200\n\n3. **Added Camera Tilt**:\n   - Added a slight downward tilt (Math.PI/16 or about 11 degrees) around the X-axis\n   - This gives a better perspective on both the front and back parts of the structure\n   - Combined with the existing side rotation for an optimal viewing angle\n\n4. **Set Initial View**:\n   - Added an initial view position using setView() on the TrackballRotator\n   - This ensures the visualization starts with a good view of the entire structure\n   - You can still rotate it freely with the mouse\n\nThese changes should now show the complete Cornucopia structure while maintaining the proper proportions. The structure will be properly centered and visible from a perspective that highlights both the bulbous central part and the extending spiral portions.&quot;}]},{&quot;role&quot;:&quot;user&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;It does nothign as it seens&quot;}],&quot;context&quot;:[{&quot;file_path&quot;:&quot;cornucopia2.js&quot;,&quot;code_text&quot;:&quot;\u0027use strict\u0027;\r\n\r\n/**\r\n * Cornucopia Surface - Fig. 2 Implementation\r\n * \r\n * Parameters:\r\n * p \u003d 0.15; m \u003d 0.1\r\n * 0 ≤ u ≤ 5π; 0 ≤ v ≤ 2π\r\n * \r\n * Parametric equations:\r\n * x(u,v) \u003d [e^(mu) + e^(pu)cos(v)]cos(u)\r\n * y(u,v) \u003d [e^(mu) + e^(pu)cos(v)]sin(u)\r\n * z(u,v) \u003d e^(pu)sin(v)\r\n */\r\n\r\n// Global variables\r\nlet gl;                 // WebGL context\r\nlet surface;            // Cornucopia surface model\r\nlet shProgram;          // Shader program\r\nlet spaceball;          // Trackball rotator\r\n\r\n/**\r\n * CornucopiaModel class to create and render the surface\r\n */\r\nfunction CornucopiaModel() {\r\n    // Surface parameters - exactly as shown in Fig. 2\r\n    this.p \u003d 0.15;\r\n    this.m \u003d 0.1;\r\n    this.uMin \u003d 0;\r\n    this.uMax \u003d 5 * Math.PI;\r\n    this.vMin \u003d 0;\r\n    this.vMax \u003d 2 * Math.PI;\r\n    \r\n    // Number of segments for the grid\r\n    this.uSegments \u003d 80;\r\n    this.vSegments \u003d 40;\r\n    \r\n    // Buffers for drawing the grid lines\r\n    this.uLinesBuffer \u003d null;\r\n    this.vLinesBuffer \u003d null;\r\n    this.uLinesCount \u003d 0;\r\n    this.vLinesCount \u003d 0;\r\n    \r\n    /**\r\n     * Calculate a point on the surface using the parametric equations\r\n     */\r\n    this.computePoint \u003d function(u, v) {\r\n        const ePu \u003d Math.exp(this.p * u); // e^(pu)\r\n        const eMu \u003d Math.exp(this.m * u); // e^(mu)\r\n        \r\n        // Use the exact formula from Fig. 2\r\n        return {\r\n            x: (eMu + ePu * Math.cos(v)) * Math.cos(u),\r\n            y: (eMu + ePu * Math.cos(v)) * Math.sin(u),\r\n            z: ePu * Math.sin(v)\r\n        };\r\n    };\r\n    \r\n    /**\r\n     * Generate the U-polylines (lines of constant v)\r\n     */\r\n    this.generateULines \u003d function() {\r\n        let vertices \u003d [];\r\n        \r\n        // Create lines for each v value\r\n        for (let vIndex \u003d 0; vIndex \u003c\u003d this.vSegments; vIndex++) {\r\n            const v \u003d this.vMin + (vIndex / this.vSegments) * (this.vMax - this.vMin);\r\n            \r\n            // Generate points along u for this v value\r\n            for (let uIndex \u003d 0; uIndex \u003c\u003d this.uSegments; uIndex++) {\r\n                const u \u003d this.uMin + (uIndex / this.uSegments) * (this.uMax - this.uMin);\r\n                const point \u003d this.computePoint(u, v);\r\n                vertices.push(point.x, point.y, point.z);\r\n            }\r\n        }\r\n        \r\n        // Create buffer\r\n        this.uLinesBuffer \u003d gl.createBuffer();\r\n        gl.bindBuffer(gl.ARRAY_BUFFER, this.uLinesBuffer);\r\n        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(vertices), gl.STATIC_DRAW);\r\n        this.uLinesCount \u003d vertices.length / 3;\r\n    };\r\n    \r\n    /**\r\n     * Generate the V-polylines (circular cross-sections)\r\n     */\r\n    this.generateVLines \u003d function() {\r\n        let vertices \u003d [];\r\n        const numCircles \u003d 40; // Number of circular cross-sections\r\n        \r\n        // Create circles at different u values\r\n        for (let uIndex \u003d 0; uIndex \u003c numCircles; uIndex++) {\r\n            // Distribute circles evenly\r\n            const u \u003d this.uMin + (uIndex / (numCircles - 1)) * (this.uMax - this.uMin);\r\n            \r\n            // Generate points around the circle at this u value\r\n            for (let vIndex \u003d 0; vIndex \u003c\u003d this.vSegments; vIndex++) {\r\n                const v \u003d this.vMin + (vIndex / this.vSegments) * (this.vMax - this.vMin);\r\n                const point \u003d this.computePoint(u, v);\r\n                vertices.push(point.x, point.y, point.z);\r\n            }\r\n        }\r\n        \r\n        // Create buffer\r\n        this.vLinesBuffer \u003d gl.createBuffer();\r\n        gl.bindBuffer(gl.ARRAY_BUFFER, this.vLinesBuffer);\r\n        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(vertices), gl.STATIC_DRAW);\r\n        this.vLinesCount \u003d vertices.length / 3;\r\n        this.numCircles \u003d numCircles;\r\n    };\r\n    \r\n    /**\r\n     * Initialize the model by generating all vertices\r\n     */\r\n    this.initialize \u003d function() {\r\n        console.log(\&quot;Initializing Cornucopia with parameters:\&quot;);\r\n        console.log(\&quot;p \u003d\&quot;, this.p, \&quot;m \u003d\&quot;, this.m);\r\n        console.log(\&quot;uMax \u003d\&quot;, this.uMax/Math.PI + \&quot;π\&quot;, \&quot;vMax \u003d\&quot;, this.vMax/Math.PI + \&quot;π\&quot;);\r\n        \r\n        this.generateULines();\r\n        this.generateVLines();\r\n    };\r\n    \r\n    /**\r\n     * Draw the model\r\n     */\r\n    this.draw \u003d function(shaderProgram) {\r\n        // Set color to green\r\n        gl.uniform4fv(shaderProgram.iColor, [0.0, 1.0, 0.0, 1.0]);\r\n        \r\n        // Draw U-polylines\r\n        gl.bindBuffer(gl.ARRAY_BUFFER, this.uLinesBuffer);\r\n        gl.vertexAttribPointer(shaderProgram.iAttribVertex, 3, gl.FLOAT, false, 0, 0);\r\n        gl.enableVertexAttribArray(shaderProgram.iAttribVertex);\r\n        \r\n        // Draw each U-polyline\r\n        const pointsPerULine \u003d this.uSegments + 1;\r\n        for (let i \u003d 0; i \u003c\u003d this.vSegments; i++) {\r\n            gl.drawArrays(gl.LINE_STRIP, i * pointsPerULine, pointsPerULine);\r\n        }\r\n        \r\n        // Draw V-polylines (circular cross-sections)\r\n        gl.bindBuffer(gl.ARRAY_BUFFER, this.vLinesBuffer);\r\n        gl.vertexAttribPointer(shaderProgram.iAttribVertex, 3, gl.FLOAT, false, 0, 0);\r\n        gl.enableVertexAttribArray(shaderProgram.iAttribVertex);\r\n        \r\n        // Draw each circular cross-section\r\n        const pointsPerVLine \u003d this.vSegments + 1;\r\n        for (let i \u003d 0; i \u003c this.numCircles; i++) {\r\n            gl.drawArrays(gl.LINE_LOOP, i * pointsPerVLine, pointsPerVLine);\r\n        }\r\n    };\r\n}\r\n\r\n/**\r\n * Shader Program constructor\r\n */\r\nfunction ShaderProgram(name, program) {\r\n    this.name \u003d name;\r\n    this.prog \u003d program;\r\n    this.iAttribVertex \u003d -1;\r\n    this.iModelViewProjectionMatrix \u003d -1;\r\n    this.iColor \u003d -1;\r\n    \r\n    this.use \u003d function() {\r\n        gl.useProgram(this.prog);\r\n    };\r\n}\r\n\r\n/**\r\n * Draw function\r\n */\r\nfunction draw() {\r\n    gl.clearColor(0, 0, 0, 1);\r\n    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);\r\n    \r\n    // Set up viewport\r\n    gl.viewport(0, 0, gl.canvas.width, gl.canvas.height);\r\n    \r\n    // Create projection matrix with wider field of view to see the entire structure\r\n    let projection \u003d m4.perspective(Math.PI/3.5, gl.canvas.width/gl.canvas.height, 1, 200); // Wider FOV and farther clipping plane\r\n    \r\n    // Get modelview matrix from trackball\r\n    let modelView \u003d spaceball.getViewMatrix();\r\n    \r\n    // Position the camera to view the entire structure\r\n    let rotateX \u003d m4.axisRotation([1, 0, 0], Math.PI/16); // Slight tilt down\r\n    let rotateY \u003d m4.axisRotation([0, 1, 0], Math.PI/2);  // Rotate to side view\r\n    let rotateToPointZero \u003d m4.multiply(rotateX, rotateY); // Combined rotation\r\n    let translateToPointZero \u003d m4.translation(-300, 240, 60); // Move camera back to see the whole structure\r\n    \r\n    // Combine matrices\r\n    let matAccum0 \u003d m4.multiply(rotateToPointZero, modelView);\r\n    let matAccum1 \u003d m4.multiply(translateToPointZero, matAccum0);\r\n    let modelViewProjection \u003d m4.multiply(projection, matAccum1);\r\n    \r\n    // Send matrices to shader\r\n    gl.uniformMatrix4fv(shProgram.iModelViewProjectionMatrix, false, modelViewProjection);\r\n    \r\n    // Draw the model\r\n    surface.draw(shProgram);\r\n}\r\n\r\n/**\r\n * Create shader program\r\n */\r\nfunction createProgram(gl, vertexShaderSource, fragmentShaderSource) {\r\n    // Create and compile vertex shader\r\n    let vsh \u003d gl.createShader(gl.VERTEX_SHADER);\r\n    gl.shaderSource(vsh, vertexShaderSource);\r\n    gl.compileShader(vsh);\r\n    if (!gl.getShaderParameter(vsh, gl.COMPILE_STATUS)) {\r\n        throw new Error(\&quot;Error in vertex shader: \&quot; + gl.getShaderInfoLog(vsh));\r\n    }\r\n    \r\n    // Create and compile fragment shader\r\n    let fsh \u003d gl.createShader(gl.FRAGMENT_SHADER);\r\n    gl.shaderSource(fsh, fragmentShaderSource);\r\n    gl.compileShader(fsh);\r\n    if (!gl.getShaderParameter(fsh, gl.COMPILE_STATUS)) {\r\n        throw new Error(\&quot;Error in fragment shader: \&quot; + gl.getShaderInfoLog(fsh));\r\n    }\r\n    \r\n    // Create program and link shaders\r\n    let prog \u003d gl.createProgram();\r\n    gl.attachShader(prog, vsh);\r\n    gl.attachShader(prog, fsh);\r\n    gl.linkProgram(prog);\r\n    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {\r\n        throw new Error(\&quot;Link error in program: \&quot; + gl.getProgramInfoLog(prog));\r\n    }\r\n    \r\n    return prog;\r\n}\r\n\r\n/**\r\n * Initialize WebGL\r\n */\r\nfunction initGL() {\r\n    // Create shader program\r\n    let prog \u003d createProgram(gl, vertexShaderSource, fragmentShaderSource);\r\n    \r\n    // Create shader program object\r\n    shProgram \u003d new ShaderProgram(\&quot;Basic\&quot;, prog);\r\n    shProgram.use();\r\n    \r\n    // Get attribute and uniform locations\r\n    shProgram.iAttribVertex \u003d gl.getAttribLocation(prog, \&quot;vertex\&quot;);\r\n    shProgram.iModelViewProjectionMatrix \u003d gl.getUniformLocation(prog, \&quot;ModelViewProjectionMatrix\&quot;);\r\n    shProgram.iColor \u003d gl.getUniformLocation(prog, \&quot;color\&quot;);\r\n    \r\n    // Create model\r\n    surface \u003d new CornucopiaModel();\r\n    surface.initialize();\r\n    \r\n    // Enable depth testing\r\n    gl.enable(gl.DEPTH_TEST);\r\n}\r\n\r\n/**\r\n * Main initialization function\r\n */\r\nfunction init() {\r\n    try {\r\n        // Get the canvas and initialize WebGL\r\n        let canvas \u003d document.getElementById(\&quot;webglcanvas\&quot;);\r\n        gl \u003d canvas.getContext(\&quot;webgl\&quot;) || canvas.getContext(\&quot;experimental-webgl\&quot;);\r\n        if (!gl) {\r\n            throw \&quot;Browser doesn\u0027t support WebGL\&quot;;\r\n        }\r\n        \r\n        // Initialize GL and create the scene\r\n        initGL();\r\n        \r\n        // Create trackball for rotation with initial rotations for better view\r\n        spaceball \u003d new TrackballRotator(canvas, draw, 0);\r\n        \r\n        // Set initial rotation to better show the entire structure\r\n        spaceball.setView([-0.2, 0.3, 0], [0, 1, 0]);\r\n        \r\n        // Initial drawing of the scene\r\n        draw();\r\n    } catch (e) {\r\n        console.error(\&quot;ERROR: \&quot; + e);\r\n        document.getElementById(\&quot;canvas-holder\&quot;).innerHTML \u003d \r\n            \&quot;\u003cp style\u003d\u0027color:red\u0027\u003e\u003cb\u003eError:\u003c/b\u003e \&quot; + e + \&quot;\u003c/p\u003e\&quot;;\r\n    }\r\n}&quot;,&quot;timestamp&quot;:1766667722384,&quot;ranges&quot;:[],&quot;type&quot;:&quot;recent_file&quot;},{&quot;file_path&quot;:&quot;index.html&quot;,&quot;code_text&quot;:&quot;\u003c!DOCTYPE html\u003e\r\n\u003chtml\u003e\r\n\u003chead\u003e\r\n    \u003cmeta http-equiv\u003d\&quot;Content-Type\&quot; content\u003d\&quot;text/html; charset\u003dUTF-8\&quot;\u003e\r\n    \u003ctitle\u003eCornucopia Surface - WebGL Visualization\u003c/title\u003e\r\n    \u003cstyle\u003e\r\n        body {\r\n            background-color: #111;\r\n            font-family: Arial, sans-serif;\r\n            color: #fff;\r\n            text-align: center;\r\n            margin: 0;\r\n            padding: 20px;\r\n        }\r\n        h1, h2 {\r\n            color: #0f0;\r\n        }\r\n        h1 {\r\n            margin-top: 10px;\r\n            font-size: 28px;\r\n        }\r\n        h2 {\r\n            font-size: 22px;\r\n            margin-top: 25px;\r\n        }\r\n        .container {\r\n            max-width: 1000px;\r\n            margin: 0 auto;\r\n            padding: 20px;\r\n        }\r\n        #canvas-holder {\r\n            margin: 20px auto;\r\n            width: 800px;\r\n            height: 600px;\r\n        }\r\n        canvas {\r\n            border: 1px solid #0f0;\r\n        }\r\n        .info-panel {\r\n            text-align: left;\r\n            background-color: rgba(0, 50, 0, 0.3);\r\n            border: 1px solid #0f0;\r\n            padding: 20px;\r\n            border-radius: 5px;\r\n            margin: 20px auto;\r\n            max-width: 800px;\r\n        }\r\n        .math-formula {\r\n            background-color: rgba(0, 30, 0, 0.5);\r\n            padding: 15px;\r\n            border-radius: 5px;\r\n            margin: 15px 0;\r\n            font-family: \&quot;Courier New\&quot;, monospace;\r\n        }\r\n        .footer {\r\n            margin-top: 30px;\r\n            font-size: 14px;\r\n            color: #aaa;\r\n            border-top: 1px solid #333;\r\n            padding-top: 15px;\r\n        }\r\n        .student-info {\r\n            text-align: left;\r\n            background-color: rgba(0, 40, 0, 0.3);\r\n            border-left: 3px solid #0f0;\r\n            padding: 10px 20px;\r\n            margin: 25px auto;\r\n            max-width: 600px;\r\n        }\r\n    \u003c/style\u003e\r\n\r\n    \u003c!-- Core libraries --\u003e\r\n    \u003cscript src\u003d\&quot;./Utils/m4.js\&quot;\u003e\u003c/script\u003e\r\n    \u003cscript src\u003d\&quot;./Utils/trackball-rotator.js\&quot;\u003e\u003c/script\u003e\r\n    \u003cscript src\u003d\&quot;./shaders.js\&quot;\u003e\u003c/script\u003e\r\n    \u003cscript src\u003d\&quot;./cornucopia2.js\&quot;\u003e\u003c/script\u003e\r\n        \r\n        \u003cscript\u003e\r\n            // Add event listener for the refresh button after the page loads\r\n            window.addEventListener(\u0027load\u0027, function() {\r\n                const refreshButton \u003d document.getElementById(\u0027refresh-button\u0027);\r\n                const paramP \u003d document.getElementById(\u0027param-p\u0027);\r\n                const paramM \u003d document.getElementById(\u0027param-m\u0027);\r\n                const paramU \u003d document.getElementById(\u0027param-u\u0027);\r\n                const paramV \u003d document.getElementById(\u0027param-v\u0027);\r\n                \r\n                // Set initial values directly from the mathematical definition\r\n                // These values match exactly what\u0027s shown in the Mathematical Definition section\r\n                paramP.value \u003d 0.15; // p \u003d 0.15\r\n                paramM.value \u003d 0.1;  // m \u003d 0.1\r\n                paramU.value \u003d 5;    // u ≤ 5π\r\n                paramV.value \u003d 2;    // v ≤ 2π\r\n                \r\n                // Also ensure the model uses these exact values\r\n                setTimeout(function() {\r\n                    if (surface) {\r\n                        // Verify that the model parameters match the HTML definition\r\n                        if (surface.p !\u003d 0.15 || surface.m !\u003d 0.1 || \r\n                            surface.uMax !\u003d 5 * Math.PI || surface.vMax !\u003d 2 * Math.PI) {\r\n                            console.log(\&quot;Correcting model parameters to match Mathematical Definition\&quot;);\r\n                            surface.p \u003d 0.15;\r\n                            surface.m \u003d 0.1;\r\n                            surface.uMax \u003d 5 * Math.PI;\r\n                            surface.vMax \u003d 2 * Math.PI;\r\n                            surface.initialize();\r\n                            draw();\r\n                        }\r\n                    }\r\n                }, 500);\r\n                \r\n                if (refreshButton) {\r\n                    refreshButton.addEventListener(\u0027click\u0027, function() {\r\n                        // Get values from inputs\r\n                        if (surface) {\r\n                            // Update parameters\r\n                            surface.p \u003d parseFloat(paramP.value);\r\n                            surface.m \u003d parseFloat(paramM.value);\r\n                            surface.uMax \u003d parseFloat(paramU.value) * Math.PI;\r\n                            surface.vMax \u003d parseFloat(paramV.value) * Math.PI;\r\n                            \r\n                            console.log(\&quot;Applying new parameters:\&quot;);\r\n                            console.log(\&quot;p \u003d\&quot;, surface.p, \&quot;m \u003d\&quot;, surface.m, \&quot;uMax \u003d\&quot;, surface.uMax/Math.PI + \&quot;π\&quot;, \&quot;vMax \u003d\&quot;, surface.vMax/Math.PI + \&quot;π\&quot;);\r\n                            \r\n                            // Update formula display in the info panel\r\n                            const mathFormula \u003d document.querySelector(\u0027.math-formula\u0027);\r\n                            if (mathFormula) {\r\n                                // Find the part after the parametric equations\r\n                                const whereSection \u003d mathFormula.innerHTML.split(\u0027\u003cstrong\u003eWhere:\u003c/strong\u003e\u0027);\r\n                                if (whereSection.length \u003e 1) {\r\n                                    mathFormula.innerHTML \u003d whereSection[0] + \r\n                                        \u0027\u003cstrong\u003eWhere:\u003c/strong\u003e\u003cbr\u003e\u0027 +\r\n                                        \u0027- p \u003d \u0027 + surface.p + \u0027 (parameter p)\u003cbr\u003e\u0027 +\r\n                                        \u0027- m \u003d \u0027 + surface.m + \u0027 (parameter m)\u003cbr\u003e\u0027 +\r\n                                        \u0027- 0 ≤ u ≤ \u0027 + (surface.uMax/Math.PI) + \u0027π (lengthwise parameter)\u003cbr\u003e\u0027 +\r\n                                        \u0027- 0 ≤ v ≤ \u0027 + (surface.vMax/Math.PI) + \u0027π (cross-section parameter)\u0027;\r\n                                }\r\n                            }\r\n                            \r\n                            // Reinitialize the model\r\n                            surface.initialize();\r\n                            \r\n                            // Redraw\r\n                            draw();\r\n                            \r\n                            console.log(\&quot;Model updated with new parameters!\&quot;);\r\n                            \r\n                            // Flash confirmation message\r\n                            const button \u003d document.getElementById(\u0027refresh-button\u0027);\r\n                            button.textContent \u003d \&quot;Parameters Applied!\&quot;;\r\n                            button.style.backgroundColor \u003d \&quot;#00ff99\&quot;;\r\n                            setTimeout(function() {\r\n                                button.textContent \u003d \&quot;Apply Parameters\&quot;;\r\n                                button.style.backgroundColor \u003d \&quot;#0f0\&quot;;\r\n                            }, 1500);\r\n                        }\r\n                    });\r\n                }\r\n            });\r\n            \r\n            // No helper functions needed\r\n        \u003c/script\u003e\r\n\u003c/head\u003e\r\n\u003cbody onload\u003d\&quot;init()\&quot;\u003e\r\n    \u003cdiv class\u003d\&quot;container\&quot;\u003e\r\n        \u003ch1\u003eCornucopia Surface - WebGL Visualization\u003c/h1\u003e\r\n        \r\n        \u003cdiv class\u003d\&quot;info-panel\&quot;\u003e\r\n            \u003ch2\u003eProject Description\u003c/h2\u003e\r\n            \u003cp\u003eThis visualization demonstrates a 3D wireframe model of a \&quot;Cornucopia\&quot; surface rendered using WebGL.\u003c/p\u003e\r\n            \u003cp\u003eThe Cornucopia is a special case of a spiral-shaped surface \&quot;Shell without vertex\&quot;. It\u0027s a cyclic surface with generatrix circles of variable radius that creates the distinctive horn-like shape.\u003c/p\u003e\r\n            \r\n            \u003ch2\u003eMathematical Definition\u003c/h2\u003e\r\n            \u003cp\u003eThe Cornucopia surface is defined by the following parametric equations:\u003c/p\u003e\r\n            \r\n            \u003cdiv class\u003d\&quot;math-formula\&quot;\u003e\r\n                \u003cstrong\u003eParametric Equations:\u003c/strong\u003e\u003cbr\u003e\r\n                x(u,v) \u003d [e\u003csup\u003emu\u003c/sup\u003e + e\u003csup\u003epu\u003c/sup\u003ecos(v)]cos(u)\u003cbr\u003e\r\n                y(u,v) \u003d [e\u003csup\u003emu\u003c/sup\u003e + e\u003csup\u003epu\u003c/sup\u003ecos(v)]sin(u)\u003cbr\u003e\r\n                z(u,v) \u003d e\u003csup\u003epu\u003c/sup\u003esin(v)\u003cbr\u003e\u003cbr\u003e\r\n                \r\n                \u003cstrong\u003eWhere:\u003c/strong\u003e\u003cbr\u003e\r\n                - p \u003d 0.15 (parameter p)\u003cbr\u003e\r\n                - m \u003d 0.1 (parameter m)\u003cbr\u003e\r\n                - 0 ≤ u ≤ 5π (lengthwise parameter)\u003cbr\u003e\r\n                - 0 ≤ v ≤ 2π (cross-section parameter)\r\n            \u003c/div\u003e\r\n            \r\n            \u003ch2\u003eVisualization Features\u003c/h2\u003e\r\n            \u003cul\u003e\r\n                \u003cli\u003e40 circular cross-sections for detailed rendering\u003c/li\u003e\r\n                \u003cli\u003eGreen wireframe for high visibility\u003c/li\u003e\r\n                \u003cli\u003eInteractive rotation using mouse or touch\u003c/li\u003e\r\n                \u003cli\u003eBulbous shape matching Fig. 2 example\u003c/li\u003e\r\n            \u003c/ul\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv id\u003d\&quot;canvas-holder\&quot;\u003e\r\n            \u003ccanvas width\u003d\&quot;800\&quot; height\u003d\&quot;600\&quot; id\u003d\&quot;webglcanvas\&quot; style\u003d\&quot;background-color:black\&quot;\u003e\u003c/canvas\u003e\r\n            \u003cdiv style\u003d\&quot;margin-top: 10px; text-align: center;\&quot;\u003e\r\n                \u003cdiv style\u003d\&quot;margin-bottom: 10px; display: inline-block; background-color: rgba(0, 30, 0, 0.7); padding: 10px; border-radius: 5px; text-align: left;\&quot;\u003e\r\n                    \u003cdiv style\u003d\&quot;margin-bottom: 8px;\&quot;\u003e\r\n                        \u003clabel for\u003d\&quot;param-p\&quot; style\u003d\&quot;display: inline-block; width: 80px;\&quot;\u003ep value:\u003c/label\u003e\r\n                        \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-p\&quot; value\u003d\&quot;0.15\&quot; step\u003d\&quot;0.01\&quot; style\u003d\&quot;width: 80px; background-color: #111; color: #0f0; border: 1px solid #0f0; padding: 4px;\&quot;\u003e\r\n                    \u003c/div\u003e\r\n                    \u003cdiv style\u003d\&quot;margin-bottom: 8px;\&quot;\u003e\r\n                        \u003clabel for\u003d\&quot;param-m\&quot; style\u003d\&quot;display: inline-block; width: 80px;\&quot;\u003em value:\u003c/label\u003e\r\n                        \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-m\&quot; value\u003d\&quot;0.1\&quot; step\u003d\&quot;0.01\&quot; style\u003d\&quot;width: 80px; background-color: #111; color: #0f0; border: 1px solid #0f0; padding: 4px;\&quot;\u003e\r\n                    \u003c/div\u003e\r\n                    \u003cdiv style\u003d\&quot;margin-bottom: 8px;\&quot;\u003e\r\n                        \u003clabel for\u003d\&quot;param-u\&quot; style\u003d\&quot;display: inline-block; width: 80px;\&quot;\u003eu max (π):\u003c/label\u003e\r\n                        \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-u\&quot; value\u003d\&quot;5\&quot; step\u003d\&quot;0.5\&quot; style\u003d\&quot;width: 80px; background-color: #111; color: #0f0; border: 1px solid #0f0; padding: 4px;\&quot;\u003e\r\n                    \u003c/div\u003e\r\n                    \u003cdiv style\u003d\&quot;margin-bottom: 8px;\&quot;\u003e\r\n                        \u003clabel for\u003d\&quot;param-v\&quot; style\u003d\&quot;display: inline-block; width: 80px;\&quot;\u003ev max (π):\u003c/label\u003e\r\n                        \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-v\&quot; value\u003d\&quot;2\&quot; step\u003d\&quot;0.5\&quot; style\u003d\&quot;width: 80px; background-color: #111; color: #0f0; border: 1px solid #0f0; padding: 4px;\&quot;\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv style\u003d\&quot;margin-top: 10px;\&quot;\u003e\r\n                    \u003cbutton id\u003d\&quot;refresh-button\&quot; style\u003d\&quot;padding: 8px 16px; background-color: #0f0; color: black; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;\&quot;\u003eApply Parameters\u003c/button\u003e\r\n                \u003c/div\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv style\u003d\&quot;height: 180px;\&quot;\u003e\u003c/div\u003e\r\n        \u003cdiv class\u003d\&quot;student-info\&quot;\u003e\r\n            \u003ch2\u003eStudent Information\u003c/h2\u003e\r\n            \u003cp\u003e\u003cstrong\u003eName:\u003c/strong\u003e Pashchenko Mykola\u003c/p\u003e\r\n            \u003cp\u003e\u003cstrong\u003eGroup:\u003c/strong\u003e TR-51mp\u003c/p\u003e\r\n            \u003cp\u003e\u003cstrong\u003eCourse:\u003c/strong\u003e WebGL Visualization\u003c/p\u003e\r\n            \u003cp\u003e\u003cstrong\u003eAssignment:\u003c/strong\u003e PA#1 - Cornucopia Surface Rendering\u003c/p\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv class\u003d\&quot;footer\&quot;\u003e\r\n            \u003cp\u003eInteractive WebGL Visualization - Created using JavaScrip