xRotationAngle);\r\n    \r\n    // Draw the surface model\r\n    surface.draw(shProgram);\r\n    \r\n    // Draw the light source\r\n    lightSource.draw(shProgram, modelViewMatrix, projectionMatrix);\r\n    \r\n    // Draw the UV reference point marker\r\n    if (uvMarker) {\r\n        uvMarker.draw(shProgram, modelViewMatrix, projectionMatrix, surface);\r\n    }\r\n    \r\n    // Request next frame for animation\r\n    requestAnimationFrame(draw);\r\n}\r\n\r\n/**\r\n * Update mesh from slider values\r\n */\r\nfunction updateMeshFromSliders() {\r\n    const uGranSlider \u003d document.getElementById(\&quot;u-granularity\&quot;);\r\n    const vGranSlider \u003d document.getElementById(\&quot;v-granularity\&quot;);\r\n    \r\n    if (uGranSlider \u0026\u0026 vGranSlider) {\r\n        const uSegments \u003d parseInt(uGranSlider.value);\r\n        const vSegments \u003d parseInt(vGranSlider.value);\r\n        \r\n        // Update the display values\r\n        document.getElementById(\&quot;u-gran-value\&quot;).textContent \u003d uSegments;\r\n        document.getElementById(\&quot;v-gran-value\&quot;).textContent \u003d vSegments;\r\n        \r\n        console.log(\&quot;Updating mesh from sliders: U\u003d\&quot; + uSegments + \&quot;, V\u003d\&quot; + vSegments);\r\n        \r\n        // Update the surface\r\n        if (surface) {\r\n            surface.updateGranularity(uSegments, vSegments);\r\n        }\r\n    }\r\n}\r\n\r\n/**\r\n * Create shader program\r\n */\r\nfunction createProgram(gl, vertexShaderSource, fragmentShaderSource) {\r\n    // Determine the variant number\r\n    // Extract student variant number from the HTML (student info section)\r\n    let variantNumber \u003d 23; // Default to 23\r\n    \r\n    try {\r\n        // Find all strong elements in the student info section\r\n        const studentInfo \u003d document.querySelector(\&quot;.student-info\&quot;);\r\n        if (studentInfo) {\r\n            const strongElements \u003d studentInfo.querySelectorAll(\&quot;strong\&quot;);\r\n            \r\n            // Find the one that contains \&quot;Variant\&quot;\r\n            for (let i \u003d 0; i \u003c strongElements.length; i++) {\r\n                if (strongElements[i].textContent.includes(\&quot;Variant\&quot;)) {\r\n                    // Extract the variant number using regex\r\n                    const variantText \u003d strongElements[i].parentElement.textContent;\r\n                    const match \u003d variantText.match(/Variant.*?(\\d+)/);\r\n                    if (match \u0026\u0026 match[1]) {\r\n                        variantNumber \u003d parseInt(match[1]);\r\n                        console.log(\&quot;Detected variant number:\&quot;, variantNumber);\r\n                        break;\r\n                    }\r\n                }\r\n            }\r\n        }\r\n    } catch (e) {\r\n        console.warn(\&quot;Could not automatically detect variant number, using default:\&quot;, variantNumber);\r\n    }\r\n    \r\n    // Check if we should use rotation (even variant) or scaling (odd variant)\r\n    const useRotation \u003d variantNumber % 2 \u003d\u003d\u003d 0;\r\n    console.log(\&quot;Using \&quot; + (useRotation ? \&quot;ROTATION\&quot; : \&quot;SCALING\&quot;) + \&quot; for texture transformation (variant \&quot; + variantNumber + \&quot;)\&quot;);\r\n    \r\n    // Modify the shader source to include the appropriate #define\r\n    let modifiedVertexSource \u003d vertexShaderSource;\r\n    if (useRotation) {\r\n        modifiedVertexSource \u003d \&quot;#define ENABLE_ROTATION\\n\&quot; + vertexShaderSource;\r\n    }\r\n    \r\n    // Create and compile vertex shader\r\n    let vsh \u003d gl.createShader(gl.VERTEX_SHADER);\r\n    gl.shaderSource(vsh, modifiedVertexSource);\r\n    gl.compileShader(vsh);\r\n    if (!gl.getShaderParameter(vsh, gl.COMPILE_STATUS)) {\r\n        throw new Error(\&quot;Error in vertex shader: \&quot; + gl.getShaderInfoLog(vsh));\r\n    }\r\n    \r\n    // Create and compile fragment shader\r\n    let fsh \u003d gl.createShader(gl.FRAGMENT_SHADER);\r\n    gl.shaderSource(fsh, fragmentShaderSource);\r\n    gl.compileShader(fsh);\r\n    if (!gl.getShaderParameter(fsh, gl.COMPILE_STATUS)) {\r\n        throw new Error(\&quot;Error in fragment shader: \&quot; + gl.getShaderInfoLog(fsh));\r\n    }\r\n    \r\n    // Create program and link shaders\r\n    let prog \u003d gl.createProgram();\r\n    gl.attachShader(prog, vsh);\r\n    gl.attachShader(prog, fsh);\r\n    gl.linkProgram(prog);\r\n    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {\r\n        throw new Error(\&quot;Link error in program: \&quot; + gl.getProgramInfoLog(prog));\r\n    }\r\n    \r\n    return prog;\r\n}\r\n\r\n/**\r\n * Initialize WebGL\r\n */\r\nfunction initGL() {\r\n    // Create shader program\r\n    let prog \u003d createProgram(gl, vertexShaderSource, fragmentShaderSource);\r\n    \r\n    // Create shader program object\r\n    shProgram \u003d new ShaderProgram(\&quot;Basic\&quot;, prog);\r\n    shProgram.use();\r\n    \r\n    // Get attribute and uniform locations\r\n    shProgram.iAttribVertex \u003d gl.getAttribLocation(prog, \&quot;vertex\&quot;);\r\n    shProgram.iAttribNormal \u003d gl.getAttribLocation(prog, \&quot;normal\&quot;);\r\n    shProgram.iAttribTangent \u003d gl.getAttribLocation(prog, \&quot;tangent\&quot;);\r\n    shProgram.iAttribBitangent \u003d gl.getAttribLocation(prog, \&quot;bitangent\&quot;);\r\n    shProgram.iAttribTexCoord \u003d gl.getAttribLocation(prog, \&quot;texCoord\&quot;);\r\n    shProgram.iModelViewProjectionMatrix \u003d gl.getUniformLocation(prog, \&quot;ModelViewProjectionMatrix\&quot;);\r\n    shProgram.iModelViewMatrix \u003d gl.getUniformLocation(prog, \&quot;ModelViewMatrix\&quot;);\r\n    shProgram.iNormalMatrix \u003d gl.getUniformLocation(prog, \&quot;NormalMatrix\&quot;);\r\n    shProgram.iLightPosition \u003d gl.getUniformLocation(prog, \&quot;lightPosition\&quot;);\r\n    shProgram.iLightColor \u003d gl.getUniformLocation(prog, \&quot;lightColor\&quot;);\r\n    shProgram.iMaterialAmbient \u003d gl.getUniformLocation(prog, \&quot;materialAmbient\&quot;);\r\n    shProgram.iMaterialDiffuse \u003d gl.getUniformLocation(prog, \&quot;materialDiffuse\&quot;);\r\n    shProgram.iMaterialSpecular \u003d gl.getUniformLocation(prog, \&quot;materialSpecular\&quot;);\r\n    shProgram.iShininess \u003d gl.getUniformLocation(prog, \&quot;shininess\&quot;);\r\n    shProgram.iTextureDiffuse \u003d gl.getUniformLocation(prog, \&quot;textureDiffuse\&quot;);\r\n    shProgram.iTextureSpecular \u003d gl.getUniformLocation(prog, \&quot;textureSpecular\&quot;);\r\n    shProgram.iTextureNormal \u003d gl.getUniformLocation(prog, \&quot;textureNormal\&quot;);\r\n    // Get texture transformation uniforms\r\n    shProgram.iTexReferencePoint \u003d gl.getUniformLocation(prog, \&quot;texReferencePoint\&quot;);\r\n    shProgram.iTexScaleFactor \u003d gl.getUniformLocation(prog, \&quot;texScaleFactor\&quot;);\r\n    shProgram.iTexRotationAngle \u003d gl.getUniformLocation(prog, \&quot;texRotationAngle\&quot;);\r\n    \r\n    // Create surface model\r\n    surface \u003d new CornucopiaModel();\r\n    surface.initialize();\r\n    \r\n    // Load textures from the res folder\r\n    surface.textureDiffuse \u003d LoadTexture(\&quot;./res/Ground080_1K-JPG_Color.jpg\&quot;);\r\n    surface.textureSpecular \u003d LoadTexture(\&quot;./res/Ground080_1K-JPG_Roughness.jpg\&quot;);\r\n    surface.textureNormal \u003d LoadTexture(\&quot;./res/Ground080_1K-JPG_NormalGL.jpg\&quot;);\r\n    \r\n    // Create light source model\r\n    lightSource \u003d new LightSourceModel();\r\n    lightSource.initialize();\r\n    \r\n    // Create UV reference point marker\r\n    uvMarker \u003d new UVMarker();\r\n    uvMarker.initialize();\r\n    \r\n    // Enable depth testing\r\n    gl.enable(gl.DEPTH_TEST);\r\n}\r\n\r\n/**\r\n * Load a texture from a URL\r\n */\r\nfunction LoadTexture(url) {\r\n    const texture \u003d gl.createTexture();\r\n    gl.bindTexture(gl.TEXTURE_2D, texture);\r\n    \r\n    // Fill with a placeholder color while loading\r\n    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, 1, 1, 0, gl.RGBA, gl.UNSIGNED_BYTE,\r\n                  new Uint8Array([128, 128, 255, 255])); // Light blue default\r\n    \r\n    // Load the image\r\n    const image \u003d new Image();\r\n    image.crossOrigin \u003d \&quot;anonymous\&quot;;\r\n    image.src \u003d url;\r\n    image.addEventListener(\u0027load\u0027, function() {\r\n        gl.bindTexture(gl.TEXTURE_2D, texture);\r\n        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, image);\r\n        \r\n        // Set texture parameters\r\n        if (isPowerOf2(image.width) \u0026\u0026 isPowerOf2(image.height)) {\r\n            gl.generateMipmap(gl.TEXTURE_2D);\r\n            // Use REPEAT for wrapping (better for tiled textures)\r\n            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.REPEAT);\r\n            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.REPEAT);\r\n        } else {\r\n            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);\r\n            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);\r\n            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);\r\n        }\r\n        \r\n        // Redraw the scene\r\n        draw();\r\n    });\r\n    \r\n    return texture;\r\n}\r\n\r\n/**\r\n * Create a flat normal map texture (pointing straight up in tangent space)\r\n * This is useful as a default when no normal map is available\r\n */\r\nfunction CreateFlatNormalMap(size) {\r\n    size \u003d size || 64; // Default 64x64 texture\r\n    \r\n    const texture \u003d gl.createTexture();\r\n    gl.bindTexture(gl.TEXTURE_2D, texture);\r\n    \r\n    // Create a flat normal map where all normals point straight up (0, 0, 1) in tangent space\r\n    // In RGB this is (0.5, 0.5, 1.0) which maps to (128, 128, 255) in byte values\r\n    const data \u003d new Uint8Array(size * size * 4);\r\n    for (let i \u003d 0; i \u003c size * size; i++) {\r\n        data[i * 4 + 0] \u003d 128; // R \u003d 0.5 (X component)\r\n        data[i * 4 + 1] \u003d 128; // G \u003d 0.5 (Y component)\r\n        data[i * 4 + 2] \u003d 255; // B \u003d 1.0 (Z component, pointing up)\r\n        data[i * 4 + 3] \u003d 255; // A \u003d 1.0 (full opacity)\r\n    }\r\n    \r\n    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, size, size, 0, gl.RGBA, gl.UNSIGNED_BYTE, data);\r\n    \r\n    // Set texture parameters\r\n    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.REPEAT);\r\n    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.REPEAT);\r\n    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);\r\n    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);\r\n    \r\n    return texture;\r\n}\r\n\r\n/**\r\n * Check if a value is a power of 2\r\n */\r\nfunction isPowerOf2(value) {\r\n    return (value \u0026 (value - 1)) \u003d\u003d\u003d 0;\r\n}\r\n\r\n/**\r\n * Set up UI controls\r\n */\r\nfunction setupControls() {\r\n    const uGranSlider \u003d document.getElementById(\&quot;u-granularity\&quot;);\r\n    const vGranSlider \u003d document.getElementById(\&quot;v-granularity\&quot;);\r\n    \r\n    if (uGranSlider \u0026\u0026 vGranSlider) {\r\n        // Initialize display values\r\n        const uGranValue \u003d document.getElementById(\&quot;u-gran-value\&quot;);\r\n        const vGranValue \u003d document.getElementById(\&quot;v-gran-value\&quot;);\r\n        \r\n        if (uGranValue) uGranValue.textContent \u003d uGranSlider.value;\r\n        if (vGranValue) vGranValue.textContent \u003d vGranSlider.value;\r\n        \r\n        // Set slider values to match current model\r\n        if (surface) {\r\n            uGranSlider.value \u003d surface.uSegments;\r\n            vGranSlider.value \u003d surface.vSegments;\r\n        }\r\n        \r\n        // Add direct input event handlers that update on drag\r\n        uGranSlider.addEventListener(\&quot;input\&quot;, function() {\r\n            if (uGranValue) uGranValue.textContent \u003d uGranSlider.value;\r\n            meshUpdateNeeded \u003d true; // Flag for update on next frame\r\n        });\r\n        \r\n        vGranSlider.addEventListener(\&quot;input\&quot;, function() {\r\n            if (vGranValue) vGranValue.textContent \u003d vGranSlider.value;\r\n            meshUpdateNeeded \u003d true; // Flag for update on next frame\r\n        });\r\n        \r\n        console.log(\&quot;UI sliders initialized successfully\&quot;);\r\n    } else {\r\n        console.warn(\&quot;Could not find granularity sliders\&quot;);\r\n    }\r\n}\r\n\r\n/**\r\n * Keyboard event handler for texture transformation controls\r\n */\r\nfunction setupKeyboardControls() {\r\n    document.addEventListener(\u0027keydown\u0027, function(event) {\r\n        let needRedraw \u003d true;\r\n        \r\n        switch(event.key) {\r\n            // Reference point movement\r\n            case \u0027a\u0027: case \u0027A\u0027: // Move reference point left (u-)\r\n                texReferencePoint[0] -\u003d texMoveSpeed;\r\n                break;\r\n                \r\n            case \u0027d\u0027: case \u0027D\u0027: // Move reference point right (u+)\r\n                texReferencePoint[0] +\u003d texMoveSpeed;\r\n                break;\r\n                \r\n            case \u0027w\u0027: case \u0027W\u0027: // Move reference point up (v-)\r\n                texReferencePoint[1] -\u003d texMoveSpeed;\r\n                break;\r\n                \r\n            case \u0027s\u0027: case \u0027S\u0027: // Move reference point down (v+)\r\n                texReferencePoint[1] +\u003d texMoveSpeed;\r\n                break;\r\n                \r\n            // Scaling controls\r\n            case \u0027q\u0027: case \u0027Q\u0027: // Decrease scale\r\n                texScaleFactor \u003d Math.max(0.1, texScaleFactor - 0.05);\r\n                break;\r\n                \r\n            case \u0027e\u0027: case \u0027E\u0027: // Increase scale\r\n                texScaleFactor +\u003d 0.05;\r\n                break;\r\n                \r\n            // Rotation controls\r\n            case \u0027z\u0027: case \u0027Z\u0027: // Rotate counter-clockwise\r\n                texRotationAngle -\u003d 0.05;\r\n                break;\r\n                \r\n            case \u0027c\u0027: case \u0027C\u0027: // Rotate clockwise\r\n                texRotationAngle +\u003d 0.05;\r\n                break;\r\n                \r\n            // Reset\r\n            case \u0027r\u0027: case \u0027R\u0027: // Reset transformations\r\n                texReferencePoint \u003d [0.5, 0.5];\r\n                texScaleFactor \u003d 1.0;\r\n                texRotationAngle \u003d 0.0;\r\n                break;\r\n                \r\n            default:\r\n                needRedraw \u003d false;\r\n                break;\r\n        }\r\n        \r\n        // Ensure reference point stays in reasonable bounds\r\n        texReferencePoint[0] \u003d Math.max(0.0, Math.min(1.0, texReferencePoint[0]));\r\n        texReferencePoint[1] \u003d Math.max(0.0, Math.min(1.0, texReferencePoint[1]));\r\n        \r\n        // Update UI to display current values\r\n        updateTextureControlsDisplay();\r\n        \r\n        // Update the marker position to the new UV coordinates\r\n        if (uvMarker) {\r\n            uvMarker.updatePosition(texReferencePoint);\r\n        }\r\n        \r\n        if (needRedraw) {\r\n            // Redraw the scene with updated values\r\n            requestAnimationFrame(draw);\r\n        }\r\n    });\r\n}\r\n\r\n/**\r\n * Update the display of texture control values\r\n */\r\nfunction updateTextureControlsDisplay() {\r\n    // Update UI elements showing current texture control values\r\n    const refPointElem \u003d document.getElementById(\u0027tex-ref-point-value\u0027);\r\n    const scaleElem \u003d document.getElementById(\u0027tex-scale-value\u0027);\r\n    const rotationElem \u003d document.getElementById(\u0027tex-rotation-value\u0027);\r\n    \r\n    if (refPointElem) {\r\n        refPointElem.textContent \u003d `(${texReferencePoint[0].toFixed(2)}, ${texReferencePoint[1].toFixed(2)})`;\r\n    }\r\n    \r\n    if (scaleElem) {\r\n        scaleElem.textContent \u003d texScaleFactor.toFixed(2);\r\n    }\r\n    \r\n    if (rotationElem) {\r\n        // Convert to degrees for display\r\n        const degrees \u003d (texRotationAngle * 180 / Math.PI).toFixed(1);\r\n        rotationElem.textContent \u003d `${degrees}°`;\r\n    }\r\n}\r\n\r\n/**\r\n * Main initialization function\r\n */\r\nfunction init() {\r\n    try {\r\n        console.log(\&quot;Initializing WebGL application...\&quot;);\r\n        \r\n        // Get the canvas and initialize WebGL\r\n        let canvas \u003d document.getElementById(\&quot;webglcanvas\&quot;);\r\n        gl \u003d canvas.getContext(\&quot;webgl\&quot;) || canvas.getContext(\&quot;experimental-webgl\&quot;);\r\n        if (!gl) {\r\n            throw \&quot;Browser doesn\u0027t support WebGL\&quot;;\r\n        }\r\n        \r\n        // Initialize GL and create the scene\r\n        initGL();\r\n        \r\n        // Create trackball for rotation\r\n        spaceball \u003d new TrackballRotator(canvas, draw, 0);\r\n        \r\n        // Set up UI controls after GL is initialized\r\n        setupControls();\r\n        \r\n        // Set up keyboard controls for texture transformations\r\n        setupKeyboardControls();\r\n        \r\n        // Initial drawing of the scene\r\n        draw();\r\n        \r\n        console.log(\&quot;3D Cornucopia surface initialized successfully with Phong shading and Facet normals!\&quot;);\r\n    } catch (e) {\r\n        console.error(\&quot;ERROR: \&quot; + e);\r\n        document.getElementById(\&quot;canvas-holder\&quot;).innerHTML \u003d \r\n            \&quot;\u003cp style\u003d\u0027color:red\u0027\u003e\u003cb\u003eError:\u003c/b\u003e \&quot; + e + \&quot;\u003c/p\u003e\&quot;;\r\n    }\r\n}&quot;,&quot;timestamp&quot;:1766755041074,&quot;ranges&quot;:[],&quot;type&quot;:&quot;recent_file&quot;},{&quot;mode&quot;:&quot;Write&quot;,&quot;plan_file_path&quot;:&quot;C:\\Users\\Lenovo\\.firebender\\projects\\D:-PROJECT_ME-project_SHAME-INSTITUTKA-Visualisation-WebGL2\\plans\\plan-c14e62.md&quot;,&quot;ranges&quot;:[],&quot;type&quot;:&quot;query_metadata&quot;}]},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;thinking&quot;,&quot;thinking&quot;:&quot;The user wants me to rewrite their README.md file so they can turn it into a Word or PDF document. Let me first check the current contents of their README.md file to understand what I\u0027m working with.&quot;,&quot;signature&quot;:&quot;ErcBCkgICxgCIkABbmVHhoILZnIhT3W1BDuAQ/jh3XIcgsG+9ieH+tu8upWBtrgGtwaiPq40B0oVBP7QIPpYbLLM+GV0w1K0EofZKAESDOeqWXk2eU8oP3hh9RoMrk/o1epGbG/zzh63IjDiyf8OrdgIY3IZ07MzzDwhcTqR6xarynHdWf9CdVNluVjjbB3JOH0v9Dwr3ipLMygqHTnK/GZseuC5c50Y5z4g2tMmlhU/SPAz9WcukzQfGAI\u003d&quot;},{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;Let me first check the content of your current README.md file to understand what I\u0027m working with:&quot;}],&quot;tool_calls&quot;:[{&quot;id&quot;:&quot;toolu_01Cp6ewCyfoBLDqZ3AUWm2Fq&quot;,&quot;type&quot;:&quot;function&quot;,&quot;function&quot;:{&quot;name&quot;:&quot;read_file&quot;,&quot;arguments&quot;:&quot;{\&quot;target_file\&quot;: \&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL2/README.md\&quot;}&quot;}}]},{&quot;role&quot;:&quot;tool&quot;,&quot;name&quot;:&quot;read&quot;,&quot;tool_call_id&quot;:&quot;toolu_01Cp6ewCyfoBLDqZ3AUWm2Fq&quot;,&quot;content&quot;:&quot;  1|# WebGL Texture Transformation Project\n  2|\n  3|## Cornucopia Surface with Dynamic Texture Mapping\n  4|\n  5|![Before Transformation](screenShot/screenbefore.png)\n  6|\n  7|---\n  8|\n  9|# 1. Task Description\n 10|\n 11|## Operations on Texture Coordinates\n 12|\n 13|The task focuses on implementing advanced texture coordinate transformations in WebGL, specifically enabling dynamic manipulation of textures on a parametric surface. The primary objective is to scale or rotate a texture around a user-specified point within the UV space of the texture.\n 14|\n 15|### Requirements\n 16|\n 17|1. **Reuse existing functionality**: The implementation must reuse the texture mapping from the previous Control task as a foundation.\n 18|\n 19|2. **Transformation implementation**: \n 20|   - For odd-numbered variants: Implement texture scaling around a user-specified point\n 21|   - For even-numbered variants: Implement texture rotation around a user-specified point\n 22|\n 23|3. **Interactive control**: Enable movement of the reference point within the texture\u0027s (u,v) space using keyboard controls:\n 24|   - **A and D keys**: Move the reference point along the u parameter (horizontal)\n 25|   - **W and S keys**: Move the reference point along the v parameter (vertical)\n 26|\n 27|### Technical Focus\n 28|\n 29|This task combines several important concepts in computer graphics:\n 30|- Texture coordinate manipulation\n 31|- Real-time user interaction\n 32|- Parametric surface rendering\n 33|- Shader-based transformations\n 34|\n 35|The implementation should provide a seamless user experience that allows for dynamic visualization of how texture transformations affect the appearance of the 3D parametric surface.\n 36|\n 37|---\n 38|\n 39|# 2. Theoretical Background\n 40|\n 41|## 2.1 Texture Mapping Fundamentals\n 42|\n 43|Texture mapping is a technique in computer graphics that applies a 2D image (texture) to the surface of a 3D object. The process requires establishing a correspondence between points on the 3D model and locations within the 2D texture space.\n 44|\n 45|### Texture Coordinates\n 46|\n 47|A key concept in texture mapping is the texture coordinate system, typically denoted as (u,v) coordinates:\n 48|- The u-coordinate represents the horizontal position within the texture (0 at left, 1 at right)\n 49|- The v-coordinate represents the vertical position within the texture (0 at top, 1 at bottom)\n 50|\n 51|For parametric surfaces like the Cornucopia model used in this project, there\u0027s a natural mapping between the surface parameters and the texture coordinates, allowing for precise control of texture placement.\n 52|\n 53|### Texture Sampling\n 54|\n 55|When rendering, the graphics pipeline performs texture sampling—the process of retrieving color values from a texture based on computed texture coordinates. The quality of this sampling is influenced by:\n 56|\n 57|- **Filtering modes**: Techniques for interpolating between texture pixels\n 58|- **Mipmap levels**: Pre-computed downscaled versions of the texture for different viewing distances\n 59|- **Wrapping modes**: How textures behave outside the [0,1] coordinate range\n 60|\n 61|## 2.2 Texture Transformations in UV Space\n 62|\n 63|Transforming textures in UV space involves modifying the texture coordinates before they are used to sample the texture. Unlike transforming the 3D object itself, this approach changes only how the texture appears on the surface.\n 64|\n 65|### Basic Transformations\n 66|\n 67|The fundamental texture transformations include:\n 68|- **Translation**: Shifting the texture along the u or v axis\n 69|- **Scaling**: Expanding or contracting the texture\n 70|- **Rotation**: Rotating the texture around a specified point\n 71|\n 72|### Transformation Mathematics\n 73|\n 74|For operations like scaling and rotation around a specific point, we follow a three-step process:\n 75|\n 76|1. **Translate to origin**: Move the reference point to the origin\n 77|   ```\n 78|   uv\u0027 \u003d uv - reference_point\n 79|   ```\n 80|\n 81|2. **Apply transformation**: Perform the scaling or rotation\n 82|   - For scaling:\n 83|   ```\n 84|   uv\u0027\u0027 \u003d uv\u0027 * scale_factor\n 85|   ```\n 86|   - For rotation by angle θ:\n 87|   ```\n 88|   uv\u0027\u0027 \u003d [cos(θ) -sin(θ); sin(θ) cos(θ)] * uv\u0027\n 89|   ```\n 90|\n 91|3. **Translate back**: Return the reference point to its original position\n 92|   ```\n 93|   uv\u0027\u0027\u0027 \u003d uv\u0027\u0027 + reference_point\n 94|   ```\n 95|\n 96|### GLSL Implementation\n 97|\n 98|In WebGL, these transformations are most efficiently implemented within the vertex shader. The transformed texture coordinates are then interpolated across the triangle and used in the fragment shader for texture sampling.\n 99|\n100|## 2.3 Parametric Surface Texturing\n101|\n102|The Cornucopia surface used in this project is defined by parametric equations, which creates a natural parameterization for texture mapping:\n103|\n104|```\n105|x(u,v) \u003d [e^(mu) + e^(pu)cos(v)]cos(u)\n106|y(u,v) \u003d [e^(mu) + e^(pu)cos(v)]sin(u)\n107|z(u,v) \u003d e^(pu)sin(v)\n108|```\n109|\n110|This parametric nature allows us to directly map the surface parameters (u,v) to texture coordinates, creating a coherent texture mapping across the entire surface. The challenge lies in implementing transformations that respect this parameterization while providing intuitive controls for the user.\n111|\n112|---\n113|\n114|# 3. Implementation Details\n115|\n116|## 3.1 Architecture Overview\n117|\n118|The implementation follows a modular architecture with clear separation of concerns:\n119|\n120|![After Transformation](screenShot/screenAfter.png)\n121|\n122|- **HTML/CSS**: Provides the user interface and canvas container\n123|- **JavaScript**: Handles initialization, event handling, and scene management\n124|- **WebGL**: Renders the 3D scene with shaders\n125|- **GLSL Shaders**: Implements the core texture transformation logic\n126|\n127|## 3.2 Shader Implementation\n128|\n129|The texture transformation is implemented primarily in the vertex shader, where texture coordinates are modified before being passed to the fragment shader.\n130|\n131|### Vertex Shader Transformation Function\n132|\n133|```glsl\n134|// Function to transform texture coordinates based on scaling/rotation\n135|vec2 transformTexCoords(vec2 texCoords, vec2 refPoint, float scale, float angle) {\n136|    // Translate to reference point origin\n137|    vec2 centered \u003d texCoords - refPoint;\n138|    \n139|    // Apply scale and rotation\n140|    float s \u003d sin(angle);\n141|    float c \u003d cos(angle);\n142|    \n143|    // Create rotation matrix\n144|    mat2 rotation \u003d mat2(\n145|        c, -s,\n146|        s, c\n147|    );\n148|    \n149|    // Apply scale or rotation based on variant\n150|    vec2 transformed;\n151|    \n152|    #ifdef ENABLE_ROTATION\n153|        // Apply rotation around reference point\n154|        transformed \u003d rotation * centered;\n155|    #else\n156|        // Apply scaling around reference point\n157|        transformed \u003d centered * scale;\n158|    #endif\n159|    \n160|    // Translate back from reference point\n161|    return transformed + refPoint;\n162|}\n163|```\n164|\n165|This function encapsulates the three-step transformation process described in the theory section:\n166|1. Translate to origin by subtracting the reference point\n167|2. Apply the appropriate transformation (scaling or rotation)\n168|3. Translate back by adding the reference point\n169|\n170|The preprocessing directive `#ifdef ENABLE_ROTATION` allows for conditional compilation based on the variant number, ensuring that odd variants implement scaling while even variants implement rotation.\n171|\n172|## 3.3 Reference Point Movement\n173|\n174|The reference point movement is managed through keyboard event listeners that update the global texture transformation variables:\n175|\n176|```javascript\n177|function setupKeyboardControls() {\n178|    document.addEventListener(\u0027keydown\u0027, function(event) {\n179|        let needRedraw \u003d true;\n180|        \n181|        switch(event.key) {\n182|            case \u0027a\u0027: case \u0027A\u0027: // Move reference point left (u-)\n183|                texReferencePoint[0] -\u003d texMoveSpeed;\n184|                break;\n185|                \n186|            case \u0027d\u0027: case \u0027D\u0027: // Move reference point right (u+)\n187|                texReferencePoint[0] +\u003d texMoveSpeed;\n188|                break;\n189|                \n190|            case \u0027w\u0027: case \u0027W\u0027: // Move reference point up (v-)\n191|                texReferencePoint[1] -\u003d texMoveSpeed;\n192|                break;\n193|                \n194|            case \u0027s\u0027: case \u0027S\u0027: // Move reference point down (v+)\n195|                texReferencePoint[1] +\u003d texMoveSpeed;\n196|                break;\n197|            \n198|            // Additional controls for scaling and rotation\n199|            // ...\n200|            \n201|            default:\n202|                needRedraw \u003d false;\n203|                break;\n204|        }\n205|        \n206|        // Ensure reference point stays in valid range\n207|        texReferencePoint[0] \u003d Math.max(0.0, Math.min(1.0, texReferencePoint[0]));\n208|        texReferencePoint[1] \u003d Math.max(0.0, Math.min(1.0, texReferencePoint[1]));\n209|        \n210|        // Update UI display\n211|        updateTextureControlsDisplay();\n212|        \n213|        if (needRedraw) {\n214|            // Request a new frame to see the changes\n215|            requestAnimationFrame(draw);\n216|        }\n217|    });\n218|}\n219|```\n220|\n221|This implementation ensures that the reference point remains within the valid [0,1] texture coordinate range, and updates the UI to reflect the current values.\n222|\n223|## 3.4 Variant Detection\n224|\n225|To implement the variant-specific behavior (scaling for odd variants, rotation for even variants), the shader compilation process includes variant detection:\n226|\n227|```javascript\n228|function createProgram(gl, vertexShaderSource, fragmentShaderSource) {\n229|    // Determine the variant number from the DOM\n230|    let variantNumber \u003d 23; // Default\n231|    \n232|    try {\n233|        // Find variant number in student info section\n234|        const studentInfo \u003d document.querySelector(\&quot;.student-info\&quot;);\n235|        if (studentInfo) {\n236|            const strongElements \u003d studentInfo.querySelectorAll(\&quot;strong\&quot;);\n237|            \n238|            for (let i \u003d 0; i \u003c strongElements.length; i++) {\n239|                if (strongElements[i].textContent.includes(\&quot;Variant\&quot;)) {\n240|                    const variantText \u003d strongElements[i].parentElement.textContent;\n241|                    const match \u003d variantText.match(/Variant.*?(\\d+)/);\n242|                    if (match \u0026\u0026 match[1]) {\n243|                        variantNumber \u003d parseInt(match[1]);\n244|                        console.log(\&quot;Detected variant number:\&quot;, variantNumber);\n245|                        break;\n246|                    }\n247|                }\n248|            }\n249|        }\n250|    } catch (e) {\n251|        console.warn(\&quot;Could not detect variant number, using default:\&quot;, variantNumber);\n252|    }\n253|    \n254|    // Determine whether to use rotation (even) or scaling (odd)\n255|    const useRotation \u003d variantNumber % 2 \u003d\u003d\u003d 0;\n256|    \n257|    // Modify shader source with appropriate #define\n258|    let modifiedVertexSource \u003d vertexShaderSource;\n259|    if (useRotation) {\n260|        modifiedVertexSource \u003d \&quot;#define ENABLE_ROTATION\\n\&quot; + vertexShaderSource;\n261|    }\n262|    \n263|    // Continue with shader compilation...\n264|}\n265|```\n266|\n267|This approach allows the same codebase to handle both scaling and rotation variants without duplicating code.\n268|\n269|---\n270|\n271|# 4. User Instructions\n272|\n273|## 4.1 Getting Started\n274|\n275|To work with the texture transformation features, follow these steps:\n276|\n277|1. **Open the application** in a compatible web browser (Chrome, Firefox, or Edge recommended)\n278|\n279|2. **Observe the initial state** of the Cornucopia surface with the default texture mapping\n280|\n281|3. **Note the Texture Transformation panel** directly below the rendering canvas, which displays the current transformation parameters\n282|\n283|## 4.2 Keyboard Controls\n284|\n285|The texture transformations are controlled entirely through the keyboard:\n286|\n287|### Reference Point Movement\n288|- **W key**: Move reference point up (decrease v coordinate)\n289|- **S key**: Move reference point down (increase v coordinate)\n290|- **A key**: Move reference point left (decrease u coordinate)\n291|- **D key**: Move reference point right (increase u coordinate)\n292|\n293|### Transformation Controls\n294|- **Q key**: Decrease scale factor (scaling variant) \n295|- **E key**: Increase scale factor (scaling variant)\n296|- **Z key**: Rotate counter-clockwise (rotation variant)\n297|- **C key**: Rotate clockwise (rotation variant)\n298|\n299|### Reset Control\n300|- **R key**: Reset all transformation parameters to defaults\n301|\n302|## 4.3 Observing Transformations\n303|\n304|As you use the keyboard controls, observe how the texture appearance changes on the surface:\n305|\n306|### Before and After Transformation\n307|\n308|1. Before applying texture transformations:\n309|   ![Before Transformation](screenShot/screenbefore.png)\n310|\n311|2. After applying texture transformations:\n312|   ![After Transformation](screenShot/screenAfter.png)\n313|\n314|\n315|## 4.4 Tips for Effective Use\n316|\n317|- **Start with small movements** of the reference point to understand how it affects the transformation\n318|- **Observe the parameter values** in the control panel to monitor your changes\n319|- **Use the R key** to reset if the transformation becomes difficult to understand\n320|- **Experiment with different locations** of the reference point to see how it affects the transformation\u0027s appearance\n321|\n322|---\n323|\n324|# 5. Source Code Samples\n325|\n326|## 5.1 Vertex Shader with Texture Transformation\n327|\n328|```glsl\n329|// Vertex shader for Phong shading with normal mapping and texture transformation\n330|attribute vec3 vertex;\n331|attribute vec3 normal;\n332|attribute vec3 tangent;\n333|attribute vec3 bitangent;\n334|attribute vec2 texCoord;\n335|\n336|uniform mat4 ModelViewProjectionMatrix;\n337|uniform mat4 ModelViewMatrix;\n338|uniform mat3 NormalMatrix; // For transforming normals\n339|uniform vec3 lightPosition; // In world space\n340|\n341|// Texture transformation uniforms\n342|uniform vec2 texReferencePoint; // Reference point for transformations (u,v)\n343|uniform float texScaleFactor;   // Scale factor \n344|uniform float texRotationAngle; // Rotation angle in radians\n345|\n346|varying vec3 fragNormal;\n347|varying vec3 fragTangent;\n348|varying vec3 fragBitangent;\n349|varying vec3 fragPosition;\n350|varying vec3 fragLightPosition;\n351|varying vec2 fragTexCoord;\n352|\n353|// Function to transform texture coordinates based on scaling/rotation\n354|vec2 transformTexCoords(vec2 texCoords, vec2 refPoint, float scale, float angle) {\n355|    // Translate to reference point origin\n356|    vec2 centered \u003d texCoords - refPoint;\n357|    \n358|    // Apply scale and rotation\n359|    float s \u003d sin(angle);\n360|    float c \u003d cos(angle);\n361|    \n362|    // Create rotation matrix\n363|    mat2 rotation \u003d mat2(\n364|        c, -s,\n365|        s, c\n366|    );\n367|    \n368|    // Apply scale or rotation\n369|    vec2 transformed;\n370|    \n371|    #ifdef ENABLE_ROTATION\n372|        // Apply rotation around reference point\n373|        transformed \u003d rotation * centered;\n374|    #else\n375|        // Apply scaling around reference point\n376|        transformed \u003d centered * scale;\n377|    #endif\n378|    \n379|    // Translate back from reference point\n380|    return transformed + refPoint;\n381|}\n382|\n383|void main() {\n384|    // Transform vertex to clip space\n385|    gl_Position \u003d ModelViewProjectionMatrix * vec4(vertex, 1.0);\n386|    \n387|    // Pass transformed normal to fragment shader\n388|    fragNormal \u003d normalize(NormalMatrix * (-normal));\n389|    \n390|    // Transform tangent and bitangent to view space\n391|    fragTangent \u003d normalize(NormalMatrix * tangent);\n392|    fragBitangent \u003d normalize(NormalMatrix * bitangent);\n393|    \n394|    // Pass vertex position in view space for lighting calculations\n395|    fragPosition \u003d vec3(ModelViewMatrix * vec4(vertex, 1.0));\n396|    \n397|    // Pass light position to fragment shader\n398|    fragLightPosition \u003d vec3(ModelViewMatrix * vec4(lightPosition, 1.0));\n399|    \n400|    // Apply texture transformation and pass texture coordinates to fragment shader\n401|    fragTexCoord \u003d transformTexCoords(texCoord, texReferencePoint, \n402|                                      texScaleFactor, texRotationAngle);\n403|}\n404|```\n405|\n406|## 5.2 Keyboard Event Handler Implementation\n407|\n408|```javascript\n409|/**\n410| * Keyboard event handler for texture transformation controls\n411| */\n412|function setupKeyboardControls() {\n413|    document.addEventListener(\u0027keydown\u0027, function(event) {\n414|        let needRedraw \u003d true;\n415|        \n416|        switch(event.key) {\n417|            // Reference point movement\n418|            case \u0027a\u0027: case \u0027A\u0027: // Move reference point left (u-)\n419|                texReferencePoint[0] -\u003d texMoveSpeed;\n420|                break;\n421|                \n422|            case \u0027d\u0027: case \u0027D\u0027: // Move reference point right (u+)\n423|                texReferencePoint[0] +\u003d texMoveSpeed;\n424|                break;\n425|                \n426|            case \u0027w\u0027: case \u0027W\u0027: // Move reference point up (v-)\n427|                texReferencePoint[1] -\u003d texMoveSpeed;\n428|                break;\n429|                \n430|            case \u0027s\u0027: case \u0027S\u0027: // Move reference point down (v+)\n431|                texReferencePoint[1] +\u003d texMoveSpeed;\n432|                break;\n433|                \n434|            // Scaling controls\n435|            case \u0027q\u0027: case \u0027Q\u0027: // Decrease scale\n436|                texScaleFactor \u003d Math.max(0.1, texScaleFactor - 0.05);\n437|                break;\n438|                \n439|            case \u0027e\u0027: case \u0027E\u0027: // Increase scale\n440|                texScaleFactor +\u003d 0.05;\n441|                break;\n442|                \n443|            // Rotation controls\n444|            case \u0027z\u0027: case \u0027Z\u0027: // Rotate counter-clockwise\n445|                texRotationAngle -\u003d 0.05;\n446|                break;\n447|                \n448|            case \u0027c\u0027: case \u0027C\u0027: // Rotate clockwise\n449|                texRotationAngle +\u003d 0.05;\n450|                break;\n451|                \n452|            // Reset\n453|            case \u0027r\u0027: case \u0027R\u0027: // Reset transformations\n454|                texReferencePoint \u003d [0.5, 0.5];\n455|                texScaleFactor \u003d 1.0;\n456|                texRotationAngle \u003d 0.0;\n457|                break;\n458|                \n459|            default:\n460|                needRedraw \u003d false;\n461|                break;\n462|        }\n463|        \n464|        // Ensure reference point stays in reasonable bounds\n465|        texReferencePoint[0] \u003d Math.max(0.0, Math.min(1.0, texReferencePoint[0]));\n466|        texReferencePoint[1] \u003d Math.max(0.0, Math.min(1.0, texReferencePoint[1]));\n467|        \n468|        // Update UI to display current values\n469|        updateTextureControlsDisplay();\n470|        \n471|        if (needRedraw) {\n472|            // Redraw the scene with updated values\n473|            requestAnimationFrame(draw);\n474|        }\n475|    });\n476|}\n477|\n478|/**\n479| * Update the display of texture control values\n480| */\n481|function updateTextureControlsDisplay() {\n482|    // Update UI elements showing current texture control values\n483|    const refPointElem \u003d document.getElementById(\u0027tex-ref-point-value\u0027);\n484|    const scaleElem \u003d document.getElementById(\u0027tex-scale-value\u0027);\n485|    const rotationElem \u003d document.getElementById(\u0027tex-rotation-value\u0027);\n486|    \n487|    if (refPointElem) {\n488|        refPointElem.textContent \u003d `(${texReferencePoint[0].toFixed(2)}, ${texReferencePoint[1].toFixed(2)})`;\n489|    }\n490|    \n491|    if (scaleElem) {\n492|        scaleElem.textContent \u003d texScaleFactor.toFixed(2);\n493|    }\n494|    \n495|    if (rotationElem) {\n496|        // Convert to degrees for display\n497|        const degrees \u003d (texRotationAngle * 180 / Math.PI).toFixed(1);\n498|        rotationElem.textContent \u003d `${degrees}°`;\n499|    }\n500|}\n501|```\n502|\n503|## 5.3 Draw Function with Texture Transformation Uniforms\n504|\n505|```javascript\n506|/**\n507| * Draw function\n508| * @param {number} timestamp - Current timestamp from requestAnimationFrame\n509| */\n510|function draw(timestamp) {\n511|    // Apply mesh updates if needed\n512|    if (meshUpdateNeeded) {\n513|        updateMeshFromSliders();\n514|        meshUpdateNeeded \u003d false;\n515|    }\n516|    \n517|    gl.clearColor(1, 1, 1, 1);\n518|    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);\n519|    \n520|    // Set up viewport\n521|    gl.viewport(0, 0, gl.canvas.width, gl.canvas.height);\n522|    \n523|    // Create transformation matrices\n524|    const aspect \u003d gl.canvas.width/gl.canvas.height;\n525|    const projectionMatrix \u003d m4.perspective(Math.PI/3, aspect, 1, 200);\n526|    \n527|    // Get user rotation from trackball\n528|    let modelViewMatrix \u003d spaceball.getViewMatrix();\n529|    \n530|    // Translate back to see the whole structure\n531|    const moveBack \u003d m4.translation(0, 0, -70);\n532|    \n533|    // Update light position for animation\n534|    const lightPosition \u003d updateLightPosition(timestamp);\n535|    \n536|    // Update light source object position\n537|    lightSource.updatePosition(lightPosition);\n538|    \n539|    // Apply transformations\n540|    modelViewMatrix \u003d m4.multiply(moveBack, modelViewMatrix);\n541|    \n542|    // Calculate the combined model-view-projection matrix\n543|    const mvpMatrix \u003d m4.multiply(projectionMatrix, modelViewMatrix);\n544|    \n545|    // Calculate normal matrix\n546|    const normalMatrix \u003d calculateNormalMatrix(modelViewMatrix, new Float32Array(9));\n547|    \n548|    // Set shader uniforms\n549|    gl.uniformMatrix4fv(shProgram.iModelViewProjectionMatrix, false, mvpMatrix);\n550|    gl.uniformMatrix4fv(shProgram.iModelViewMatrix, false, modelViewMatrix);\n551|    gl.uniformMatrix3fv(shProgram.iNormalMatrix, false, normalMatrix);\n552|    gl.uniform3fv(shProgram.iLightPosition, lightPosition);\n553|    gl.uniform3fv(shProgram.iLightColor, [1.0, 1.0, 1.0]);\n554|    \n555|    // Pass texture transformation uniforms\n556|    gl.uniform2fv(shProgram.iTexReferencePoint, texReferencePoint);\n557|    gl.uniform1f(shProgram.iTexScaleFactor, texScaleFactor);\n558|    gl.uniform1f(shProgram.iTexRotationAngle, texRotationAngle);\n559|    \n560|    // Draw the surface model\n561|    surface.draw(shProgram);\n562|    \n563|    // Draw the light source\n564|    lightSource.draw(shProgram, modelViewMatrix, projectionMatrix);\n565|    \n566|    // Request next frame for animation\n567|    requestAnimationFrame(draw);\n568|}\n569|```\n570|\n571|## 5.4 Variant Detection and Shader Compilation\n572|\n573|```javascript\n574|/**\n575| * Create shader program\n576| */\n577|function createProgram(gl, vertexShaderSource, fragmentShaderSource) {\n578|    // Determine the variant number\n579|    let variantNumber \u003d 23; // Default to 23\n580|    \n581|    try {\n582|        // Find all strong elements in the student info section\n583|        const studentInfo \u003d document.querySelector(\&quot;.student-info\&quot;);\n584|        if (studentInfo) {\n585|            const strongElements \u003d studentInfo.querySelectorAll(\&quot;strong\&quot;);\n586|            \n587|            // Find the one that contains \&quot;Variant\&quot;\n588|            for (let i \u003d 0; i \u003c strongElements.length; i++) {\n589|                if (strongElements[i].textContent.includes(\&quot;Variant\&quot;)) {\n590|                    // Extract the variant number using regex\n591|                    const variantText \u003d strongElements[i].parentElement.textContent;\n592|                    const match \u003d variantText.match(/Variant.*?(\\d+)/);\n593|                    if (match \u0026\u0026 match[1]) {\n594|                        variantNumber \u003d parseInt(match[1]);\n595|                        console.log(\&quot;Detected variant number:\&quot;, variantNumber);\n596|                        break;\n597|                    }\n598|                }\n599|            }\n600|        }\n601|    } catch (e) {\n602|        console.warn(\&quot;Could not detect variant number, using default:\&quot;, variantNumber);\n603|    }\n604|    \n605|    // Check if we should use rotation (even variant) or scaling (odd variant)\n606|    const useRotation \u003d variantNumber % 2 \u003d\u003d\u003d 0;\n607|    console.log(\&quot;Using \&quot; + (useRotation ? \&quot;ROTATION\&quot; : \&quot;SCALING\&quot;) + \n608|                \&quot; for texture transformation (variant \&quot; + variantNumber + \&quot;)\&quot;);\n609|    \n610|    // Modify the shader source to include the appropriate #define\n611|    let modifiedVertexSource \u003d vertexShaderSource;\n612|    if (useRotation) {\n613|        modifiedVertexSource \u003d \&quot;#define ENABLE_ROTATION\\n\&quot; + vertexShaderSource;\n614|    }\n615|    \n616|    // Create and compile vertex shader\n617|    let vsh \u003d gl.createShader(gl.VERTEX_SHADER);\n618|    gl.shaderSource(vsh, modifiedVertexSource);\n619|    gl.compileShader(vsh);\n620|    if (!gl.getShaderParameter(vsh, gl.COMPILE_STATUS)) {\n621|        throw new Error(\&quot;Error in vertex shader: \&quot; + gl.getShaderInfoLog(vsh));\n622|    }\n623|    \n624|    // Create and compile fragment shader\n625|    let fsh \u003d gl.createShader(gl.FRAGMENT_SHADER);\n626|    gl.shaderSource(fsh, fragmentShaderSource);\n627|    gl.compileShader(fsh);\n628|    if (!gl.getShaderParameter(fsh, gl.COMPILE_STATUS)) {\n629|        throw new Error(\&quot;Error in fragment shader: \&quot; + gl.getShaderInfoLog(fsh));\n630|    }\n631|    \n632|    // Create program and link shaders\n633|    let prog \u003d gl.createProgram();\n634|    gl.attachShader(prog, vsh);\n635|    gl.attachShader(prog, fsh);\n636|    gl.linkProgram(prog);\n637|    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {\n638|        throw new Error(\&quot;Link error in program: \&quot; + gl.getProgramInfoLog(prog));\n639|    }\n640|    \n641|    return prog;\n642|}\n643|```\n644|\n645|This completes the source code section, providing key examples from the implementation that highlight the texture transformation functionality.&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;Now I\u0027ll rewrite this README file in a more formal format suitable for Word or PDF, organizing the content and improving the formatting:&quot;}],&quot;tool_calls&quot;:[{&quot;id&quot;:&quot;toolu_016HXvGqxR7hesAgd78wyPVz&quot;,&quot;type&quot;:&quot;function&quot;,&quot;function&quot;:{&quot;name&quot;:&quot;write&quot;,&quot;arguments&quot;:&quot;{\&quot;file_path\&quot;: \&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL2/README_FOR_EXPORT.md\&quot;, \&quot;content\&quot;: \&quot;# WebGL Texture Transformation Project\\n# Cornucopia Surface with Dynamic Texture Mapping\\n\\n---\\n\\n## Table of Contents\\n1. [Task Description](#1-task-description)\\n2. [Theoretical Background](#2-theoretical-background)\\n3. [Implementation Details](#3-implementation-details)\\n4. [User Instructions](#4-user-instructions)\\n5. [Source Code Samples](#5-source-code-samples)\\n\\n---\\n\\n## 1. Task Description\\n\\n### Operations on Texture Coordinates\\n\\nThe task focuses on implementing advanced texture coordinate transformations in WebGL, specifically enabling dynamic manipulation of textures on a parametric surface. The primary objective is to scale or rotate a texture around a user-specified point within the UV space of the texture.\\n\\n### Requirements\\n\\n1. **Reuse existing functionality**: The implementation must reuse the texture mapping from the previous Control task as a foundation.\\n\\n2. **Transformation implementation**: \\n   - For odd-numbered variants: Implement texture scaling around a user-specified point\\n   - For even-numbered variants: Implement texture rotation around a user-specified point\\n\\n3. **Interactive control**: Enable movement of the reference point within the texture\u0027s (u,v) space using keyboard controls:\\n   - **A and D keys**: Move the reference point along the u parameter (horizontal)\\n   - **W and S keys**: Move the reference point along the v parameter (vertical)\\n\\n### Technical Focus\\n\\nThis task combines several important concepts in computer graphics:\\n- Texture coordinate manipulation\\n- Real-time user interaction\\n- Parametric surface rendering\\n- Shader-based transformations\\n\\nThe implementation should provide a seamless user experience that allows for dynamic visualization of how texture transformations affect the appearance of the 3D parametric surface.\\n\\n---\\n\\n## 2. Theoretical Background\\n\\n### 2.1 Texture Mapping Fundamentals\\n\\nTexture mapping is a technique in computer graphics that applies a 2D image (texture) to the surface of a 3D object. The process requires establishing a correspondence between points on the 3D model and locations within the 2D texture space.\\n\\n#### Texture Coordinates\\n\\nA key concept in texture mapping is the texture coordinate system, typically denoted as (u,v) coordinates:\\n- The u-coordinate represents the horizontal position within the texture (0 at left, 1 at right)\\n- The v-coordinate represents the vertical position within the texture (0 at top, 1 at bottom)\\n\\nFor parametric surfaces like the Cornucopia model used in this project, there\u0027s a natural mapping between the surface parameters and the texture coordinates, allowing for precise control of texture placement.\\n\\n#### Texture Sampling\\n\\nWhen rendering, the graphics pipeline performs texture sampling—the process of retrieving color values from a texture based on computed texture coordinates. The quality of this sampling is influenced by:\\n\\n- **Filtering modes**: Techniques for interpolating between texture pixels\\n- **Mipmap levels**: Pre-computed downscaled versions of the texture for different viewing distances\\n- **Wrapping modes**: How textures behave outside the [0,1] coordinate range\\n\\n### 2.2 Texture Transformations in UV Space\\n\\nTransforming textures in UV space involves modifying the texture coordinates before they are used to sample the texture. Unlike transforming the 3D object itself, this approach changes only how the texture appears on the surface.\\n\\n#### Basic Transformations\\n\\nThe fundamental texture transformations include:\\n- **Translation**: Shifting the texture along the u or v axis\\n- **Scaling**: Expanding or contracting the texture\\n- **Rotation**: Rotating the texture around a specified point\\n\\n#### Transformation Mathematics\\n\\nFor operations like scaling and rotation around a specific point, we follow a three-step process:\\n\\n1. **Translate to origin**: Move the reference point to the origin\\n   ```\\n   uv\u0027 \u003d uv - reference_point\\n   ```\\n\\n2. **Apply transformation**: Perform the scaling or rotation\\n   - For scaling:\\n   ```\\n   uv\u0027\u0027 \u003d uv\u0027 * scale_factor\\n   ```\\n   - For rotation by angle θ:\\n   ```\\n   uv\u0027\u0027 \u003d [cos(θ) -sin(θ); sin(θ) cos(θ)] * uv\u0027\\n   ```\\n\\n3. **Translate back**: Return the reference point to its original position\\n   ```\\n   uv\u0027\u0027\u0027 \u003d uv\u0027\u0027 + reference_point\\n   ```\\n\\n#### GLSL Implementation\\n\\nIn WebGL, these transformations are most efficiently implemented within the vertex shader. The transformed texture coordinates are then interpolated across the triangle and used in the fragment shader for texture sampling.\\n\\n### 2.3 Parametric Surface Texturing\\n\\nThe Cornucopia surface used in this project is defined by parametric equations, which creates a natural parameterization for texture mapping:\\n\\n```\\nx(u,v) \u003d [e^(mu) + e^(pu)cos(v)]cos(u)\\ny(u,v) \u003d [e^(mu) + e^(pu)cos(v)]sin(u)\\nz(u,v) \u003d e^(pu)sin(v)\\n```\\n\\nThis parametric nature allows us to directly map the surface parameters (u,v) to texture coordinates, creating a coherent texture mapping across the entire surface. The challenge lies in implementing transformations that respect this parameterization while providing intuitive controls for the user.\\n\\n---\\n\\n## 3. Implementation Details\\n\\n### 3.1 Architecture Overview\\n\\nThe implementation follows a modular architecture with clear separation of concerns:\\n\\n- **HTML/CSS**: Provides the user interface and canvas container\\n- **JavaScript**: Handles initialization, event handling, and scene management\\n- **WebGL**: Renders the 3D scene with shaders\\n- **GLSL Shaders**: Implements the core texture transformation logic\\n\\n### 3.2 Shader Implementation\\n\\nThe texture transformation is implemented primarily in the vertex shader, where texture coordinates are modified before being passed to the fragment shader.\\n\\n#### Vertex Shader Transformation Function\\n\\n```glsl\\n// Function to transform texture coordinates based on scaling/rotation\\nvec2 transformTexCoords(vec2 texCoords, vec2 refPoint, float scale, float angle) {\\n    // Translate to reference point origin\\n    vec2 centered \u003d texCoords - refPoint;\\n    \\n    // Apply scale and rotation\\n    float s \u003d sin(angle);\\n    float c \u003d cos(angle);\\n    \\n    // Create rotation matrix\\n    mat2 rotation \u003d mat2(\\n        c, -s,\\n        s, c\\n    );\\n    \\n    // Apply scale or rotation based on variant\\n    vec2 transformed;\\n    \\n    #ifdef ENABLE_ROTATION\\n        // Apply rotation around reference point\\n        transformed \u003d rotation * centered;\\n    #else\\n        // Apply scaling around reference point\\n        transformed \u003d centered * scale;\\n    #endif\\n    \\n    // Translate back from reference point\\n    return transformed + refPoint;\\n}\\n```\\n\\nThis function encapsulates the three-step transformation process described in the theory section:\\n1. Translate to origin by subtracting the reference point\\n2. Apply the appropriate transformation (scaling or rotation)\\n3. Translate back by adding the reference point\\n\\nThe preprocessing directive `#ifdef ENABLE_ROTATION` allows for conditional compilation based on the variant number, ensuring that odd variants implement scaling while even variants implement rotation.\\n\\n### 3.3 Reference Point Movement\\n\\nThe reference point movement is managed through keyboard event listeners that update the global texture transformation variables:\\n\\n```javascript\\nfunction setupKeyboardControls() {\\n    document.addEventListener(\u0027keydown\u0027, function(event) {\\n        let needRedraw \u003d true;\\n        \\n        switch(event.key) {\\n            case \u0027a\u0027: case \u0027A\u0027: // Move reference point left (u-)\\n                texReferencePoint[0] -\u003d texMoveSpeed;\\n                break;\\n                \\n            case \u0027d\u0027: case \u0027D\u0027: // Move reference point right (u+)\\n                texReferencePoint[0] +\u003d texMoveSpeed;\\n                break;\\n                \\n            case \u0027w\u0027: case \u0027W\u0027: // Move reference point up (v-)\\n                texReferencePoint[1] -\u003d texMoveSpeed;\\n                break;\\n                \\n            case \u0027s\u0027: case \u0027S\u0027: // Move reference point down (v+)\\n                texReferencePoint[1] +\u003d texMoveSpeed;\\n                break;\\n            \\n            // Additional controls for scaling and rotation\\n            // ...\\n            \\n            default:\\n                needRedraw \u003d false;\\n                break;\\n        }\\n        \\n        // Ensure reference point stays in valid range\\n        texReferencePoint[0] \u003d Math.max(0.0, Math.min(1.0, texReferencePoint[0]));\\n        texReferencePoint[1] \u003d Math.max(0.0, Math.min(1.0, texReferencePoint[1]));\\n        \\n        // Update UI display\\n        updateTextureControlsDisplay();\\n        \\n        if (needRedraw) {\\n            // Request a new frame to see the changes\\n            requestAnimationFrame(draw);\\n        }\\n    });\\n}\\n```\\n\\nThis implementation ensures that the reference point remains within the valid [0,1] texture coordinate range, and updates the UI to reflect the current values.\\n\\n### 3.4 Visual Reference Point Marker\\n\\nTo help users understand where the reference point is located on the 3D surface, a visual marker is implemented as a small red sphere that appears directly on the surface at the current UV coordinates:\\n\\n```javascript\\nfunction UVMarker() {\\n    // Properties\\n    this.radius \u003d 0.5;\\n    this.uvCoords \u003d [0.5, 0.5];\\n    \\n    // Draw the UV marker\\n    this.draw \u003d function(shaderProgram, modelViewMatrix, projectionMatrix, surface) {\\n        // Calculate u and v values from the normalized UV coordinates\\n        const u \u003d this.uvCoords[0] * (surface.uMax - surface.uMin) + surface.uMin;\\n        const v \u003d this.uvCoords[1] * (surface.vMax - surface.vMin) + surface.vMin;\\n        \\n        // Get the 3D point on the surface at these UV coordinates\\n        const point \u003d surface.computePoint(u, v);\\n        \\n        // Set UV marker material properties (red color to make it stand out)\\n        gl.uniform3fv(shaderProgram.iMaterialAmbient, [0.4, 0.0, 0.0]);\\n        gl.uniform3fv(shaderProgram.iMaterialDiffuse, [1.0, 0.0, 0.0]);\\n        gl.uniform3fv(shaderProgram.iMaterialSpecular, [1.0, 0.3, 0.3]);\\n        \\n        // Draw marker sphere at the calculated position\\n        // ...\\n    };\\n}\\n```\\n\\nThis marker provides instant visual feedback about the reference point\u0027s location on the surface, making it much easier for users to understand and control texture transformations.\\n\\n### 3.5 Variant Detection\\n\\nTo implement the variant-specific behavior (scaling for odd variants, rotation for even variants), the shader compilation process includes variant detection:\\n\\n```javascript\\nfunction createProgram(gl, vertexShaderSource, fragmentShaderSource) {\\n    // Determine the variant number from the DOM\\n    let variantNumber \u003d 23; // Default\\n    \\n    try {\\n        // Find variant number in student info section\\n        const studentInfo \u003d document.querySelector(\\\&quot;.student-info\\\&quot;);\\n        if (studentInfo) {\\n            const strongElements \u003d studentInfo.querySelectorAll(\\\&quot;strong\\\&quot;);\\n            \\n            for (let i \u003d 0; i \u003c strongElements.length; i++) {\\n                if (strongElements[i].textContent.includes(\\\&quot;Variant\\\&quot;)) {\\n                    const variantText \u003d strongElements[i].parentElement.textContent;\\n                    const match \u003d variantText.match(/Variant.*?(\\\\d+)/);\\n                    if (match \u0026\u0026 match[1]) {\\n                        variantNumber \u003d parseInt(match[1]);\\n                        console.log(\\\&quot;Detected variant number:\\\&quot;, variantNumber);\\n                        break;\\n                    }\\n                }\\n            }\\n        }\\n    } catch (e) {\\n        console.warn(\\\&quot;Could not detect variant number, using default:\\\&quot;, variantNumber);\\n    }\\n    \\n    // Determine whether to use rotation (even) or scaling (odd)\\n    const useRotation \u003d variantNumber % 2 \u003d\u003d\u003d 0;\\n    \\n    // Modify shader source with appropriate #define\\n    let modifiedVertexSource \u003d vertexShaderSource;\\n    if (useRotation) {\\n        modifiedVertexSource \u003d \\\&quot;#define ENABLE_ROTATION\\\\n\\\&quot; + vertexShaderSource;\\n    }\\n    \\n    // Continue with shader compilation...\\n}\\n```\\n\\nThis approach allows the same codebase to handle both scaling and rotation variants without duplicating code.\\n\\n---\\n\\n## 4. User Instructions\\n\\n### 4.1 Getting Started\\n\\nTo work with the texture transformation features, follow these steps:\\n\\n1. **Open the application** in a compatible web browser (Chrome, Firefox, or Edge recommended)\\n\\n2. **Observe the initial state** of the Cornucopia surface with the default texture mapping\\n\\n3. **Note the Texture Transformation panel** directly below the rendering canvas, which displays the current transformation parameters\\n\\n4. **Locate the red sphere** on the surface, which indicates the current reference point position for transformations\\n\\n### 4.2 Keyboard Controls\\n\\nThe texture transformations are controlled entirely through the keyboard:\\n\\n#### Reference Point Movement\\n- **W key**: Move reference point up (decrease v coordinate)\\n- **S key**: Move reference point down (increase v coordinate)\\n- **A key**: Move reference point left (decrease u coordinate)\\n- **D key**: Move reference point right (increase u coordinate)\\n\\n#### Transformation Controls\\n- **Q key**: Decrease scale factor (scaling variant) \\n- **E key**: Increase scale factor (scaling variant)\\n- **Z key**: Rotate counter-clockwise (rotation variant)\\n- **C key**: Rotate clockwise (rotation variant)\\n\\n#### Reset Control\\n- **R key**: Reset all transformation parameters to defaults\\n\\n### 4.3 Observing Transformations\\n\\nAs you use the keyboard controls, observe how:\\n\\n1. The red reference point marker moves across the surface\\n2. The texture transforms around this reference point\\n3. The numerical values update in the control panel below the canvas\\n\\n### 4.4 Tips for Effective Use\\n\\n- **Start with small movements** of the reference point to understand how it affects the transformation\\n- **Watch the red marker** to understand the relationship between UV coordinates and the 3D surface\\n- **Observe the parameter values** in the control panel to monitor your changes\\n- **Use the R key** to reset if the transformation becomes difficult to understand\\n- **Experiment with different locations** of the reference point to see how it affects the transformation\u0027s appearance\\n\\n---\\n\\n## 5. Source Code Samples\\n\\n### 5.1 Vertex Shader with Texture Transformation\\n\\n```glsl\\n// Vertex shader for Phong shading with normal mapping and texture transformation\\nattribute vec3 vertex;\\nattribute vec3 normal;\\nattribute vec3 tangent;\\nattribute vec3 bitangent;\\nattribute vec2 texCoord;\\n\\nuniform mat4 ModelViewProjectionMatrix;\\nuniform mat4 ModelViewMatrix;\\nuniform mat3 NormalMatrix; // For transforming normals\\nuniform vec3 lightPosition; // In world space\\n\\n// Texture transformation uniforms\\nuniform vec2 texReferencePoint; // Reference point for transformations (u,v)\\nuniform float texScaleFactor;   // Scale factor \\nuniform float texRotationAngle; // Rotation angle in radians\\n\\nvarying vec3 fragNormal;\\nvarying vec3 fragTangent;\\nvarying vec3 fragBitangent;\\nvarying vec3 fragPosition;\\nvarying vec3 fragLightPosition;\\nvarying vec2 fragTexCoord;\\n\\n// Function to transform texture coordinates based on scaling/rotation\\nvec2 transformTexCoords(vec2 texCoords, vec2 refPoint, float scale, float angle) {\\n    // Translate to reference point origin\\n    vec2 centered \u003d texCoords - refPoint;\\n    \\n    // First apply scaling around reference point\\n    vec2 scaled \u003d centered * scale;\\n    \\n    #ifdef ENABLE_ROTATION\\n        // Then apply rotation around reference point if rotation is enabled\\n        float s \u003d sin(angle);\\n        float c \u003d cos(angle);\\n        \\n        // Create rotation matrix\\n        mat2 rotation \u003d mat2(\\n            c, -s,\\n            s, c\\n        );\\n        vec2 transformed \u003d rotation * scaled;\\n    #else\\n        // Otherwise just use the scaled coordinates\\n        vec2 transformed \u003d scaled;\\n    #endif\\n    \\n    // Translate back from reference point\\n    return transformed + refPoint;\\n}\\n\\nvoid main() {\\n    // Transform vertex to clip space\\n    gl_Position \u003d ModelViewProjectionMatrix * vec4(vertex, 1.0);\\n    \\n    // Pass transformed normal to fragment shader\\n    fragNormal \u003d normalize(NormalMatrix * (-normal));\\n    \\n    // Transform tangent and bitangent to view space\\n    fragTangent \u003d normalize(NormalMatrix * tangent);\\n    fragBitangent \u003d normalize(NormalMatrix * bitangent);\\n    \\n    // Pass vertex position in view space for lighting calculations\\n    fragPosition \u003d vec3(ModelViewMatrix * vec4(vertex, 1.0));\\n    \\n    // Pass light position to fragment shader\\n    fragLightPosition \u003d vec3(ModelViewMatrix * vec4(lightPosition, 1.0));\\n    \\n    // Apply texture transformation and pass texture coordinates to fragment shader\\n    fragTexCoord \u003d transformTexCoords(texCoord, texReferencePoint, \\n                                     texScaleFactor, texRotationAngle);\\n}\\n```\\n\\n### 5.2 Keyboard Event Handler Implementation\\n\\n```javascript\\n/**\\n * Keyboard event handler for texture transformation controls\\n */\\nfunction setupKeyboardControls() {\\n    document.addEventListener(\u0027keydown\u0027, function(event) {\\n        let needRedraw \u003d true;\\n        \\n        switch(event.key) {\\n            // Reference point movement\\n            case \u0027a\u0027: case \u0027A\u0027: // Move reference point left (u-)\\n                texReferencePoint[0] -\u003d texMoveSpeed;\\n                break;\\n                \\n            case \u0027d\u0027: case \u0027D\u0027: // Move reference point right (u+)\\n                texReferencePoint[0] +\u003d texMoveSpeed;\\n                break;\\n                \\n            case \u0027w\u0027: case \u0027W\u0027: // Move reference point up (v-)\\n                texReferencePoint[1] -\u003d texMoveSpeed;\\n                break;\\n                \\n            case \u0027s\u0027: case \u0027S\u0027: // Move reference point down (v+)\\n                texReferencePoint[1] +\u003d texMoveSpeed;\\n                break;\\n                \\n            // Scaling controls\\n            case \u0027q\u0027: case \u0027Q\u0027: // Decrease scale\\n                texScaleFactor \u003d Math.max(0.1, texScaleFactor - 0.05);\\n                break;\\n                \\n            case \u0027e\u0027: case \u0027E\u0027: // Increase scale\\n                texScaleFactor +\u003d 0.05;\\n                break;\\n                \\n            // Rotation controls\\n            case \u0027z\u0027: case \u0027Z\u0027: // Rotate counter-clockwise\\n                texRotationAngle -\u003d 0.05;\\n                break;\\n                \\n            case \u0027c\u0027: case \u0027C\u0027: // Rotate clockwise\\n                texRotationAngle +\u003d 0.05;\\n                break;\\n                \\n            // Reset\\n            case \u0027r\u0027: case \u0027R\u0027: // Reset transformations\\n                texReferencePoint \u003d [0.5, 0.5];\\n                texScaleFactor \u003d 1.0;\\n                texRotationAngle \u003d 0.0;\\n                break;\\n                \\n            default:\\n                needRedraw \u003d false;\\n                break;\\n        }\\n        \\n        // Ensure reference point stays in reasonable bounds\\n        texReferencePoint[0] \u003d Math.max(0.0, Math.min(1.0, texReferencePoint[0]));\\n        texReferencePoint[1] \u003d Math.max(0.0, Math.min(1.0, texReferencePoint[1]));\\n        \\n        // Update the marker position to the new UV coordinates\\n        if (uvMarker) {\\n            uvMarker.updatePosition(texReferencePoint);\\n        }\\n        \\n        // Update UI to display current values\\n        updateTextureControlsDisplay();\\n        \\n        if (needRedraw) {\\n            // Redraw the scene with updated values\\n            requestAnimationFrame(draw);\\n        }\\n    });\\n}\\n\\n/**\\n * Update the display of texture control values\\n */\\nfunction updateTextureControlsDisplay() {\\n    // Update UI elements showing current texture control values\\n    const refPointElem \u003d document.getElementById(\u0027tex-ref-point-value\u0027);\\n    const scaleElem \u003d document.getElementById(\u0027tex-scale-value\u0027);\\n    const rotationElem \u003d document.getElementById(\u0027tex-rotation-value\u0027);\\n    \\n    if (refPointElem) {\\n        refPointElem.textContent \u003d `(${texReferencePoint[0].toFixed(2)}, ${texReferencePoint[1].toFixed(2)})`;\\n    }\\n    \\n    if (scaleElem) {\\n        scaleElem.textContent \u003d texScaleFactor.toFixed(2);\\n    }\\n    \\n    if (rotationElem) {\\n        // Convert to degrees for display\\n        const degrees \u003d (texRotationAngle * 180 / Math.PI).toFixed(1);\\n        rotationElem.textContent \u003d `${degrees}°`;\\n    }\\n}\\n```\\n\\n### 5.3 Draw Function with Texture Transformation Uniforms\\n\\n```javascript\\n/**\\n * Draw function\\n * @param {number} timestamp - Current timestamp from requestAnimationFrame\\n */\\nfunction draw(timestamp) {\\n    // Apply mesh updates if needed\\n    if (meshUpdateNeeded) {\\n        updateMeshFromSliders();\\n        meshUpdateNeeded \u003d false;\\n    }\\n    \\n    gl.clearColor(1, 1, 1, 1);\\n    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);\\n    \\n    // Set up viewport\\n    gl.viewport(0, 0, gl.canvas.width, gl.canvas.height);\\n    \\n    // Create transformation matrices\\n    const aspect \u003d gl.canvas.width/gl.canvas.height;\\n    const projectionMatrix \u003d m4.perspective(Math.PI/3, aspect, 1, 200);\\n    \\n    // Get user rotation from trackball\\n    let modelViewMatrix \u003d spaceball.getViewMatrix();\\n    \\n    // Translate back to see the whole structure\\n    const moveBack \u003d m4.translation(0, 0, -70);\\n    \\n    // Update light position for animation\\n    const lightPosition \u003d updateLightPosition(timestamp);\\n    \\n    // Update light source object position\\n    lightSource.updatePosition(lightPosition);\\n    \\n    // Apply transformations\\n    modelViewMatrix \u003d m4.multiply(moveBack, modelViewMatrix);\\n    \\n    // Calculate the combined model-view-projection matrix\\n    const mvpMatrix \u003d m4.multiply(projectionMatrix, modelViewMatrix);\\n    \\n    // Calculate normal matrix\\n    const normalMatrix \u003d calculateNormalMatrix(modelViewMatrix, new Float32Array(9));\\n    \\n    // Set shader uniforms\\n    gl.uniformMatrix4fv(shProgram.iModelViewProjectionMatrix, false, mvpMatrix);\\n    gl.uniformMatrix4fv(shProgram.iModelViewMatrix, false, modelViewMatrix);\\n    gl.uniformMatrix3fv(shProgram.iNormalMatrix, false, normalMatrix);\\n    gl.uniform3fv(shProgram.iLightPosition, lightPosition);\\n    gl.uniform3fv(shProgram.iLightColor, [1.0, 1.0, 1.0]);\\n    \\n    // Pass texture transformation uniforms\\n    gl.uniform2fv(shProgram.iTexReferencePoint, texReferencePoint);\\n    gl.uniform1f(shProgram.iTexScaleFactor, texScaleFactor);\\n    gl.uniform1f(shProgram.iTexRotationAngle, texRotationAngle);\\n    \\n    // Draw the surface model\\n    surface.draw(shProgram);\\n    \\n    // Draw the light source\\n    lightSource.draw(shProgram, modelViewMatrix, projectionMatrix);\\n    \\n    // Draw the UV reference point marker\\n    if (uvMarker) {\\n        uvMarker.draw(shProgram, modelViewMatrix, projectionMatrix, surface);\\n    }\\n    \\n    // Request next frame for animation\\n    requestAnimationFrame(draw);\\n}\\n```\\n\\n---\\n\\n## Project Author Information\\n\\n**Name:** Pashchenko Mykola  \\n**Group:** TR-51mp  \\n**Course:** WebGL Visualization  \\n**Assignment:** Texture Transformation  \\n**Variant:** 23 (Odd variant - Scaling implementation)\&quot;}&quot;}}]},{&quot;role&quot;:&quot;tool&quot;,&quot;name&quot;:&quot;write&quot;,&quot;tool_call_id&quot;:&quot;toolu_016HXvGqxR7hesAgd78wyPVz&quot;,&quot;content&quot;:&quot;Wrote contents to D:\\PROJECT_ME\\project_SHAME\\INSTITUTKA\\Visualisation\\WebGL2\\README_FOR_EXPORT.md.\n\nWhen you\u0027re done with your current set of changes to this file, you should call the read_lints tool with the specific file path and fix any newly introduced errors.&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;## Document Ready for Export\n\nI\u0027ve created a new file called `README_FOR_EXPORT.md` in your project folder that is formatted specifically for exporting to Word or PDF. Here\u0027s what I\u0027ve done:\n\n### Key Improvements Made:\n\n1. **Professional Document Structure**:\n   - Created a clear table of contents\n   - Maintained consistent heading hierarchy\n   - Improved spacing and formatting for better readability\n\n2. **Enhanced Content Organization**:\n   - Reorganized sections for logical flow\n   - Added section numbers for easier navigation\n   - Created clearer separations between sections\n\n3. **Updated Technical Content**:\n   - Added information about your newly implemented UV marker feature\n   - Updated the shader code example to reflect the fixed implementation (both scaling and rotation)\n   - Included more descriptive explanations of each component\n\n4. **Added Author Information**:\n   - Included your name, group, and course details at the end of the document\n\n### How to Convert to Word or PDF:\n\n1. **Using Word**:\n   - Open Microsoft Word\n   - Choose \&quot;File \u003e Open\&quot; and select the `README_FOR_EXPORT.md` file\n   - Word should automatically convert the Markdown to a formatted document\n   - Adjust any formatting as needed and save as .docx\n\n2. **Using Online Markdown Converters**:\n   - Copy the contents of `README_FOR_EXPORT.md`\n   - Use an online converter like [Pandoc](https://pandoc.org/) or websites like [CloudConvert](https://cloudconvert.com/md-to-pdf)\n   - Download the resulting PDF or Word document\n\n3. **Using Visual Studio Code**:\n   - If you have VSCode, install the \&quot;Markdown PDF\&quot; extension\n   - Open the `README_FOR_EXPORT.md` file\n   - Use the extension to convert directly to PDF or HTML\n\nThe document is now well-structured and ready to be converted to either Word or PDF format, making it suitable for submission as professional documentation for your WebGL project.&quot;}]},{&quot;role&quot;:&quot;user&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;сan you create one more report for the word \nby this plan\na title page;\na chapter describing the task (1 page);\na chapter describing theory (2 pages);\na chapter describing the implementation details (2 pages);\na chapter of user\u0027s instruction with screenshots (2 pages);\na sample of source code (2 pages).\nabout this project \n\ntask was like this^\nOperations on texture coordinates\nScale and rotate a texture around a user specified point.\n\nRequirements\nReuse texture mapping from Control task.\nImplement texture scaling (texture coordinates) scaling / rotation around user specified point- odd variants implement scaling, even variants implement rotation\nIt has to be possible to move the point along the surface (u,v) space using a keyboard. E.g. keys A and D move the point along u parameter and keys W and S move the point along v parameter.&quot;}],&quot;context&quot;:[{&quot;file_path&quot;:&quot;README_FOR_EXPORT.md&quot;,&quot;code_text&quot;:&quot;# WebGL Texture Transformation Project\r\n# Cornucopia Surface with Dynamic Texture Mapping\r\n\r\n---\r\n\r\n## Table of Contents\r\n1. [Task Description](#1-task-description)\r\n2. [Theoretical Background](#2-theoretical-background)\r\n3. [Implementation Details](#3-implementation-details)\r\n4. [User Instructions](#4-user-instructions)\r\n5. [Source Code Samples](#5-source-code-samples)\r\n\r\n---\r\n\r\n## 1. Task Description\r\n\r\n### Operations on Texture Coordinates\r\n\r\nThe task focuses on implementing advanced texture coordinate transformations in WebGL, specifically enabling dynamic manipulation of textures on a parametric surface. The primary objective is to scale or rotate a texture around a user-specified point within the UV space of the texture.\r\n\r\n### Requirements\r\n\r\n1. **Reuse existing functionality**: The implementation must reuse the texture mapping from the previous Control task as a foundation.\r\n\r\n2. **Transformation implementation**: \r\n   - For odd-numbered variants: Implement texture scaling around a user-specified point\r\n   - For even-numbered variants: Implement texture rotation around a user-specified point\r\n\r\n3. **Interactive control**: Enable movement of the reference point within the texture\u0027s (u,v) space using keyboard controls:\r\n   - **A and D keys**: Move the reference point along the u parameter (horizontal)\r\n   - **W and S keys**: Move the reference point along the v parameter (vertical)\r\n\r\n### Technical Focus\r\n\r\nThis task combines several important concepts in computer graphics:\r\n- Texture coordinate manipulation\r\n- Real-time user interaction\r\n- Parametric surface rendering\r\n- Shader-based transformations\r\n\r\nThe implementation should provide a seamless user experience that allows for dynamic visualization of how texture transformations affect the appearance of the 3D parametric surface.\r\n\r\n---\r\n\r\n## 2. Theoretical Background\r\n\r\n### 2.1 Texture Mapping Fundamentals\r\n\r\nTexture mapping is a technique in computer graphics that applies a 2D image (texture) to the surface of a 3D object. The process requires establishing a correspondence between points on the 3D model and locations within the 2D texture space.\r\n\r\n#### Texture Coordinates\r\n\r\nA key concept in texture mapping is the texture coordinate system, typically denoted as (u,v) coordinates:\r\n- The u-coordinate represents the horizontal position within the texture (0 at left, 1 at right)\r\n- The v-coordinate represents the vertical position within the texture (0 at top, 1 at bottom)\r\n\r\nFor parametric surfaces like the Cornucopia model used in this project, there\u0027s a natural mapping between the surface parameters and the texture coordinates, allowing for precise control of texture placement.\r\n\r\n#### Texture Sampling\r\n\r\nWhen rendering, the graphics pipeline performs texture sampling—the process of retrieving color values from a texture based on computed texture coordinates. The quality of this sampling is influenced by:\r\n\r\n- **Filtering modes**: Techniques for interpolating between texture pixels\r\n- **Mipmap levels**: Pre-computed downscaled versions of the texture for different viewing distances\r\n- **Wrapping modes**: How textures behave outside the [0,1] coordinate range\r\n\r\n### 2.2 Texture Transformations in UV Space\r\n\r\nTransforming textures in UV space involves modifying the texture coordinates before they are used to sample the texture. Unlike transforming the 3D object itself, this approach changes only how the texture appears on the surface.\r\n\r\n#### Basic Transformations\r\n\r\nThe fundamental texture transformations include:\r\n- **Translation**: Shifting the texture along the u or v axis\r\n- **Scaling**: Expanding or contracting the texture\r\n- **Rotation**: Rotating the texture around a specified point\r\n\r\n#### Transformation Mathematics\r\n\r\nFor operations like scaling and rotation around a specific point, we follow a three-step process:\r\n\r\n1. **Translate to origin**: Move the reference point to the origin\r\n   ```\r\n   uv\u0027 \u003d uv - reference_point\r\n   ```\r\n\r\n2. **Apply transformation**: Perform the scaling or rotation\r\n   - For scaling:\r\n   ```\r\n   uv\u0027\u0027 \u003d uv\u0027 * scale_factor\r\n   ```\r\n   - For rotation by angle θ:\r\n   ```\r\n   uv\u0027\u0027 \u003d [cos(θ) -sin(θ); sin(θ) cos(θ)] * uv\u0027\r\n   ```\r\n\r\n3. **Translate back**: Return the reference point to its original position\r\n   ```\r\n   uv\u0027\u0027\u0027 \u003d uv\u0027\u0027 + reference_point\r\n   ```\r\n\r\n#### GLSL Implementation\r\n\r\nIn WebGL, these transformations are most efficiently implemented within the vertex shader. The transformed texture coordinates are then interpolated across the triangle and used in the fragment shader for texture sampling.\r\n\r\n### 2.3 Parametric Surface Texturing\r\n\r\nThe Cornucopia surface used in this project is defined by parametric equations, which creates a natural parameterization for texture mapping:\r\n\r\n```\r\nx(u,v) \u003d [e^(mu) + e^(pu)cos(v)]cos(u)\r\ny(u,v) \u003d [e^(mu) + e^(pu)cos(v)]sin(u)\r\nz(u,v) \u003d e^(pu)sin(v)\r\n```\r\n\r\nThis parametric nature allows us to directly map the surface parameters (u,v) to texture coordinates, creating a coherent texture mapping across the entire surface. The challenge lies in implementing transformations that respect this parameterization while providing intuitive controls for the user.\r\n\r\n---\r\n\r\n## 3. Implementation Details\r\n\r\n### 3.1 Architecture Overview\r\n\r\nThe implementation follows a modular architecture with clear separation of concerns:\r\n\r\n- **HTML/CSS**: Provides the user interface and canvas container\r\n- **JavaScript**: Handles initialization, event handling, and scene management\r\n- **WebGL**: Renders the 3D scene with shaders\r\n- **GLSL Shaders**: Implements the core texture transformation logic\r\n\r\n### 3.2 Shader Implementation\r\n\r\nThe texture transformation is implemented primarily in the vertex shader, where texture coordinates are modified before being passed to the fragment shader.\r\n\r\n#### Vertex Shader Transformation Function\r\n\r\n```glsl\r\n// Function to transform texture coordinates based on scaling/rotation\r\nvec2 transformTexCoords(vec2 texCoords, vec2 refPoint, float scale, float angle) {\r\n    // Translate to reference point origin\r\n    vec2 centered \u003d texCoords - refPoint;\r\n    \r\n    // Apply scale and rotation\r\n    float s \u003d sin(angle);\r\n    float c \u003d cos(angle);\r\n    \r\n    // Create rotation matrix\r\n    mat2 rotation \u003d mat2(\r\n        c, -s,\r\n        s, c\r\n    );\r\n    \r\n    // Apply scale or rotation based on variant\r\n    vec2 transformed;\r\n    \r\n    #ifdef ENABLE_ROTATION\r\n        // Apply rotation around reference point\r\n        transformed \u003d rotation * centered;\r\n    #else\r\n        // Apply scaling around reference point\r\n        transformed \u003d centered * scale;\r\n    #endif\r\n    \r\n    // Translate back from reference point\r\n    return transformed + refPoint;\r\n}\r\n```\r\n\r\nThis function encapsulates the three-step transformation process described in the theory section:\r\n1. Translate to origin by subtracting the reference point\r\n2. Apply the appropriate transformation (scaling or rotation)\r\n3. Translate back by adding the reference point\r\n\r\nThe preprocessing directive `#ifdef ENABLE_ROTATION` allows for conditional compilation based on the variant number, ensuring that odd variants implement scaling while even variants implement rotation.\r\n\r\n### 3.3 Reference Point Movement\r\n\r\nThe reference point movement is managed through keyboard event listeners that update the global texture transformation variables:\r\n\r\n```javascript\r\nfunction setupKeyboardControls() {\r\n    document.addEventListener(\u0027keydown\u0027, function(event) {\r\n        let needRedraw \u003d true;\r\n        \r\n        switch(event.key) {\r\n            case \u0027a\u0027: case \u0027A\u0027: // Move reference point left (u-)\r\n                texReferencePoint[0] -\u003d texMoveSpeed;\r\n                break;\r\n                \r\n            case \u0027d\u0027: case \u0027D\u0027: // Move reference point right (u+)\r\n                texReferencePoint[0] +\u003d texMoveSpeed;\r\n                break;\r\n                \r\n            case \u0027w\u0027: case \u0027W\u0027: // Move reference point up (v-)\r\n                texReferencePoint[1] -\u003d texMoveSpeed;\r\n                break;\r\n                \r\n            case \u0027s\u0027: case \u0027S\u0027: // Move reference point down (v+)\r\n                texReferencePoint[1] +\u003d texMoveSpeed;\r\n                break;\r\n            \r\n            // Additional controls for scaling and rotation\r\n            // ...\r\n            \r\n            default:\r\n                needRedraw \u003d false;\r\n                break;\r\n        }\r\n        \r\n        // Ensure reference point stays in valid range\r\n        texReferencePoint[0] \u003d Math.max(0.0, Math.min(1.0, texReferencePoint[0]));\r\n        texReferencePoint[1] \u003d Math.max(0.0, Math.min(1.0, texReferencePoint[1]));\r\n        \r\n        // Update UI display\r\n        updateTextureControlsDisplay();\r\n        \r\n        if (needRedraw) {\r\n            // Request a new frame to see the changes\r\n            requestAnimationFrame(draw);\r\n        }\r\n    });\r\n}\r\n```\r\n\r\nThis implementation ensures that the reference point remains within the valid [0,1] texture coordinate range, and updates the UI to reflect the current values.\r\n\r\n### 3.4 Visual Reference Point Marker\r\n\r\nTo help users understand where the reference point is located on the 3D surface, a visual marker is implemented as a small red sphere that appears directly on the surface at the current UV coordinates:\r\n\r\n```javascript\r\nfunction UVMarker() {\r\n    // Properties\r\n    this.radius \u003d 0.5;\r\n    this.uvCoords \u003d [0.5, 0.5];\r\n    \r\n    // Draw the UV marker\r\n    this.draw \u003d function(shaderProgram, modelViewMatrix, projectionMatrix, surface) {\r\n        // Calculate u and v values from the normalized UV coordinates\r\n        const u \u003d this.uvCoords[0] * (surface.uMax - surface.uMin) + surface.uMin;\r\n        const v \u003d this.uvCoords[1] * (surface.vMax - surface.vMin) + surface.vMin;\r\n        \r\n        // Get the 3D point on the surface at these UV coordinates\r\n        const point \u003d surface.computePoint(u, v);\r\n        \r\n        // Set UV marker material properties (red color to make it stand out)\r\n        gl.uniform3fv(shaderProgram.iMaterialAmbient, [0.4, 0.0, 0.0]);\r\n        gl.uniform3fv(shaderProgram.iMaterialDiffuse, [1.0, 0.0, 0.0]);\r\n        gl.uniform3fv(shaderProgram.iMaterialSpecular, [1.0, 0.3, 0.3]);\r\n        \r\n        // Draw marker sphere at the calculated position\r\n        // ...\r\n    };\r\n}\r\n```\r\n\r\nThis marker provides instant visual feedback about the reference point\u0027s location on the surface, making it much easier for users to understand and control texture transformations.\r\n\r\n### 3.5 Variant Detection\r\n\r\nTo implement the variant-specific behavior (scaling for odd variants, rotation for even variants), the shader compilation process includes variant detection:\r\n\r\n```javascript\r\nfunction createProgram(gl, vertexShaderSource, fragmentShaderSource) {\r\n    // Determine the variant number from the DOM\r\n    let variantNumber \u003d 23; // Default\r\n    \r\n    try {\r\n        // Find variant number in student info section\r\n        const studentInfo \u003d document.querySelector(\&quot;.student-info\&quot;);\r\n        if (studentInfo) {\r\n            const strongElements \u003d studentInfo.querySelectorAll(\&quot;strong\&quot;);\r\n            \r\n            for (let i \u003d 0; i \u003c strongElements.length; i++) {\r\n                if (strongElements[i].textContent.includes(\&quot;Variant\&quot;)) {\r\n                    const variantText \u003d strongElements[i].parentElement.textContent;\r\n                    const match \u003d variantText.match(/Variant.*?(\\d+)/);\r\n                    if (match \u0026\u0026 match[1]) {\r\n                        variantNumber \u003d parseInt(match[1]);\r\n                        console.log(\&quot;Detected variant number:\&quot;, variantNumber);\r\n                        break;\r\n                    }\r\n                }\r\n            }\r\n        }\r\n    } catch (e) {\r\n        console.warn(\&quot;Could not detect variant number, using default:\&quot;, variantNumber);\r\n    }\r\n    \r\n    // Determine whether to use rotation (even) or scaling (odd)\r\n    const useRotation \u003d variantNumber % 2 \u003d\u003d\u003d 0;\r\n    \r\n    // Modify shader source with appropriate #define\r\n    let modifiedVertexSource \u003d vertexShaderSource;\r\n    if (useRotation) {\r\n        modifiedVertexSource \u003d \&quot;#define ENABLE_ROTATION\\n\&quot; + vertexShaderSource;\r\n    }\r\n    \r\n    // Continue with shader compilation...\r\n}\r\n```\r\n\r\nThis approach allows the same codebase to handle both scaling and rotation variants without duplicating code.\r\n\r\n---\r\n\r\n## 4. User Instructions\r\n\r\n### 4.1 Getting Started\r\n\r\nTo work with the texture transformation features, follow these steps:\r\n\r\n1. **Open the application** in a compatible web browser (Chrome, Firefox, or Edge recommended)\r\n\r\n2. **Observe the initial state** of the Cornucopia surface with the default texture mapping\r\n\r\n3. **Note the Texture Transformation panel** directly below the rendering canvas, which displays the current transformation parameters\r\n\r\n4. **Locate the red sphere** on the surface, which indicates the current reference point position for transformations\r\n\r\n### 4.2 Keyboard Controls\r\n\r\nThe texture transformations are controlled entirely through the keyboard:\r\n\r\n#### Reference Point Movement\r\n- **W key**: Move reference point up (decrease v coordinate)\r\n- **S key**: Move reference point down (increase v coordinate)\r\n- **A key**: Move reference point left (decrease u coordinate)\r\n- **D key**: Move reference point right (increase u coordinate)\r\n\r\n#### Transformation Controls\r\n- **Q key**: Decrease scale factor (scaling variant) \r\n- **E key**: Increase scale factor (scaling variant)\r\n- **Z key**: Rotate counter-clockwise (rotation variant)\r\n- **C key**: Rotate clockwise (rotation variant)\r\n\r\n#### Reset Control\r\n- **R key**: Reset all transformation parameters to defaults\r\n\r\n### 4.3 Observing Transformations\r\n\r\nAs you use the keyboard controls, observe how:\r\n\r\n1. The red reference point marker moves across the surface\r\n2. The texture transforms around this reference point\r\n3. The numerical values update in the control panel below the canvas\r\n\r\n### 4.4 Tips for Effective Use\r\n\r\n- **Start with small movements** of the reference point to understand how it affects the transformation\r\n- **Watch the red marker** to understand the relationship between UV coordinates and the 3D surface\r\n- **Observe the parameter values** in the control panel to monitor your changes\r\n- **Use the R key** to reset if the transformation becomes difficult to understand\r\n- **Experiment with different locations** of the reference point to see how it affects the transformation\u0027s appearance\r\n\r\n---\r\n\r\n## 5. Source Code Samples\r\n\r\n### 5.1 Vertex Shader with Texture Transformation\r\n\r\n```glsl\r\n// Vertex shader for Phong shading with normal mapping and texture transformation\r\nattribute vec3 vertex;\r\nattribute vec3 normal;\r\nattribute vec3 tangent;\r\nattribute vec3 bitangent;\r\nattribute vec2 texCoord;\r\n\r\nuniform mat4 ModelViewProjectionMatrix;\r\nuniform mat4 ModelViewMatrix;\r\nuniform mat3 NormalMatrix; // For transforming normals\r\nuniform vec3 lightPosition; // In world space\r\n\r\n// Texture transformation uniforms\r\nuniform vec2 texReferencePoint; // Reference point for transformations (u,v)\r\nuniform float texScaleFactor;   // Scale factor \r\nuniform float texRotationAngle; // Rotation angle in radians\r\n\r\nvarying vec3 fragNormal;\r\nvarying vec3 fragTangent;\r\nvarying vec3 fragBitangent;\r\nvarying vec3 fragPosition;\r\nvarying vec3 fragLightPosition;\r\nvarying vec2 fragTexCoord;\r\n\r\n// Function to transform texture coordinates based on scaling/rotation\r\nvec2 transformTexCoords(vec2 texCoords, vec2 refPoint, float scale, float angle) {\r\n    // Translate to reference point origin\r\n    vec2 centered \u003d texCoords - refPoint;\r\n    \r\n    // First apply scaling around reference point\r\n    vec2 scaled \u003d centered * scale;\r\n    \r\n    #ifdef ENABLE_ROTATION\r\n        // Then apply rotation around reference point if rotation is enabled\r\n        float s \u003d sin(angle);\r\n        float c \u003d cos(angle);\r\n        \r\n        // Create rotation matrix\r\n        mat2 rotation \u003d mat2(\r\n            c, -s,\r\n            s, c\r\n        );\r\n        vec2 transformed \u003d rotation * scaled;\r\n    #else\r\n        // Otherwise just use the scaled coordinates\r\n        vec2 transformed \u003d scaled;\r\n    #endif\r\n    \r\n    // Translate back from reference point\r\n    return transformed + refPoint;\r\n}\r\n\r\nvoid main() {\r\n    // Transform vertex to clip space\r\n    gl_Position \u003d ModelViewProjectionMatrix * vec4(vertex, 1.0);\r\n    \r\n    // Pass transformed normal to fragment shader\r\n    fragNormal \u003d normalize(NormalMatrix * (-normal));\r\n    \r\n    // Transform tangent and bitangent to view space\r\n    fragTangent \u003d normalize(NormalMatrix * tangent);\r\n    fragBitangent \u003d normalize(NormalMatrix * bitangent);\r\n    \r\n    // Pass vertex position in view space for lighting calculations\r\n    fragPosition \u003d vec3(ModelViewMatrix * vec4(vertex, 1.0));\r\n    \r\n    // Pass light position to fragment shader\r\n    fragLightPosition \u003d vec3(ModelViewMatrix * vec4(lightPosition, 1.0));\r\n    \r\n    // Apply texture transformation and pass texture coordinates to fragment shader\r\n    fragTexCoord \u003d transformTexCoords(texCoord, texReferencePoint, \r\n                                     texScaleFactor, texRotationAngle);\r\n}\r\n```\r\n\r\n### 5.2 Keyboard Event Handler Implementation\r\n\r\n```javascript\r\n/**\r\n * Keyboard event handler for texture transformation controls\r\n */\r\nfunction setupKeyboardControls() {\r\n    document.addEventListener(\u0027keydown\u0027, function(event) {\r\n        let needRedraw \u003d true;\r\n        \r\n        switch(event.key) {\r\n            // Reference point movement\r\n            case \u0027a\u0027: case \u0027A\u0027: // Move reference point left (u-)\r\n                texReferencePoint[0] -\u003d texMoveSpeed;\r\n                break;\r\n                \r\n            case \u0027d\u0027: case \u0027D\u0027: // Move reference point right (u+)\r\n                texReferencePoint[0] +\u003d texMoveSpeed;\r\n                break;\r\n                \r\n            case \u0027w\u0027: case \u0027W\u0027: // Move reference point up (v-)\r\n                texReferencePoint[1] -\u003d texMoveSpeed;\r\n                break;\r\n                \r\n            case \u0027s\u0027: case \u0027S\u0027: // Move reference point down (v+)\r\n                texReferencePoint[1] +\u003d texMoveSpeed;\r\n                break;\r\n                \r\n            // Scaling controls\r\n            case \u0027q\u0027: case \u0027Q\u0027: // Decrease scale\r\n                texScaleFactor \u003d Math.max(0.1, texScaleFactor - 0.05);\r\n                break;\r\n                \r\n            case \u0027e\u0027: case \u0027E\u0027: // Increase scale\r\n                texScaleFactor +\u003d 0.05;\r\n                break;\r\n                \r\n            // Rotation controls\r\n            case \u0027z\u0027: case \u0027Z\u0027: // Rotate counter-clockwise\r\n                texRotationAngle -\u003d 0.05;\r\n                break;\r\n                \r\n            case \u0027c\u0027: case \u0027C\u0027: // Rotate clockwise\r\n                texRotationAngle +\u003d 0.05;\r\n                break;\r\n                \r\n            // Reset\r\n            case \u0027r\u0027: case \u0027R\u0027: // Reset transformations\r\n                texReferencePoint \u003d [0.5, 0.5];\r\n                texScaleFactor \u003d 1.0;\r\n                texRotationAngle \u003d 0.0;\r\n                break;\r\n                \r\n            default:\r\n                needRedraw \u003d false;\r\n                break;\r\n        }\r\n        \r\n        // Ensure reference point stays in reasonable bounds\r\n        texReferencePoint[0] \u003d Math.max(0.0, Math.min(1.0, texReferencePoint[0]));\r\n        texReferencePoint[1] \u003d Math.max(0.0, Math.min(1.0, texReferencePoint[1]));\r\n        \r\n        // Update the marker position to the new UV coordinates\r\n        if (uvMarker) {\r\n            uvMarker.updatePosition(texReferencePoint);\r\n        }\r\n        \r\n        // Update UI to display current values\r\n        updateTextureControlsDisplay();\r\n        \r\n        if (needRedraw) {\r\n            // Redraw the scene with updated values\r\n            requestAnimationFrame(draw);\r\n        }\r\n    });\r\n}\r\n\r\n/**\r\n * Update the display of texture control values\r\n */\r\nfunction updateTextureControlsDisplay() {\r\n    // Update UI elements showing current texture control values\r\n    const refPointElem \u003d document.getElementById(\u0027tex-ref-point-value\u0027);\r\n    const scaleElem \u003d document.getElementById(\u0027tex-scale-value\u0027);\r\n    const rotationElem \u003d document.getElementById(\u0027tex-rotation-value\u0027);\r\n    \r\n    if (refPointElem) {\r\n        refPointElem.textContent \u003d `(${texReferencePoint[0].toFixed(2)}, ${texReferencePoint[1].toFixed(2)})`;\r\n    }\r\n    \r\n    if (scaleElem) {\r\n        scaleElem.textContent \u003d texScaleFactor.toFixed(2);\r\n    }\r\n    \r\n    if (rotationElem) {\r\n        // Convert to degrees for display\r\n        const degrees \u003d (texRotationAngle * 180 / Math.PI).toFixed(1);\r\n        rotationElem.textContent \u003d `${degrees}°`;\r\n    }\r\n}\r\n```\r\n\r\n### 5.3 Draw Function with Texture Transformation Uniforms\r\n\r\n```javascript\r\n/**\r\n * Draw function\r\n * @param {number} timestamp - Current timestamp from requestAnimationFrame\r\n */\r\nfunction draw(timestamp) {\r\n    // Apply mesh updates if needed\r\n    if (meshUpdateNeeded) {\r\n        updateMeshFromSliders();\r\n        meshUpdateNeeded \u003d false;\r\n    }\r\n    \r\n    gl.clearColor(1, 1, 1, 1);\r\n    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);\r\n    \r\n    // Set up viewport\r\n    gl.viewport(0, 0, gl.canvas.width, gl.canvas.height);\r\n    \r\n    // Create transformation matrices\r\n    const aspect \u003d gl.canvas.width/gl.canvas.height;\r\n    const projectionMatrix \u003d m4.perspective(Math.PI/3, aspect, 1, 200);\r\n    \r\n    // Get user rotation from trackball\r\n    let modelViewMatrix \u003d spaceball.getViewMatrix();\r\n    \r\n    // Translate back to see the whole structure\r\n    const moveBack \u003d m4.translation(0, 0, -70);\r\n    \r\n    // Update light position for animation\r\n    const lightPosition \u003d updateLightPosition(timestamp);\r\n    \r\n    // Update light source object position\r\n    lightSource.updatePosition(lightPosition);\r\n    \r\n    // Apply transformations\r\n    modelViewMatrix \u003d m4.multiply(moveBack, modelViewMatrix);\r\n    \r\n    // Calculate the combined model-view-projection matrix\r\n    const mvpMatrix \u003d m4.multiply(projectionMatrix, modelViewMatrix);\r\n    \r\n    // Calculate normal matrix\r\n    const normalMatrix \u003d calculateNormalMatrix(modelViewMatrix, new Float32Array(9));\r\n    \r\n    // Set shader uniforms\r\n    gl.uniformMatrix4fv(shProgram.iModelViewProjectionMatrix, false, mvpMatrix);\r\n    gl.uniformMatrix4fv(shProgram.iModelViewMatrix, false, modelViewMatrix);\r\n    gl.uniformMatrix3fv(shProgram.iNormalMatrix, false, normalMatrix);\r\n    gl.uniform3fv(shProgram.iLightPosition, lightPosition);\r\n    gl.uniform3fv(shProgram.iLightColor, [1.0, 1.0, 1.0]);\r\n    \r\n    // Pass texture transformation uniforms\r\n    gl.uniform2fv(shProgram.iTexReferencePoint, texReferencePoint);\r\n    gl.uniform1f(shProgram.iTexScaleFactor, texScaleFactor);\r\n    gl.uniform1f(shProgram.iTexRotationAngle, texRotationAngle);\r\n    \r\n    // Draw the surface model\r\n    surface.draw(shProgram);\r\n    \r\n    // Draw the light source\r\n    lightSource.draw(shProgram, modelViewMatrix, projectionMatrix);\r\n    \r\n    // Draw the UV reference point marker\r\n    if (uvMarker) {\r\n        uvMarker.draw(shProgram, modelViewMatrix, projectionMatrix, surface);\r\n    }\r\n    \r\n    // Request next frame for animation\r\n    requestAnimationFrame(draw);\r\n}\r\n```\r\n\r\n---\r\n\r\n## Project Author Information\r\n\r\n**Name:** Pashchenko Mykola  \r\n**Group:** TR-51mp  \r\n**Course:** WebGL Visualization  \r\n**Assignment:** Texture Transformation  \r\n**Variant:** 23 (Odd variant - Scaling implementation)&quot;,&quot;ranges&quot;:[],&quot;type&quot;:&quot;current_file&quot;},{&quot;file_path&quot;:&quot;README.md&quot;,&quot;code_text&quot;:&quot;# WebGL Texture Transformation Project\r\n\r\n## Cornucopia Surface with Dynamic Texture Mapping\r\n\r\n![Before Transformation](screenShot/screenbefore.png)\r\n\r\n---\r\n\r\n# 1. Task Description\r\n\r\n## Operations on Texture Coordinates\r\n\r\nThe task focuses on implementing advanced texture coordinate transformations in WebGL, specifically enabling dynamic manipulation of textures on a parametric surface. The primary objective is to scale or rotate a texture around a user-specified point within the UV space of the texture.\r\n\r\n### Requirements\r\n\r\n1. **Reuse existing functionality**: The implementation must reuse the texture mapping from the previous Control task as a foundation.\r\n\r\n2. **Transformation implementation**: \r\n   - For odd-numbered variants: Implement texture scaling around a user-specified point\r\n   - For even-numbered variants: Implement texture rotation around a user-specified point\r\n\r\n3. **Interactive control**: Enable movement of the reference point within the texture\u0027s (u,v) space using keyboard controls:\r\n   - **A and D keys**: Move the reference point along the u parameter (horizontal)\r\n   - **W and S keys**: Move the reference point along the v parameter (vertical)\r\n\r\n### Technical Focus\r\n\r\nThis task combines several important concepts in computer graphics:\r\n- Texture coordinate manipulation\r\n- Real-time user interaction\r\n- Parametric surface rendering\r\n- Shader-based transformations\r\n\r\nThe implementation should provide a seamless user experience that allows for dynamic visualization of how texture transformations affect the appearance of the 3D parametric surface.\r\n\r\n---\r\n\r\n# 2. Theoretical Background\r\n\r\n## 2.1 Texture Mapping Fundamentals\r\n\r\nTexture mapping is a technique in computer graphics that applies a 2D image (texture) to the surface of a 3D object. The process requires establishing a correspondence between points on the 3D model and locations within the 2D texture space.\r\n\r\n### Texture Coordinates\r\n\r\nA key concept in texture mapping is the texture coordinate system, typically denoted as (u,v) coordinates:\r\n- The u-coordinate represents the horizontal position within the texture (0 at left, 1 at right)\r\n- The v-coordinate represents the vertical position within the texture (0 at top, 1 at bottom)\r\n\r\nFor parametric surfaces like the Cornucopia model used in this project, there\u0027s a natural mapping between the surface parameters and the texture coordinates, allowing for precise control of texture placement.\r\n\r\n### Texture Sampling\r\n\r\nWhen rendering, the graphics pipeline performs texture sampling—the process of retrieving color values from a texture based on computed texture coordinates. The quality of this sampling is influenced by:\r\n\r\n- **Filtering modes**: Techniques for interpolating between texture pixels\r\n- **Mipmap levels**: Pre-computed downscaled versions of the texture for different viewing distances\r\n- **Wrapping modes**: How textures behave outside the [0,1] coordinate range\r\n\r\n## 2.2 Texture Transformations in UV Space\r\n\r\nTransforming textures in UV space involves modifying the texture coordinates before they are used to sample the texture. Unlike transforming the 3D object itself, this approach changes only how the texture appears on the surface.\r\n\r\n### Basic Transformations\r\n\r\nThe fundamental texture transformations include:\r\n- **Translation**: Shifting the texture along the u or v axis\r\n- **Scaling**: Expanding or contracting the texture\r\n- **Rotation**: Rotating the texture around a specified point\r\n\r\n### Transformation Mathematics\r\n\r\nFor operations like scaling and rotation around a specific point, we follow a three-step process:\r\n\r\n1. **Translate to origin**: Move the reference point to the origin\r\n   ```\r\n   uv\u0027 \u003d uv - reference_point\r\n   ```\r\n\r\n2. **Apply transformation**: Perform the scaling or rotation\r\n   - For scaling:\r\n   ```\r\n   uv\u0027\u0027 \u003d uv\u0027 * scale_factor\r\n   ```\r\n   - For rotation by angle θ:\r\n   ```\r\n   uv\u0027\u0027 \u003d [cos(θ) -sin(θ); sin(θ) cos(θ)] * uv\u0027\r\n   ```\r\n\r\n3. **Translate back**: Return the reference point to its original position\r\n   ```\r\n   uv\u0027\u0027\u0027 \u003d uv\u0027\u0027 + reference_point\r\n   ```\r\n\r\n### GLSL Implementation\r\n\r\nIn WebGL, these transformations are most efficiently implemented within the vertex shader. The transformed texture coordinates are then interpolated across the triangle and used in the fragment shader for texture sampling.\r\n\r\n## 2.3 Parametric Surface Texturing\r\n\r\nThe Cornucopia surface used in this project is defined by parametric equations, which creates a natural parameterization for texture mapping:\r\n\r\n```\r\nx(u,v) \u003d [e^(mu) + e^(pu)cos(v)]cos(u)\r\ny(u,v) \u003d [e^(mu) + e^(pu)cos(v)]sin(u)\r\nz(u,v) \u003d e^(pu)sin(v)\r\n```\r\n\r\nThis parametric nature allows us to directly map the surface parameters (u,v) to texture coordinates, creating a coherent texture mapping across the entire surface. The challenge lies in implementing transformations that respect this parameterization while providing intuitive controls for the user.\r\n\r\n---\r\n\r\n# 3. Implementation Details\r\n\r\n## 3.1 Architecture Overview\r\n\r\nThe implementation follows a modular architecture with clear separation of concerns:\r\n\r\n![After Transformation](screenShot/screenAfter.png)\r\n\r\n- **HTML/CSS**: Provides the user interface and canvas container\r\n- **JavaScript**: Handles initialization, event handling, and scene management\r\n- **WebGL**: Renders the 3D scene with shaders\r\n- **GLSL Shaders**: Implements the core texture transformation logic\r\n\r\n## 3.2 Shader Implementation\r\n\r\nThe texture transformation is implemented primarily in the vertex shader, where texture coordinates are modified before being passed to the fragment shader.\r\n\r\n### Vertex Shader Transformation Function\r\n\r\n```glsl\r\n// Function to transform texture coordinates based on scaling/rotation\r\nvec2 transformTexCoords(vec2 texCoords, vec2 refPoint, float scale, float angle) {\r\n    // Translate to reference point origin\r\n    vec2 centered \u003d texCoords - refPoint;\r\n    \r\n    // Apply scale and rotation\r\n    float s \u003d sin(angle);\r\n    float c \u003d cos(angle);\r\n    \r\n    // Create rotation matrix\r\n    mat2 rotation \u003d mat2(\r\n        c, -s,\r\n        s, c\r\n    );\r\n    \r\n    // Apply scale or rotation based on variant\r\n    vec2 transformed;\r\n    \r\n    #ifdef ENABLE_ROTATION\r\n        // Apply rotation around reference point\r\n        transformed \u003d rotation * centered;\r\n    #else\r\n        // Apply scaling around reference point\r\n        transformed \u003d centered * scale;\r\n    #endif\r\n    \r\n    // Translate back from reference point\r\n    return transformed + refPoint;\r\n}\r\n```\r\n\r\nThis function encapsulates the three-step transformation process described in the theory section:\r\n1. Translate to origin by subtracting the reference point\r\n2. Apply the appropriate transformation (scaling or rotation)\r\n3. Translate back by adding the reference point\r\n\r\nThe preprocessing directive `#ifdef ENABLE_ROTATION` allows for conditional compilation based on the variant number, ensuring that odd variants implement scaling while even variants implement rotation.\r\n\r\n## 3.3 Reference Point Movement\r\n\r\nThe reference point movement is managed through keyboard event listeners that update the global texture transformation variables:\r\n\r\n```javascript\r\nfunction setupKeyboardControls() {\r\n    document.addEventListener(\u0027keydown\u0027, function(event) {\r\n        let needRedraw \u003d true;\r\n        \r\n        switch(event.key) {\r\n            case \u0027a\u0027: case \u0027A\u0027: // Move reference point left (u-)\r\n                texReferencePoint[0] -\u003d texMoveSpeed;\r\n                break;\r\n                \r\n            case \u0027d\u0027: case \u0027D\u0027: // Move reference point right (u+)\r\n                texReferencePoint[0] +\u003d texMoveSpeed;\r\n                break;\r\n                \r\n            case \u0027w\u0027: case \u0027W\u0027: // Move reference point up (v-)\r\n                texReferencePoint[1] -\u003d texMoveSpeed;\r\n                break;\r\n                \r\n            case \u0027s\u0027: case \u0027S\u0027: // Move reference point down (v+)\r\n                texReferencePoint[1] +\u003d texMoveSpeed;\r\n                break;\r\n            \r\n            // Additional controls for scaling and rotation\r\n            // ...\r\n            \r\n            default:\r\n                needRedraw \u003d false;\r\n                break;\r\n        }\r\n        \r\n        // Ensure reference point stays in valid range\r\n        texReferencePoint[0] \u003d Math.max(0.0, Math.min(1.0, texReferencePoint[0]));\r\n        texReferencePoint[1] \u003d Math.max(0.0, Math.min(1.0, texReferencePoint[1]));\r\n        \r\n        // Update UI display\r\n        updateTextureControlsDisplay();\r\n        \r\n        if (needRedraw) {\r\n            // Request a new frame to see the changes\r\n            requestAnimationFrame(draw);\r\n        }\r\n    });\r\n}\r\n```\r\n\r\nThis implementation ensures that the reference point remains within the valid [0,1] texture coordinate range, and updates the UI to reflect the current values.\r\n\r\n## 3.4 Variant Detection\r\n\r\nTo implement the variant-specific behavior (scaling for odd variants, rotation for even variants), the shader compilation process includes variant detection:\r\n\r\n```javascript\r\nfunction createProgram(gl, vertexShaderSource, fragmentShaderSource) {\r\n    // Determine the variant number from the DOM\r\n    let variantNumber \u003d 23; // Default\r\n    \r\n    try {\r\n        // Find variant number in student info section\r\n        const studentInfo \u003d document.querySelector(\&quot;.student-info\&quot;);\r\n        if (studentInfo) {\r\n            const strongElements \u003d studentInfo.querySelectorAll(\&quot;strong\&quot;);\r\n            \r\n            for (let i \u003d 0; i \u003c strongElements.length; i++) {\r\n                if (strongElements[i].textContent.includes(\&quot;Variant\&quot;)) {\r\n                    const variantText \u003d strongElements[i].parentElement.textContent;\r\n                    const match \u003d variantText.match(/Variant.*?(\\d+)/);\r\n                    if (match \u0026\u0026 match[1]) {\r\n                        variantNumber \u003d parseInt(match[1]);\r\n                        console.log(\&quot;Detected variant number:\&quot;, variantNumber);\r\n                        break;\r\n                    }\r\n                }\r\n            }\r\n        }\r\n    } catch (e) {\r\n        console.warn(\&quot;Could not detect variant number, using default:\&quot;, variantNumber);\r\n    }\r\n    \r\n    // Determine whether to use rotation (even) or scaling (odd)\r\n    const useRotation \u003d variantNumber % 2 \u003d\u003d\u003d 0;\r\n    \r\n    // Modify shader source with appropriate #define\r\n    let modifiedVertexSource \u003d vertexShaderSource;\r\n    if (useRotation) {\r\n        modifiedVertexSource \u003d \&quot;#define ENABLE_ROTATION\\n\&quot; + vertexShaderSource;\r\n    }\r\n    \r\n    // Continue with shader compilation...\r\n}\r\n```\r\n\r\nThis approach allows the same codebase to handle both scaling and rotation variants without duplicating code.\r\n\r\n---\r\n\r\n# 4. User Instructions\r\n\r\n## 4.1 Getting Started\r\n\r\nTo work with the texture transformation features, follow these steps:\r\n\r\n1. **Open the application** in a compatible web browser (Chrome, Firefox, or Edge recommended)\r\n\r\n2. **Observe the initial state** of the Cornucopia surface with the default texture mapping\r\n\r\n3. **Note the Texture Transformation panel** directly below the rendering canvas, which displays the current transformation parameters\r\n\r\n## 4.2 Keyboard Controls\r\n\r\nThe texture transformations are controlled entirely through the keyboard:\r\n\r\n### Reference Point Movement\r\n- **W key**: Move reference point up (decrease v coordinate)\r\n- **S key**: Move reference point down (increase v coordinate)\r\n- **A key**: Move reference point left (decrease u coordinate)\r\n- **D key**: Move reference point right (increase u coordinate)\r\n\r\n### Transformation Controls\r\n- **Q key**: Decrease scale factor (scaling variant) \r\n- **E key**: Increase scale factor (scaling variant)\r\n- **Z key**: Rotate counter-clockwise (rotation variant)\r\n- **C key**: Rotate clockwise (rotation variant)\r\n\r\n### Reset Control\r\n- **R key**: Reset all transformation parameters to defaults\r\n\r\n## 4.3 Observing Transformations\r\n\r\nAs you use the keyboard controls, observe how the texture appearance changes on the surface:\r\n\r\n### Before and After Transformation\r\n\r\n1. Before applying texture transformations:\r\n   ![Before Transformation](screenShot/screenbefore.png)\r\n\r\n2. After applying texture transformations:\r\n   ![After Transformation](screenShot/screenAfter.png)\r\n\r\n\r\n## 4.4 Tips for Effective Use\r\n\r\n- **Start with small movements** of the reference point to understand how it affects the transformation\r\n- **Observe the parameter values** in the control panel to monitor your changes\r\n- **Use the R key** to reset if the transformation becomes difficult to understand\r\n- **Experiment with different locations** of the reference point to see how it affects the transformation\u0027s appearance\r\n\r\n---\r\n\r\n# 5. Source Code Samples\r\n\r\n## 5.1 Vertex Shader with Texture Transformation\r\n\r\n```glsl\r\n// Vertex shader for Phong shading with normal mapping and texture transformation\r\nattribute vec3 vertex;\r\nattribute vec3 normal;\r\nattribute vec3 tangent;\r\nattribute vec3 bitangent;\r\nattribute vec2 texCoord;\r\n\r\nuniform mat4 ModelViewProjectionMatrix;\r\nuniform mat4 ModelViewMatrix;\r\nuniform mat3 NormalMatrix; // For transforming normals\r\nuniform vec3 lightPosition; // In world space\r\n\r\n// Texture transformation uniforms\r\nuniform vec2 texReferencePoint; // Reference point for transformations (u,v)\r\nuniform float texScaleFactor;   // Scale factor \r\nuniform float texRotationAngle; // Rotation angle in radians\r\n\r\nvarying vec3 fragNormal;\r\nvarying vec3 fragTangent;\r\nvarying vec3 fragBitangent;\r\nvarying vec3 fragPosition;\r\nvarying vec3 fragLightPosition;\r\nvarying vec2 fragTexCoord;\r\n\r\n// Function to transform texture coordinates based on scaling/rotation\r\nvec2 transformTexCoords(vec2 texCoords, vec2 refPoint, float scale, float angle) {\r\n    // Translate to reference point origin\r\n    vec2 centered \u003d texCoords - refPoint;\r\n    \r\n    // Apply scale and rotation\r\n    float s \u003d sin(angle);\r\n    float c \u003d cos(angle);\r\n    \r\n    // Create rotation matrix\r\n    mat2 rotation \u003d mat2(\r\n        c, -s,\r\n        s, c\r\n    );\r\n    \r\n    // Apply scale or rotation\r\n    vec2 transformed;\r\n    \r\n    #ifdef ENABLE_ROTATION\r\n        // Apply rotation around reference point\r\n        transformed \u003d rotation * centered;\r\n    #else\r\n        // Apply scaling around reference point\r\n        transformed \u003d centered * scale;\r\n    #endif\r\n    \r\n    // Translate back from reference point\r\n    return transformed + refPoint;\r\n}\r\n\r\nvoid main() {\r\n    // Transform vertex to clip space\r\n    gl_Position \u003d ModelViewProjectionMatrix * vec4(vertex, 1.0);\r\n    \r\n    // Pass transformed normal to fragment shader\r\n    fragNormal \u003d normalize(NormalMatrix * (-normal));\r\n    \r\n    // Transform tangent and bitangent to view space\r\n    fragTangent \u003d normalize(NormalMatrix * tangent);\r\n    fragBitangent \u003d normalize(NormalMatrix * bitangent);\r\n    \r\n    // Pass vertex position in view space for lighting calculations\r\n    fragPosition \u003d vec3(ModelViewMatrix * vec4(vertex, 1.0));\r\n    \r\n    // Pass light position to fragment shader\r\n    fragLightPosition \u003d vec3(ModelViewMatrix * vec4(lightPosition, 1.0));\r\n    \r\n    // Apply texture transformation and pass texture coordinates to fragment shader\r\n    fragTexCoord \u003d transformTexCoords(texCoord, texReferencePoint, \r\n                                      texScaleFactor, texRotationAngle);\r\n}\r\n```\r\n\r\n## 5.2 Keyboard Event Handler Implementation\r\n\r\n```javascript\r\n/**\r\n * Keyboard event handler for texture transformation controls\r\n */\r\nfunction setupKeyboardControls() {\r\n    document.addEventListener(\u0027keydown\u0027, function(event) {\r\n        let needRedraw \u003d true;\r\n        \r\n        switch(event.key) {\r\n            // Reference point movement\r\n            case \u0027a\u0027: case \u0027A\u0027: // Move reference point left (u-)\r\n                texReferencePoint[0] -\u003d texMoveSpeed;\r\n                break;\r\n                \r\n            case \u0027d\u0027: case \u0027D\u0027: // Move reference point right (u+)\r\n                texReferencePoint[0] +\u003d texMoveSpeed;\r\n                break;\r\n                \r\n            case \u0027w\u0027: case \u0027W\u0027: // Move reference point up (v-)\r\n                texReferencePoint[1] -\u003d texMoveSpeed;\r\n                break;\r\n                \r\n            case \u0027s\u0027: case \u0027S\u0027: // Move reference point down (v+)\r\n                texReferencePoint[1] +\u003d texMoveSpeed;\r\n                break;\r\n                \r\n            // Scaling controls\r\n            case \u0027q\u0027: case \u0027Q\u0027: // Decrease scale\r\n                texScaleFactor \u003d Math.max(0.1, texScaleFactor - 0.05);\r\n                break;\r\n                \r\n            case \u0027e\u0027: case \u0027E\u0027: // Increase scale\r\n                texScaleFactor +\u003d 0.05;\r\n                break;\r\n                \r\n            // Rotation controls\r\n            case \u0027z\u0027: case \u0027Z\u0027: // Rotate counter-clockwise\r\n                texRotationAngle -\u003d 0.05;\r\n                break;\r\n                \r\n            case \u0027c\u0027: case \u0027C\u0027: // Rotate clockwise\r\n                texRotationAngle +\u003d 0.05;\r\n                break;\r\n                \r\n            // Reset\r\n            case \u0027r\u0027: case \u0027R\u0027: // Reset transformations\r\n                texReferencePoint \u003d [0.5, 0.5];\r\n                texScaleFactor \u003d 1.0;\r\n                texRotationAngle \u003d 0.0;\r\n                break;\r\n                \r\n            default:\r\n                needRedraw \u003d false;\r\n                break;\r\n        }\r\n        \r\n        // Ensure reference point stays in reasonable bounds\r\n        texReferencePoint[0] \u003d Math.max(0.0, Math.min(1.0, texReferencePoint[0]));\r\n        texReferencePoint[1] \u003d Math.max(0.0, Math.min(1.0, texReferencePoint[1]));\r\n        \r\n        // Update UI to display current values\r\n        updateTextureControlsDisplay();\r\n        \r\n        if (needRedraw) {\r\n            // Redraw the scene with updated values\r\n            requestAnimationFrame(draw);\r\n        }\r\n    });\r\n}\r\n\r\n/**\r\n * Update the display of texture control values\r\n */\r\nfunction updateTextureControlsDisplay() {\r\n    // Update UI elements showing current texture control values\r\n    const refPointElem \u003d document.getElementById(\u0027tex-ref-point-value\u0027);\r\n    const scaleElem \u003d document.getElementById(\u0027tex-scale-value\u0027);\r\n    const rotationElem \u003d document.getElementById(\u0027tex-rotation-value\u0027);\r\n    \r\n    if (refPointElem) {\r\n        refPointElem.textContent \u003d `(${texReferencePoint[0].toFixed(2)}, ${texReferencePoint[1].toFixed(2)})`;\r\n    }\r\n    \r\n    if (scaleElem) {\r\n        scaleElem.textContent \u003d texScaleFactor.toFixed(2);\r\n    }\r\n    \r\n    if (rotationElem) {\r\n        // Convert to degrees for display\r\n        const degrees \u003d (texRotationAngle * 180 / Math.PI).toFixed(1);\r\n        rotationElem.textContent \u003d `${degrees}°`;\r\n    }\r\n}\r\n```\r\n\r\n## 5.3 Draw Function with Texture Transformation Uniforms\r\n\r\n```javascript\r\n/**\r\n * Draw function\r\n * @param {number} timestamp - Current timestamp from requestAnimationFrame\r\n */\r\nfunction draw(timestamp) {\r\n    // Apply mesh updates if needed\r\n    if (meshUpdateNeeded) {\r\n        updateMeshFromSliders();\r\n        meshUpdateNeeded \u003d false;\r\n    }\r\n    \r\n    gl.clearColor(1, 1, 1, 1);\r\n    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);\r\n    \r\n    // Set up viewport\r\n    gl.viewport(0, 0, gl.canvas.width, gl.canvas.height);\r\n    \r\n    // Create transformation matrices\r\n    const aspect \u003d gl.canvas.width/gl.canvas.height;\r\n    const projectionMatrix \u003d m4.perspective(Math.PI/3, aspect, 1, 200);\r\n    \r\n    // Get user rotation from trackball\r\n    let modelViewMatrix \u003d spaceball.getViewMatrix();\r\n    \r\n    // Translate back to see the whole structure\r\n    const moveBack \u003d m4.translation(0, 0, -70);\r\n    \r\n    // Update light position for animation\r\n    const lightPosition \u003d updateLightPosition(timestamp);\r\n    \r\n    // Update light source object position\r\n    lightSource.updatePosition(lightPosition);\r\n    \r\n    // Apply transformations\r\n    modelViewMatrix \u003d m4.multiply(moveBack, modelViewMatrix);\r\n    \r\n    // Calculate the combined model-view-projection matrix\r\n    const mvpMatrix \u003d m4.multiply(projectionMatrix, modelViewMatrix);\r\n    \r\n    // Calculate normal matrix\r\n    const normalMatrix \u003d calculateNormalMatrix(modelViewMatrix, new Float32Array(9));\r\n    \r\n    // Set shader uniforms\r\n    gl.uniformMatrix4fv(shProgram.iModelViewProjectionMatrix, false, mvpMatrix);\r\n    gl.uniformMatrix4fv(shProgram.iModelViewMatrix, false, modelViewMatrix);\r\n    gl.uniformMatrix3fv(shProgram.iNormalMatrix, false, normalMatrix);\r\n    gl.uniform3fv(shProgram.iLightPosition, lightPosition);\r\n    gl.uniform3fv(shProgram.iLightColor, [1.0, 1.0, 1.0]);\r\n    \r\n    // Pass texture transformation uniforms\r\n    gl.uniform2fv(shProgram.iTexReferencePoint, texReferencePoint);\r\n    gl.uniform1f(shProgram.iTexScaleFactor, texScaleFactor);\r\n    gl.uniform1f(shProgram.iTexRotationAngle, texRotationAngle);\r\n    \r\n    // Draw the surface model\r\n    surface.draw(shProgram);\r\n    \r\n    // Draw the light source\r\n    lightSource.draw(shProgram, modelViewMatrix, projectionMatrix);\r\n    \r\n    // Request next frame for animation\r\n    requestAnimationFrame(draw);\r\n}\r\n```\r\n\r\n## 5.4 Variant Detection and Shader Compilation\r\n\r\n```javascript\r\n/**\r\n * Create shader program\r\n */\r\nfunction createProgram(gl, vertexShaderSource, fragmentShaderSource) {\r\n    // Determine the variant number\r\n    let variantNumber \u003d 23; // Default to 23\r\n    \r\n    try {\r\n        // Find all strong elements in the student info section\r\n        const studentInfo \u003d document.querySelector(\&quot;.student-info\&quot;);\r\n        if (studentInfo) {\r\n            const strongElements \u003d studentInfo.querySelectorAll(\&quot;strong\&quot;);\r\n            \r\n            // Find the one that contains \&quot;Variant\&quot;\r\n            for (let i \u003d 0; i \u003c strongElements.length; i++) {\r\n                if (strongElements[i].textContent.includes(\&quot;Variant\&quot;)) {\r\n                    // Extract the variant number using regex\r\n                    const variantText \u003d strongElements[i].parentElement.textContent;\r\n                    const match \u003d variantText.match(/Variant.*?(\\d+)/);\r\n                    if (match \u0026\u0026 match[1]) {\r\n                        variantNumber \u003d parseInt(match[1]);\r\n                        console.log(\&quot;Detected variant number:\&quot;, variantNumber);\r\n                        break;\r\n                    }\r\n                }\r\n            }\r\n        }\r\n    } catch (e) {\r\n        console.warn(\&quot;Could not detect variant number, using default:\&quot;, variantNumber);\r\n    }\r\n    \r\n    // Check if we should use rotation (even variant) or scaling (odd variant)\r\n    const useRotation \u003d variantNumber % 2 \u003d\u003d\u003d 0;\r\n    console.log(\&quot;Using \&quot; + (useRotation ? \&quot;ROTATION\&quot; : \&quot;SCALING\&quot;) + \r\n                \&quot; for texture transformation (variant \&quot; + variantNumber + \&quot;)\&quot;);\r\n    \r\n    // Modify the shader source to include the appropriate #define\r\n    let modifiedVertexSource \u003d vertexShaderSource;\r\n    if (useRotation) {\r\n        modifiedVertexSource \u003d \&quot;#define ENABLE_ROTATION\\n\&quot; + vertexShaderSource;\r\n    }\r\n    \r\n    // Create and compile vertex shader\r\n    let vsh \u003d gl.createShader(gl.VERTEX_SHADER);\r\n    gl.shaderSource(vsh, modifiedVertexSource);\r\n    gl.compileShader(vsh);\r\n    if (!gl.getShaderParameter(vsh, gl.COMPILE_STATUS)) {\r\n        throw new Error(\&quot;Error in vertex shader: \&quot; + gl.getShaderInfoLog(vsh));\r\n    }\r\n    \r\n    // Create and compile fragment shader\r\n    let fsh \u003d gl.createShader(gl.FRAGMENT_SHADER);\r\n    gl.shaderSource(fsh, fragmentShaderSource);\r\n    gl.compileShader(fsh);\r\n    if (!gl.getShaderParameter(fsh, gl.COMPILE_STATUS)) {\r\n        throw new Error(\&quot;Error in fragment shader: \&quot; + gl.getShaderInfoLog(fsh));\r\n    }\r\n    \r\n    // Create program and link shaders\r\n    let prog \u003d gl.createProgram();\r\n    gl.attachShader(prog, vsh);\r\n    gl.attachShader(prog, fsh);\r\n    gl.linkProgram(prog);\r\n    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {\r\n        throw new Error(\&quot;Link error in program: \&quot; + gl.getProgramInfoLog(prog));\r\n    }\r\n    \r\n    return prog;\r\n}\r\n```\r\n\r\nThis completes the source code section, providing key examples from the implementation that highlight the texture transformation functionality.&quot;,&quot;timestamp&quot;:1766758918806,&quot;ranges&quot;:[],&quot;type&quot;:&quot;recent_file&quot;},{&quot;mode&quot;:&quot;Write&quot;,&quot;plan_file_path&quot;:&quot;C:\\Users\\Lenovo\\.firebender\\projects\\D:-PROJECT_ME-project_SHAME-INSTITUTKA-Visualisation-WebGL2\\plans\\plan-c14e62.md&quot;,&quot;ranges&quot;:[],&quot;type&quot;:&quot;query_metadata&quot;}]},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;thinking&quot;,&quot;thinking&quot;:&quot;The user wants me to create a more structured report document following a specific plan with designated page counts for each section:\n\n1. Title page\n2. Task description (1 page)\n3. Theory (2 pages)\n4. Implementation details (2 pages)\n5. User\u0027s instructions with screenshots (2 pages)\n6. Sample source code (2 pages)\n\nThis is different from the previous README_FOR_EXPORT.md I created which had a somewhat different structure. I need to create a new document that follows this exact structure and maintains appropriate length for each section as specified.\n\nThe user has also clarified the original task requirements, which I should incorporate:\n- Operations on texture coordinates: scaling/rotating around a user-specified point\n- Reuse texture mapping from Control task\n- Implement texture scaling for odd variants, rotation for even variants\n- Enable movement of the point using keyboard (A/D for u, W/S for v)\n\nI\u0027ll create a new document with these specific requirements in mind.&quot;,&quot;signature&quot;:&quot;ErcBCkgICxgCIkCirjHDLKDLiTuFiDFKmv/SUfNHMNRBGNPxUwjs+BHYgUCi2jjbNgAcyEdL9wpmHvFiAKQG1B/4lDXKbU1QDyzXKAESDFLodF2H63wth0+NxBoM4xfzzhTeD5iZehBKIjAwsv8WN7issrbsxYoVykSjNrlCSy67NmGsXVzfS+EIwIPt+Un2TXOWW+EgubwdyXwqHSARt4iMHFiDj8nWVV41EDgL+r86wZoy8c302SZlGAI\u003d&quot;},{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;I\u0027ll create a new structured report following your specific plan with the designated page counts for each section. This will be formatted for easy conversion to Word.&quot;}],&quot;tool_calls&quot;:[{&quot;id&quot;:&quot;toolu_014xzh9C4Cfqf6PMeLPkHH5z&quot;,&quot;type&quot;:&quot;function&quot;,&quot;function&quot;:{&quot;name&quot;:&quot;write&quot;,&quot;arguments&quot;:&quot;{\&quot;file_path\&quot;: \&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL2/REPORT_FOR_WORD.md\&quot;, \&quot;content\&quot;: \&quot;# WebGL Texture Coordinate Transformation\\n\\n\u003cdiv style\u003d\\\&quot;text-align: center; margin-top: 120px; margin-bottom: 120px;\\\&quot;\u003e\\n    \u003ch1 style\u003d\\\&quot;font-size: 24pt;\\\&quot;\u003eWebGL Texture Transformation Project:\u003c/h1\u003e\\n    \u003ch2 style\u003d\\\&quot;font-size: 20pt;\\\&quot;\u003eCornucopia Surface with Dynamic Texture Mapping\u003c/h2\u003e\\n    \u003cp style\u003d\\\&quot;margin-top: 80px; font-size: 14pt;\\\&quot;\u003eVariant 23: Texture Scaling Implementation\u003c/p\u003e\\n    \u003cp style\u003d\\\&quot;margin-top: 200px; font-size: 14pt;\\\&quot;\u003eAuthor: Pashchenko Mykola\u003c/p\u003e\\n    \u003cp style\u003d\\\&quot;font-size: 14pt;\\\&quot;\u003eGroup: TR-51mp\u003c/p\u003e\\n    \u003cp style\u003d\\\&quot;font-size: 14pt;\\\&quot;\u003eCourse: WebGL Visualization\u003c/p\u003e\\n    \u003cp style\u003d\\\&quot;margin-top: 200px; font-size: 14pt;\\\&quot;\u003e2025\u003c/p\u003e\\n\u003c/div\u003e\\n\\n\u003cdiv style\u003d\\\&quot;page-break-after: always;\\\&quot;\u003e\u003c/div\u003e\\n\\n## 1. Task Description\\n\\n### 1.1. Overview\\n\\nThe assignment focuses on implementing advanced texture coordinate transformations in WebGL, enabling dynamic manipulation of textures on a parametric surface. Specifically, the task requires implementing the ability to scale or rotate a texture around a user-specified point within the texture\u0027s UV coordinate space.\\n\\n### 1.2. Requirements\\n\\n1. **Base Implementation**:\\n   - Reuse the texture mapping implementation from the previous Control task\\n   - Maintain all existing functionality including normal mapping with three textures (diffuse, specular, normal)\\n\\n2. **Transformation Implementation**:\\n   - For odd-numbered variants (including my variant 23): Implement texture scaling around a user-specified reference point\\n   - For even-numbered variants: Implement texture rotation around a user-specified reference point\\n\\n3. **Interactive Controls**:\\n   - Enable movement of the reference point within the texture\u0027s UV coordinate space using keyboard controls:\\n     - **A and D keys**: Move the reference point horizontally (along the U parameter)\\n     - **W and S keys**: Move the reference point vertically (along the V parameter)\\n   - Implement controls for the transformation:\\n     - **Q and E keys**: Decrease/increase the scale factor (for scaling variants)\\n     - **Z and C keys**: Rotate counter-clockwise/clockwise (for rotation variants)\\n     - **R key**: Reset all transformation parameters to default values\\n\\n4. **Visual Feedback**:\\n   - Provide visual feedback showing the current reference point location on the 3D surface\\n   - Display the current transformation values (reference point coordinates, scale factor, rotation angle)\\n\\n### 1.3. Expected Results\\n\\nThe implementation should provide a seamless user experience that allows for dynamic visualization of how texture transformations affect the appearance of the 3D parametric surface. Users should be able to:\\n\\n- Interactively move the reference point across the surface\\n- Apply scaling or rotation transformations centered on this reference point\\n- Observe the effects of these transformations in real-time\\n- Reset the transformations to return to the default state\\n\\nThis task combines several important concepts in computer graphics, including texture coordinate manipulation, real-time user interaction, parametric surface rendering, and shader-based transformations.\\n\\n\u003cdiv style\u003d\\\&quot;page-break-after: always;\\\&quot;\u003e\u003c/div\u003e\\n\\n## 2. Theoretical Background\\n\\n### 2.1. Texture Mapping Fundamentals\\n\\nTexture mapping is a technique in computer graphics that applies a 2D image (texture) to the surface of a 3D object. This process involves establishing a correspondence between points on the 3D model and locations within the 2D texture space.\\n\\n#### 2.1.1. Texture Coordinate System\\n\\nThe texture coordinate system, typically denoted as (u,v) coordinates, is a normalized space where:\\n- The u-coordinate represents the horizontal position within the texture (0 at left, 1 at right)\\n- The v-coordinate represents the vertical position within the texture (0 at top, 1 at bottom)\\n\\nFor parametric surfaces like the Cornucopia model used in this project, there\u0027s a natural mapping between the surface parameters and the texture coordinates, allowing for precise control over texture placement.\\n\\n#### 2.1.2. Texture Sampling Process\\n\\nWhen rendering, the graphics pipeline performs texture sampling—retrieving color values from a texture based on computed texture coordinates. The quality of this sampling depends on:\\n\\n- **Filtering modes**: Techniques for interpolating between texture pixels (texels)\\n- **Mipmap levels**: Pre-computed downscaled versions of the texture for different viewing distances\\n- **Wrapping modes**: How textures behave outside the [0,1] coordinate range (repeat, clamp, mirror)\\n\\n### 2.2. Texture Transformations in UV Space\\n\\nTransforming textures in UV space involves modifying the texture coordinates before they are used to sample the texture. Unlike transforming the 3D object itself, this approach changes only how the texture appears on the surface while preserving the object\u0027s geometry.\\n\\n#### 2.2.1. Transformation Mathematics\\n\\nFor operations like scaling and rotation around a specific point, we follow a three-step process:\\n\\n1. **Translate to origin**: Move the reference point to the origin\\n   ```\\n   uv\u0027 \u003d uv - reference_point\\n   ```\\n\\n2. **Apply transformation**: Perform the scaling or rotation\\n   - For scaling by factor s:\\n   ```\\n   uv\u0027\u0027 \u003d uv\u0027 * s\\n   ```\\n   - For rotation by angle θ:\\n   ```\\n   u\u0027\u0027 \u003d u\u0027 * cos(θ) - v\u0027 * sin(θ)\\n   v\u0027\u0027 \u003d u\u0027 * sin(θ) + v\u0027 * cos(θ)\\n   ```\\n   Or using matrix notation:\\n   ```\\n   uv\u0027\u0027 \u003d [cos(θ) -sin(θ); sin(θ) cos(θ)] * uv\u0027\\n   ```\\n\\n3. **Translate back**: Return the reference point to its original position\\n   ```\\n   uv\u0027\u0027\u0027 \u003d uv\u0027\u0027 + reference_point\\n   ```\\n\\nThis three-step process ensures that the transformation is centered at the user-specified reference point rather than at the origin of the texture coordinate system.\\n\\n### 2.3. Parametric Surfaces and Texture Mapping\\n\\nThe Cornucopia surface used in this project is defined by parametric equations:\\n\\n```\\nx(u,v) \u003d [e^(mu) + e^(pu)cos(v)]cos(u)\\ny(u,v) \u003d [e^(mu) + e^(pu)cos(v)]sin(u)\\nz(u,v) \u003d e^(pu)sin(v)\\n```\\n\\nWhere:\\n- p and m are shape parameters (p \u003d 0.15, m \u003d 0.1)\\n- u is the lengthwise parameter (0 ≤ u ≤ 5π)\\n- v is the cross-section parameter (0 ≤ v ≤ 2π)\\n\\nThis parametric nature creates a natural mapping between the surface parameters (u,v) and texture coordinates, allowing for intuitive texture placement. However, it also presents challenges for texture transformations, as the relationship between UV coordinates and surface points is non-linear.\\n\\n### 2.4. WebGL Implementation Considerations\\n\\nIn WebGL, texture transformations are most efficiently implemented in the vertex shader. The key considerations include:\\n\\n1. **Performance**: Transformations in the vertex shader are interpolated across triangles, making them more efficient than per-fragment calculations.\\n\\n2. **Precision**: Floating-point precision can affect the quality of transformations, especially when scaling factors are very small or large.\\n\\n3. **Conditional Compilation**: GLSL supports preprocessor directives that allow for conditionally compiling different code paths based on variant requirements.\\n\\n4. **Visual Feedback**: Implementing visual indicators for the reference point helps users understand the transformation center.\\n\\n\u003cdiv style\u003d\\\&quot;page-break-after: always;\\\&quot;\u003e\u003c/div\u003e\\n\\n## 3. Implementation Details\\n\\n### 3.1. Architecture Overview\\n\\nThe implementation follows a modular architecture with clear separation of concerns:\\n\\n- **HTML/CSS**: Provides the user interface, canvas container, and control displays\\n- **JavaScript**: Handles initialization, event handling, and scene management\\n- **WebGL**: Renders the 3D scene with advanced shaders\\n- **GLSL Shaders**: Implements the core texture transformation logic\\n\\nThe application consists of several key components:\\n\\n1. **CornucopiaModel**: Generates and renders the parametric surface\\n2. **ShaderProgram**: Manages compilation and uniform setting for GLSL shaders\\n3. **UVMarker**: Provides a visual reference point indicator on the 3D surface\\n4. **Keyboard Controls**: Handles user input for reference point movement and transformation\\n\\n### 3.2. Shader Implementation\\n\\nThe texture transformation is implemented primarily in the vertex shader. The shader receives texture transformation parameters as uniforms and applies them to the texture coordinates before passing them to the fragment shader.\\n\\n#### 3.2.1. Vertex Shader Transformation Function\\n\\nThe key part of the implementation is the `transformTexCoords` function in the vertex shader:\\n\\n```glsl\\n// Function to transform texture coordinates based on scaling/rotation\\nvec2 transformTexCoords(vec2 texCoords, vec2 refPoint, float scale, float angle) {\\n    // Translate to reference point origin\\n    vec2 centered \u003d texCoords - refPoint;\\n    \\n    // First apply scaling around reference point\\n    vec2 scaled \u003d centered * scale;\\n    \\n    #ifdef ENABLE_ROTATION\\n        // Then apply rotation around reference point if rotation is enabled\\n        float s \u003d sin(angle);\\n        float c \u003d cos(angle);\\n        mat2 rotation \u003d mat2(c, -s, s, c);\\n        vec2 transformed \u003d rotation * scaled;\\n    #else\\n        // Otherwise just use the scaled coordinates\\n        vec2 transformed \u003d scaled;\\n    #endif\\n    \\n    // Translate back from reference point\\n    return transformed + refPoint;\\n}\\n```\\n\\nThis function encapsulates the three-step transformation process described in the theory section. The preprocessing directive `#ifdef ENABLE_ROTATION` allows for conditional compilation based on the variant number, ensuring that odd variants implement scaling while even variants implement rotation.\\n\\n### 3.3. Reference Point Visualization\\n\\nA critical addition to the implementation is the visual marker for the reference point. This helps users understand exactly where on the 3D surface the reference point is located, making the transformation behavior more intuitive.\\n\\nThe marker is implemented as a small red sphere that is positioned directly on the surface at the specified UV coordinates:\\n\\n```javascript\\nfunction UVMarker() {\\n    this.radius \u003d 0.5;  // Size of the marker sphere\\n    this.uvCoords \u003d [0.5, 0.5];  // Default UV coordinates\\n    \\n    // Draw the UV marker at the current reference point\\n    this.draw \u003d function(shaderProgram, modelViewMatrix, projectionMatrix, surface) {\\n        // Calculate u and v values from the normalized UV coordinates\\n        const u \u003d this.uvCoords[0] * (surface.uMax - surface.uMin) + surface.uMin;\\n        const v \u003d this.uvCoords[1] * (surface.vMax - surface.vMin) + surface.vMin;\\n        \\n        // Get the 3D point on the surface at these UV coordinates\\n        const point \u003d surface.computePoint(u, v);\\n        \\n        // Set UV marker material properties (red color)\\n        gl.uniform3fv(shaderProgram.iMaterialAmbient, [0.4, 0.0, 0.0]);\\n        gl.uniform3fv(shaderProgram.iMaterialDiffuse, [1.0, 0.0, 0.0]);\\n        gl.uniform3fv(shaderProgram.iMaterialSpecular, [1.0, 0.3, 0.3]);\\n        \\n        // Draw a sphere at the calculated position\\n        // ... (sphere drawing code)\\n    };\\n}\\n```\\n\\nThis visual feedback significantly improves the user experience by providing a clear reference for texture transformations.\\n\\n### 3.4. Keyboard Control Implementation\\n\\nThe keyboard controls are implemented using JavaScript event listeners that update global transformation variables:\\n\\n```javascript\\nfunction setupKeyboardControls() {\\n    document.addEventListener(\u0027keydown\u0027, function(event) {\\n        let needRedraw \u003d true;\\n        \\n        switch(event.key) {\\n            // Reference point movement\\n            case \u0027a\u0027: case \u0027A\u0027: // Move reference point left (u-)\\n                texReferencePoint[0] -\u003d texMoveSpeed;\\n                break;\\n                \\n            case \u0027d\u0027: case \u0027D\u0027: // Move reference point right (u+)\\n                texReferencePoint[0] +\u003d texMoveSpeed;\\n                break;\\n                \\n            case \u0027w\u0027: case \u0027W\u0027: // Move reference point up (v-)\\n                texReferencePoint[1] -\u003d texMoveSpeed;\\n                break;\\n                \\n            case \u0027s\u0027: case \u0027S\u0027: // Move reference point down (v+)\\n                texReferencePoint[1] +\u003d texMoveSpeed;\\n                break;\\n                \\n            // Scaling controls\\n            case \u0027q\u0027: case \u0027Q\u0027: // Decrease scale\\n                texScaleFactor \u003d Math.max(0.1, texScaleFactor - 0.05);\\n                break;\\n                \\n            case \u0027e\u0027: case \u0027E\u0027: // Increase scale\\n                texScaleFactor +\u003d 0.05;\\n                break;\\n                \\n            // ... other controls\\n            \\n            default:\\n                needRedraw \u003d false;\\n                break;\\n        }\\n        \\n        // Ensure reference point stays in bounds\\n        texReferencePoint[0] \u003d Math.max(0.0, Math.min(1.0, texReferencePoint[0]));\\n        texReferencePoint[1] \u003d Math.max(0.0, Math.min(1.0, texReferencePoint[1]));\\n        \\n        // Update marker position\\n        if (uvMarker) {\\n            uvMarker.updatePosition(texReferencePoint);\\n        }\\n        \\n        // Update UI display\\n        updateTextureControlsDisplay();\\n        \\n        // Redraw if needed\\n        if (needRedraw) {\\n            requestAnimationFrame(draw);\\n        }\\n    });\\n}\\n```\\n\\nThis implementation ensures that the reference point remains within the valid [0,1] texture coordinate range, updates both the UI and the visual marker, and triggers a redraw when necessary.\\n\\n### 3.5. Dynamic Variant Detection\\n\\nTo support both scaling and rotation variants with a single codebase, the implementation includes automatic variant detection:\\n\\n```javascript\\n// Determine the variant number\\nlet variantNumber \u003d 23;  // Default to variant 23\\n\\n// Extract actual variant number from the HTML if available\\n// ... (code to extract variant number)\\n\\n// Determine transformation type based on variant number\\nconst useRotation \u003d variantNumber % 2 \u003d\u003d\u003d 0;\\n\\n// Modify shader source with appropriate #define\\nlet modifiedVertexSource \u003d vertexShaderSource;\\nif (useRotation) {\\n    modifiedVertexSource \u003d \\\&quot;#define ENABLE_ROTATION\\\\n\\\&quot; + vertexShaderSource;\\n}\\n```\\n\\nThis approach enables the correct transformation type (scaling for odd variants, rotation for even variants) without duplicating code, making the implementation more maintainable.\\n\\n\u003cdiv style\u003d\\\&quot;page-break-after: always;\\\&quot;\u003e\u003c/div\u003e\\n\\n## 4. User Instructions\\n\\n### 4.1. Getting Started\\n\\nTo use the texture transformation features in the WebGL Cornucopia Surface Visualization:\\n\\n1. **Open the application** in a web browser (Chrome, Firefox, or Edge recommended)\\n2. **Observe the initial state** of the Cornucopia surface with default texture mapping\\n3. **Locate the red reference point marker** on the surface - this indicates the center of transformations\\n4. **Note the control panel** below the canvas displaying current transformation values\\n\\n![Initial Application State](screenShot/screenbefore.png)\\n*Figure 1: Initial state of the application showing the Cornucopia surface with default texture mapping*\\n\\n### 4.2. Navigation and Camera Control\\n\\nBefore applying texture transformations, you may want to adjust your view of the 3D model:\\n\\n- **Click and drag** on the canvas to rotate the model\\n- This allows you to view different parts of the surface and better observe texture transformation effects\\n\\n### 4.3. Texture Transformation Controls\\n\\nAll texture transformations are controlled through the keyboard:\\n\\n#### 4.3.1. Moving the Reference Point\\n\\nThe reference point (shown as a red sphere on the surface) can be moved using these keys:\\n\\n- **W key**: Move reference point up (decrease v coordinate)\\n- **S key**: Move reference point down (increase v coordinate)\\n- **A key**: Move reference point left (decrease u coordinate)\\n- **D key**: Move reference point right (increase u coordinate)\\n\\nAs you move the reference point, observe how the red marker moves across the surface, and note the updated coordinate values in the control panel.\\n\\n![Reference Point Movement](screenShot/refPointMove.png)\\n*Figure 2: Moving the reference point using WASD keys - observe the red marker on the surface*\\n\\n#### 4.3.2. Applying Transformations\\n\\nDepending on your variant, you will have access to either scaling or rotation controls:\\n\\n**For Odd Variants (including Variant 23):**\\n- **Q key**: Decrease scale factor (make texture appear larger)\\n- **E key**: Increase scale factor (make texture appear smaller)\\n\\n**For Even Variants:**\\n- **Z key**: Rotate texture counter-clockwise\\n- **C key**: Rotate texture clockwise\\n\\nThe current transformation values are always displayed in the control panel:\\n- Reference Point: (u, v) coordinates\\n- Scale Factor: Current scaling amount\\n- Rotation: Current rotation angle in degrees\\n\\n#### 4.3.3. Resetting Transformations\\n\\nIf you want to return to the default state:\\n- **R key**: Reset all transformation parameters to their default values\\n  - Reference point returns to (0.5, 0.5)\\n  - Scale factor returns to 1.0\\n  - Rotation angle returns to 0°\\n\\n### 4.4. Observing Transformation Effects\\n\\nAs you apply transformations, observe how the texture appearance changes on the surface:\\n\\n![After Transformation](screenShot/screenAfter.png)\\n*Figure 3: The surface after applying texture transformations - note how the texture pattern has changed*\\n\\nKey things to observe:\\n1. **Center of transformation**: The red reference point indicates where the transformation is centered\\n2. **Texture pattern**: Notice how the texture pattern changes relative to the reference point\\n3. **Parameter values**: Monitor the transformation values in the control panel\\n\\n### 4.5. Tips for Effective Use\\n\\n- **Start with small movements** of the reference point to understand how it affects the transformation\\n- **Try different reference point positions** to see how the transformation center affects the result\\n- **Use the reset function (R key)** if the transformation becomes difficult to understand\\n- **Combine transformations** with different viewing angles to explore the full capabilities\\n- **Watch the texture seams** to understand how the transformations wrap around the parametric surface\\n\\n\u003cdiv style\u003d\\\&quot;page-break-after: always;\\\&quot;\u003e\u003c/div\u003e\\n\\n## 5. Source Code Samples\\n\\n### 5.1. Vertex Shader with Texture Transformation\\n\\n```glsl\\n// Vertex shader for Phong shading with normal mapping and texture transformation\\nattribute vec3 vertex;\\nattribute vec3 normal;\\nattribute vec3 tangent;\\nattribute vec3 bitangent;\\nattribute vec2 texCoord;\\n\\nuniform mat4 ModelViewProjectionMatrix;\\nuniform mat4 ModelViewMatrix;\\nuniform mat3 NormalMatrix;\\nuniform vec3 lightPosition;\\n\\n// Texture transformation uniforms\\nuniform vec2 texReferencePoint; // Reference point for transformations (u,v)\\nuniform float texScaleFactor;   // Scale factor \\nuniform float texRotationAngle; // Rotation angle in radians\\n\\nvarying vec3 fragNormal;\\nvarying vec3 fragTangent;\\nvarying vec3 fragBitangent;\\nvarying vec3 fragPosition;\\nvarying vec3 fragLightPosition;\\nvarying vec2 fragTexCoord;\\n\\n// Function to transform texture coordinates based on scaling/rotation\\nvec2 transformTexCoords(vec2 texCoords, vec2 refPoint, float scale, float angle) {\\n    // Translate to reference point origin\\n    vec2 centered \u003d texCoords - refPoint;\\n    \\n    // First apply scaling around reference point\\n    vec2 scaled \u003d centered * scale;\\n    \\n    #ifdef ENABLE_ROTATION\\n        // Then apply rotation around reference point if rotation is enabled\\n        float s \u003d sin(angle);\\n        float c \u003d cos(angle);\\n        \\n        // Create rotation matrix\\n        mat2 rotation \u003d mat2(\\n            c, -s,\\n            s, c\\n        );\\n        vec2 transformed \u003d rotation * scaled;\\n    #else\\n        // Otherwise just use the scaled coordinates\\n        vec2 transformed \u003d scaled;\\n    #endif\\n    \\n    // Translate back from reference point\\n    return transformed + refPoint;\\n}\\n\\nvoid main() {\\n    // Transform vertex to clip space\\n    gl_Position \u003d ModelViewProjectionMatrix * vec4(vertex, 1.0);\\n    \\n    // Pass transformed normal to fragment shader\\n    fragNormal \u003d normalize(NormalMatrix * (-normal));\\n    \\n    // Transform tangent and bitangent to view space\\n    fragTangent \u003d normalize(NormalMatrix * tangent);\\n    fragBitangent \u003d normalize(NormalMatrix * bitangent);\\n    \\n    // Pass vertex position in view space for lighting calculations\\n    fragPosition \u003d vec3(ModelViewMatrix * vec4(vertex, 1.0));\\n    \\n    // Pass light position to fragment shader\\n    fragLightPosition \u003d vec3(ModelViewMatrix * vec4(lightPosition, 1.0));\\n    \\n    // Apply texture transformation and pass texture coordinates to fragment shader\\n    fragTexCoord \u003d transformTexCoords(texCoord, texReferencePoint, \\n                                     texScaleFactor, texRotationAngle);\\n}\\n```\\n\\n### 5.2. UV Reference Point Marker Implementation\\n\\n```javascript\\n/**\\n * UVMarker class for creating a visible marker at UV coordinates\\n */\\nfunction UVMarker() {\\n    this.vertexBuffer \u003d null;\\n    this.indexBuffer \u003d null;\\n    this.normalBuffer \u003d null;\\n    this.vertices \u003d [];\\n    this.indices \u003d [];\\n    this.normals \u003d [];\\n    this.numVertices \u003d 0;\\n    this.numIndices \u003d 0;\\n    this.position \u003d [0, 0, 0]; // Current position of the marker\\n    this.radius \u003d 0.5; // Size of the marker sphere\\n    this.uvCoords \u003d [0.5, 0.5]; // Default UV coordinates\\n    \\n    /**\\n     * Generate a sphere mesh for the marker\\n     */\\n    this.generateSphere \u003d function() {\\n        // Sphere parameters (simpler than light source)\\n        const segments \u003d 10;\\n        const rings \u003d 10;\\n        \\n        this.vertices \u003d [];\\n        this.indices \u003d [];\\n        this.normals \u003d [];\\n        \\n        // Generate vertices\\n        for (let ring \u003d 0; ring \u003c\u003d rings; ring++) {\\n            const theta \u003d ring * Math.PI / rings;\\n            const sinTheta \u003d Math.sin(theta);\\n            const cosTheta \u003d Math.cos(theta);\\n            \\n            for (let segment \u003d 0; segment \u003c\u003d segments; segment++) {\\n                const phi \u003d segment * 2 * Math.PI / segments;\\n                const sinPhi \u003d Math.sin(phi);\\n                const cosPhi \u003d Math.cos(phi);\\n                \\n                // Vertex position\\n                const x \u003d this.radius * cosPhi * sinTheta;\\n                const y \u003d this.radius * sinPhi * sinTheta;\\n                const z \u003d this.radius * cosTheta;\\n                \\n                // Add vertex to the array\\n                this.vertices.push(x, y, z);\\n                \\n                // Normal vector\\n                this.normals.push(cosPhi * sinTheta, sinPhi * sinTheta, cosTheta);\\n            }\\n        }\\n        \\n        // Generate indices for triangle strips\\n        for (let ring \u003d 0; ring \u003c rings; ring++) {\\n            const ringStart \u003d ring * (segments + 1);\\n            const nextRingStart \u003d (ring + 1) * (segments + 1);\\n            \\n            for (let segment \u003d 0; segment \u003c segments; segment++) {\\n                // Triangle 1\\n                this.indices.push(ringStart + segment);\\n                this.indices.push(nextRingStart + segment);\\n                this.indices.push(ringStart + segment + 1);\\n                \\n                // Triangle 2\\n                this.indices.push(ringStart + segment + 1);\\n                this.indices.push(nextRingStart + segment);\\n                this.indices.push(nextRingStart + segment + 1);\\n            }\\n        }\\n        \\n        this.numVertices \u003d this.vertices.length / 3;\\n        this.numIndices \u003d this.indices.length;\\n    };\\n    \\n    /**\\n     * Update the position of the UV marker based on UV coordinates\\n     */\\n    this.updatePosition \u003d function(uvCoords) {\\n        this.uvCoords \u003d uvCoords;\\n    };\\n    \\n    /**\\n     * Draw the UV marker\\n     */\\n    this.draw \u003d function(shaderProgram, modelViewMatrix, projectionMatrix, surface) {\\n        if (!surface) return; // Safety check\\n        \\n        // Calculate u and v values from the normalized UV coordinates\\n        const u \u003d this.uvCoords[0] * (surface.uMax - surface.uMin) + surface.uMin;\\n        const v \u003d this.uvCoords[1] * (surface.vMax - surface.vMin) + surface.vMin;\\n        \\n        // Get the 3D point on the surface at these UV coordinates\\n        const point \u003d surface.computePoint(u, v);\\n        \\n        // Bind vertex buffer and set attribute pointer\\n        gl.bindBuffer(gl.ARRAY_BUFFER, this.vertexBuffer);\\n        gl.vertexAttribPointer(shaderProgram.iAttribVertex, 3, gl.FLOAT, false, 0, 0);\\n        gl.enableVertexAttribArray(shaderProgram.iAttribVertex);\\n        \\n        // Bind normal buffer and set attribute pointer\\n        gl.bindBuffer(gl.ARRAY_BUFFER, this.normalBuffer);\\n        gl.vertexAttribPointer(shaderProgram.iAttribNormal, 3, gl.FLOAT, false, 0, 0);\\n        gl.enableVertexAttribArray(shaderProgram.iAttribNormal);\\n        \\n        // Bind index buffer\\n        gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, this.indexBuffer);\\n        \\n        // Set UV marker material properties (red color)\\n        gl.uniform3fv(shaderProgram.iMaterialAmbient, [0.4, 0.0, 0.0]);\\n        gl.uniform3fv(shaderProgram.iMaterialDiffuse, [1.0, 0.0, 0.0]);\\n        gl.uniform3fv(shaderProgram.iMaterialSpecular, [1.0, 0.3, 0.3]);\\n        gl.uniform1f(shaderProgram.iShininess, 30.0);\\n        \\n        // Create a model matrix for the marker\\n        const markerModelMatrix \u003d m4.translation(\\n            point.x, \\n            point.y, \\n            point.z\\n        );\\n        \\n        // Save the original model view matrix\\n        const savedModelViewMatrix \u003d new Float32Array(16);\\n        for (let i \u003d 0; i \u003c 16; i++) {\\n            savedModelViewMatrix[i] \u003d modelViewMatrix[i];\\n        }\\n        \\n        // Combine matrices\\n        const markerModelViewMatrix \u003d m4.multiply(modelViewMatrix, markerModelMatrix);\\n        const markerMVP \u003d m4.multiply(projectionMatrix, markerModelViewMatrix);\\n        \\n        // Calculate normal matrix for the marker\\n        const markerNormalMatrix \u003d calculateNormalMatrix(markerModelViewMatrix, new Float32Array(9));\\n        \\n        // Set the new matrices for drawing the marker\\n        gl.uniformMatrix4fv(shaderProgram.iModelViewProjectionMatrix, false, markerMVP);\\n        gl.uniformMatrix4fv(shaderProgram.iModelViewMatrix, false, markerModelViewMatrix);\\n        gl.uniformMatrix3fv(shaderProgram.iNormalMatrix, false, markerNormalMatrix);\\n        \\n        // Draw the marker sphere\\n        gl.drawElements(gl.TRIANGLES, this.numIndices, gl.UNSIGNED_SHORT, 0);\\n        \\n        // Restore the original modelview and normal matrices\\n        gl.uniformMatrix4fv(shaderProgram.iModelViewMatrix, false, savedModelViewMatrix);\\n        const originalNormalMatrix \u003d calculateNormalMatrix(savedModelViewMatrix, new Float32Array(9));\\n        gl.uniformMatrix3fv(shaderProgram.iNormalMatrix, false, originalNormalMatrix);\\n    };\\n}\\n```\\n\\n### 5.3. Keyboard Event Handler Implementation\\n\\n```javascript\\n/**\\n * Keyboard event handler for texture transformation controls\\n */\\nfunction setupKeyboardControls() {\\n    document.addEventListener(\u0027keydown\u0027, function(event) {\\n        let needRedraw \u003d true;\\n        \\n        switch(event.key) {\\n            // Reference point movement\\n            case \u0027a\u0027: case \u0027A\u0027: // Move reference point left (u-)\\n                texReferencePoint[0] -\u003d texMoveSpeed;\\n                break;\\n                \\n            case \u0027d\u0027: case \u0027D\u0027: // Move reference point right (u+)\\n                texReferencePoint[0] +\u003d texMoveSpeed;\\n                break;\\n                \\n            case \u0027w\u0027: case \u0027W\u0027: // Move reference point up (v-)\\n                texReferencePoint[1] -\u003d texMoveSpeed;\\n                break;\\n                \\n            case \u0027s\u0027: case \u0027S\u0027: // Move reference point down (v+)\\n                texReferencePoint[1] +\u003d texMoveSpeed;\\n                break;\\n                \\n            // Scaling controls\\n            case \u0027q\u0027: case \u0027Q\u0027: // Decrease scale\\n                texScaleFactor \u003d Math.max(0.1, texScaleFactor - 0.05);\\n                break;\\n                \\n            case \u0027e\u0027: case \u0027E\u0027: // Increase scale\\n                texScaleFactor +\u003d 0.05;\\n                break;\\n                \\n            // Rotation controls\\n            case \u0027z\u0027: case \u0027Z\u0027: // Rotate counter-clockwise\\n                texRotationAngle -\u003d 0.05;\\n                break;\\n                \\n            case \u0027c\u0027: case \u0027C\u0027: // Rotate clockwise\\n                texRotationAngle +\u003d 0.05;\\n                break;\\n                \\n            // Reset\\n            case \u0027r\u0027: case \u0027R\u0027: // Reset transformations\\n                texReferencePoint \u003d [0.5, 0.5];\\n                texScaleFactor \u003d 1.0;\\n                texRotationAngle \u003d 0.0;\\n                break;\\n                \\n            default:\\n                needRedraw \u003d false;\\n                break;\\n        }\\n        \\n        // Ensure reference point stays in reasonable bounds\\n        texReferencePoint[0] \u003d Math.max(0.0, Math.min(1.0, texReferencePoint[0]));\\n        texReferencePoint[1] \u003d Math.max(0.0, Math.min(1.0, texReferencePoint[1]));\\n        \\n        // Update the marker position to the new UV coordinates\\n        if (uvMarker) {\\n            uvMarker.updatePosition(texReferencePoint);\\n        }\\n        \\n        // Update UI to display current values\\n        updateTextureControlsDisplay();\\n        \\n        if (needRedraw) {\\n            // Redraw the scene with updated values\\n            requestAnimationFrame(draw);\\n        }\\n    });\\n}\\n\\n/**\\n * Update the display of texture control values\\n */\\nfunction updateTextureControlsDisplay() {\\n    // Update UI elements showing current texture control values\\n    const refPointElem \u003d document.getElementById(\u0027tex-ref-point-value\u0027);\\n    const scaleElem \u003d document.getElementById(\u0027tex-scale-value\u0027);\\n    const rotationElem \u003d document.getElementById(\u0027tex-rotation-value\u0027);\\n    \\n    if (refPointElem) {\\n        refPointElem.textContent \u003d `(${texReferencePoint[0].toFixed(2)}, ${texReferencePoint[1].toFixed(2)})`;\\n    }\\n    \\n    if (scaleElem) {\\n        scaleElem.textContent \u003d texScaleFactor.toFixed(2);\\n    }\\n    \\n    if (rotationElem) {\\n        // Convert to degrees for display\\n        const degrees \u003d (texRotationAngle * 180 / Math.PI).toFixed(1);\\n        rotationElem.textContent \u003d `${degrees}°`;\\n    }\\n}\\n```\&quot;}&quot;}}]},{&quot;role&quot;:&quot;tool&quot;,&quot;name&quot;:&quot;write&quot;,&quot;tool_call_id&quot;:&quot;toolu_014xzh9C4Cfqf6PMeLPkHH5z&quot;,&quot;content&quot;:&quot;Wrote contents to D:\\PROJECT_ME\\project_SHAME\\INSTITUTKA\\Visualisation\\WebGL2\\REPORT_FOR_WORD.md.\n\nWhen you\u0027re done with your current set of changes to this file, you should call the read_lints tool with the specific file path and fix any newly introduced errors.&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;I\u0027ve created a formal report document following your specified structure in the file `REPORT_FOR_WORD.md`. This document is specifically designed for conversion to Word format with appropriate page breaks and content length for each section.\n\n## About the New Report\n\nThe report follows your exact requirements:\n\n1. **Title Page**: Includes project title, variant information, and author details\n   - Formatted with centered text and appropriate spacing\n\n2. **Task Description (1 page)**:\n   - Clear explanation of the assignment requirements\n   - Structured with subsections for clarity\n   - Focuses specifically on texture coordinate operations\n\n3. **Theoretical Background (2 pages)**:\n   - Covers texture mapping fundamentals\n   - Explains transformation mathematics\n   - Details the parametric surface equations\n   - Discusses WebGL implementation considerations\n\n4. **Implementation Details (2 pages)**:\n   - Architecture overview\n   - Shader