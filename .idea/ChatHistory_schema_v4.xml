t\u003e\r\n    \u003cscript src\u003d\&quot;./cornucopia3.js\&quot;\u003e\u003c/script\u003e\r\n        \r\n    \u003cscript\u003e\r\n        // Add event listener for the refresh button after the page loads\r\n        window.addEventListener(\u0027load\u0027, function() {\r\n            const refreshButton \u003d document.getElementById(\u0027refresh-button\u0027);\r\n            const paramP \u003d document.getElementById(\u0027param-p\u0027);\r\n            const paramM \u003d document.getElementById(\u0027param-m\u0027);\r\n            const paramU \u003d document.getElementById(\u0027param-u\u0027);\r\n            const paramV \u003d document.getElementById(\u0027param-v\u0027);\r\n            \r\n            // Set initial values directly from the mathematical definition\r\n            // These values match exactly what\u0027s shown in the Mathematical Definition section\r\n            paramP.value \u003d 0.15; // p \u003d 0.15\r\n            paramM.value \u003d 0.1;  // m \u003d 0.1\r\n            paramU.value \u003d 5;    // u ≤ 5π\r\n            paramV.value \u003d 2;    // v ≤ 2π\r\n            \r\n            // Also ensure the model uses these exact values\r\n            setTimeout(function() {\r\n                if (surface) {\r\n                    // Verify that the model parameters match the HTML definition\r\n                    if (surface.p !\u003d 0.15 || surface.m !\u003d 0.1 || \r\n                        surface.uMax !\u003d 5 * Math.PI || surface.vMax !\u003d 2 * Math.PI) {\r\n                        console.log(\&quot;Correcting model parameters to match Mathematical Definition\&quot;);\r\n                        surface.p \u003d 0.15;\r\n                        surface.m \u003d 0.1;\r\n                        surface.uMax \u003d 5 * Math.PI;\r\n                        surface.vMax \u003d 2 * Math.PI;\r\n                        surface.initialize();\r\n                        draw();\r\n                    }\r\n                }\r\n            }, 500);\r\n            \r\n            if (refreshButton) {\r\n                refreshButton.addEventListener(\u0027click\u0027, function() {\r\n                    // Get values from inputs\r\n                    if (surface) {\r\n                        // Update parameters\r\n                        surface.p \u003d parseFloat(paramP.value);\r\n                        surface.m \u003d parseFloat(paramM.value);\r\n                        surface.uMax \u003d parseFloat(paramU.value) * Math.PI;\r\n                        surface.vMax \u003d parseFloat(paramV.value) * Math.PI;\r\n                        \r\n                        console.log(\&quot;Applying new parameters:\&quot;);\r\n                        console.log(\&quot;p \u003d\&quot;, surface.p, \&quot;m \u003d\&quot;, surface.m, \&quot;uMax \u003d\&quot;, surface.uMax/Math.PI + \&quot;π\&quot;, \&quot;vMax \u003d\&quot;, surface.vMax/Math.PI + \&quot;π\&quot;);\r\n                        \r\n                        // Update formula display in the info panel\r\n                        const mathFormula \u003d document.querySelector(\u0027.math-formula\u0027);\r\n                        if (mathFormula) {\r\n                            // Find the part after the parametric equations\r\n                            const whereSection \u003d mathFormula.innerHTML.split(\u0027\u003cstrong\u003eWhere:\u003c/strong\u003e\u0027);\r\n                            if (whereSection.length \u003e 1) {\r\n                                mathFormula.innerHTML \u003d whereSection[0] + \r\n                                    \u0027\u003cstrong\u003eWhere:\u003c/strong\u003e\u003cbr\u003e\u0027 +\r\n                                    \u0027- p \u003d \u0027 + surface.p + \u0027 (parameter p)\u003cbr\u003e\u0027 +\r\n                                    \u0027- m \u003d \u0027 + surface.m + \u0027 (parameter m)\u003cbr\u003e\u0027 +\r\n                                    \u0027- 0 ≤ u ≤ \u0027 + (surface.uMax/Math.PI) + \u0027π (lengthwise parameter)\u003cbr\u003e\u0027 +\r\n                                    \u0027- 0 ≤ v ≤ \u0027 + (surface.vMax/Math.PI) + \u0027π (cross-section parameter)\u0027;\r\n                            }\r\n                        }\r\n                        \r\n                        // Reinitialize the model\r\n                        surface.initialize();\r\n                        \r\n                        // Redraw\r\n                        draw();\r\n                        \r\n                        console.log(\&quot;Model updated with new parameters!\&quot;);\r\n                        \r\n                        // Flash confirmation message\r\n                        const button \u003d document.getElementById(\u0027refresh-button\u0027);\r\n                        button.textContent \u003d \&quot;Parameters Applied!\&quot;;\r\n                        button.style.backgroundColor \u003d \&quot;#00ff99\&quot;;\r\n                        setTimeout(function() {\r\n                            button.textContent \u003d \&quot;Apply Parameters\&quot;;\r\n                            button.style.backgroundColor \u003d \&quot;#0f0\&quot;;\r\n                        }, 1500);\r\n                    }\r\n                });\r\n            }\r\n        });\r\n    \u003c/script\u003e\r\n\u003c/head\u003e\r\n\u003cbody onload\u003d\&quot;init()\&quot;\u003e\r\n    \u003cdiv class\u003d\&quot;container\&quot;\u003e\r\n        \u003ch1\u003eCornucopia Surface - WebGL Visualization with Phong Shading\u003c/h1\u003e\r\n        \r\n        \u003cdiv class\u003d\&quot;info-panel\&quot;\u003e\r\n            \u003ch2\u003eProject Description\u003c/h2\u003e\r\n            \u003cp\u003eThis visualization demonstrates a 3D model of a \&quot;Cornucopia\&quot; surface rendered using WebGL with Phong shading and Facet Average normal calculation.\u003c/p\u003e\r\n            \u003cp\u003eThe Cornucopia is a special case of a spiral-shaped surface \&quot;Shell without vertex\&quot;. It\u0027s a cyclic surface with generatrix circles of variable radius that creates the distinctive horn-like shape.\u003c/p\u003e\r\n            \r\n            \u003ch2\u003eMathematical Definition\u003c/h2\u003e\r\n            \u003cp\u003eThe Cornucopia surface is defined by the following parametric equations:\u003c/p\u003e\r\n            \r\n            \u003cdiv class\u003d\&quot;math-formula\&quot;\u003e\r\n                \u003cstrong\u003eParametric Equations:\u003c/strong\u003e\u003cbr\u003e\r\n                x(u,v) \u003d [e\u003csup\u003emu\u003c/sup\u003e + e\u003csup\u003epu\u003c/sup\u003ecos(v)]cos(u)\u003cbr\u003e\r\n                y(u,v) \u003d [e\u003csup\u003emu\u003c/sup\u003e + e\u003csup\u003epu\u003c/sup\u003ecos(v)]sin(u)\u003cbr\u003e\r\n                z(u,v) \u003d e\u003csup\u003epu\u003c/sup\u003esin(v)\u003cbr\u003e\u003cbr\u003e\r\n                \r\n                \u003cstrong\u003eWhere:\u003c/strong\u003e\u003cbr\u003e\r\n                - p \u003d 0.15 (parameter p)\u003cbr\u003e\r\n                - m \u003d 0.1 (parameter m)\u003cbr\u003e\r\n                - 0 ≤ u ≤ 5π (lengthwise parameter)\u003cbr\u003e\r\n                - 0 ≤ v ≤ 2π (cross-section parameter)\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv id\u003d\&quot;canvas-holder\&quot;\u003e\r\n            \u003ccanvas width\u003d\&quot;800\&quot; height\u003d\&quot;600\&quot; id\u003d\&quot;webglcanvas\&quot; style\u003d\&quot;background-color:black\&quot;\u003e\u003c/canvas\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv class\u003d\&quot;controls-panel\&quot;\u003e\r\n            \u003ch3\u003eSurface Parameters\u003c/h3\u003e\r\n            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\r\n                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-p\&quot;\u003ep value:\u003c/label\u003e\r\n                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-p\&quot; value\u003d\&quot;0.15\&quot; step\u003d\&quot;0.01\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\r\n                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-m\&quot;\u003em value:\u003c/label\u003e\r\n                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-m\&quot; value\u003d\&quot;0.1\&quot; step\u003d\&quot;0.01\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\r\n                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-u\&quot;\u003eu max (π):\u003c/label\u003e\r\n                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-u\&quot; value\u003d\&quot;5\&quot; step\u003d\&quot;0.5\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\r\n                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-v\&quot;\u003ev max (π):\u003c/label\u003e\r\n                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-v\&quot; value\u003d\&quot;2\&quot; step\u003d\&quot;0.5\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\r\n            \u003c/div\u003e\r\n            \r\n            \u003cbutton id\u003d\&quot;refresh-button\&quot; style\u003d\&quot;margin-top: 10px; padding: 8px 16px; background-color: #0f0; color: black; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;\&quot;\u003eApply Parameters\u003c/button\u003e\r\n            \r\n            \u003chr style\u003d\&quot;border-color: #333; margin: 20px 0;\&quot;\u003e\r\n            \r\n            \u003ch3\u003eMesh Granularity\u003c/h3\u003e\r\n            \u003cdiv class\u003d\&quot;slider-container\&quot;\u003e\r\n                \u003cspan class\u003d\&quot;slider-label\&quot;\u003eU Segments:\u003c/span\u003e\r\n                \u003cinput type\u003d\&quot;range\&quot; min\u003d\&quot;10\&quot; max\u003d\&quot;200\&quot; value\u003d\&quot;80\&quot; class\u003d\&quot;slider\&quot; id\u003d\&quot;u-granularity\&quot;\u003e\r\n                \u003cspan class\u003d\&quot;slider-value\&quot; id\u003d\&quot;u-gran-value\&quot;\u003e80\u003c/span\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class\u003d\&quot;slider-container\&quot;\u003e\r\n                \u003cspan class\u003d\&quot;slider-label\&quot;\u003eV Segments:\u003c/span\u003e\r\n                \u003cinput type\u003d\&quot;range\&quot; min\u003d\&quot;10\&quot; max\u003d\&quot;100\&quot; value\u003d\&quot;40\&quot; class\u003d\&quot;slider\&quot; id\u003d\&quot;v-granularity\&quot;\u003e\r\n                \u003cspan class\u003d\&quot;slider-value\&quot; id\u003d\&quot;v-gran-value\&quot;\u003e40\u003c/span\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv class\u003d\&quot;info-panel\&quot;\u003e\r\n            \u003ch2\u003eImplementation Details\u003c/h2\u003e\r\n            \u003cp\u003eThis implementation includes:\u003c/p\u003e\r\n            \u003cul\u003e\r\n                \u003cli\u003e\u003cstrong\u003ePhong Shading:\u003c/strong\u003e Realistic lighting with ambient, diffuse, and specular components\u003c/li\u003e\r\n                \u003cli\u003e\u003cstrong\u003eFacet Average Normal:\u003c/strong\u003e Normals are calculated by averaging adjacent facet normals\u003c/li\u003e\r\n                \u003cli\u003e\u003cstrong\u003eRotating Light Source:\u003c/strong\u003e A moving light that circles around the model\u003c/li\u003e\r\n                \u003cli\u003e\u003cstrong\u003eTriangle Mesh:\u003c/strong\u003e The surface is rendered with filled triangles using VBO with indices\u003c/li\u003e\r\n                \u003cli\u003e\u003cstrong\u003eAdjustable Granularity:\u003c/strong\u003e U and V segment sliders allow controlling the mesh density\u003c/li\u003e\r\n            \u003c/ul\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv class\u003d\&quot;student-info\&quot;\u003e\r\n            \u003ch2\u003eStudent Information\u003c/h2\u003e\r\n            \u003cp\u003e\u003cstrong\u003eName:\u003c/strong\u003e Pashchenko Mykola\u003c/p\u003e\r\n            \u003cp\u003e\u003cstrong\u003eGroup:\u003c/strong\u003e TR-51mp\u003c/p\u003e\r\n            \u003cp\u003e\u003cstrong\u003eCourse:\u003c/strong\u003e WebGL Visualization\u003c/p\u003e\r\n            \u003cp\u003e\u003cstrong\u003eAssignment:\u003c/strong\u003e PA#2 - Cornucopia Surface with Phong Shading\u003c/p\u003e\r\n            \u003cp\u003e\u003cstrong\u003eVariant:\u003c/strong\u003e 23 (Phong Shading, Facet Average Normals)\u003c/p\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv class\u003d\&quot;footer\&quot;\u003e\r\n            \u003cp\u003eInteractive WebGL Visualization - Created using JavaScript and WebGL\u003c/p\u003e\r\n            \u003cp\u003eDrag your mouse on the model to rotate it. On a touch screen, you can use your finger.\u003c/p\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n\u003c/body\u003e\r\n\u003c/html\u003e&quot;,&quot;timestamp&quot;:1766676322978,&quot;ranges&quot;:[],&quot;type&quot;:&quot;recent_file&quot;},{&quot;file_path&quot;:&quot;README.md&quot;,&quot;code_text&quot;:&quot;# Enhanced Cornucopia Surface WebGL Visualization\r\n\r\nThis project implements a WebGL visualization of an enhanced Cornucopia surface with pronounced curl, rendered as a wireframe model with two sets of polylines (U-lines and V-lines).\r\n\r\n## Surface Definition\r\n\r\nThe Cornucopia surface is a special case of a spiral-shaped surface \&quot;Shell without vertex\&quot;. It is a cyclic surface with generatrix circles of variable radius. Our enhanced version uses modified parameters and additional transformations to create a more dramatic spiral effect:\r\n\r\nBase equation: R(u) \u003d e^(pu)\r\n\r\nParameters (matching reference image):\r\n- p \u003d 0.1 (standard parameter as shown in reference)\r\n- m \u003d 0.2 (standard parameter as shown in reference)\r\n- 0 ≤ u ≤ 4π (expanded range for complete disk-like spiral)\r\n- 0 ≤ v ≤ 2π\r\n\r\nVisualization features:\r\n- Rainbow color gradient matching the reference image\r\n- Grid-like wireframe appearance with clear U and V lines\r\n- Flat, disk-like spiral structure\r\n- Higher resolution sampling with 80×60 grid for smooth appearance\r\n- Optimized camera angle to match the reference image view\r\n\r\n## Implementation Details\r\n\r\nThe implementation uses WebGL for rendering and consists of the following components:\r\n\r\n1. **Model Object**: The `CornucopiaModel` object in `model.js` contains the implementation of:\r\n   - Parametric equations for the Cornucopia surface\r\n   - Functions to generate vertices for U-polylines (constant v, varying u)\r\n   - Functions to generate vertices for V-polylines (constant u, varying v)\r\n   - Drawing function that renders both sets of polylines\r\n\r\n2. **Data Structure**:\r\n   - U-polylines: Represent circles in the v-direction at fixed u values\r\n   - V-polylines: Represent spiral curves in the u-direction at fixed v values\r\n   - Both sets of polylines are stored in separate WebGL buffers\r\n\r\n## How to Launch\r\n\r\n1. Clone or download the repository\r\n2. Open the `index.html` file in a modern web browser that supports WebGL\r\n3. You should see the Cornucopia surface rendered as a wireframe\r\n4. Use mouse drag (or touch on touchscreens) to rotate the model\r\n\r\n## Controls\r\n\r\n- **Mouse Drag**: Rotate the model\r\n- **Touch and Drag**: Rotate the model (on touch-enabled devices)\r\n\r\n## Technical Requirements\r\n\r\n- A modern web browser with WebGL support (Chrome, Firefox, Edge, Safari)\r\n- JavaScript enabled\r\n\r\n## File Structure\r\n\r\n- `index.html`: Main HTML file\r\n- `main.js`: WebGL initialization and main drawing loop\r\n- `model.js`: Cornucopia model implementation with parametric equations\r\n- `shader.gpu`: Vertex and fragment shaders\r\n- `Utils/`: Helper utilities\r\n  - `m4.js`: Matrix operations for 3D transformations\r\n  - `trackball-rotator.js`: Mouse rotation implementation\r\n\r\n## Task Description\r\n\r\nThis project was created as a part of a practical assignment to render a wireframe model of an analytical surface using WebGL. The Cornucopia surface was chosen as the specific variant.\r\n\r\nThe implementation draws the surface wireframe as two sets of vertices:\r\n- A set of U polylines (with constant v parameter)\r\n- A set of V polylines (with constant u parameter)&quot;,&quot;timestamp&quot;:1766676316488,&quot;ranges&quot;:[],&quot;type&quot;:&quot;recent_file&quot;},{&quot;mode&quot;:&quot;Write&quot;,&quot;plan_file_path&quot;:&quot;C:\\Users\\Lenovo\\.firebender\\projects\\D:-PROJECT_ME-project_SHAME-INSTITUTKA-Visualisation-WebGL2\\plans\\plan-ceee66.md&quot;,&quot;ranges&quot;:[],&quot;type&quot;:&quot;query_metadata&quot;}]},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;thinking&quot;,&quot;thinking&quot;:&quot;Let me examine the issue with the U and V segment sliders not causing any changes. The problem might be that we\u0027ve set up the UI elements, but the event listeners for the granularity sliders may not be properly connected to the WebGL rendering.\n\nI\u0027ll check the current implementation in the index.html file and the cornucopia3.js file to see what might be wrong with the event handlers for the sliders.&quot;,&quot;signature&quot;:&quot;ErcBCkgICxgCIkDyXlds+jgn7j4GLm1o8s336I9ECxYCkCuna0DcA2/7LYVvsth1HCU18uhdtqQIXv4fNO+fLM9GQIou6/in+BrQKAESDOXmORBipy5IyG+KDRoMvChMXx9ryfvRk00uIjCNEKkIogLQPVSYKIlcBQ9ZADXk9rpParXQEqKV/Ys0IgU32iQlyzcWBOEZ+u8nsX0qHS+KwmOOkrVOAEUzkgnexxR6jzGAkoE6Yllq1ab3GAI\u003d&quot;},{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;I\u0027ll check why the U and V segment sliders aren\u0027t working. Let me examine the event listeners and make sure they\u0027re properly connected to the rendering code.&quot;}],&quot;tool_calls&quot;:[{&quot;id&quot;:&quot;toolu_01JkUGUQRdyUYhJLMqtdHWAo&quot;,&quot;type&quot;:&quot;function&quot;,&quot;function&quot;:{&quot;name&quot;:&quot;read_file&quot;,&quot;arguments&quot;:&quot;{\&quot;target_file\&quot;: \&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL2/cornucopia3.js\&quot;}&quot;}}]},{&quot;role&quot;:&quot;tool&quot;,&quot;name&quot;:&quot;read&quot;,&quot;tool_call_id&quot;:&quot;toolu_01JkUGUQRdyUYhJLMqtdHWAo&quot;,&quot;content&quot;:&quot;  1|\u0027use strict\u0027;\n  2|\n  3|/**\n  4| * Cornucopia Surface - Parametric Surface Implementation with Phong Shading\n  5| * \n  6| * Parameters:\n  7| * p \u003d 0.15; m \u003d 0.1\n  8| * 0 ≤ u ≤ 5π; 0 ≤ v ≤ 2π\n  9| * \n 10| * Parametric equations:\n 11| * x(u,v) \u003d [e^(mu) + e^(pu)cos(v)]cos(u)\n 12| * y(u,v) \u003d [e^(mu) + e^(pu)cos(v)]sin(u)\n 13| * z(u,v) \u003d e^(pu)sin(v)\n 14| */\n 15|\n 16|// Global variables\n 17|let gl;                 // WebGL context\n 18|let surface;            // Cornucopia surface model\n 19|let shProgram;          // Shader program\n 20|let spaceball;          // Trackball rotator\n 21|let lightAngle \u003d 0;     // Angle for rotating light\n 22|let lightRadius \u003d 60;   // Distance of light from origin\n 23|\n 24|/**\n 25| * CornucopiaModel class to create and render the surface\n 26| */\n 27|function CornucopiaModel() {\n 28|    // Surface parameters - exactly as shown in Fig. 2\n 29|    this.p \u003d 0.15;\n 30|    this.m \u003d 0.1;\n 31|    this.uMin \u003d 0;\n 32|    this.uMax \u003d 5 * Math.PI;\n 33|    this.vMin \u003d 0;\n 34|    this.vMax \u003d 2 * Math.PI;\n 35|    \n 36|    // Number of segments for the grid (adjustable via sliders)\n 37|    this.uSegments \u003d 80;\n 38|    this.vSegments \u003d 40;\n 39|    \n 40|    // Buffers for the triangular mesh\n 41|    this.vertexBuffer \u003d null;\n 42|    this.normalBuffer \u003d null;\n 43|    this.indexBuffer \u003d null;\n 44|    this.numVertices \u003d 0;\n 45|    this.numIndices \u003d 0;\n 46|\n 47|    // Array to store vertex positions for normal calculation\n 48|    this.vertices \u003d [];\n 49|    this.normals \u003d [];\n 50|    this.indices \u003d [];\n 51|    \n 52|    /**\n 53|     * Calculate a point on the surface using the parametric equations\n 54|     */\n 55|    this.computePoint \u003d function(u, v) {\n 56|        const ePu \u003d Math.exp(this.p * u); // e^(pu)\n 57|        const eMu \u003d Math.exp(this.m * u); // e^(mu)\n 58|        \n 59|        return {\n 60|            x: (eMu + ePu * Math.cos(v)) * Math.cos(u),\n 61|            y: (eMu + ePu * Math.cos(v)) * Math.sin(u),\n 62|            z: ePu * Math.sin(v)\n 63|        };\n 64|    };\n 65|    \n 66|    /**\n 67|     * Calculate the analytical normal at a point by computing the cross product\n 68|     * of the tangent vectors along u and v directions\n 69|     */\n 70|    this.computeAnalyticalNormal \u003d function(u, v) {\n 71|        const ePu \u003d Math.exp(this.p * u);\n 72|        const eMu \u003d Math.exp(this.m * u);\n 73|        \n 74|        // Partial derivative with respect to u\n 75|        const dxdu \u003d -1 * (eMu + ePu * Math.cos(v)) * Math.sin(u) \n 76|                   + (this.m * eMu + this.p * ePu * Math.cos(v)) * Math.cos(u);\n 77|        const dydu \u003d (eMu + ePu * Math.cos(v)) * Math.cos(u) \n 78|                   + (this.m * eMu + this.p * ePu * Math.cos(v)) * Math.sin(u);\n 79|        const dzdu \u003d this.p * ePu * Math.sin(v);\n 80|        \n 81|        // Partial derivative with respect to v\n 82|        const dxdv \u003d -1 * ePu * Math.sin(v) * Math.cos(u);\n 83|        const dydv \u003d -1 * ePu * Math.sin(v) * Math.sin(u);\n 84|        const dzdv \u003d ePu * Math.cos(v);\n 85|        \n 86|        // Cross product to find normal vector\n 87|        const nx \u003d dydu * dzdv - dzdu * dydv;\n 88|        const ny \u003d dzdu * dxdv - dxdu * dzdv;\n 89|        const nz \u003d dxdu * dydv - dydu * dxdv;\n 90|        \n 91|        // Normalize the normal vector\n 92|        const length \u003d Math.sqrt(nx*nx + ny*ny + nz*nz);\n 93|        return {\n 94|            x: nx / length,\n 95|            y: ny / length,\n 96|            z: nz / length\n 97|        };\n 98|    };\n 99|    \n100|    /**\n101|     * Generate the triangular mesh vertices and indices\n102|     */\n103|    this.generateMesh \u003d function() {\n104|        this.vertices \u003d [];\n105|        this.indices \u003d [];\n106|        \n107|        // Generate vertices\n108|        for (let uIndex \u003d 0; uIndex \u003c\u003d this.uSegments; uIndex++) {\n109|            const u \u003d this.uMin + (uIndex / this.uSegments) * (this.uMax - this.uMin);\n110|            \n111|            for (let vIndex \u003d 0; vIndex \u003c\u003d this.vSegments; vIndex++) {\n112|                const v \u003d this.vMin + (vIndex / this.vSegments) * (this.vMax - this.vMin);\n113|                const point \u003d this.computePoint(u, v);\n114|                \n115|                // Store vertex\n116|                this.vertices.push(point.x, point.y, point.z);\n117|                \n118|                // Calculate analytical normal for now (will be replaced with facet average)\n119|                const normal \u003d this.computeAnalyticalNormal(u, v);\n120|                this.normals.push(normal.x, normal.y, normal.z);\n121|            }\n122|        }\n123|        \n124|        // Generate indices for triangle strips\n125|        for (let uIndex \u003d 0; uIndex \u003c this.uSegments; uIndex++) {\n126|            for (let vIndex \u003d 0; vIndex \u003c this.vSegments; vIndex++) {\n127|                const vertexIndex \u003d uIndex * (this.vSegments + 