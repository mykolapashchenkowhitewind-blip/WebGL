\n50|    vec3 normal \u003d normalize(fragNormal);\n51|    \n52|    // Calculate vector from fragment to light\n53|    vec3 lightDir \u003d normalize(fragLightPosition - fragPosition);\n54|    \n55|    // Calculate view direction vector (viewer at origin in view space)\n56|    // Using global viewer model as per hint - fixed direction (0,0,1)\n57|    vec3 viewDir \u003d normalize(vec3(0.0, 0.0, 1.0));\n58|    \n59|    // Calculate ambient component\n60|    vec3 ambient \u003d materialAmbient;\n61|    \n62|    // Calculate diffuse component\n63|    float diffuseFactor \u003d max(dot(normal, lightDir), 0.0);\n64|    vec3 diffuse \u003d materialDiffuse * diffuseFactor;\n65|    \n66|    // Calculate specular component (Phong reflection model)\n67|    vec3 reflectDir \u003d reflect(-lightDir, normal);\n68|    float specularFactor \u003d pow(max(dot(viewDir, reflectDir), 0.0), shininess);\n69|    vec3 specular \u003d materialSpecular * specularFactor;\n70|    \n71|    // Combine all lighting components\n72|    vec3 finalColor \u003d ambient + diffuse + specular;\n73|    \n74|    // Set final fragment color\n75|    gl_FragColor \u003d vec4(finalColor, 1.0);\n76|}`;&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;Let\u0027s also check the HTML file to understand the project structure:&quot;}],&quot;tool_calls&quot;:[{&quot;id&quot;:&quot;toolu_01Ww19kLfwmYSQL6d8aAzZnG&quot;,&quot;type&quot;:&quot;function&quot;,&quot;function&quot;:{&quot;name&quot;:&quot;read_file&quot;,&quot;arguments&quot;:&quot;{\&quot;target_file\&quot;: \&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL2/index.html\&quot;}&quot;}}]},{&quot;role&quot;:&quot;tool&quot;,&quot;name&quot;:&quot;read&quot;,&quot;tool_call_id&quot;:&quot;toolu_01Ww19kLfwmYSQL6d8aAzZnG&quot;,&quot;content&quot;:&quot;  1|\u003c!DOCTYPE html\u003e\n  2|\u003chtml\u003e\n  3|\u003chead\u003e\n  4|    \u003cmeta http-equiv\u003d\&quot;Co