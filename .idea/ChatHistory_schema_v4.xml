for lighting calculations\n 36|    fragPosition \u003d vec3(ModelViewMatrix * vec4(vertex, 1.0));\n 37|    \n 38|    // Pass light position to fragment shader\n 39|    fragLightPosition \u003d vec3(ModelViewMatrix * vec4(lightPosition, 1.0));\n 40|    \n 41|    // Pass texture coordinates to fragment shader\n 42|    fragTexCoord \u003d texCoord;\n 43|}`;\n 44|\n 45|// Fragment shader for Phong lighting with normal mapping\n 46|const fragmentShaderSource \u003d `\n 47|#ifdef GL_FRAGMENT_PRECISION_HIGH\n 48|   precision highp float;\n 49|#else\n 50|   precision mediump float;\n 51|#endif\n 52|\n 53|varying vec3 fragNormal;\n 54|varying vec3 fragTangent;\n 55|varying vec3 fragBitangent;\n 56|varying vec3 fragPosition;\n 57|varying vec3 fragLightPosition;\n 58|varying vec2 fragTexCoord;\n 59|\n 60|// Material properties\n 61|uniform vec3 materialAmbient;\n 62|uniform vec3 materialDiffuse;\n 63|uniform vec3 materialSpecular;\n 64|uniform float shininess;\n 65|\n 66|// Light properties\n 67|uniform vec3 lightColor; // Light color\n 68|\n 69|// Texture samplers\n 70|uniform sampler2D textureDiffuse;\n 71|uniform sampler2D textureSpecular;\n 72|uniform sampler2D textureNormal;\n 73|\n 74|void main() {\n 75|    // Sample textures\n 76|    vec4 diffuseColor \u003d texture2D(textureDiffuse, fragTexCoord);\n 77|    \n 78|    // The roughness map is the inverse of specularity\n 79|    // Convert from roughness to specular by inverting: specular \u003d 1.0 - roughness\n 80|    vec4 roughnessColor \u003d texture2D(textureSpecular, fragTexCoord);\n 81|    vec4 specularColor \u003d vec4(vec3(1.0 - roughnessColor.r), 1.0);\n 82|    \n 83|    vec3 normalMapColor \u003d texture2D(textureNormal, fragTexCoord).rgb;\n 84|    \n 85|    // Convert normal map from [0, 1] to [-1, 1] range\n 86|    vec3 normalTangentSpace \u003d normalMapColor * 2.0 - 1.0;\n 87|    \n 88|    // Construct TBN matrix (Tangent, Bitangent, Normal) for transforming normal from tangent space to view space\n 89|    // This matrix transforms vectors from tangent space to view space\n 90|    mat3 TBN \u003d mat3(\n 91|        normalize(fragTangent),\n 92|        normalize(fragBitangent),\n 93|        normalize(fragNormal)\n 94|    );\n 95|    \n 96|    // Transform normal from tangent space to view space\n 97|    vec3 normal \u003d normalize(TBN * normalTangentSpace);\n 98|    \n 99|    // Calculate vector from fragment to light\n100|    vec3 lightDir \u003d normalize(fragLightPosition - fragPosition);\n101|    \n102|    // Calculate view direction vector (viewer at origin in view space)\n103|    // Using global viewer model as per hint - fixed direction (0,0,1)\n104|    vec3 viewDir \u003d normalize(vec3(0.0, 0.0, 1.0));\n105|    \n106|    // Calculate ambient component (controlled ambient for better shadows)\n107|    // Modulated by diffuse texture\n108|    vec3 ambient \u003d materialAmbient * diffuseColor.rgb;\n109|    \n110|    // Calculate diffuse component with light color\n111|    // The dot product determines how directly the light hits the surface\n112|    // A value of 1.0 means the light is hitting directly, 0.0 means it\u0027s at 90 degrees\n113|    // and negative values mean the light is coming from behind the surface\n114|    float diffuseFactor \u003d dot(normal, lightDir);\n115|    \n116|    // Only apply lighting where the light actually hits the surface (front-facing)\n117|    diffuseFactor \u003d max(diffuseFactor, 0.0);\n118|    \n119|    // Apply stronger non-linearity to the diffuse factor for very dramatic shadows\n120|    // Higher exponent (2.0) creates a much sharper transition between light and shadow\n121|    diffuseFactor \u003d pow(diffuseFactor, 2.0); \n122|    \n123|    // Calculate final diffuse color - modulated by diffuse texture\n124|    vec3 diffuse \u003d materialDiffuse * lightColor * diffuseFactor * diffuseColor.rgb;\n125|    \n126|    // Calculate specular component (Phong reflection model) with light color\n127|    vec3 reflectDir \u003d reflect(-lightDir, normal);\n128|    float specularFactor \u003d pow(max(dot(viewDir, reflectDir), 0.0), shininess);\n129|    \n130|    // Modulate specular by specular texture\n131|    vec3 specular \u003d materialSpecular * lightColor * specularFactor * specularColor.rgb;\n132|    \n133|    // Combine all lighting components\n134|    vec3 finalColor \u003d ambient + diffuse + specular;\n135|    \n136|    // Set final fragment color\n137|    gl_FragColor \u003d vec4(finalColor, 1.0);\n138|}`;&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;Let me look for any texture manipulation code and keyboard handling in the project:&quot;}],&quot;tool_calls&quot;:[{&quot;id&quot;:&quot;toolu_01Xfxn4F7fvFssrHUcEKm4YV&quot;,&quot;type&quot;:&quot;function&quot;,&quot;function&quot;:{&quot;name&quot;:&quot;list_dir&quot;,&quot;arguments&quot;:&quot;{\&quot;target_directory\&quot;: \&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL2\&quot;}&quot;}}]},{&quot;role&quot;:&quot;tool&quot;,&quot;name&quot;:&quot;list_dir&quot;,&quot;tool_call_id&quot;:&quot;toolu_01Xfxn4F7fvFssrHUcEKm4YV&quot;,&quot;content&quot;:&quot;Contents of directory:\n\n[dir] res/ - Dec 25, 2025 10:34 PM\n[dir] Utils/ - Dec 25, 2025 05:03 PM\n[file] cornucopia3.js (43.7KB, 1136 lines) - Dec 25, 2025 10:53 PM\n[file] index.html (15.6KB, 371 lines) - Dec 25, 2025 10:14 PM\n[file] LICENSE (1.1KB, 21 lines) - Dec 25, 2025 05:02 PM\n[file] main.js (5.9KB, 166 lines) - Dec 25, 2025 08:50 PM\n[file] Model.js (4.0KB, 142 lines) - Dec 25, 2025 08:51 PM\n[file] README.md (3.0KB, 72 lines) - Dec 25, 2025 05:25 PM\n[file] res\\Ground080_1K-JPG_Color.jpg (1.0MB, 6819 lines) - Dec 25, 2025 10:34 PM\n[file] res\\Ground080_1K-JPG_NormalGL.jpg (1.4MB, 13026 lines) - Dec 25, 2025 10:33 PM\n[file] res\\Ground080_1K-JPG_Roughness.jpg (482.3KB, 4380 lines) - Dec 25, 2025 10:34 PM\n[file] shader.gpu (693B, 36 lines) - Dec 25, 2025 08:50 P