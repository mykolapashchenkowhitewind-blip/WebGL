 flex;\n126|            align-items: center;\n127|        }\n128|        .parameter-label {\n129|            display: inline-block;\n130|            width: 80px;\n131|        }\n132|        .parameter-input {\n133|            width: 80px;\n134|            background-color: #111;\n135|            color: #0f0;\n136|            border: 1px solid #0f0;\n137|            padding: 4px;\n138|        }\n139|        h3 {\n140|            margin-top: 0;\n141|            color: #0f0;\n142|        }\n143|        ul {\n144|            padding-left: 20px;\n145|        }\n146|        li {\n147|            margin-bottom: 8px;\n148|        }\n149|        .granularity-section {\n150|            border-top: 1px solid #0f0;\n151|            padding-top: 15px;\n152|            margin-top: 20px;\n153|        }\n154|    \u003c/style\u003e\n155|\n156|    \u003c!-- Core libraries --\u003e\n157|    \u003cscript src\u003d\&quot;./Utils/m4.js\&quot;\u003e\u003c/script\u003e\n158|    \u003cscript src\u003d\&quot;./Utils/trackball-rotator.js\&quot;\u003e\u003c/script\u003e\n159|    \u003cscript src\u003d\&quot;./shaders.js\&quot;\u003e\u003c/script\u003e\n160|    \u003cscript src\u003d\&quot;./cornucopia3.js\&quot;\u003e\u003c/script\u003e\n161|        \n162|    \u003cscript\u003e\n163|        // Add event listener for the refresh button after the page loads\n164|        window.addEventListener(\u0027load\u0027, function() {\n165|            const refreshButton \u003d document.getElementById(\u0027refresh-button\u0027);\n166|            const paramP \u003d document.getElementById(\u0027param-p\u0027);\n167|            const paramM \u003d document.getElementById(\u0027param-m\u0027);\n168|            const paramU \u003d document.getElementById(\u0027param-u\u0027);\n169|            const paramV \u003d document.getElementById(\u0027param-v\u0027);\n170|            \n171|            // Set initial values directly from the mathematical definition\n172|            // These values match exactly what\u0027s shown in the Mathematical Definition section\n173|            paramP.value \u003d 0.15; // p \u003d 0.15\n174|            paramM.value \u003d 0.1;  // m \u003d 0.1\n175|            paramU.value \u003d 5;    // u ≤ 5π\n176|            paramV.value \u003d 2;    // v ≤ 2π\n177|            \n178|            // Also ensure the model uses these exact values\n179|            setTimeout(function() {\n180|                if (surface) {\n181|                    // Verify that the model parameters match the HTML definition\n182|                    if (surface.p !\u003d 0.15 || surface.m !\u003d 0.1 || \n183|                        surface.uMax !\u003d 5 * Math.PI || surface.vMax !\u003d 2 * Math.PI) {\n184|                        console.log(\&quot;Correcting model parameters to match Mathematical Definition\&quot;);\n185|                        surface.p \u003d 0.15;\n186|                        surface.m \u003d 0.1;\n187|                        surface.uMax \u003d 5 * Math.PI;\n188|                        surface.vMax \u003d 2 * Math.PI;\n189|                        surface.initialize();\n190|                        draw();\n191|                    }\n192|                }\n193|            }, 500);\n194|            \n195|            if (refreshButton) {\n196|                refreshButton.addEventListener(\u0027click\u0027, function() {\n197|                    // Get values from inputs\n198|                    if (surface) {\n199|                        // Update parameters\n200|                        surface.p \u003d parseFloat(paramP.value);\n201|                        surface.m \u003d parseFloat(paramM.value);\n202|                        surface.uMax \u003d parseFloat(paramU.value) * Math.PI;\n203|                        surface.vMax \u003d parseFloat(paramV.value) * Math.PI;\n204|                        \n205|                        console.log(\&quot;Applying new parameters:\&quot;);\n206|                        console.log(\&quot;p \u003d\&quot;, surface.p, \&quot;m \u003d\&quot;, surface.m, \&quot;uMax \u003d\&quot;, surface.uMax/Math.PI + \&quot;π\&quot;, \&quot;vMax \u003d\&quot;, surface.vMax/Math.PI + \&quot;π\&quot;);\n207|                        \n208|                        // Update formula display in the info panel\n209|                        const mathFormula \u003d document.querySelector(\u0027.math-formula\u0027);\n210|                        if (mathFormula) {\n211|                            // Find the part after the parametric equations\n212|                            const whereSection \u003d mathFormula.innerHTML.split(\u0027\u003cstrong\u003eWhere:\u003c/strong\u003e\u0027);\n213|                            if (whereSection.length \u003e 1) {\n214|                                mathFormula.innerHTML \u003d whereSection[0] + \n215|                                    \u0027\u003cstrong\u003eWhere:\u003c/strong\u003e\u003cbr\u003e\u0027 +\n216|                                    \u0027- p \u003d \u0027 + surface.p + \u0027 (parameter p)\u003cbr\u003e\u0027 +\n217|                                    \u0027- m \u003d \u0027 + surface.m + \u0027 (parameter m)\u003cbr\u003e\u0027 +\n218|                                    \u0027- 0 ≤ u ≤ \u0027 + (surface.uMax/Math.PI) + \u0027π (lengthwise parameter)\u003cbr\u003e\u0027 +\n219|                                    \u0027- 0 ≤ v ≤ \u0027 + (surface.vMax/Math.PI) + \u0027π (cross-section parameter)\u0027;\n220|                            }\n221|                        }\n222|                        \n223|                        // Reinitialize the model\n224|                        surface.initialize();\n225|                        \n226|                        // Redraw\n227|                        draw();\n228|                        \n229|                        console.log(\&quot;Model updated with new parameters!\&quot;);\n230|                        \n231|                        // Flash confirmation message\n232|                        const button \u003d document.getElementById(\u0027refresh-button\u0027);\n233|                        button.textContent \u003d \&quot;Parameters Applied!\&quot;;\n234|                        button.style.backgroundColor \u003d \&quot;#00ff99\&quot;;\n235|                        setTimeout(function() {\n236|                            button.textContent \u003d \&quot;Apply Parameters\&quot;;\n237|                            button.style.backgroundColor \u003d \&quot;#0f0\&quot;;\n238|                        }, 1500);\n239|                    }\n240|                });\n241|            }\n242|\n243|            // Add direct event listeners to granularity sliders\n244|            setupGranularitySliders();\n245|        });\n246|\n247|        // Function to directly update mesh when sliders change\n248|        function updateMeshGranularity() {\n249|            if (!surface) return;\n250|\n251|            const uSlider \u003d document.getElementById(\&quot;u-granularity\&quot;);\n252|            const vSlider \u003d document.getElementById(\&quot;v-granularity\&quot;);\n253|            const uValue \u003d document.getElementById(\&quot;u-gran-value\&quot;);\n254|            const vValue \u003d document.getElementById(\&quot;v-gran-value\&quot;);\n255|\n256|            if (uSlider \u0026\u0026 vSlider \u0026\u0026 uValue \u0026\u0026 vValue) {\n257|                const uSegments \u003d parseInt(uSlider.value);\n258|                const vSegments \u003d parseInt(vSlider.value);\n259|                \n260|                // Update display values\n261|                uValue.textContent \u003d uSegments;\n262|                vValue.textContent \u003d vSegments;\n263|\n264|                // Update the surface\n265|                console.log(\&quot;Direct update from sliders: U\u003d\&quot; + uSegments + \&quot;, V\u003d\&quot; + vSegments);\n266|                surface.uSegments \u003d uSegments;\n267|                surface.vSegments \u003d vSegments;\n268|                surface.initialize();\n269|                draw();\n270|            }\n271|        }\n272|\n273|        // Setup granularity sliders with direct event handlers\n274|        function setupGranularitySliders() {\n275|            const uSlider \u003d document.getElementById(\&quot;u-granularity\&quot;);\n276|            const vSlider \u003d document.getElementById(\&quot;v-granularity\&quot;);\n277|            \n278|            if (uSlider \u0026\u0026 vSlider \u0026\u0026 surface) {\n279|                // Set initial values to match model\n280|                uSlider.value \u003d surface.uSegments;\n281|                vSlider.value \u003d surface.vSegments;\n282|                \n283|                document.getElementById(\&quot;u-gran-value\&quot;).textContent \u003d surface.uSegments;\n284|                document.getElementById(\&quot;v-gran-value\&quot;).textContent \u003d surface.vSegments;\n285|                \n286|                console.log(\&quot;Granularity sliders initialized with values:\&quot;, surface.uSegments, surface.vSegments);\n287|            }\n288|        }\n289|    \u003c/script\u003e\n290|\u003c/head\u003e\n291|\u003cbody onload\u003d\&quot;init()\&quot;\u003e\n292|    \u003cdiv class\u003d\&quot;container\&quot;\u003e\n293|        \u003ch1\u003eCornucopia Surface - WebGL Visualization with Phong Shading\u003c/h1\u003e\n294|        \n295|        \u003cdiv class\u003d\&quot;info-panel\&quot;\u003e\n296|            \u003ch2\u003eProject Description\u003c/h2\u003e\n297|            \u003cp\u003eThis visualization demonstrates a 3D model of a \&quot;Cornucopia\&quot; surface rendered using WebGL with Phong shading and Facet Average normal calculation.\u003c/p\u003e\n298|            \u003cp\u003eThe Cornucopia is a special case of a spiral-shaped surface \&quot;Shell without vertex\&quot;. It\u0027s a cyclic surface with generatrix circles of variable radius that creates the distinctive horn-like shape.\u003c/p\u003e\n299|            \n300|            \u003ch2\u003eMathematical Definition\u003c/h2\u003e\n301|            \u003cp\u003eThe Cornucopia surface is defined by the following parametric equations:\u003c/p\u003e\n302|            \n303|            \u003cdiv class\u003d\&quot;math-formula\&quot;\u003e\n304|                \u003cstrong\u003eParametric Equations:\u003c/strong\u003e\u003cbr\u003e\n305|                x(u,v) \u003d [e\u003csup\u003emu\u003c/sup\u003e + e\u003csup\u003epu\u003c/sup\u003ecos(v)]cos(u)\u003cbr\u003e\n306|                y(u,v) \u003d [e\u003csup\u003emu\u003c/sup\u003e + e\u003csup\u003epu\u003c/sup\u003ecos(v)]sin(u)\u003cbr\u003e\n307|                z(u,v) \u003d e\u003csup\u003epu\u003c/sup\u003esin(v)\u003cbr\u003e\u003cbr\u003e\n308|                \n309|                \u003cstrong\u003eWhere:\u003c/strong\u003e\u003cbr\u003e\n310|                - p \u003d 0.15 (parameter p)\u003cbr\u003e\n311|                - m \u003d 0.1 (parameter m)\u003cbr\u003e\n312|                - 0 ≤ u ≤ 5π (lengthwise parameter)\u003cbr\u003e\n313|                - 0 ≤ v ≤ 2π (cross-section parameter)\n314|            \u003c/div\u003e\n315|        \u003c/div\u003e\n316|        \n317|        \u003cdiv id\u003d\&quot;canvas-holder\&quot;\u003e\n318|            \u003ccanvas width\u003d\&quot;800\&quot; height\u003d\&quot;600\&quot; id\u003d\&quot;webglcanvas\&quot; style\u003d\&quot;background-color:black\&quot;\u003e\u003c/canvas\u003e\n319|        \u003c/div\u003e\n320|        \n321|        \u003cdiv class\u003d\&quot;controls-panel\&quot;\u003e\n322|            \u003ch3\u003eSurface Parameters\u003c/h3\u003e\n323|            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\n324|                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-p\&quot;\u003ep value:\u003c/label\u003e\n325|                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-p\&quot; value\u003d\&quot;0.15\&quot; step\u003d\&quot;0.01\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\n326|            \u003c/div\u003e\n327|            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\n328|                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-m\&quot;\u003em value:\u003c/label\u003e\n329|                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-m\&quot; value\u003d\&quot;0.1\&quot; step\u003d\&quot;0.01\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\n330|            \u003c/div\u003e\n331|            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\n332|                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-u\&quot;\u003eu max (π):\u003c/label\u003e\n333|                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-u\&quot; value\u003d\&quot;5\&quot; step\u003d\&quot;0.5\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\n334|            \u003c/div\u003e\n335|            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\n336|                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-v\&quot;\u003ev max (π):\u003c/label\u003e\n337|                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-v\&quot; value\u003d\&quot;2\&quot; step\u003d\&quot;0.5\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\n338|            \u003c/div\u003e\n339|            \n340|            \u003cbutton id\u003d\&quot;refresh-button\&quot; style\u003d\&quot;margin-top: 10px; padding: 8px 16px; background-color: #0f0; color: black; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;\&quot;\u003eApply Parameters\u003c/button\u003e\n341|            \n342|            \u003cdiv class\u003d\&quot;granularity-section\&quot;\u003e\n343|                \u003ch3\u003eMesh Granularity\u003c/h3\u003e\n344|                \u003cdiv class\u003d\&quot;slider-container\&quot;\u003e\n345|                    \u003cspan class\u003d\&quot;slider-label\&quot;\u003eU Segments:\u003c/span\u003e\n346|                    \u003cinput type\u003d\&quot;range\&quot; min\u003d\&quot;10\&quot; max\u003d\&quot;200\&quot; value\u003d\&quot;80\&quot; class\u003d\&quot;slider\&quot; id\u003d\&quot;u-granularity\&quot; oninput\u003d\&quot;updateMeshGranularity()\&quot;\u003e\n347|                    \u003cspan class\u003d\&quot;slider-value\&quot; id\u003d\&quot;u-gran-value\&quot;\u003e80\u003c/span\u003e\n348|                \u003c/div\u003e\n349|                \u003cdiv class\u003d\&quot;slider-container\&quot;\u003e\n350|                    \u003cspan class\u003d\&quot;slider-label\&quot;\u003eV Segments:\u003c/span\u003e\n351|                    \u003cinput type\u003d\&quot;range\&quot; min\u003d\&quot;10\&quot; max\u003d\&quot;100\&quot; value\u003d\&quot;40\&quot; class\u003d\&quot;slider\&quot; id\u003d\&quot;v-granularity\&quot; oninput\u003d\&quot;updateMeshGranularity()\&quot;\u003e\n352|                    \u003cspan class\u003d\&quot;slider-value\&quot; id\u003d\&quot;v-gran-value\&quot;\u003e40\u003c/span\u003e\n353|                \u003c/div\u003e\n354|            \u003c/div\u003e\n355|        \u003c/div\u003e\n356|        \n357|        \u003cdiv class\u003d\&quot;info-panel\&quot;\u003e\n358|            \u003ch2\u003eImplementation Details\u003c/h2\u003e\n359|            \u003cp\u003eThis implementation includes:\u003c/p\u003e\n360|            \u003cul\u003e\n361|                \u003cli\u003e\u003cstrong\u003ePhong Shading:\u003c/strong\u003e Realistic lighting with ambient, diffuse, and specular components\u003c/li\u003e\n362|                \u003cli\u003e\u003cstrong\u003eFacet Average Normal:\u003c/strong\u003e Normals are calculated by averaging adjacent facet normals\u003c/li\u003e\n363|                \u003cli\u003e\u003cstrong\u003eRotating Light Source:\u003c/strong\u003e A moving light that circles around the model\u003c/li\u003e\n364|                \u003cli\u003e\u003cstrong\u003eTriangle Mesh:\u003c/strong\u003e The surface is rendered with filled triangles using VBO with indices\u003c/li\u003e\n365|                \u003cli\u003e\u003cstrong\u003eAdjustable Granularity:\u003c/strong\u003e U and V segment sliders allow controlling the mesh density\u003c/li\u003e\n366|            \u003c/ul\u003e\n367|        \u003c/div\u003e\n368|        \n369|        \u003cdiv class\u003d\&quot;student-info\&quot;\u003e\n370|            \u003ch2\u003eStudent Information\u003c/h2\u003e\n371|            \u003cp\u003e\u003cstrong\u003eName:\u003c/strong\u003e Pashchenko Mykola\u003c/p\u003e\n372|            \u003cp\u003e\u003cstrong\u003eGroup:\u003c/strong\u003e TR-51mp\u003c/p\u003e\n373|            \u003cp\u003e\u003cstrong\u003eCourse:\u003c/strong\u003e WebGL Visualization\u003c/p\u003e\n374|            \u003cp\u003e\u003cstrong\u003eAssignment:\u003c/strong\u003e PA#2 - Cornucopia Surface with Phong Shading\u003c/p\u003e\n375|            \u003cp\u003e\u003cstrong\u003eVariant:\u003c/strong\u003e 23 (Phong Shading, Facet Average Normals)\u003c/p\u003e\n376|        \u003c/div\u003e\n377|        \n378|        \u003cdiv class\u003d\&quot;footer\&quot;\u003e\n379|            \u003cp\u003eInteractive WebGL Visualization - Created using JavaScript and WebGL\u003c/p\u003e\n380|            \u003cp\u003eDrag your mouse on the model to rotate it. On a touch screen, you can use your finger.\u003c/p\u003e\n381|        \u003c/div\u003e\n382|    \u003c/div\u003e\n383|\u003c/body\u003e\n384|\u003c/html\u003e&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;I\u0027ve found where the background color is set in `cornucopia3.js`. To change it from black to white, I need to modify the `draw()` function. Here\u0027s the change:&quot;}],&quot;tool_calls&quot;:[{&quot;id&quot;:&quot;toolu_012VAq5LvU28S3PcyhdzYukE&quot;,&quot;type&quot;:&quot;function&quot;,&quot;function&quot;:{&quot;name&quot;:&quot;edit&quot;,&quot;arguments&quot;:&quot;{\&quot;file_path\&quot;: \&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL2/cornucopia3.js\&quot;, \&quot;old_string\&quot;: \&quot;    gl.clearColor(0, 0, 0, 1);\\n    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);\&quot;, \&quot;new_string\&quot;: \&quot;    gl.clearColor(1, 1, 1, 1); // Changed from black (0,0,0) to white (1,1,1)\\n    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);\&quot;}&quot;}}]},{&quot;role&quot;:&quot;tool&quot;,&quot;name&quot;:&quot;edit&quot;,&quot;tool_call_id&quot;:&quot;toolu_012VAq5LvU28S3PcyhdzYukE&quot;,&quot;content&quot;:&quot;The file D:\\PROJECT_ME\\project_SHAME\\INSTITUTKA\\Visualisation\\WebGL2\\cornucopia3.js has been updated.\n\nWhen you\u0027re done with your current set of changes to this file, you should call the read_lints tool with the specific file path and fix any newly introduced errors.&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;I also need to check the canvas style attribute in the HTML file, which might override the WebGL background:&quot;}],&quot;tool_calls&quot;:[{&quot;id&quot;:&quot;toolu_017AUp1KfXJGd78HXHAynVku&quot;,&quot;type&quot;:&quot;function&quot;,&quot;function&quot;:{&quot;name&quot;:&quot;edit&quot;,&quot;arguments&quot;:&quot;{\&quot;file_path\&quot;: \&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL2/index.html\&quot;, \&quot;old_string\&quot;: \&quot;            \u003ccanvas width\u003d\\\&quot;800\\\&quot; height\u003d\\\&quot;600\\\&quot; id\u003d\\\&quot;webglcanvas\\\&quot; style\u003d\\\&quot;background-color:black\\\&quot;\u003e\u003c/canvas\u003e\&quot;, \&quot;new_string\&quot;: \&quot;            \u003ccanvas width\u003d\\\&quot;800\\\&quot; height\u003d\\\&quot;600\\\&quot; id\u003d\\\&quot;webglcanvas\\\&quot; style\u003d\\\&quot;background-color:white\\\&quot;\u003e\u003c/canvas\u003e\&quot;}&quot;}}]},{&quot;role&quot;:&quot;tool&quot;,&quot;name&quot;:&quot;edit&quot;,&quot;tool_call_id&quot;:&quot;toolu_017AUp1KfXJGd78HXHAynVku&quot;,&quot;content&quot;:&quot;The file D:\\PROJECT_ME\\project_SHAME\\INSTITUTKA\\Visualisation\\WebGL2\\index.html has been updated.\n\nWhen you\u0027re done with your current set of changes to this file, you should call the read_lints tool with the specific file path and fix any newly introduced errors.&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;Let\u0027s check for any linting errors:&quot;}],&quot;tool_calls&quot;:[{&quot;id&quot;:&quot;toolu_01Tgv7amwnc23bP1A6hZBjMN&quot;,&quot;type&quot;:&quot;function&quot;,&quot;function&quot;:{&quot;name&quot;:&quot;read_lints&quot;,&quot;arguments&quot;:&quot;{\&quot;paths\&quot;: [\&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL2/cornucopia3.js\&quot;,\&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL2/index.html\&quot;]}&quot;}}]},{&quot;role&quot;:&quot;tool&quot;,&quot;name&quot;:&quot;read_lints&quot;,&quot;tool_call_id&quot;:&quot;toolu_01Tgv7amwnc23bP1A6hZBjMN&quot;,&quot;content&quot;:&quot;No linter errors found in 2 checked files.&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;Great! I\u0027ve successfully changed the background color to white in the WebGL rendering. Here\u0027s what I did:\n\n1. Changed the `gl.clearColor()` call in `cornucopia3.js` from `(0, 0, 0, 1)` (black) to `(1, 1, 1, 1)` (white). This sets the color that WebGL uses to clear the canvas before drawing.\n\n2. Also updated the canvas element in `index.html` to have `style\u003d\&quot;background-color:white\&quot;` instead of `style\u003d\&quot;background-color:black\&quot;`. This ensures the HTML canvas background color matches the WebGL clear color.\n\nThese changes will make the background white when rendering the 3D model. The changes were clean with no linting errors.&quot;}]},{&quot;role&quot;:&quot;user&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;why can see the dot of light ?\nthe point from whrere light come out&quot;}],&quot;context&quot;:[{&quot;file_path&quot;:&quot;index.html&quot;,&quot;code_text&quot;:&quot;\u003c!DOCTYPE html\u003e\r\n\u003chtml\u003e\r\n\u003chead\u003e\r\n    \u003cmeta http-equiv\u003d\&quot;Content-Type\&quot; content\u003d\&quot;text/html; charset\u003dUTF-8\&quot;\u003e\r\n    \u003ctitle\u003eCornucopia Surface - WebGL Visualization with Phong Shading\u003c/title\u003e\r\n    \u003cstyle\u003e\r\n        body {\r\n            background-color: #111;\r\n            font-family: Arial, sans-serif;\r\n            color: #fff;\r\n            text-align: center;\r\n            margin: 0;\r\n            padding: 20px;\r\n        }\r\n        h1, h2 {\r\n            color: #0f0;\r\n        }\r\n        h1 {\r\n            margin-top: 10px;\r\n            font-size: 28px;\r\n        }\r\n        h2 {\r\n            font-size: 22px;\r\n            margin-top: 25px;\r\n        }\r\n        .container {\r\n            max-width: 1000px;\r\n            margin: 0 auto;\r\n            padding: 20px;\r\n        }\r\n        #canvas-holder {\r\n            margin: 20px auto;\r\n            width: 800px;\r\n        }\r\n        canvas {\r\n            border: 1px solid #0f0;\r\n            display: block;\r\n            margin: 0 auto;\r\n        }\r\n        .info-panel {\r\n            text-align: left;\r\n            background-color: rgba(0, 50, 0, 0.3);\r\n            border: 1px solid #0f0;\r\n            padding: 20px;\r\n            border-radius: 5px;\r\n            margin: 20px auto;\r\n            max-width: 800px;\r\n        }\r\n        .controls-panel {\r\n            margin: 20px auto;\r\n            display: inline-block;\r\n            background-color: rgba(0, 30, 0, 0.7);\r\n            padding: 15px;\r\n            border-radius: 5px;\r\n            text-align: left;\r\n            width: 90%;\r\n            box-sizing: border-box;\r\n        }\r\n        .math-formula {\r\n            background-color: rgba(0, 30, 0, 0.5);\r\n            padding: 15px;\r\n            border-radius: 5px;\r\n            margin: 15px 0;\r\n            font-family: \&quot;Courier New\&quot;, monospace;\r\n        }\r\n        .footer {\r\n            margin-top: 30px;\r\n            font-size: 14px;\r\n            color: #aaa;\r\n            border-top: 1px solid #333;\r\n            padding-top: 15px;\r\n        }\r\n        .student-info {\r\n            text-align: left;\r\n            background-color: rgba(0, 40, 0, 0.3);\r\n            border-left: 3px solid #0f0;\r\n            padding: 10px 20px;\r\n            margin: 25px auto;\r\n            max-width: 600px;\r\n        }\r\n        .slider-container {\r\n            margin: 15px 0;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: space-between;\r\n        }\r\n        .slider-label {\r\n            width: 150px;\r\n            text-align: right;\r\n            margin-right: 15px;\r\n        }\r\n        .slider {\r\n            flex-grow: 1;\r\n            height: 5px;\r\n            background: #333;\r\n            outline: none;\r\n            -webkit-appearance: none;\r\n            cursor: pointer;\r\n        }\r\n        .slider::-webkit-slider-thumb {\r\n            -webkit-appearance: none;\r\n            appearance: none;\r\n            width: 15px;\r\n            height: 15px;\r\n            background: #0f0;\r\n            border-radius: 50%;\r\n            cursor: pointer;\r\n        }\r\n        .slider::-moz-range-thumb {\r\n            width: 15px;\r\n            height: 15px;\r\n            background: #0f0;\r\n            border-radius: 50%;\r\n            cursor: pointer;\r\n        }\r\n        .slider-value {\r\n            width: 40px;\r\n            margin-left: 15px;\r\n            text-align: center;\r\n            font-weight: bold;\r\n            color: #0f0;\r\n        }\r\n        .parameter-row {\r\n            margin-bottom: 8px;\r\n            display: flex;\r\n            align-items: center;\r\n        }\r\n        .parameter-label {\r\n            display: inline-block;\r\n            width: 80px;\r\n        }\r\n        .parameter-input {\r\n            width: 80px;\r\n            background-color: #111;\r\n            color: #0f0;\r\n            border: 1px solid #0f0;\r\n            padding: 4px;\r\n        }\r\n        h3 {\r\n            margin-top: 0;\r\n            color: #0f0;\r\n        }\r\n        ul {\r\n            padding-left: 20px;\r\n        }\r\n        li {\r\n            margin-bottom: 8px;\r\n        }\r\n        .granularity-section {\r\n            border-top: 1px solid #0f0;\r\n            padding-top: 15px;\r\n            margin-top: 20px;\r\n        }\r\n    \u003c/style\u003e\r\n\r\n    \u003c!-- Core libraries --\u003e\r\n    \u003cscript src\u003d\&quot;./Utils/m4.js\&quot;\u003e\u003c/script\u003e\r\n    \u003cscript src\u003d\&quot;./Utils/trackball-rotator.js\&quot;\u003e\u003c/script\u003e\r\n    \u003cscript src\u003d\&quot;./shaders.js\&quot;\u003e\u003c/script\u003e\r\n    \u003cscript src\u003d\&quot;./cornucopia3.js\&quot;\u003e\u003c/script\u003e\r\n        \r\n    \u003cscript\u003e\r\n        // Add event listener for the refresh button after the page loads\r\n        window.addEventListener(\u0027load\u0027, function() {\r\n            const refreshButton \u003d document.getElementById(\u0027refresh-button\u0027);\r\n            const paramP \u003d document.getElementById(\u0027param-p\u0027);\r\n            const paramM \u003d document.getElementById(\u0027param-m\u0027);\r\n            const paramU \u003d document.getElementById(\u0027param-u\u0027);\r\n            const paramV \u003d document.getElementById(\u0027param-v\u0027);\r\n            \r\n            // Set initial values directly from the mathematical definition\r\n            // These values match exactly what\u0027s shown in the Mathematical Definition section\r\n            paramP.value \u003d 0.15; // p \u003d 0.15\r\n            paramM.value \u003d 0.1;  // m \u003d 0.1\r\n            paramU.value \u003d 5;    // u ≤ 5π\r\n            paramV.value \u003d 2;    // v ≤ 2π\r\n            \r\n            // Also ensure the model uses these exact values\r\n            setTimeout(function() {\r\n                if (surface) {\r\n                    // Verify that the model parameters match the HTML definition\r\n                    if (surface.p !\u003d 0.15 || surface.m !\u003d 0.1 || \r\n                        surface.uMax !\u003d 5 * Math.PI || surface.vMax !\u003d 2 * Math.PI) {\r\n                        console.log(\&quot;Correcting model parameters to match Mathematical Definition\&quot;);\r\n                        surface.p \u003d 0.15;\r\n                        surface.m \u003d 0.1;\r\n                        surface.uMax \u003d 5 * Math.PI;\r\n                        surface.vMax \u003d 2 * Math.PI;\r\n                        surface.initialize();\r\n                        draw();\r\n                    }\r\n                }\r\n            }, 500);\r\n            \r\n            if (refreshButton) {\r\n                refreshButton.addEventListener(\u0027click\u0027, function() {\r\n                    // Get values from inputs\r\n                    if (surface) {\r\n                        // Update parameters\r\n                        surface.p \u003d parseFloat(paramP.value);\r\n                        surface.m \u003d parseFloat(paramM.value);\r\n                        surface.uMax \u003d parseFloat(paramU.value) * Math.PI;\r\n                        surface.vMax \u003d parseFloat(paramV.value) * Math.PI;\r\n                        \r\n                        console.log(\&quot;Applying new parameters:\&quot;);\r\n                        console.log(\&quot;p \u003d\&quot;, surface.p, \&quot;m \u003d\&quot;, surface.m, \&quot;uMax \u003d\&quot;, surface.uMax/Math.PI + \&quot;π\&quot;, \&quot;vMax \u003d\&quot;, surface.vMax/Math.PI + \&quot;π\&quot;);\r\n                        \r\n                        // Update formula display in the info panel\r\n                        const mathFormula \u003d document.querySelector(\u0027.math-formula\u0027);\r\n                        if (mathFormula) {\r\n                            // Find the part after the parametric equations\r\n                            const whereSection \u003d mathFormula.innerHTML.split(\u0027\u003cstrong\u003eWhere:\u003c/strong\u003e\u0027);\r\n                            if (whereSection.length \u003e 1) {\r\n                                mathFormula.innerHTML \u003d whereSection[0] + \r\n                                    \u0027\u003cstrong\u003eWhere:\u003c/strong\u003e\u003cbr\u003e\u0027 +\r\n                                    \u0027- p \u003d \u0027 + surface.p + \u0027 (parameter p)\u003cbr\u003e\u0027 +\r\n                                    \u0027- m \u003d \u0027 + surface.m + \u0027 (parameter m)\u003cbr\u003e\u0027 +\r\n                                    \u0027- 0 ≤ u ≤ \u0027 + (surface.uMax/Math.PI) + \u0027π (lengthwise parameter)\u003cbr\u003e\u0027 +\r\n                                    \u0027- 0 ≤ v ≤ \u0027 + (surface.vMax/Math.PI) + \u0027π (cross-section parameter)\u0027;\r\n                            }\r\n                        }\r\n                        \r\n                        // Reinitialize the model\r\n                        surface.initialize();\r\n                        \r\n                        // Redraw\r\n                        draw();\r\n                        \r\n                        console.log(\&quot;Model updated with new parameters!\&quot;);\r\n                        \r\n                        // Flash confirmation message\r\n                        const button \u003d document.getElementById(\u0027refresh-button\u0027);\r\n                        button.textContent \u003d \&quot;Parameters Applied!\&quot;;\r\n                        button.style.backgroundColor \u003d \&quot;#00ff99\&quot;;\r\n                        setTimeout(function() {\r\n                            button.textContent \u003d \&quot;Apply Parameters\&quot;;\r\n                            button.style.backgroundColor \u003d \&quot;#0f0\&quot;;\r\n                        }, 1500);\r\n                    }\r\n                });\r\n            }\r\n\r\n            // Add direct event listeners to granularity sliders\r\n            setupGranularitySliders();\r\n        });\r\n\r\n        // Function to directly update mesh when sliders change\r\n        function updateMeshGranularity() {\r\n            if (!surface) return;\r\n\r\n            const uSlider \u003d document.getElementById(\&quot;u-granularity\&quot;);\r\n            const vSlider \u003d document.getElementById(\&quot;v-granularity\&quot;);\r\n            const uValue \u003d document.getElementById(\&quot;u-gran-value\&quot;);\r\n            const vValue \u003d document.getElementById(\&quot;v-gran-value\&quot;);\r\n\r\n            if (uSlider \u0026\u0026 vSlider \u0026\u0026 uValue \u0026\u0026 vValue) {\r\n                const uSegments \u003d parseInt(uSlider.value);\r\n                const vSegments \u003d parseInt(vSlider.value);\r\n                \r\n                // Update display values\r\n                uValue.textContent \u003d uSegments;\r\n                vValue.textContent \u003d vSegments;\r\n\r\n                // Update the surface\r\n                console.log(\&quot;Direct update from sliders: U\u003d\&quot; + uSegments + \&quot;, V\u003d\&quot; + vSegments);\r\n                surface.uSegments \u003d uSegments;\r\n                surface.vSegments \u003d vSegments;\r\n                surface.initialize();\r\n                draw();\r\n            }\r\n        }\r\n\r\n        // Setup granularity sliders with direct event handlers\r\n        function setupGranularitySliders() {\r\n            const uSlider \u003d document.getElementById(\&quot;u-granularity\&quot;);\r\n            const vSlider \u003d document.getElementById(\&quot;v-granularity\&quot;);\r\n            \r\n            if (uSlider \u0026\u0026 vSlider \u0026\u0026 surface) {\r\n                // Set initial values to match model\r\n                uSlider.value \u003d surface.uSegments;\r\n                vSlider.value \u003d surface.vSegments;\r\n                \r\n                document.getElementById(\&quot;u-gran-value\&quot;).textContent \u003d surface.uSegments;\r\n                document.getElementById(\&quot;v-gran-value\&quot;).textContent \u003d surface.vSegments;\r\n                \r\n                console.log(\&quot;Granularity sliders initialized with values:\&quot;, surface.uSegments, surface.vSegments);\r\n            }\r\n        }\r\n    \u003c/script\u003e\r\n\u003c/head\u003e\r\n\u003cbody onload\u003d\&quot;init()\&quot;\u003e\r\n    \u003cdiv class\u003d\&quot;container\&quot;\u003e\r\n        \u003ch1\u003eCornucopia Surface - WebGL Visualization with Phong Shading\u003c/h1\u003e\r\n        \r\n        \u003cdiv class\u003d\&quot;info-panel\&quot;\u003e\r\n            \u003ch2\u003eProject Description\u003c/h2\u003e\r\n            \u003cp\u003eThis visualization demonstrates a 3D model of a \&quot;Cornucopia\&quot; surface rendered using WebGL with Phong shading and Facet Average normal calculation.\u003c/p\u003e\r\n            \u003cp\u003eThe Cornucopia is a special case of a spiral-shaped surface \&quot;Shell without vertex\&quot;. It\u0027s a cyclic surface with generatrix circles of variable radius that creates the distinctive horn-like shape.\u003c/p\u003e\r\n            \r\n            \u003ch2\u003eMathematical Definition\u003c/h2\u003e\r\n            \u003cp\u003eThe Cornucopia surface is defined by the following parametric equations:\u003c/p\u003e\r\n            \r\n            \u003cdiv class\u003d\&quot;math-formula\&quot;\u003e\r\n                \u003cstrong\u003eParametric Equations:\u003c/strong\u003e\u003cbr\u003e\r\n                x(u,v) \u003d [e\u003csup\u003emu\u003c/sup\u003e + e\u003csup\u003epu\u003c/sup\u003ecos(v)]cos(u)\u003cbr\u003e\r\n                y(u,v) \u003d [e\u003csup\u003emu\u003c/sup\u003e + e\u003csup\u003epu\u003c/sup\u003ecos(v)]sin(u)\u003cbr\u003e\r\n                z(u,v) \u003d e\u003csup\u003epu\u003c/sup\u003esin(v)\u003cbr\u003e\u003cbr\u003e\r\n                \r\n                \u003cstrong\u003eWhere:\u003c/strong\u003e\u003cbr\u003e\r\n                - p \u003d 0.15 (parameter p)\u003cbr\u003e\r\n                - m \u003d 0.1 (parameter m)\u003cbr\u003e\r\n                - 0 ≤ u ≤ 5π (lengthwise parameter)\u003cbr\u003e\r\n                - 0 ≤ v ≤ 2π (cross-section parameter)\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv id\u003d\&quot;canvas-holder\&quot;\u003e\r\n            \u003ccanvas width\u003d\&quot;800\&quot; height\u003d\&quot;600\&quot; id\u003d\&quot;webglcanvas\&quot; style\u003d\&quot;background-color:white\&quot;\u003e\u003c/canvas\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv class\u003d\&quot;controls-panel\&quot;\u003e\r\n            \u003ch3\u003eSurface Parameters\u003c/h3\u003e\r\n            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\r\n                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-p\&quot;\u003ep value:\u003c/label\u003e\r\n                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-p\&quot; value\u003d\&quot;0.15\&quot; step\u003d\&quot;0.01\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\r\n                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-m\&quot;\u003em value:\u003c/label\u003e\r\n                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-m\&quot; value\u003d\&quot;0.1\&quot; step\u003d\&quot;0.01\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\r\n                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-u\&quot;\u003eu max (π):\u003c/label\u003e\r\n                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-u\&quot; value\u003d\&quot;5\&quot; step\u003d\&quot;0.5\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\r\n                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-v\&quot;\u003ev max (π):\u003c/label\u003e\r\n                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-v\&quot; value\u003d\&quot;2\&quot; step\u003d\&quot;0.5\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\r\n            \u003c/div\u003e\r\n            \r\n            \u003cbutton id\u003d\&quot;refresh-button\&quot; style\u003d\&quot;margin-top: 10px; padding: 8px 16px; background-color: #0f0; color: black; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;\&quot;\u003eApply Parameters\u003c/button\u003e\r\n            \r\n            \u003cdiv class\u003d\&quot;granularity-section\&quot;\u003e\r\n                \u003ch3\u003eMesh Granularity\u003c/h3\u003e\r\n                \u003cdiv class\u003d\&quot;slider-container\&quot;\u003e\r\n                    \u003cspan class\u003d\&quot;slider-label\&quot;\u003eU Segments:\u003c/span\u003e\r\n                    \u003cinput type\u003d\&quot;range\&quot; min\u003d\&quot;10\&quot; max\u003d\&quot;200\&quot; value\u003d\&quot;80\&quot; class\u003d\&quot;slider\&quot; id\u003d\&quot;u-granularity\&quot; oninput\u003d\&quot;updateMeshGranularity()\&quot;\u003e\r\n                    \u003cspan class\u003d\&quot;slider-value\&quot; id\u003d\&quot;u-gran-value\&quot;\u003e80\u003c/span\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class\u003d\&quot;slider-container\&quot;\u003e\r\n                    \u003cspan class\u003d\&quot;slider-label\&quot;\u003eV Segments:\u003c/span\u003e\r\n                    \u003cinput type\u003d\&quot;range\&quot; min\u003d\&quot;10\&quot; max\u003d\&quot;100\&quot; value\u003d\&quot;40\&quot; class\u003d\&quot;slider\&quot; id\u003d\&quot;v-granularity\&quot; oninput\u003d\&quot;updateMeshGranularity()\&quot;\u003e\r\n                    \u003cspan class\u003d\&quot;slider-value\&quot; id\u003d\&quot;v-gran-value\&quot;\u003e40\u003c/span\u003e\r\n                \u003c/div\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv class\u003d\&quot;info-panel\&quot;\u003e\r\n            \u003ch2\u003eImplementation Details\u003c/h2\u003e\r\n            \u003cp\u003eThis implementation includes:\u003c/p\u003e\r\n            \u003cul\u003e\r\n                \u003cli\u003e\u003cstrong\u003ePhong Shading:\u003c/strong\u003e Realistic lighting with ambient, diffuse, and specular components\u003c/li\u003e\r\n                \u003cli\u003e\u003cstrong\u003eFacet Average Normal:\u003c/strong\u003e Normals are calculated by averaging adjacent facet normals\u003c/li\u003e\r\n                \u003cli\u003e\u003cstrong\u003eRotating Light Source:\u003c/strong\u003e A moving light that circles around the model\u003c/li\u003e\r\n                \u003cli\u003e\u003cstrong\u003eTriangle Mesh:\u003c/strong\u003e The surface is rendered with filled triangles using VBO with indices\u003c/li\u003e\r\n                \u003cli\u003e\u003cstrong\u003eAdjustable Granularity:\u003c/strong\u003e U and V segment sliders allow controlling the mesh density\u003c/li\u003e\r\n            \u003c/ul\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv class\u003d\&quot;student-info\&quot;\u003e\r\n            \u003ch2\u003eStudent Information\u003c/h2\u003e\r\n            \u003cp\u003e\u003cstrong\u003eName:\u003c/strong\u003e Pashchenko Mykola\u003c/p\u003e\r\n            \u003cp\u003e\u003cstrong\u003eGroup:\u003c/strong\u003e TR-51mp\u003c/p\u003e\r\n            \u003cp\u003e\u003cstrong\u003eCourse:\u003c/strong\u003e WebGL Visualization\u003c/p\u003e\r\n            \u003cp\u003e\u003cstrong\u003eAssignment:\u003c/strong\u003e PA#2 - Cornucopia Surface with Phong Shading\u003c/p\u003e\r\n            \u003cp\u003e\u003cstrong\u003eVariant:\u003c/strong\u003e 23 (Phong Shading, Facet Average Normals)\u003c/p\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv class\u003d\&quot;footer\&quot;\u003e\r\n            \u003cp\u003eInteractive WebGL Visualization - Created using JavaScript and WebGL\u003c/p\u003e\r\n            \u003cp\u003eDrag your mouse on the model to rotate it. On a touch screen, you can use your finger.\u003c/p\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n\u003c/body\u003e\r\n\u003c/html\u003e&quot;,&quot;ranges&quot;:[],&quot;type&quot;:&quot;current_file&quot;},{&quot;file_path&quot;:&quot;cornucopia3.js&quot;,&quot;code_text&quot;:&quot;\u0027use strict\u0027;\r\n\r\n/**\r\n * Cornucopia Surface - Parametric Surface Implementation with Phong Shading\r\n * \r\n * Parameters:\r\n * p \u003d 0.15; m \u003d 0.1\r\n * 0 ≤ u ≤ 5π; 0 ≤ v ≤ 2π\r\n * \r\n * Parametric equations:\r\n * x(u,v) \u003d [e^(mu) + e^(pu)cos(v)]cos(u)\r\n * y(u,v) \u003d [e^(mu) + e^(pu)cos(v)]sin(u)\r\n * z(u,v) \u003d e^(pu)sin(v)\r\n */\r\n\r\n// Global variables\r\nlet gl;                 // WebGL context\r\nlet surface;            // Cornucopia surface model\r\nlet shProgram;          // Shader program\r\nlet spaceball;          // Trackball rotator\r\nlet lightAngle \u003d 0;     // Angle for rotating light\r\nlet lightRadius \u003d 60;   // Distance of light from origin\r\nlet meshUpdateNeeded \u003d false;  // Flag to indicate if the mesh needs to be updated\r\n\r\n/**\r\n * CornucopiaModel class to create and render the surface\r\n */\r\nfunction CornucopiaModel() {\r\n    // Surface parameters - exactly as shown in Fig. 2\r\n    this.p \u003d 0.15;\r\n    this.m \u003d 0.1;\r\n    this.uMin \u003d 0;\r\n    this.uMax \u003d 5 * Math.PI;\r\n    this.vMin \u003d 0;\r\n    this.vMax \u003d 2 * Math.PI;\r\n    \r\n    // Number of segments for the grid (adjustable via sliders)\r\n    this.uSegments \u003d 80;\r\n    this.vSegments \u003d 40;\r\n    \r\n    // Buffers for the triangular mesh\r\n    this.vertexBuffer \u003d null;\r\n    this.normalBuffer \u003d null;\r\n    this.indexBuffer \u003d null;\r\n    this.numVertices \u003d 0;\r\n    this.numIndices \u003d 0;\r\n\r\n    // Array to store vertex positions for normal calculation\r\n    this.vertices \u003d [];\r\n    this.normals \u003d [];\r\n    this.indices \u003d [];\r\n    \r\n    /**\r\n     * Calculate a point on the surface using the parametric equations\r\n     */\r\n    this.computePoint \u003d function(u, v) {\r\n        const ePu \u003d Math.exp(this.p * u); // e^(pu)\r\n        const eMu \u003d Math.exp(this.m * u); // e^(mu)\r\n        \r\n        return {\r\n            x: (eMu + ePu * Math.cos(v)) * Math.cos(u),\r\n            y: (eMu + ePu * Math.cos(v)) * Math.sin(u),\r\n            z: ePu * Math.sin(v)\r\n        };\r\n    };\r\n    \r\n    /**\r\n     * Calculate the analytical normal at a point by computing the cross product\r\n     * of the tangent vectors along u and v directions\r\n     */\r\n    this.computeAnalyticalNormal \u003d function(u, v) {\r\n        const ePu \u003d Math.exp(this.p * u);\r\n        const eMu \u003d Math.exp(this.m * u);\r\n        \r\n        // Partial derivative with respect to u\r\n        const dxdu \u003d -1 * (eMu + ePu * Math.cos(v)) * Math.sin(u) \r\n                   + (this.m * eMu + this.p * ePu * Math.cos(v)) * Math.cos(u);\r\n        const dydu \u003d (eMu + ePu * Math.cos(v)) * Math.cos(u) \r\n                   + (this.m * eMu + this.p * ePu * Math.cos(v)) * Math.sin(u);\r\n        const dzdu \u003d this.p * ePu * Math.sin(v);\r\n        \r\n        // Partial derivative with respect to v\r\n        const dxdv \u003d -1 * ePu * Math.sin(v) * Math.cos(u);\r\n        const dydv \u003d -1 * ePu * Math.sin(v) * Math.sin(u);\r\n        const dzdv \u003d ePu * Math.cos(v);\r\n        \r\n        // Cross product to find normal vector\r\n        const nx \u003d dydu * dzdv - dzdu * dydv;\r\n        const ny \u003d dzdu * dxdv - dxdu * dzdv;\r\n        const nz \u003d dxdu * dydv - dydu * dxdv;\r\n        \r\n        // Normalize the normal vector\r\n        const length \u003d Math.sqrt(nx*nx + ny*ny + nz*nz);\r\n        return {\r\n            x: nx / length,\r\n            y: ny / length,\r\n            z: nz / length\r\n        };\r\n    };\r\n    \r\n    /**\r\n     * Generate the triangular mesh vertices and indices\r\n     */\r\n    this.generateMesh \u003d function() {\r\n        console.log(\&quot;Generating mesh with segments: U\u003d\&quot; + this.uSegments + \&quot;, V\u003d\&quot; + this.vSegments);\r\n        \r\n        this.vertices \u003d [];\r\n        this.normals \u003d [];\r\n        this.indices \u003d [];\r\n        \r\n        // Generate vertices\r\n        for (let uIndex \u003d 0; uIndex \u003c\u003d this.uSegments; uIndex++) {\r\n            const u \u003d this.uMin + (uIndex / this.uSegments) * (this.uMax - this.uMin);\r\n            \r\n            for (let vIndex \u003d 0; vIndex \u003c\u003d this.vSegments; vIndex++) {\r\n                const v \u003d this.vMin + (vIndex / this.vSegments) * (this.vMax - this.vMin);\r\n                const point \u003d this.computePoint(u, v);\r\n                \r\n                // Store vertex\r\n                this.vertices.push(point.x, point.y, point.z);\r\n                \r\n                // Calculate analytical normal for now (will be replaced with facet average)\r\n                const normal \u003d this.computeAnalyticalNormal(u, v);\r\n                this.normals.push(normal.x, normal.y, normal.z);\r\n            }\r\n        }\r\n        \r\n        // Generate indices for triangle strips\r\n        for (let uIndex \u003d 0; uIndex \u003c this.uSegments; uIndex++) {\r\n            for (let vIndex \u003d 0; vIndex \u003c this.vSegments; vIndex++) {\r\n                const vertexIndex \u003d uIndex * (this.vSegments + 1) + vIndex;\r\n                \r\n                // First triangle\r\n                this.indices.push(vertexIndex);\r\n                this.indices.push(vertexIndex + 1);\r\n                this.indices.push(vertexIndex + this.vSegments + 1);\r\n                \r\n                // Second triangle\r\n                this.indices.push(vertexIndex + 1);\r\n                this.indices.push(vertexIndex + this.vSegments + 2);\r\n                this.indices.push(vertexIndex + this.vSegments + 1);\r\n            }\r\n        }\r\n        \r\n        this.numVertices \u003d this.vertices.length / 3;\r\n        this.numIndices \u003d this.indices.length;\r\n    };\r\n    \r\n    /**\r\n     * Calculate facet normals for each triangle\r\n     */\r\n    this.calculateFacetNormals \u003d function() {\r\n        const facetNormals \u003d [];\r\n        \r\n        // Initialize facet normals array\r\n        for (let i \u003d 0; i \u003c this.numIndices / 3; i++) {\r\n            facetNormals.push({ x: 0, y: 0, z: 0 });\r\n        }\r\n        \r\n        // Calculate normal for each triangle\r\n        for (let i \u003d 0; i \u003c this.numIndices; i +\u003d 3) {\r\n            const idx1 \u003d this.indices[i];\r\n            const idx2 \u003d this.indices[i + 1];\r\n            const idx3 \u003d this.indices[i + 2];\r\n            \r\n            const v1x \u003d this.vertices[idx1 * 3];\r\n            const v1y \u003d this.vertices[idx1 * 3 + 1];\r\n            const v1z \u003d this.vertices[idx1 * 3 + 2];\r\n            \r\n            const v2x \u003d this.vertices[idx2 * 3];\r\n            const v2y \u003d this.vertices[idx2 * 3 + 1];\r\n            const v2z \u003d this.vertices[idx2 * 3 + 2];\r\n            \r\n            const v3x \u003d this.vertices[idx3 * 3];\r\n            const v3y \u003d this.vertices[idx3 * 3 + 1];\r\n            const v3z \u003d this.vertices[idx3 * 3 + 2];\r\n            \r\n            // Calculate vectors for two sides of the triangle\r\n            const ax \u003d v2x - v1x;\r\n            const ay \u003d v2y - v1y;\r\n            const az \u003d v2z - v1z;\r\n            \r\n            const bx \u003d v3x - v1x;\r\n            const by \u003d v3y - v1y;\r\n            const bz \u003d v3z - v1z;\r\n            \r\n            // Cross product to get normal\r\n            const nx \u003d ay * bz - az * by;\r\n            const ny \u003d az * bx - ax * bz;\r\n            const nz \u003d ax * by - ay * bx;\r\n            \r\n            // Normalize\r\n            const length \u003d Math.sqrt(nx*nx + ny*ny + nz*nz);\r\n            \r\n            if (length \u003e 0) {\r\n                facetNormals[i/3] \u003d {\r\n                    x: nx / length,\r\n                    y: ny / length,\r\n                    z: nz / length\r\n                };\r\n            } else {\r\n                facetNormals[i/3] \u003d {\r\n                    x: 0,\r\n                    y: 0,\r\n                    z: 1  // Default normal if length is zero\r\n                };\r\n            }\r\n        }\r\n        \r\n        return facetNormals;\r\n    };\r\n    \r\n    /**\r\n     * Calculate vertex normals using facet average method\r\n     */\r\n    this.calculateFacetAverageNormals \u003d function() {\r\n        // Reset normals array\r\n        this.normals \u003d new Array(this.numVertices * 3).fill(0);\r\n        \r\n        // Get facet normals\r\n        const facetNormals \u003d this.calculateF