n 29|        gl.bindBuffer(gl.ARRAY_BUFFER, this.iVertexBuffer);\n 30|        gl.vertexAttribPointer(shProgram.iAttribVertex, 3, gl.FLOAT, false, 0, 0);\n 31|        gl.enableVertexAttribArray(shProgram.iAttribVertex);\n 32|   \n 33|        gl.drawArrays(gl.LINE_STRIP, 0, this.count);\n 34|    }\n 35|}\n 36|\n 37|\n 38|// Constructor\n 39|function ShaderProgram(name, program) {\n 40|\n 41|    this.name \u003d name;\n 42|    this.prog \u003d program;\n 43|\n 44|    // Location of the attribute variable in the shader program.\n 45|    this.iAttribVertex \u003d -1;\n 46|    // Location of the uniform specifying a color for the primitive.\n 47|    this.iColor \u003d -1;\n 48|    // Location of the uniform matrix representing the combined transformation.\n 49|    this.iModelViewProjectionMatrix \u003d -1;\n 50|\n 51|    this.Use \u003d function() {\n 52|        gl.useProgram(this.prog);\n 53|    }\n 54|}\n 55|\n 56|\n 57|/* Draws a colored cube, along with a set of coordinate axes.\n 58| * (Note that the use of the above drawPrimitive function is not an efficient\n 59| * way to draw with WebGL.  Here, the geometry is so simple that it doesn\u0027t matter.)\n 60| */\n 61|function draw() { \n 62|    gl.clearColor(0,0,0,1);\n 63|    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);\n 64|    \n 65|    /* Set the values of the projection transformation */\n 66|    let projection \u003d m4.perspective(Math.PI/8, 1, 8, 12); \n 67|    \n 68|    /* Get the view matrix from the SimpleRotator object.*/\n 69|    let modelView \u003d spaceball.getViewMatrix();\n 70|\n 71|    let rotateToPointZero \u003d m4.axisRotation([0.707,0.707,0], 0.7);\n 72|    let translateToPointZero \u003d m4.translation(0,0,-10);\n 73|\n 74|    let matAccum0 \u003d m4.multiply(rotateToPointZero, modelView );\n 75|    let matAccum1 \u003d m4.multiply(translateToPointZero, matAccum0 );\n 76|        \n 77|    /* Multiply the projection matrix times the modelview matrix to give the\n 78|       combined transformation matrix, and send that to the shader program. */\n 79|    let modelViewProjection \u003d m4.multiply(projection, matAccum1 );\n 80|\n 81|    gl.uniformMatrix4fv(shProgram.iModelViewProjectionMatrix, false, modelViewProjection );\n 82|    \n 83|    /* Draw the six faces of a cube, with different colors. */\n 84|    gl.uniform4fv(shProgram.iColor, [1,1,0,1] );\n 85|\n 86|    surface.Draw();\n 87|}\n 88|\n 89|function CreateSurfaceData()\n 90|{\n 91|    let vertexList \u003d [];\n 92|\n 93|    for (let i\u003d0; i\u003c360; i+\u003d5) {\n 94|        vertexList.push( Math.sin(deg2rad(i)), 1, Math.cos(deg2rad(i)) );\n 95|        vertexList.push( Math.sin(deg2rad(i)), 0, Math.cos(deg2rad(i)) );\n 96|    }\n 97|\n 98|    return vertexList;\n 99|}\n100|\n101|\n102|/* Initialize the WebGL context. Called from init() */\n103|function initGL() {\n104|    let prog \u003d createProgram( gl, vertexShaderSource, fragmentShaderSource );\n105|\n106|    shProgram \u003d new ShaderProgram(\u0027Basic\u0027, prog);\n107|    shProgram.Use();\n108|\n109|    shProgram.iAttribVertex              \u003d gl.getAttribLocation(prog, \&quot;vertex\&quot;);\n110|    shProgram.iModelViewProjectionMatrix \u003d gl.getUniformLocation(prog, \&quot;ModelViewProjectionMatrix\&quot;);\n111|    shProgram.iColor                     \u003d gl.getUniformLocation(prog, \&quot;color\&quot;);\n112|\n113|    surface \u003d new Model(\u0027Surface\u0027);\n114|    surface.BufferData(CreateSurfaceData());\n115|\n116|    gl.enable(gl.DEPTH_TEST);\n117|}\n118|\n119|\n120|/* Creates a program for use in the WebGL context gl, and returns the\n121| * identifier for that program.  If an error occurs while compiling or\n122| * linking the program, an exception of type Error is thrown.  The error\n123| * string contains the compilation or linking error.  If no error occurs,\n124| * the program identifier is the return value of the function.\n125| * The second and third parameters are strings that contain the\n126| * source code for the vertex shader and for the fragment shader.\n127| */\n128|function createProgram(gl, vShader, fShader) {\n129|    let vsh \u003d gl.createShader( gl.VERTEX_SHADER );\n130|    gl.shaderSource(vsh,vShader);\n131|    gl.compileShader(vsh);\n132|    if ( ! gl.getShaderParameter(vsh, gl.COMPILE_STATUS) ) {\n133|        throw new Error(\&quot;Error in vertex shader:  \&quot; + gl.getShaderInfoLog(vsh));\n134|     }\n135|    let fsh \u003d gl.createShader( gl.FRAGMENT_SHADER );\n136|    gl.shaderSource(fsh, fShader);\n137|    gl.compileShader(fsh);\n138|    if ( ! gl.getShaderParameter(fsh, gl.COMPILE_STATUS) ) {\n139|       throw new Error(\&quot;Error in fragment shader:  \&quot; + gl.getShaderInfoLog(fsh));\n140|    }\n141|    let prog \u003d gl.createProgram();\n142|    gl.attachShader(prog,vsh);\n143|    gl.attachShader(prog, fsh);\n144|    gl.linkProgram(prog);\n145|    if ( ! gl.getProgramParameter( prog, gl.LINK_STATUS) ) {\n146|       throw new Error(\&quot;Link error in program:  \&quot; + gl.getProgramInfoLog(prog));\n147|    }\n148|    return prog;\n149|}\n150|\n151|\n152|/**\n153| * initialization function that will be called when the page has loaded\n154| */\n155|function init() {\n156|    let canvas;\n157|    try {\n158|        canvas \u003d document.getElementById(\&quot;webglcanvas\&quot;);\n159|        gl \u003d canvas.getContext(\&quot;webgl\&quot;);\n160|        if ( ! gl ) {\n161|            throw \&quot;Browser does not support WebGL\&quot;;\n162|        }\n163|    }\n164|    catch (e) {\n165|        document.getElementById(\&quot;canvas-holder\&quot;).innerHTML \u003d\n166|            \&quot;\u003cp\u003eSorry, could not get a WebGL graphics context.\u003c/p\u003e\&quot;;\n167|        return;\n168|    }\n169|    try {\n170|        initGL();  // initialize the WebGL graphics context\n171|    }\n172|    catch (e) {\n173|        document.getElementById(\&quot;canvas-holder\&quot;).innerHTML \u003d\n174|            \&quot;\u003cp\u003eSorry, could not initialize the WebGL graphics context: \&quot; + e + \&quot;\u003c/p\u003e\&quot;;\n175|        return;\n176|    }\n177|\n178|    spaceball \u003d new TrackballRotator(canvas, draw, 0);\n179|\n180|    draw();\n181|}\n182|&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;Let\u0027s also check the shader file:&quot;}],&quot;tool_calls&quot;:[{&quot;id&quot;:&quot;toolu_01NJDQLZUrBgRg6UG37yAZeF&quot;,&quot;type&quot;:&quot;function&quot;,&quot;function&quot;:{&quot;name&quot;:&quot;read_file&quot;,&quot;arguments&quot;:&quot;{\&quot;target_file\&quot;: \&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL/shader.gpu\&quot;}&quot;}}]},{&quot;role&quot;:&quot;tool&quot;,&quot;name&quot;:&quot;read&quot;,&quot;tool_call_id&quot;:&quot;toolu_01NJDQLZUrBgRg6UG37yAZeF&quot;,&quot;content&quot;:&quot; 1|\n 2|\n 3|// Vertex shader\n 4|const vertexShaderSource \u003d `\n 5|attribute vec3 vertex;\n 6|uniform mat4 ModelViewProjectionMatrix;\n 7|\n 8|void main() {\n 9|    gl_Position \u003d ModelViewProjectionMatrix * vec4(vertex,1.0);\n10|}`;\n11|\n12|\n13|// Fragment shader\n14|const fragmentShaderSource \u003d `\n15|#ifdef GL_FRAGMENT_PRECISION_HIGH\n16|   precision highp float;\n17|#else\n18|   precision mediump float;\n19|#endif\n20|\n21|uniform vec4 color;\n22|void main() {\n23|    gl_FragColor \u003d color;\n24|}`;&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;Let\u0027s check what utility files are included:&quot;}],&quot;tool_calls&quot;:[{&quot;id&quot;:&quot;toolu_01XfhTTcjrq9ESCTMhacUS2e&quot;,&quot;type&quot;:&quot;function&quot;,&quot;function&quot;:{&quot;name&quot;:&quot;read_file&quot;,&quot;arguments&quot;:&quot;{\&quot;target_file\&quot;: \&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL/Utils/trackball-rotator.js\&quot;}&quot;}}]},{&quot;role&quot;:&quot;tool&quot;,&quot;name&quot;:&quot;read&quot;,&quot;tool_call_id&quot;:&quot;toolu_01XfhTTcjrq9ESCTMhacUS2e&quot;,&quot;content&quot;:&quot;  1|/**\n  2| * An object of type TrackballRotator can be used to implement a trackball-like mouse rotation\n  3| * of a WebGL scene about the origin.  Only the first parameter to the constructor is required.\n  4| * When an object is created, mouse event handlers are set up on the canvas to respond to rotation.\n  5| * It will also work with a touchscreen.\n  6| * \n  7| * The class defines the following methods for an object rotator of type SimpleRotator:\n  8| *\n  9| *    rotator.getViewMatrix() returns the view transformation matrix as a regular JavaScript\n 10| *         array of 16 elements, in column-major orde, suitable for use with gl.uniformMatrix4fv\n 11| *         or for further transformation with the glMatrix library mat4 class.\n 12| *    rotator.setView(viewDistance, viewpointDirection, viewUp) set up the view, where the\n 13| *         parameters are optional and are used in the same way as the corresponding parameters\n 14| *         in the constructor.\n 15| *    rotator.setViewDistance(viewDistance) sets the distance of the viewer from the origin without\n 16| *         changing the direction of view. The parameter must be a positive number.\n 17| *    rotator.getViewDistance() returns the current value.\n 18| *    rotator.setRotationCenter( vector ) -- Sets the center of rotation.\n 19| *       The parameter must be an array of (at least) three numbers.  The\n 20| *       view is rotated about this point.  Usually, you want the rotation\n 21| *       center to be the point that appears at the middle of the canvas,\n 22| *       but that is not a requirement.  The initial value is effectively\n 23| *       equal to [0,0,0].\n 24| *    rotator.getRotationCenter() -- returns the current value.\n 25| *\n 26| * @param canvas the HTML canvas element used for WebGL drawing.  The user will rotate the\n 27| *    scene 