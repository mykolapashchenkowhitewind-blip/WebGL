is.uMax \u003d 5 * Math.PI; // Maximum u value (5π)\r\n    this.vMin \u003d 0;           // Minimum v value (0)\r\n    this.vMax \u003d 2 * Math.PI; // Maximum v value (2π)\r\n    \r\n    // Segment counts - higher density to match Fig. 2\u0027s detailed grid\r\n    this.uSegments \u003d 150;    // Longitudinal segments \r\n    this.vSegments \u003d 60;     // Circular segments - increased to match Fig. 2\u0027s finer grid\r\n    \r\n    // No longer need a separate radius function with the new formula\r\n    \r\n    /**\r\n     * Calculate the 3D point coordinates for parameters u, v\r\n     * Exactly matching the formula in the Mathematical Definition section:\r\n     * x(u,v) \u003d [e^(mu) + e^(pu)cos(v)]cos(u)\r\n     * y(u,v) \u003d [e^(mu) + e^(pu)cos(v)]sin(u)\r\n     * z(u,v) \u003d e^(pu)sin(v)\r\n     */\r\n    this.surfacePoint \u003d function(u, v) {\r\n        const ePu \u003d Math.exp(this.p * u);  // e^(pu)\r\n        const eMu \u003d Math.exp(this.m * u);  // e^(mu)\r\n        \r\n        return {\r\n            x: (eMu + ePu * Math.cos(v)) * Math.cos(u),\r\n            y: (eMu + ePu * Math.cos(v)) * Math.sin(u),\r\n            z: ePu * Math.sin(v)\r\n        };\r\n    };\r\n    \r\n    /**\r\n     * Generate vertices for U polylines (longitudinal lines)\r\n     */\r\n    this.generateULines \u003d function() {\r\n        let vertexList \u003d [];\r\n        \r\n        // Distribute the v lines evenly to create the grid pattern seen in Fig. 2\r\n        const vStep \u003d (this.vMax - this.vMin) / this.vSegments;\r\n        for (let vi \u003d 0; vi \u003c\u003d this.vSegments; vi++) {\r\n            const v \u003d this.vMin + vi * vStep;\r\n            \r\n            // Use more points at the beginning of the u range to better define the bulbous part\r\n            for (let ui \u003d 0; ui \u003c\u003d this.uSegments; ui++) {\r\n                // Slight non-linear distribution to match Fig. 2\u0027s grid density\r\n                const t \u003d ui / this.uSegments;\r\n                const u \u003d this.uMin + (Math.pow(t, 1.05)) * (this.uMax - this.uMin);\r\n                const point \u003d this.surfacePoint(u, v);\r\n                vertexList.push(point.x, point.y, point.z);\r\n            }\r\n        }\r\n        \r\n        this.uLinesCount \u003d vertexList.length / 3;\r\n        gl.bindBuffer(gl.ARRAY_BUFFER, this.uLinesBuffer);\r\n        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(vertexList), gl.STATIC_DRAW);\r\n    };\r\n    \r\n    /**\r\n     * Generate vertices for V polylines (circular cross-sections)\r\n     */\r\n    this.generateVLines \u003d function() {\r\n        // Generate circular cross-sections with distribution that highlights the bulbous shape\r\n        const numCircles \u003d 70; // More circles for finer detail\r\n        let circleVertices \u003d [];\r\n        \r\n        // Use non-linear distribution to concentrate more circles in the bulbous part\r\n        // This helps match the appearance in Fig. 2 which shows more detail in the spherical areas\r\n        for (let i \u003d 0; i \u003c numCircles; i++) {\r\n            // Non-linear distribution that concentrates circles in the central part\r\n            // This emphasizes the spherical bulbous shape seen in Fig. 2\r\n            let t \u003d i / (numCircles - 1);\r\n            // Concentrate more circles in the middle section for bulbous shape\r\n            const u \u003d this.uMin + (0.1 + 0.9 * Math.pow(t, 0.95)) * (this.uMax - this.uMin);\r\n            \r\n            for (let vi \u003d 0; vi \u003c\u003d this.vSegments; vi++) {\r\n                const v \u003d this.vMin + (vi / this.vSegments) * (this.vMax - this.vMin);\r\n                const point \u003d this.surfacePoint(u, v);\r\n                circleVertices.push(point.x, point.y, point.z);\r\n            }\r\n        }\r\n        \r\n        this.vLinesCount \u003d circleVertices.length / 3;\r\n        gl.bindBuffer(gl.ARRAY_BUFFER, this.vLinesB