-size: 28px;\r\n        }\r\n        h2 {\r\n            font-size: 22px;\r\n            margin-top: 25px;\r\n        }\r\n        .container {\r\n            max-width: 1000px;\r\n            margin: 0 auto;\r\n            padding: 20px;\r\n        }\r\n        #canvas-holder {\r\n            margin: 20px auto;\r\n            width: 800px;\r\n        }\r\n        canvas {\r\n            border: 1px solid #0f0;\r\n            display: block;\r\n            margin: 0 auto;\r\n        }\r\n        .info-panel {\r\n            text-align: left;\r\n            background-color: rgba(0, 50, 0, 0.3);\r\n            border: 1px solid #0f0;\r\n            padding: 20px;\r\n            border-radius: 5px;\r\n            margin: 20px auto;\r\n            max-width: 800px;\r\n        }\r\n        .controls-panel {\r\n            margin: 20px auto;\r\n            display: inline-block;\r\n            background-color: rgba(0, 30, 0, 0.7);\r\n            padding: 15px;\r\n            border-radius: 5px;\r\n            text-align: left;\r\n            width: 90%;\r\n            box-sizing: border-box;\r\n        }\r\n        .math-formula {\r\n            background-color: rgba(0, 30, 0, 0.5);\r\n            padding: 15px;\r\n            border-radius: 5px;\r\n            margin: 15px 0;\r\n            font-family: \&quot;Courier New\&quot;, monospace;\r\n        }\r\n        .footer {\r\n            margin-top: 30px;\r\n            font-size: 14px;\r\n            color: #aaa;\r\n            border-top: 1px solid #333;\r\n            padding-top: 15px;\r\n        }\r\n        .student-info {\r\n            text-align: left;\r\n            background-color: rgba(0, 40, 0, 0.3);\r\n            border-left: 3px solid #0f0;\r\n            padding: 10px 20px;\r\n            margin: 25px auto;\r\n            max-width: 600px;\r\n        }\r\n        .slider-container {\r\n            margin: 15px 0;\r\n            display: flex;\r\n            align-items: center;\r\n            justif