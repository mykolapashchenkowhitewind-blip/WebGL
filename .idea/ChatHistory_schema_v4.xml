-1;\n352|    \n353|    this.use \u003d function() {\n354|        gl.useProgram(this.prog);\n355|    };\n356|}\n357|\n358|/**\n359| * Calculate the normal matrix from the model-view matrix\n360| * Normal matrix is the transpose of the inverse of the top-left 3x3 of the model-view matrix\n361| */\n362|function calculateNormalMatrix(modelViewMatrix, resultMatrix) {\n363|    // Extract the 3x3 portion\n364|    let a00 \u003d modelViewMatrix[0], a01 \u003d modelViewMatrix[1], a02 \u003d modelViewMatrix[2];\n365|    let a10 \u003d modelViewMatrix[4], a11 \u003d modelViewMatrix[5], a12 \u003d modelViewMatrix[6];\n366|    let a20 \u003d modelViewMatrix[8], a21 \u003d modelViewMatrix[9], a22 \u003d modelViewMatrix[10];\n367|    \n368|    // Calculate the determinant\n369|    let det \u003d a00 * (a11 * a22 - a12 * a21) -\n370|              a01 * (a10 * a22 - a12 * a20) +\n371|              a02 * (a10 * a21 - a11 * a20);\n372|    \n373|    if (!det) {\n374|        return resultMatrix || [1, 0, 0, 0, 1, 0, 0, 0, 1]; // Return identity if no det\n375|    }\n376|    \n377|    det \u003d 1.0 / det;\n378|    \n379|    if (!resultMatrix) {\n380|        resultMatrix \u003d new Float32Array(9);\n381|    }\n382|    \n383|    // Calculate the inverse\n384|    resultMatrix[0] \u003d (a11 * a22 - a12 * a21) * det;\n385|    resultMatrix[1] \u003d (a02 * a21 - a01 * a22) * det;\n386|    resultMatrix[2] \u003d (a01 * a12 - a02 * a11) * det;\n387|    resultMatrix[3] \u003d (a12 * a20 - a10 * a22) * det;\n388|    resultMatrix[4] \u003d (a00 * a22 - a02 * a20) * det;\n389|    resultMatrix[5] \u003d (a02 * a10 - a00 * a12) * det;\n390|    resultMatrix[6] \u003d (a10 * a21 - a11 * a20) * det;\n391|    resultMatrix[7] \u003d (a01 * a20 - a00 * a21) * det;\n392|    resultMatrix[8] \u003d (a00 * a11 - a01 * a10) * det;\n393|    \n394|    return resultMatrix;\n395|}\n396|\n397|/**\n398| * Update the light position for animation\n399| */\n400|function updateLightPosition() {\n401|    // Rotate light around the surface\n402|    lightAngle +\u003d 0.01;\n403|    if (lightAngle \u003e 2 * Math.PI) {\n404|        lightAngle -\u003d 2 * Math.PI;\n405|    }\n406|    \n407|    // Calculate light position (circular orbit)\n408|    const lightX \u003d lightRadius * Math.cos(lightAngle);\n409|    const lightY \u003d lightRadius * Math.sin(lightAngle);\n410|    const lightZ \u003d 20; // Height of the light\n411|    \n412|    return [lightX, lightY, lightZ];\n413|}\n414|\n415|/**\n416| * Draw function\n417| */\n418|function draw() {\n419|    // Apply mesh updates if needed\n420|    if (meshUpdateNeeded) {\n421|        updateMeshFromSliders();\n422|        meshUpdateNeeded \u003d false;\n423|    }\n424|    \n425|    gl.clearColor(0, 0, 0, 1);\n426|    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);\n427|    \n428|    // Set up viewport\n429|    gl.viewport(0, 0, gl.canvas.width, gl.canvas.height);\n430|    \n431|    // Create custom transformation matrices\n432|    const aspect \u003d gl.canvas.width/gl.canvas.height;\n433|    const znear \u003d 1;\n434|    const zfar \u003d 200;\n435|    const fov \u003d Math.PI/3; // 60 degrees field of view\n436|    \n437|    // Create a projection matrix\n438|    const projectionMatrix \u003d m4.perspective(fov, aspect, znear, zfar);\n439|    \n440|    // Get user rotation from trackball\n441|    let modelViewMatrix \u003d spaceball.getViewMatrix();\n442|    \n443|    // Translate back to see the whole structure\n444|    const moveBack \u003d m4.translation(0, 0, -50);\n445|    \n446|    // Update light position for animation\n447|    const lightPosition \u003d updateLightPosition();\n448|    \n449|    // Apply transformations (right to left)\n450|    modelViewMatrix \u003d m4.multiply(moveBack, modelViewMatrix);\n451|    \n452|    // Calculate the combined model-view-projection matrix\n453|    const mvpMatrix \u003d m4.multiply(projectionMatrix, modelViewMatrix);\n454|    \n455|    // Calculate normal matrix (for transforming normals)\n456|    const normalMatrix \u003d calculateNormalMatrix(modelViewMatrix, new Float32Array(9));\n457|    \n458|    // Set shader uniforms\n459|    gl.uniformMatrix4fv(shProgram.iModelViewProjectionMatrix, false, mvpMatrix);\n460|    gl.uniformMatrix4fv(shProgram.iModelViewMatrix, false, modelViewMatrix);\n461|    gl.uniformMatrix3fv(shProgram.iNormalMatrix, false, normalMatrix);\n462|    gl.uniform3fv(shProgram.iLightPosition, lightPosition);\n463|    \n464|    // Draw the model\n465|    surface.draw(shProgram);\n466|    \n467|    // Request next frame for animation\n468|    requestAnimationFrame(draw);\n469|}\n470|\n471|/**\n472| * Update mesh from slider values\n473| */\n474|function updateMeshFromSliders() {\n475|    const uGranSlider \u003d document.getElementById(\&quot;u-granularity\&quot;);\n476|    const vGranSlider \u003d document.getElementById(\&quot;v-granularity\&quot;);\n477|    \n478|    if (uGranSlider \u0026\u0026 vGranSlider) {\n479|        const uSegments \u003d parseInt(uGranSlider.value);\n480|        const vSegments \u003d parseInt(vGranSlider.value);\n481|        \n482|        // Update the display values\n483|        document.getElementById(\&quot;u-gran-value\&quot;).textContent \u003d uSegments;\n484|        document.getElementById(\&quot;v-gran-value\&quot;).textContent \u003d vSegments;\n485|        \n486|        console.log(\&quot;Updating mesh from sliders: U\u003d\&quot; + uSegments + \&quot;, V\u003d\&quot; + vSegments);\n487|        \n488|        // Update the surface\n489|        if (surface) {\n490|            surface.updateGranularity(uSegments, vSegments);\n491|        }\n492|    }\n493|}\n494|\n495|/**\n496| * Create shader program\n497| */\n498|function createProgram(gl, vertexShaderSource, fragmentShaderSource) {\n499|    // Create and compile vertex shader\n500|    let vsh \u003d gl.createShader(gl.VERTEX_SHADER);\n501|    gl.shaderSource(vsh, vertexShaderSource);\n502|    gl.compileShader(vsh);\n503|    if (!gl.getShaderParameter(vsh, gl.COMPILE_STATUS)) {\n504|        throw new Error(\&quot;Error in vertex shader: \&quot; + gl.getShaderInfoLog(vsh));\n505|    }\n506|    \n507|    // Create and compile fragment shader\n508|    let fsh \u003d gl.createShader(gl.FRAGMENT_SHADER);\n509|    gl.shaderSource(fsh, fragmentShaderSource);\n510|    gl.compileShader(fsh);\n511|    if (!gl.getShaderParameter(fsh, gl.COMPILE_STATUS)) {\n512|        throw new Error(\&quot;Error in fragment shader: \&quot; + gl.getShaderInfoLog(fsh));\n513|    }\n514|    \n515|    // Create program and link shaders\n516|    let prog \u003d gl.createProgram();\n517|    gl.attachShader(prog, vsh);\n518|    gl.attachShader(prog, fsh);\n519|    gl.linkProgram(prog);\n520|    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {\n521|        throw new Error(\&quot;Link error in program: \&quot; + gl.getProgramInfoLog(prog));\n522|    }\n523|    \n524|    return prog;\n525|}\n526|\n527|/**\n528| * Initialize WebGL\n529| */\n530|function initGL() {\n531|    // Create shader program\n532|    let prog \u003d createProgram(gl, vertexShaderSource, fragmentShaderSource);\n533|    \n534|    // Create shader program object\n535|    shProgram \u003d new ShaderProgram(\&quot;Basic\&quot;, prog);\n536|    shProgram.use();\n537|    \n538|    // Get attribute and uniform locations\n539|    shProgram.iAttribVertex \u003d gl.getAttribLocation(prog, \&quot;vertex\&quot;);\n540|    shProgram.iAttribNormal \u003d gl.getAttribLocation(prog, \&quot;normal\&quot;);\n541|    shProgram.iModelViewProjectionMatrix \u003d gl.getUniformLocation(prog, \&quot;ModelViewProjectionMatrix\&quot;);\n542|    shProgram.iModelViewMatrix \u003d gl.getUniformLocation(prog, \&quot;ModelViewMatrix\&quot;);\n543|    shProgram.iNormalMatrix \u003d gl.getUniformLocation(prog, \&quot;NormalMatrix\&quot;);\n544|    shProgram.iLightPosition \u003d gl.getUniformLocation(prog, \&quot;lightPosition\&quot;);\n545|    shProgram.iMaterialAmbient \u003d gl.getUniformLocation(prog, \&quot;materialAmbient\&quot;);\n546|    shProgram.iMaterialDiffuse \u003d gl.getUniformLocation(prog, \&quot;materialDiffuse\&quot;);\n547|    shProgram.iMaterialSpecular \u003d gl.getUniformLocation(prog, \&quot;materialSpecular\&quot;);\n548|    shProgram.iShininess \u003d gl.getUniformLocation(prog, \&quot;shininess\&quot;);\n549|    \n550|    // Create model\n551|    surface \u003d new CornucopiaModel();\n552|    surface.initialize();\n553|    \n554|    // Enable depth testing\n555|    gl.enable(gl.DEPTH_TEST);\n556|}\n557|\n558|/**\n559| * Set up UI controls\n560| */\n561|function setupControls() {\n562|    const uGranSlider \u003d document.getElementById(\&quot;u-granularity\&quot;);\n563|    const vGranSlider \u003d document.getElementById(\&quot;v-granularity\&quot;);\n564|    \n565|    if (uGranSlider \u0026\u0026 vGranSlider) {\n566|        // Initialize display values\n567|        const uGranValue \u003d document.getElementById(\&quot;u-gran-value\&quot;);\n568|        const vGranValue \u003d document.getElementById(\&quot;v-gran-value\&quot;);\n569|        \n570|        if (uGranValue) uGranValue.textContent \u003d uGranSlider.value;\n571|        if (vGranValue) vGranValue.textContent \u003d vGranSlider.value;\n572|        \n573|        // Set slider values to match current model\n574|        if (surface) {\n575|            uGranSlider.value \u003d surface.uSegments;\n576|            vGranSlider.value \u003d surface.vSegments;\n577|        }\n578|        \n579|        // Add direct input event handlers that update on drag\n580|        uGranSlider.addEventListener(\&quot;input\&quot;, function() {\n581|            if (uGranValue) uGranValue.textContent \u003d uGranSlider.value;\n582|            meshUpdateNeeded \u003d true; // Flag for update on next frame\n583|        });\n584|        \n585|        vGranSlider.addEventListener(\&quot;input\&quot;, function() {\n586|            if (vGranValue) vGranValue.textContent \u003d vGranSlider.value;\n