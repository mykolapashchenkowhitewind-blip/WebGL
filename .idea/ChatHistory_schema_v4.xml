)cos(v)]sin(u)\n 13| * z(u,v) \u003d e^(pu)sin(v)\n 14| */\n 15|\n 16|// Global variables\n 17|let gl;                 // WebGL context\n 18|let surface;            // Cornucopia surface model\n 19|let lightSource;        // Light source object\n 20|let shProgram;          // Shader program\n 21|let spaceball;          // Trackball rotator\n 22|let lightAngle \u003d 0;     // Angle for rotating light\n 23|let lightRotationSpeed \u003d 0.002; // Speed of light rotation (reduced for slower movement)\n 24|let lightRadius \u003d 20;   // Distance of light from origin (moved even closer to the model)\n 25|let meshUpdateNeeded \u003d false;  // Flag to indicate if the mesh needs to be updated\n 26|let lastTime \u003d 0;       // Last frame timestamp for constant movement\n 27|\n 28|/**\n 29| * CornucopiaModel class to create and render the surface\n 30| */\n 31|/**\n 32| * LightSourceModel class for creating and rendering a visible light source\n 33| */\n 34|function LightSourceModel() {\n 35|    this.vertexBuffer \u003d null;\n 36|    this.indexBuffer \u003d null;\n 37|    this.normalBuffer \u003d null;\n 38|    this.vertices \u003d [];\n 39|    this.indices \u003d [];\n 40|    this.normals \u003d [];\n 41|    this.numVertices \u003d 0;\n 42|    this.numIndices \u003d 0;\n 43|    this.position \u003d [0, 0, 0]; // Current position of the light\n 44|    this.radius \u003d .5; // Smaller radius for the light sphere\n 45|    \n 46|    /**\n 47|     * Generate a sphere mesh for the light source\n 48|     */\n 49|    this.generateSphere \u003d function() {\n 50|        // Sphere parameters\n 51|        const segments \u003d 16;\n 52|        const rings \u003d 16;\n 53|        \n 54|        this.vertices \u003d [];\n 55|        this.indices \u003d [];\n 56|        this.normals \u003d [];\n 57|        \n 58|        // Generate vertices\n 59|        for (let ring \u003d 0; ring \u003c\u003d rings; ring++) {\n 60|            const theta \u003d ring * Math.PI / rings;\n 61|            const sinTheta \u003d Math.sin(theta);\n 62|            const cosTheta \u003d Math.cos(theta);\n 63|            \n 64|            for (let segment \u003d 0; segment \u003c\u003d segments; segment++) {\n 65|                const phi \u003d segment * 2 * Math.PI / segments;\n 66|                const sinPhi \u003d Math.sin(phi);\n 67|                const cosPhi \u003d Math.cos(phi);\n 68|                \n 69|                // Vertex position\n 70|                const x \u003d this.radius * cosPhi * sinTheta;\n 71|                const y \u003d this.radius * sinPhi * sinTheta;\n 72|                const z \u003d this.radius * cosTheta;\n 73|                \n 74|                // Add vertex to the array\n 75|                this.vertices.push(x, y, z);\n 76|                \n 77|                // Normal vector is simply the normalized position vector for a sphere\n 78|                this.normals.push(cosPhi * sinTheta, sinPhi * sinTheta, cosTheta);\n 79|            }\n 80|        }\n 81|        \n 82|        // Generate indices for triangle strips\n 83|        for (let ring \u003d 0; ring \u003c rings; ring++) {\n 84|            const ringStart \u003d ring * (segments + 1);\n 85|            const nextRingStart \u003d (ring + 1) * (segments + 1);\n 86|            \n 87|            for (let segment \u003d 0; segment \u003c segments; segment++) {\n 88|                // Triangle 1\n 89|                this.indices.push(ringStart + segment);\n 90|                this.indices.push(nextRingStart + segment);\n 91|                this.indices.push(ringStart + segment + 1);\n 92|                \n 93|                // Triangle 2\n 94|                this.indices.push(ringStart + segment + 1);\n 95|                this.indices.push(nextRingStart + segment);\n 96|                this.indices.push(nextRingStart + segment + 1);\n 97|            }\n 98|        }\n 99|        \n100|        this.numVertices \u003d this.vertices.length / 3;\n101|        this.numIndices \u0