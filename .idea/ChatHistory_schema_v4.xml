eter(fsh, gl.COMPILE_STATUS)) {\n 928|        throw new Error(\&quot;Error in fragment shader: \&quot; + gl.getShaderInfoLog(fsh));\n 929|    }\n 930|    \n 931|    // Create program and link shaders\n 932|    let prog \u003d gl.createProgram();\n 933|    gl.attachShader(prog, vsh);\n 934|    gl.attachShader(prog, fsh);\n 935|    gl.linkProgram(prog);\n 936|    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {\n 937|        throw new Error(\&quot;Link error in program: \&quot; + gl.getProgramInfoLog(prog));\n 938|    }\n 939|    \n 940|    return prog;\n 941|}\n 942|\n 943|/**\n 944| * Initialize WebGL\n 945| */\n 946|function initGL() {\n 947|    // Create shader program\n 948|    let prog \u003d createProgram(gl, vertexShaderSource, fragmentShaderSource);\n 949|    \n 950|    // Create shader program object\n 951|    shProgram \u003d new ShaderProgram(\&quot;Basic\&quot;, prog);\n 952|    shProgram.use();\n 953|    \n 954|    // Get attribute and uniform locations\n 955|    shProgram.iAttribVertex \u003d gl.getAttribLocation(prog, \&quot;vertex\&quot;);\n 956|    shProgram.iAttribNormal \u003d gl.getAttribLocation(prog, \&quot;normal\&quot;);\n 957|    shProgram.iAttribTangent \u003d gl.getAttribLocation(prog, \&quot;tangent\&quot;);\n 958|    shProgram.iAttribBitangent \u003d gl.getAttribLocation(prog, \&quot;bitangent\&quot;);\n 959|    shProgram.iAttribTexCoord \u003d gl.getAttribLocation(prog, \&quot;texCoord\&quot;);\n 960|    shProgram.iModelViewProjectionMatrix \u003d gl.getUniformLocation(prog, \&quot;ModelViewProjectionMatrix\&quot;);\n 961|    shProgram.iModelViewMatrix \u003d gl.getUniformLocation(prog, \&quot;ModelViewMatrix\&quot;);\n 962|    shProgram.iNormalMatrix \u003d gl.getUniformLocation(prog, \&quot;NormalMatrix\&quot;);\n 963|    shProgram.iLightPosition \u003d gl.getUniformLocation(prog, \&quot;lightPosition\&quot;);\n 964|    shProgram.iLightColor \u003d gl.getUniformLocation(prog, \&quot;lightColor\&quot;);\n 965|    shProgram.iMaterialAmbient \u003d gl.getUniformLocation(prog, \&quot;materialAmbient\&quot;);\n 966|    shProgram.iMaterialDiffuse \u003d gl.getUniformLocation(prog, \&quot;materialDiffuse\&quot;);\n 967|    shProgram.iMaterialSpecular \u003d gl.getUniformLocation(prog, \&quot;materialSpecular\&quot;);\n 968|    shProgram.iShininess \u003d gl.getUniformLocation(prog, \&quot;shininess\&quot;);\n 969|    shProgram.iTextureDiffuse \u003d gl.getUniformLocation(prog, \&quot;textureDiffuse\&quot;);\n 970|    shProgram.iTextureSpecular \u003d gl.getUniformLocation(prog, \&quot;textureSpecular\&quot;);\n 971|    shProgram.iTextureNormal \u003d gl.getUniformLocation(prog, \&quot;textureNormal\&quot;);\n 972|    \n 973|    // Create surface model\n 974|    surface \u003d new CornucopiaModel();\n 975|    surface.initialize();\n 976|    \n 977|    // Load textures from the res folder\n 978|    surface.textureDiffuse \u003d LoadTexture(\&quot;./res/Ground080_1K-JPG_Color.jpg\&quot;);\n 979|    surface.textureSpecular \u003d LoadTexture(\&quot;./res/Ground080_1K-JPG_Roughness.jpg\&quot;);\n 980|    surface.textureNormal \u003d LoadTexture(\&quot;./res/Ground080_1K-JPG_NormalGL.jpg\&quot;);\n 981|    \n 982|    // Create light source model\n 983|    lightSource \u003d new LightSourceModel();\n 984|    lightSource.initialize();\n 985|    \n 986|    // Enable depth testing\n 987|    gl.enable(gl.DEPTH_TEST);\n 988|}\n 989|\n 990|/**\n 991| * Load a texture from a URL\n 992| */\n 993|function LoadTexture(url) {\n 994|    const texture \u003d gl.createTexture();\n 995|    gl.bindTexture(gl.TEXTURE_2D, texture);\n 996|    \n 997|    // Fill with a placeholder color while loading\n 998|    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, 1, 1, 0, gl.RGBA, gl.UNSIGNED_BYTE,\n 999|                  new Uint8Array([128, 128, 255, 255])); // Light blue default\n1000|    \n1001|    // Load the image\n1002|    const image \u003d new Image();\n1003|    image.crossOrigin \u003d \&quot;anonymous\&quot;;\n1004|    image.src \u003d url;\n1005|    image.addEventListener(\u0027load\u0027, function() {\n1006|        gl.bindTexture(gl.TEXTURE_2D, texture);\n1007|        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, image);\n1008|        \n1009|        // Set texture parameters\n1010|        if (isPowerOf2(image.width) \u0026\u0026 isPowerOf2(image.height)) {\n1011|            gl.generateMipmap(gl.TEXTURE_2D);\n1012|            // Use REPEAT for wrapping (better for tiled textures)\n1013|            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.REPEAT);\n1014|            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.REPEAT);\n1015|        } else {\n1016|            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);\n1017|            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);\n1018|            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);\n1019|        }\n1020|        \n1021|        // Redraw the scene\n1022|        draw();\n1023|    });\n1024|    \n1025|    return texture;\n1026|}\n1027|\n1028|/**\n1029| * Create a flat normal map texture (pointing straight up in tangent space)\n1030| * This is useful as a default when no normal map is available\n1031| */\n1032|function CreateFlatNormalMap(size) {\n1033|    size \u003d size || 64; // Default 64x64 texture\n1034|    \n1035|    const texture \u003d gl.createTexture();\n1036|    gl.bindTexture(gl.TEXTURE_2D, texture);\n1037|    \n1038|    // Create a flat normal map where all normals point straight up (0, 0, 1) in tangent space\n1039|    // In RGB this is (0.5, 0.5, 1.0) which maps to (128, 128, 255) in byte values\n1040|    const data \u003d new Uint8Array(size * size * 4);\n1041|    for (let i \u003d 0; i \u003c size * size; i++) {\n1042|        data[i * 4 + 0] \u003d 128; // R \u003d 0.5 (X component)\n1043|        data[i * 4 + 1] \u003d 128; // G \u003d 0.5 (Y component)\n1044|        data[i * 4 + 2] \u003d 255; // B \u003d 1.0 (Z component, pointing up)\n1045|        data[i * 4 + 3] \u003d 255; // A \u003d 1.0 (full opacity)\n1046|    }\n1047|    \n1048|    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, size, size, 0, gl.RGBA, gl.UNSIGNED_BYTE, data);\n1049|    \n1050|    // Set texture parameters\n1051|    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.REPEAT);\n1052|    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.REPEAT);\n1053|    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);\n1054|    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);\n1055|    \n1056|    return texture;\n1057|}\n1058|\n1059|/**\n1060| * Check if a value is a power of 2\n1061| */\n1062|function isPowerOf2(value) {\n1063|    return (value \u0026 (value - 1)) \u003d\u003d\u003d 0;\n1064|}\n1065|\n1066|/**\n1067| * Set up UI controls\n1068| */\n1069|function setupControls() {\n1070|    const uGranSlider \u003d document.getElementById(\&quot;u-granularity\&quot;);\n1071|    const vGranSlider \u003d document.getElementById(\&quot;v-granularity\&quot;);\n1072|    \n1073|    if (uGranSlider \u0026\u0026 vGranSlider) {\n1074|        // Initialize display values\n1075|        const uGranValue \u003d document.getElementById(\&quot;u-gran-value\&quot;);\n1076|        const vGranValue \u003d document.getElementById(\&quot;v-gran-value\&quot;);\n1077|        \n1078|        if (uGranValue) uGranValue.textContent \u003d uGranSlider.value;\n1079|        if (vGranValue) vGranValue.textContent \u003d vGranSlider.value;\n1080|        \n1081|        // Set slider values to match current model\n1082|        if (surface) {\n1083|            uGranSlider.value \u003d surface.uSegments;\n1084|            vGranSlider.value \u003d surface.vSegments;\n1085|        }\n1086|        \n1087|        // Add direct input event handlers that update on drag\n1088|        uGranSlider.addEventListener(\&quot;input\&quot;, function() {\n1089|            if (uGranValue) uGranValue.textContent \u003d uGranSlider.value;\n1090|            meshUpdateNeeded \u003d true; // Flag for update on next frame\n1091|        });\n1092|        \n1093|        vGranSlider.addEventListener(\&quot;input\&quot;, function() {\n1094|            if (vGranValue) vGranValue.textContent \u003d vGranSlider.value;\n1095|            meshUpdateNeeded \u003d true; // Flag for update on next frame\n1096|        });\n1097|        \n1098|        console.log(\&quot;UI sliders initialized successfully\&quot;);\n1099|    } else {\n1100|        console.warn(\&quot;Could not find granularity sliders\&quot;);\n1101|    }\n1102|}\n1103|\n1104|/**\n1105| * Main initialization function\n1106| */\n1107|function init() {\n1108|    try {\n1109|        console.log(\&quot;Initializing WebGL application...\&quot;);\n1110|        \n1111|        // Get the canvas and initialize WebGL\n1112|        let canvas \u003d document.getElementById(\&quot;webglcanvas\&quot;);\n1113|        gl \u003d canvas.getContext(\&quot;webgl\&quot;) || canvas.getContext(\&quot;experimental-webgl\&quot;);\n1114|        if (!gl) {\n1115|            throw \&quot;Browser doesn\u0027t support WebGL\&quot;;\n1116|        }\n1117|        \n1118|        // Initialize GL and create the scene\n1119|        initGL();\n1120|        \n1121|        // Create trackball for rotation\n1122|        spaceball \u003d new TrackballRotator(canvas, draw, 0);\n1123|        \n1124|        // Set up UI controls after GL is initialized\n1125|        setupControls();\n1126|        \n1127|        // Initial drawing of the scene\n1128|        draw();\n1129|        \n1130|        console.log(\&quot;3D Cornucopia surface initialized successfully with Phong shading and Facet Average normals!\&quot;);\n1131|    } catch (e) {\n1132|        console.error(\&quot;ERROR: \&quot; + e);\n1133|        document.getElementById(\&quot;canvas-holder\&quot;).innerHTML \u003d \n1134|            \&quot;\u003cp style\u003d\u0027color:red\u0027\u003e\u003cb\u003eError:\u003c/b\u003e \&quot; + e + \&q