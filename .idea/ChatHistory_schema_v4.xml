ccessible:\u003c/p\u003e\r\n        \u003cbutton onclick\u003d\&quot;checkFiles()\&quot;\u003eCheck Files\u003c/button\u003e\r\n        \u003cdiv id\u003d\&quot;results\&quot;\u003e\u003c/div\u003e\r\n    \u003c/div\u003e\r\n\r\n    \u003cscript\u003e\r\n        function checkFiles() {\r\n            const files \u003d [\r\n                \&quot;index.html\&quot;,\r\n                \&quot;main.js\&quot;,\r\n                \&quot;model.js\&quot;,\r\n                \&quot;shaders.js\&quot;,\r\n                \&quot;Utils/trackball-rotator.js\&quot;,\r\n                \&quot;Utils/m4.js\&quot;\r\n            ];\r\n            \r\n            const resultsDiv \u003d document.getElementById(\u0027results\u0027);\r\n            resultsDiv.innerHTML \u003d \&quot;\u003ch3\u003eChecking files...\u003c/h3\u003e\&quot;;\r\n            let results \u003d \&quot;\&quot;;\r\n            let checkCount \u003d 0;\r\n            let passCount \u003d 0;\r\n            \r\n            files.forEach(file \u003d\u003e {\r\n                const xhr \u003d new XMLHttpRequest();\r\n                xhr.onreadystatechange \u003d function() {\r\n                    if (xhr.readyState \u003d\u003d\u003d 4) {\r\n                        checkCount++;\r\n                        const success \u003d xhr.status \u003d\u003d\u003d 200;\r\n                        if (success) passCount++;\r\n                        \r\n                        results +\u003d `\u003cdiv\u003e${file}: ${success ? \r\n                            \u0027\u003cspan style\u003d\&quot;color: lime;\&quot;\u003e✓ FOUND\u003c/span\u003e\u0027 : \r\n                            \u0027\u003cspan style\u003d\&quot;color: red;\&quot;\u003e✗ NOT FOUND\u003c/span\u003e\u0027}\u003c/div\u003e`;\r\n                        \r\n                        if (checkCount \u003d\u003d\u003d files.length) {\r\n                            resultsDiv.innerHTML \u003d results;\r\n                            resultsDiv.innerHTML +\u003d `\u0