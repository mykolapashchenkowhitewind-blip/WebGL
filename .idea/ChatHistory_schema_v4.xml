d document.getElementById(\u0027param-u\u0027);\n 85|                const paramV \u003d document.getElementById(\u0027param-v\u0027);\n 86|                \n 87|                // Set initial values directly from the mathematical definition\n 88|                // These values match exactly what\u0027s shown in the Mathematical Definition section\n 89|                paramP.value \u003d 0.15; // p \u003d 0.15\n 90|                paramM.value \u003d 0.1;  // m \u003d 0.1\n 91|                paramU.value \u003d 5;    // u ≤ 5π\n 92|                paramV.value \u003d 2;    // v ≤ 2π\n 93|                \n 94|                // Also ensure the model uses these exact values\n 95|                setTimeout(function() {\n 96|                    if (surface) {\n 97|                        // Verify that the model parameters match the HTML definition\n 98|                        if (surface.p !\u003d 0.15 || surface.m !\u003d 0.1 || \n 99|                            surface.uMax !\u003d 5 * Math.PI || surface.vMax !\u003d 2 * Math.PI) {\n100|                            console.log(\&quot;Correcting model parameters to match Mathematical Definition\&quot;);\n101|                            surface.p \u003d 0.15;\n102|                            surface.m \u003d 0.1;\n103|                            surface.uMax \u003d 5 * Math.PI;\n104|                            surface.vMax \u003d 2 * Math.PI;\n105|                            surface.initialize();\n106|                            draw();\n107|                        }\n108|                    }\n109|                }, 500);\n110|                \n111|                if (refreshButton) {\n112|                    refreshButton.addEventListener(\u0027click\u0027, function() {\n113|                        // Get values from inputs\n114|                        if (surface) {\n115|                            // Update parameters\n116|                            surface.p \u003d parseFloat(paramP.value);\n117|                            surface.m \u003d parseFloat(paramM.value);\n118|                            surface.uMax \u003d parseFloat(paramU.value) * Math.PI;\n119|                            surface.vMax \u003d parseFloat(paramV.value) * Math.PI;\n120|                            \n121|                            console.log(\&quot;Applying new parameters:\&quot;);\n122|                            console.log(\&quot;p \u003d\&quot;, surface.p, \&quot;m \u003d\&quot;, surface.m, \&quot;uMax \u003d\&quot;, surface.uMax/Math.PI + \&quot;π\&quot;, \&quot;vMax \u003d\&quot;, surface.vMax/Math.PI + \&quot;π\&quot;);\n123|                            \n124|                            // Update formula display in the info panel\n125|                            const mathFormula \u003d document.querySelector(\u0027.math-formula\u0027);\n126|                            if (mathFormula) {\n127|                                // Find the part after the parametric equations\n128|                                const whereSection \u003d mathFormula.innerHTML.split(\u0027\u003cstrong\u003eWhere:\u003c/strong\u003e\u0027);\n129|                                if (whereSection.length \u003e 1) {\n130|                                    mathFormula.innerHTML \u003d whereSection[0] + \n131|                                        \u0027\u003cstrong\u003eWhere:\u003c/strong\u003e\u003cbr\u003e\u0027 +\n132|                                        \u0027- p \u003d \u0027 + surface.p + \u0027 (parameter p)\u003cbr\u003e\u0027 +\n133|                                        \u0027- m \u003d \u0027 + surface.m + \u0027 (parameter m)\u003cbr\u003e\u0027 +\n134|                                        \u0027- 0 ≤ u ≤ \u0027 + (surface.uMax/Math.PI) + \u0027π (lengthwise parameter)\u003cbr\u003e\u0027 +\n135|                                        \u0027- 0 ≤ v ≤ \u0027 + (surface.vMax/Math.PI) + \u0027π (cross-section parameter)\u0027;\n136|                                }\n137|                            }\n138|                            \n139|                            // Reinitialize the model\n140|                            surface.initialize();\n141|                            \n142|                            // Redraw\n143|                            draw();\n144|                            \n145|                            console.log(\&quot;Model updated with new parameters!\&quot;);\n146|                            \n147|                            // Flash confirmation message\n148|                            const button \u003d document.getElementById(\u0027refresh-button\u0027);\n149|                            button.textContent \u003d \&quot;Parameters Applied!\&quot;;\n150|                            button.style.backgroundColor \u003d \&quot;#00ff99\&quot;;\n151|                            setTimeout(function() {\n152|                                button.textContent \u003d \&quot;Apply Parameters\&quot;;\n153|                                button.style.backgroundColor \u003d \&quot;#0f0\&quot;;\n154|                            }, 1500);\n155|                        }\n156|                    });\n157|                }\n158|            });\n159|            \n160|            // No helper functions needed\n161|        \u003c/script\u003e\n162|\u003c/head\u003e\n163|\u003cbody onload\u003d\&quot;init()\&quot;\u003e\n164|    \u003cdiv class\u003d\&quot;container\&quot;\u003e\n165|        \u003ch1\u003eCornucopia Surface - WebGL Visualization\u003c/h1\u003e\n166|        \n167|        \u003cdiv class\u003d\&quot;info-panel\&quot;\u003e\n168|            \u003ch2\u003eProject Description\u003c/h2\u003e\n169|            \u003cp\u003eThis visualization demonstrates a 3D wireframe model of a \&quot;Cornucopia\&quot; surface rendered using WebGL.\u003c/p\u003e\n170|            \u003cp\u003eThe Cornucopia is a special case of a spiral-shaped surface \&quot;Shell without vertex\&quot;. It\u0027s a cyclic surface with generatrix circles of variable radius that creates the distinctive horn-like shape.\u003c/p\u003e\n171|            \n172|            \u003ch2\u003eMathematical Definition\u003c/h2\u003e\n173|            \u003cp\u003eThe Cornucopia surface is defined by the following parametric equations:\u003c/p\u003e\n174|            \n175|            \u003cdiv class\u003d\&quot;math-formula\&quot;\u003e\n176|                \u003cstrong\u003eParametric Equations:\u003c/strong\u003e\u003cbr\u003e\n177|                x(u,v) \u003d [e\u003csup\u003emu\u003c/sup\u003e + e\u003csup\u003epu\u003c/sup\u003ecos(v)]cos(u)\u003cbr\u003e\n178|                y(u,v) \u003d [e\u003csup\u003emu\u003c/sup\u003e + e\u003csup\u003epu\u003c/sup\u003ecos(v)]sin(u)\u003cbr\u003e\n179|                z(u,v) \u003d e\u003csup\u003epu\u003c/sup\u003esin(v)\u003cbr\u003e\u003cbr\u003e\n180|                \n181|                \u003cstrong\u003eWhere:\u003c/strong\u003e\u003cbr\u003e\n182|                - p \u003d 0.15 (parameter p)\u003cbr\u003e\n183|                - m \u003d 0.1 (parameter m)\u003cbr\u003e\n184|                - 0 ≤ u ≤ 5π (lengthwise parameter)\u003cbr\u003e\n185|                - 0 ≤ v ≤ 2π (cross-section parameter)\n186|            \u003c/div\u003e\n187|            \n188|            \u003ch2\u003eVisualization Features\u003c/h2\u003e\n189|            \u003cul\u003e\n190|                \u003cli\u003e60 circular cross-sections for detailed rendering\u003c/li\u003e\n191|                \u003cli\u003eGreen wireframe for high visibility\u003c/li\u003e\n192|                \u003cli\u003eInteractive rotation using mouse or touch\u003c/li\u003e\n193|                \u003cli\u003eElongated shape with oval cross-sections\u003c/li\u003e\n194|            \u003c/ul\u003e\n195|        \u003c/div\u003e\n196|        \n197|        \u003cdiv id\u003d\&quot;canvas-holder\&quot;\u003e\n198|            \u003ccanvas width\u003d\&quot;800\&quot; height\u003d\&quot;600\&quot; id\u003d\&quot;webglcanvas\&quot; style\u003d\&quot;background-color:bla