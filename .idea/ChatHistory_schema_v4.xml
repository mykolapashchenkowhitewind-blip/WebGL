\u003d 0;           // Minimum u value\n 23|    this.uMax \u003d 5 * Math.PI; // Maximum u value\n 24|    this.vMin \u003d 0;           // Minimum v value\n 25|    this.vMax \u003d Math.PI * 2; // Maximum v value\n 26|    \n 27|    // Segment counts\n 28|    this.uSegments \u003d 140;    // Increased segments for longer spiral\n 29|    this.vSegments \u003d 40;     // Segments around each circular cross-section\n 30|    \n 31|    // No longer need a separate radius function with the new formula\n 32|    \n 33|    /**\n 34|     * Calculate the 3D point coordinates for parameters u, v\n 35|     * Using the correct Cornucopia surface equations\n 36|     */\n 37|    this.surfacePoint \u003d function(u, v) {\n 38|        // Implementing the correct formula:\n 39|        // x \u003d [e^(mu) + e^(pu)cos(v)]cos(u)\n 40|        // y \u003d [e^(mu) + e^(pu)cos(v)]sin(u)\n 41|        // z \u003d e^(pu)sin(v)\n 42|        \n 43|        const ePu \u003d Math.exp(this.p * u);  // e^(pu)\n 44|        const eMu \u003d Math.exp(this.m * u);  // e^(mu)\n 45|        \n 46|        return {\n 47|            x: (eMu + ePu * Math.cos(v)) * Math.cos(u),\n 48|            y: (eMu + ePu * Math.cos(v)) * Math.sin(u),\n 49|            z: ePu * Math.sin(v)\n 50|        };\n 51|    };\n 52|    \n 53|    /**\n 54|     * Generate vertices for U polylines (longitudinal lines)\n 55|     */\n 56|    this.generateULines \u003d function() {\n 57|        let vertexList \u003d [];\n 58|        \n 59|        const vStep \u003d (this.vMax - this.vMin) / this.vSegments;\n 60|        for (let vi \u003d 0; vi \u003c\u003d this.vSegments; vi++) {\n 61|            const v \u003d this.vMin + vi * vStep;\n 62|            \n 63|            for (let ui \u003d 0; ui \u003c\u003d this.uSegments; ui++) {\n 64|                const u \u003d this.uMin + (ui / this.uSegments) * (this.uMax - this.uMin);\n 65|                const point \u003d this.surfacePoint(u, v);\n 66|                vertexList.push(point.x, point.y, point.z);\n 67|            }\n 68|        }\n 69|        \n 70|        this.uLinesCount \u003d vertexList.length / 3;\n 71|        gl.bindBuffer(gl.ARRAY_BUFFER, this.uLinesBuffer);\n 72|        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(vertexList), gl.STATIC_DRAW);\n 73|    };\n 74|    \n 75|    /**\n 76|     * Generate vertices for V polylines (circular cross-sections)\n 77|     */\n 78|    this.generateVLines \u003d function() {\n 79|        // Generate exactly 60 circular cross-sections\n 80|        const numCircles \u003d 60;\n 81|        let circleVertices \u003d [];\n 82|        \n 83|        for (let i \u003d 0; i \u003c numCircles; i++) {\n 84|            const u \u003d this.uMin + (i / (numCircles - 1)) * (this.uMax - this.uMin);\n 85|            \n 86|            for (let vi \u003d 0; vi \u003c\u003d this.vSegments; vi++) {\n 87|                const v \u003d this.vMin + (vi / this.vSegments) * (this.vMax - this.vMin);\n 88|                const point \u003d this.surfacePoint(u, v);\n 89|                circleVertices.push(point.x, point.y, point.z);\n 90|            }\n 91|        }\n 92|        \n 93|        this.vLinesCount \u003d circleVertices.length / 3;\n 94|        gl.bindBuffer(gl.ARRAY_BUFFER, this.vLinesBuffer);\n 95|        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(circleVertices), gl.STATIC_DRAW);\n 96|        this.numCircles \u003d numCircles;\n 97|    };\n 98|    \n 99|    /**\n100|     * Initialize the model\n101|     */\n102|    this.initialize \u003d function() {\n103|        this.generateULines();\n104|        this.generateVLines();\n105|    };\n106|    \n107|    /**\n108|     * Draw the wireframe model\n109|     */\n110|    this.Draw \u003d function(shaderProgram) {\n111|        // Set the color to bright green\n112|        gl.uniform4fv(shaderProgram.iColor, [0.0, 1.0, 0.0, 1.0]);\n113|        \n114|        // Draw U polylines\n115|        gl.bindBuffer(gl.ARRAY_BUFFER, this.uLinesBuffer);\n116|        gl.vertexAttribPointer(shaderProgram.iAttribVertex, 3, gl.FLOAT, false, 0, 0);\n117|        gl.enableVertexAttribArray(shaderProgram.iAttribVertex);\n118|        \n119|        const verticesPerULine \u003d this.uSegments + 1;\n120|        for (let i \u003d 0; i \u003c this.uLinesCount / verticesPerULine; i++) {\n121|            gl.drawArrays(gl.LINE_STRIP, i * verticesPerULine, verticesPerULine);\n122|        }\n123|        \n124|        // Draw V polylines\n125|        gl.bindBuffer(gl.ARRAY_BUFFER, this.vLinesBuffer);\n126|        gl.vertexAttribPointer(shaderProgram.iAttribVertex, 3, gl.FLOAT, false, 0, 0);\n127|        gl.enableVertexAttribArray(shaderProgram.iAttribVertex);\n128|        \n129|        const verticesPerCircle \u003d this.vSegments + 1;\n130|        for (let i \u003d 0; i \u003c this.numCircles; i++) {\n131|            gl.drawArrays(gl.LINE_LOOP, i * verticesPerCircle, verticesPerCircle);\n132|        }\n133|    };\n134|}\n135|\n136|/**\n137| * Shader Program constructor\n138| */\n139|function ShaderProgram(name, program) {\n140|    this.name \u003d name;\n141|    this.prog \u003d program;\n142|    this.iAttribVertex \u003d -1;\n143|    this.iColor \u003d -1;\n144|    this.iModelViewProjectionMatrix \u003d -1;\n145|\n146|    this.Use \u003d function() {\n147|        gl.useProgram(this.prog);\n148|    }\n149|}\n150|\n151|/**\n152| * Draw function\n153| */\n154|function draw() {\n155|    gl.clearColor(0,0,0,1);\n156|    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);\n157|    \n158|    gl.viewport(0, 0, gl.canvas.width, gl.canvas.height);\n159|    \n160|    // Set up projection matrix\n161|    let projection \u003d m4.perspective(Math.PI/5, gl.canvas.width/gl.canvas.height, 0.1, 200);\n162|    \n163|    // Get view matrix from trackball\n164|    let modelView \u003d spaceball.getViewMatrix();\n165|    \n166|    // Position camera\n167|    let rotateToPointZero \u003d m4.axisRotation([0.2,1.0,0.3], 1.0);\n168|    let translateToPointZero \u003d m4.translation(0,0,-3