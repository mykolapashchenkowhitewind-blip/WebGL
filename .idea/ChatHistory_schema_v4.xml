entById(\u0027param-u\u0027);\n170|            const paramV \u003d document.getElementById(\u0027param-v\u0027);\n171|            \n172|            // Set initial values directly from the mathematical definition\n173|            // These values match exactly what\u0027s shown in the Mathematical Definition section\n174|            paramP.value \u003d 0.1; // p \u003d 0.15\n175|            paramM.value \u003d 0.2;  // m \u003d 0.1\n176|            paramU.value \u003d 4;    // u ≤ 5π\n177|            paramV.value \u003d 2;    // v ≤ 2π\n178|\n179|            if (refreshButton) {\n180|                refreshButton.addEventListener(\u0027click\u0027, function() {\n181|                    // Get values from inputs\n182|                    if (surface) {\n183|                        // Update parameters\n184|                        surface.p \u003d parseFloat(paramP.value);\n185|                        surface.m \u003d parseFloat(paramM.value);\n186|                        surface.uMax \u003d parseFloat(paramU.value) * Math.PI;\n187|                        surface.vMax \u003d parseFloat(paramV.value) * Math.PI;\n188|                        \n189|                        console.log(\&quot;Applying new parameters:\&quot;);\n190|                        console.log(\&quot;p \u003d\&quot;, surface.p, \&quot;m \u003d\&quot;, surface.m, \&quot;uMax \u003d\&quot;, surface.uMax/Math.PI + \&quot;π\&quot;, \&quot;vMax \u003d\&quot;, surface.vMax/Math.PI + \&quot;π\&quot;);\n191|                        \n192|                        // Update formula display in the info panel\n193|                        const mathFormula \u003d document.querySelector(\u0027.math-formula\u0027);\n194|                        if (mathFormula) {\n195|                            // Find the part after the parametric equations\n196|                            const whereSection \u003d mathFormula.innerHTML.split(\u0027\u003cstrong\u003eWhere:\u003c/strong\u003e\u0027);\n197|                            if (whereSection.length \u003e 1) {\n198|                                mathFormula.innerHTML \u003d whereSection[0] + \n199|                                    \u0027\u003cstrong\u003eWhere:\u003c/strong\u003e\u003cbr\u003e\u0027 +\n200|                                    \u0027- p \u003d \u0027 + surface.p + \u0027 (parameter p)\u003cbr\u003e\u0027 +\n201|                                    \u0027- m \u003d \u0027 + surface.m + \u0027 (parameter m)\u003cbr\u003e\u0027 +\n202|                                    \u0027- 0 ≤ u ≤ \u0027 + (surface.uMax/Math.PI) + \u0027π (lengthwise parameter)\u003cbr\u003e\u0027 +\n203|                                    \u0027- 0 ≤ v ≤ \u0027 + (surface.vMax/Math.PI) + \u0027π (cross-section parameter)\u0027;\n204|                            }\n205|                        }\n206|                        \n207|                        // Reinitialize the model\n208|                        surface.initialize();\n209|                        \n210|                        // Redraw\n211|                        draw();\n212|                        \n213|                        console.log(\&quot;Model updated with new parameters!\&quot;);\n214|                        \n215|                        // Flash confirmation message\n216|                        const button \u003d document.getElementById(\u0027refresh-button\u0027);\n217|                        button.textContent \u003d \&quot;Parameters Applied!\&quot;;\n218|                        button.style.backgroundColor \u003d \&quot;#00ff99\&quot;;\n219|                        setTimeout(function() {\n220|                            button.textContent \u003d \&quot;Apply Parameters\&quot;;\n221|                            button.style.backgroundColor \u003d \&quot;#0f0\&quot;;\n222|                        }, 1500);\n223|                    }\n224|                });\n225|            }\n226|\n227|            // Add direct event listeners to granularity sliders\n228|            setupGranularitySliders();\n229|        });\n230|\n231|        // Function to directly update mesh when sliders change\n232|        function updateMeshGranularity() {\n233|            if (!surface) return;\n234|\n235|            const uSlider \u003d document.getElementById(\&quot;u-granularity\&quot;);\n236|            const vSlider \u003d document.getElementById(\&quot;v-granularity\&quot;);\n237|            const uValue \u003d document.getElementById(\&quot;u-gran-value\&quot;);\n238|            const vValue \u003d document.getElementById(\&quot;v-gran-value\&quot;);\n239|\n240|            if (uSlider \u0026\u0026 vSlider \u0026\u0026 uValue \u0026\u0026 vValue) {\n241|                const uSegments \u003d parseInt(uSlider.value);\n242|                const vSegments \u003d parseInt(vSlider.value);\n243|                \n244|                // Update display values\n245|                uValue.textContent \u003d uSegments;\n246|                vValue.textContent \u003d vSegments;\n247|\n248|                // Update the surface\n249|                console.log(\&quot;Direct update from sliders: U\u003d\&quot; + uSegments + \&quot;, V\u003d\&quot; + vSegments);\n250|                surface.uSegments \u003d uSegments;\n251|                surface.vSegments \u003d vSegments;\n252|                surface.initialize();\n253|                draw();\n254|            }\n255|        }\n256|\n257|        // Setup granularity sliders with direct event handlers\n258|        function setupGranularitySliders() {\n259|            const uSlider \u003d document.getElementById(\&quot;u-granularity\&quot;);\n260|            const vSlider \u003d document.getElementById(\&quot;v-granularity\&quot;);\n261|            \n262|            if (uSlider \u0026\u0026 vSlider \u0026\u0026 surface) {\n263|                // Set initial values to match model\n264|                uSlider.value \u003d surface.uSegments;\n265|                vSlider.value \u003d surface.vSegments;\n266|                \n267|                document.getElementById(\&quot;u-gran-value\&quot;).textContent \u003d surface.uSegments;\n268|                document.getElementById(\&quot;v-gran-value\&quot;).textContent \u003d surface.vSegments;\n269|                \n270|                console.log(\&quot;Granularity sliders initialized with values:\&quot;, surface.uSegments, surface.vSegments);\n271|            }\n272|        }\n273|    \u003c/script\u003e\n274|\u003c/head\u003e\n275|\u003cbody onload\u003d\&quot;init()\&quot;\u003e\n276|    \u003cdiv class\u003d\&quot;container\&quot;\u003e\n277|        \u003ch1\u003eCornucopia Surface - WebGL Visualization with Phong Shading\u003c/h1\u003e\n278|        \n279|        \u003cdiv class\u003d\&quot;info-panel\&quot;\u003e\n280|            \u003ch2\u003eProject Description\u003c/h2\u003e\n281|            \u003cp\u003eThis visualization demonstrates a 3D model of a \&quot;Cornucopia\&quot; surface rendered using WebGL with Phong shading and Facet Average normal calculation.\u003c/p\u003e\n282|            \u003cp\u003eThe Cornucopia is a special case of a spiral-shaped surface \&quot;Shell without vertex\&quot;. It\u0027s a cyclic surface with generatrix circles of variable radius that creates the distinctive horn-like shape.\u003c/p\u003e\n283|            \n284|            \u003ch2\u003eMathematical Definition\u003c/h2\u003e\n285|            \u003cp\u003eThe Cornucopia surface is defined by the following parametric equations:\u003c/p\u003e\n286|            \n287|            \u003cdiv class\u003d\&quot;math-formula\&quot;\u003e\n288|                \u003cstrong\u003eParametric Equations:\u003c/strong\u003e\u003cbr\u003e\n289|                x(u,v) \u003d [e\u003csup\u003emu\u003c/sup\u003e + e\u003csup\u003epu\u003c/sup\u003ecos(v)]cos(u)\u003cbr\u003e\n290|                y(u,v) \u003d [e\u003csup\u003emu\u003c/sup\u003e + e\u003csup\u003epu\u003c/sup\u003ecos(v)]sin(u)\u003cbr\u003e\n291|                z(u,v) \u003d e\u003csup\u003epu\u003c/sup\u003esin(v)\u003cbr\u003e\u003cbr\u003e\n292|                \n293|                \u003cstrong\u003eWhere:\u003c/strong\u003e\u003cbr\u003e\n294|                - p \u003d 0.15 (parameter p)\u003cbr\u003e\n295|                - m \u003d 0.1 (parameter m)\u003cbr\u003e\n296|                - 0 ≤ u ≤ 5π (lengthwise parameter)\u003cbr\u003e\n297|                - 0 ≤ v ≤ 2π (cross-section parameter)\n298|            \u003c/div\u003e\n299|        \u003c/div\u003e\n300|        \n301|        \u003cdiv id\u003d\&quot;canvas-holder\&quot;\u003e\n302|            \u003ccanvas width\u003d\&quot;800\&quot; height\u003d\&quot;600\&quot; id\u003d\&quot;webglcanvas\&quot; style\u003d\&quot;background-color:white\&quot;\u003e\u003c/canvas\u003e\n303|        \u003c/div\u003e\n304|        \n305|        \u003cdiv class\u003d\&quot;controls-panel\&quot;\u003e\n306|            \u003ch3\u003eSurface Parameters\u003c/h3\u003e\n307|            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\n308|                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-p\&quot;\u003ep value:\u003c/label\u003e\n309|                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-p\&quot; value\u003d\&quot;0.1\&quot; step\u003d\&quot;0.01\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\n310|            \u003c/div\u003e\n311|            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\n312|                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-m\&quot;\u003em value:\u003c/label\u003e\n313|                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-m\&quot; value\u003d\&quot;0.2\&quot; step\u003d\&quot;0.01\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\n314|            \u003c/div\u003e\n315|            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\n316|                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-u\&quot;\u003eu max (π):\u003c/label\u003e\n317|                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-u\&quot; value\u003d\&quot;4\&quot; step\u003d\&quot;0.5\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\n318|            \u003c/div\u003e\n319|            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\n320|                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-v\&quot;\u003ev max (π):\u003c/label\u003e\n321|                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-v\&quot; value\u003d\&quot;2\&quot; step\u003d\&quot;0.5\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\n322|            \u003c/div\u003e\n323|            \n324|            \u003cbutton id\u003d\&quot;refresh-button\&quot; style\u003d\&quot;margin-top: 10px; padding: 8px 16px; background-color: #0f0; color: black; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;\&quot;\u003eApply Parameters\u003c/button\u003e\n325|            \n326|            \u003cdiv class\u003d\&quot;granularity-section\&quot;\u003e\n327|                \u003ch3\u003eMesh Granularity\u003c/h3\u003e\n328|                \u003cdiv class\u003d\&quot;slider-container\&quot;\u003e\n329|                    \u003cspan class\u003d\&quot;slider-label\&quot;\u003eU Segments:\u003c/span\u003e\n330|                    \u003cinput type\u003d\&quot;range\&quot; min\u003d\&quot;10\&quot; max\u003d\&quot;200\&quot; value\u003d\&quot;80\&quot; class\u003d\&quot;slider\&quot; id\u003d\&quot;u-granularity\&quot; oninput\u003d\&quot;updateMeshGranularity()\&quot;\u003e\n331|                    \u003cspan class\u003d\&quot;slider-value\&quot; id\u003d\&quot;u-gran-value\&quot;\u003e80\u003c/span\u003e\n332|                \u003c/div\u003e\n333|                \u003cdiv class\u003d\&quot;slider-container\&quot;\u003e\n334|                    \u003cspan class\u003d\&quot;slider-label\&quot;\u003eV Segments:\u003c/span\u003e\n335|                    \u003cinput type\u0