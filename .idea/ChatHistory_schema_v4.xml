og, \&quot;ModelViewMatrix\&quot;);\n531|    shProgram.iNormalMatrix \u003d gl.getUniformLocation(prog, \&quot;NormalMatrix\&quot;);\n532|    shProgram.iLightPosition \u003d gl.getUniformLocation(prog, \&quot;lightPosition\&quot;);\n533|    shProgram.iMaterialAmbient \u003d gl.getUniformLocation(prog, \&quot;materialAmbient\&quot;);\n534|    shProgram.iMaterialDiffuse \u003d gl.getUniformLocation(prog, \&quot;materialDiffuse\&quot;);\n535|    shProgram.iMaterialSpecular \u003d gl.getUniformLocation(prog, \&quot;materialSpecular\&quot;);\n536|    shProgram.iShininess \u003d gl.getUniformLocation(prog, \&quot;shininess\&quot;);\n537|    \n538|    // Create model\n539|    surface \u003d new CornucopiaModel();\n540|    surface.initialize();\n541|    \n542|    // Enable depth testing\n543|    gl.enable(gl.DEPTH_TEST);\n544|}\n545|\n546|/**\n547| * Update mesh from slider values\n548| */\n549|function updateMeshFromSliders() {\n550|    const uGranSlider \u003d document.getElementById(\&quot;u-granularity\&quot;);\n551|    const vGranSlider \u003d document.getElementById(\&quot;v-granularity\&quot;);\n552|    \n553|    if (uGranSlider \u0026\u0026 vGranSlider) {\n554|        const uSegments \u003d parseInt(uGranSlider.value);\n555|        const vSegments \u003d parseInt(vGranSlider.value);\n556|        \n557|        // Update the display values\n558|        document.getElementById(\&quot;u-gran-value\&quot;).textContent \u003d uSegments;\n559|        document.getElementById(\&quot;v-gran-value\&quot;).textContent \u003d vSegments;\n560|        \n561|        console.log(\&quot;Updating mesh from sliders: U\u003d\&quot; + uSegments + \&quot;, V\u003d\&quot; + vSegments);\n562|        \n563|        // Update the surface\n564|        if (surface) {\n565|            surface.updateGranularity(uSegments, vSegments);\n566|        }\n567|    }\n568|}\n569|\n570|/**\n571| * Set up UI controls\n572| */\n573|function setupControls() {\n574|    const uGranSlider \u003d document.getElementById(\&quot;u-granularity\&quot;);\n575|    const vGranSlider \u003d document.getElementById(\&quot;v-granularity\&quot;);\n576|    \n577|    if (uGranSlider \u0026\u0026 vGranSlider) {\n578|        // Initialize display values\n579|        const uGranValue \u003d document.getElementById(\&quot;u-gran-value\&quot;);\n580|        const vGranValue \u003d document.getElementById(\&quot;v-gran-value\&quot;);\n581|        \n582|        if (uGranValue) uGranValue.textContent \u003d uGranSlider.value;\n583|        if (vGranValue) vGranValue.textContent \u003d vGranSlider.value;\n584|        \n585|        // Set slider values to match current model\n586|        if (surface) {\n587|            uGranSlider.value \u003d surface.uSegments;\n588|            vGranSlider.value \u003d surface.vSegments;\n589|        }\n590|        \n591|        // Add direct input event handlers\n592|        uGranSlider.oninput \u003d function() {\n593|            if (uGranValue) uGranValue.textContent \u003d uGranSlider.value;\n594|            if (surface) {\n595|                surface.uSegments \u003d parseInt(uGranSlider.value);\n596|                surface.initialize();\n597|            }\n598|        };\n599|        \n600|        vGranSlider.oninput \u003d function() {\n601|            if (vGranValue) vGranValue.textContent \u003d vGranSlider.value;\n602|            if (surface) {\n603|                surface.vSegments \u003d parseInt(vGranSlider.value);\n604|                surface.initialize();\n605|            }\n606|        };\n607|        \n608|        console.log(\&quot;UI sliders initialized successfully\&quot;);\n609|    } else {\n610|        console.warn(\&quot;Could not find granularity sliders\&quot;);\n611|    }\n612|}\n613|\n614|/**\n615| * Main initialization function\n616| */\n617|function init() {\n618|    try {\n619|        console.log(\&quot;Initializing WebGL application...\&quot;);\n620|        \n621|        // Get the canvas and initialize WebGL\n622|        let canvas