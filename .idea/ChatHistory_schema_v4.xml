]cos(u)\n 12| * y(u,v) \u003d [e^(mu) + e^(pu)cos(v)]sin(u)\n 13| * z(u,v) \u003d e^(pu)sin(v)\n 14| */\n 15|\n 16|// Global variables\n 17|let gl;                 // WebGL context\n 18|let surface;            // Cornucopia surface model\n 19|let shProgram;          // Shader program\n 20|let spaceball;          // Trackball rotator\n 21|let lightAngle \u003d 0;     // Angle for rotating light\n 22|let lightRadius \u003d 60;   // Distance of light from origin\n 23|\n 24|/**\n 25| * CornucopiaModel class to create and render the surface\n 26| */\n 27|function CornucopiaModel() {\n 28|    // Surface parameters - exactly as shown in Fig. 2\n 29|    this.p \u003d 0.15;\n 30|    this.m \u003d 0.1;\n 31|    this.uMin \u003d 0;\n 32|    this.uMax \u003d 5 * Math.PI;\n 33|    this.vMin \u003d 0;\n 34|    this.vMax \u003d 2 * Math.PI;\n 35|    \n 36|    // Number of segments for the grid (adjustable via sliders)\n 37|    this.uSegments \u003d 80;\n 38|    this.vSegments \u003d 40;\n 39|    \n 40|    // Buffers for the triangular mesh\n 41|    this.vertexBuffer \u003d null;\n 42|    this.normalBuffer \u003d null;\n 43|    this.indexBuffer \u003d null;\n 44|    this.numVertices \u003d 0;\n 45|    this.numIndices \u003d 0;\n 46|\n 47|    // Array to store vertex positions for normal calculation\n 48|    this.vertices \u003d [];\n 49|    this.normals \u003d [];\n 50|    this.indices \u003d [];\n 51|    \n 52|    /**\n 53|     * Calculate a point on the surface using the parametric equations\n 54|     */\n 55|    this.computePoint \u003d function(u, v) {\n 56|        const ePu \u003d Math.exp(this.p * u); // e^(pu)\n 57|        const eMu \u003d Math.exp(this.m * u); // e^(mu)\n 58|        \n 59|        return {\n 60|            x: (eMu + ePu * Math.cos(v)) * Math.cos(u),\n 61|            y: (eMu + ePu * Math.cos(v)) * Math.sin(u),\n 62|            z: ePu * Math.sin(v)\n 63|        };\n 64|    };\n 65|    \n 66|    /**\n 67|     * Calculate the analytical normal at a point by computing the cross product\n 68|     * of the tangent vectors along u and v directions\n 69|     */\n 70|    this.computeAnalyticalNormal \u003d function(u, v) {\n 71|        const ePu \u003d Math.exp(this.p * u);\n 72|        const eMu \u003d Math.exp(this.m * u);\n 73|        \n 74|        // Partial derivative with respect to u\n 75|        const dxdu \u003d -1 * (eMu + ePu * Math.cos(v)) * Math.sin(u) \n 76|                   + (this.m * eMu + this.p * ePu * Math.cos(v)) * Math.cos(u);\n 77|        const dydu \u003d (eMu + ePu * Math.cos(v)) * Math.cos(u) \n 78|                   + (this.m * eMu + this.p * ePu * Math.cos(v)) * Math.sin(u);\n 79|        const dzdu \u003d this.p * ePu * Math.sin(v);\n 80|        \n 81|        // Partial derivative with respect to v\n 82|        const dxdv \u003d -1 * ePu * Math.sin(v) * Math.cos(u);\n 83|        const dydv \u003d -1 * ePu * Math.sin(v) * Math.sin(u);\n 84|        const dzdv \u003d ePu * Math.cos(v);\n 85|        \n 86|        // Cross product to find normal vector\n 87|        const nx \u003d dydu * dzdv - dzdu * dydv;\n 88|        const ny \u003d dzdu * dxdv - dxdu * dzdv;\n 89|        const nz \u003d dxdu * dydv - dydu * dxdv;\n 90|        \n 91|        // Normalize the normal vector\n 92|        const length \u003d Math.sqrt(nx*nx + ny*ny + nz*nz);\n 93|        return {\n 94|            x: nx / length,\n 95|            y: ny / length,\n 96|            z: nz / length\n 97|        };\n 98|    };\n 99|    \n100|    /**\n101|     * Generate the triangular mesh vertices and indices\n102|     */\n103|    this.generateMesh \u003d function() {\n104|        this.vertices \u003d [];\n105|        this.indices \u003d [];\n106|        \n107|        // Generate vertices\n108|        for (let uIndex \u003d 0; uIndex \u003c\u003d this.uSegments; uIndex++) {\n109|            const u \u003d this.uMin + (uIndex / this.uSegments) * (this.uMax - this.uMin);\n110|            \n111|            for (let vIndex \u003d 0; vIndex \u003c\u003d this.vSegments; vIndex++) {\n112|                const v \u003d this.vMin + (vIndex / this.vSegments) * (this.vMax - this.vMin);\n113|                const point \u003d this.computePoint(u, v);\n114|                \n115|                // Store vertex\n116|                this.vertices.push(point.x, point.y, point.z);\n117|                \n118|                // Calculate analytical normal for now (will be replaced with facet average)\n119|                const normal \u003d this.computeAnalyticalNormal(u, v);\n120|                this.normals.push(normal.x, normal.y, normal.z);\n121|            }\n122|        }\n123|        \n124|        // Generate indices for triangle strips\n125|        for (let uIndex \u003d 0; uIndex \u003c this.uSegments; uIndex++) {\n126|            for (let vIndex \u003d 0; vIndex \u003c this.vSegments; vIndex++) {\n127|                const vertexIndex \u003d uIndex * (this.vSegments + 1) + vIndex;\n128|                \n129|                // First triangle\n130|                this.indices.push(vertexIndex);\n131|                this.indices.push(vertexIndex + 1);\n132|                this.indices.push(vertexIndex + this.vSegments + 1);\n133|                \n134|                // Second triangle\n135|                this.indices.push(vertexIndex + 1);\n136|                this.indices.push(vertexIndex + this.vSegments + 2);\n137|                this.indices.push(vertexIndex + this.vSegments + 1);\n138|            }\n139|        }\n140|        \n141|        this.numVertices \u003d this.vertices.length / 3;\n142|        this.numIndices \u003d this.indices.length;\n143|    };\n144|    \n145|    /**\n146|     * Calculate facet normals for each triangle\n147|     */\n148|    this.calculateFacetNormals \u003d function() {\n149|        const facetNormals \u003d [];\n150|        \n151|        // Initialize facet normals array\n152|        for (let i \u003d 0; i \u003c this.numIndices / 3; i++) {\n153|            facetNormals.push({ x: 0, y: 0, z: 0 });\n154|        }\n155|        \n156|        // Calculate normal for each triangle\n157|        for (let i \u003d 0; i \u003c this.numIndices; i +\u003d 3) {\n158|            const idx1 \u003d this.indices[i];\n159|            const idx2 \u003d this.indices[i + 1];\n160|            const idx3 \u003d this.indices[i + 2];\n161|            \n162|            const v1x \u003d this.vertices[idx1 * 3];\n163|            const v1y \u003d this.vertices[idx1 * 3 + 1];\n164|            const v1z \u003d this.vertices[idx1 * 3 + 2];\n165|            \n166|            const v2x \u003d this.vertices[idx2 * 3];\n167|            const v2y \u003d this.vertices[idx2 * 3 + 1];\n168|            const v2z \u003d this.vertices[idx2 * 3 + 2];\n169|            \n170|            const v3x \u003d this.vertices[idx3 * 3];\n171|            const v3y \u003d this.vertices[idx3 * 3 + 1];\n172|            const v3z \u003d this.vertices[idx3 * 3 + 2];\n173|            \n174|            // Calculate vectors for two sides of the triangle\n175|            const ax \u003d v2x - v1x;\n176|            const ay \u003d v2y - v1y;\n177|            const az \u003d v2z - v1z;\n178|            \n179|            const bx \u003d v3x - v1x;\n180|            const by \u003d v3y - v1y;\n181|            const bz \u003d v3z - v1z;\n182|            \n183|            // Cross product to get normal\n184|            const nx \u003d ay * bz - az * by;\n185|            const ny \u003d az * bx - ax * bz;\n186|            const nz \u003d ax * by - ay * bx;\n187|            \n188|            // Normalize\n189|            const length \u003d Math.sqrt(nx*nx + ny*ny + nz*nz);\n190|            \n191|            facetNormals[i/3] \u003d {\n192|                x: nx / length,\n193|                y: ny / length,\n194|                z: nz / length\n195|            };\n196|        }\n197|        \n198|        return facetNormals;\n199|    };\n200|    \n201|    /**\n202|     * Calculate vertex normals using facet average method\n203|     */\n204|    this.calculateFacetAverageNormals \u003d function() {\n205|        // Reset normals array\n206|        this.normals \u003d new Array(this.numVertices * 3).fill(0);\n207|        \n208|        // Get facet normals\n209|        const facetNormals \u003d this.calculateFacetNormals();\n210|        \n211|        // Map to track which facets are adjacent to each vertex\n212|        const vertexFacets \u003d new Array(this.numVertices).fill().map(() \u003d\u003e []);\n213|        \n214|        // Associate each facet with its vertices\n215|        for (let i \u003d 0; i \u003c this.numIndices; i +\u003d 3) {\n216|            const faceIndex \u003d i / 3;\n217|            const idx1 \u003d this.indices[i];\n218|            const idx2 \u003d this.indices[i + 1];\n219|            const idx3 \u003d this.indices[i + 2];\n220|            \n221|            vertexFacets[idx1].push(faceIndex);\n222|            vertexFacets[idx2].push(faceIndex);\n223|            vertexFacets[idx3].push(faceIndex);\n224|        }\n225|        \n226|        // Calculate average normal for each vertex\n227|        for (let i \u003d 0; i \u003c this.numVertices; i++) {\n228|            let sumX \u003d 0, sumY \u003d 0, sumZ \u003d 0;\n229|            \n230|            // Sum normals of all adjacent facets\n231|            for (const facetIdx of vertexFacets[i]) {\n232|                sumX +\u003d facetNormals[facetIdx].x;\n233|                sumY +\u003d facetNormals[facetIdx].y;\n234|                sumZ +\u003d facetNormals[facetIdx].z;\n235|            }\n236|            \n237|            // Normalize the result\n238|            const length \u003d Math.sqrt(sumX*sumX + sumY*sumY + sumZ*sumZ);\n239|            if (length \u003e 0) {\n240|                this.normals[i * 3] \u003d sumX / length;\n241|                this.normals[i * 3 + 1] \u003d sumY / length;\n242|                this.normals[i * 3 + 2] \u003d sumZ / length;\n243|            }\n244|        }\n245|    };\n246|    \n247|    /**\n248|     * Initialize the model by generating the mesh and setting up buffers\n249|     */\n250|    this.initialize \u003d function() {\n251|        console.log(\&quot;Initializing Cornucopia with parameters:\&quot;);\n252|        console.log(\&quot;p \u003d\&quot;, this.p, \&quot;m \u003d\&quot;, this.m);\n253|        console.log(\&quot;uMax \u003d\&quot;, this.uMax/Math.PI + \&quot;π\&quot;, \&quot;vMax \u003d\&quot;, this.vMax/Math.PI + \&quot;π\&quot;);\n254|        console.log(\&quot;uSegments \u003d\&quot;, this.uSegments, \&quot;vSegments \u003d\&quot;, this.vSegments);\n255|        \n256|        // Generate the mesh data\n257|        this.generateMesh();\n258|        \n259|        // Calculate facet average normals\n260|        this.calculateFacetAverageNormals();\n261|        \n262|        // Create and populate the vertex buffer\n263|        this.vertexBuffer \u003d gl.createBuffer();\n264|        gl.bindBuffer(gl.ARRAY_BUFFER, this.vertexBuffer);\n265|        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(this.vertices), gl.STATIC_DRAW);\n266|        \n267|        // Create and populate the normal buffer\n268|        this.normalBuffer \u003d gl.createBuffer();\n269|        gl.bindBuffer(gl.ARRAY_BUFFER, this.normalBuffer);\n270|        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(this.normals), gl.STATIC_DRAW);\n271|        \n272|        // Create and populate the index buffer\n273|        this.indexBuffer \u003d gl.createBuffer();\n274|        gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, this.indexBuffer);\n275|        gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, new Uint16Array(this.indices), gl.STATIC_DRAW);\n276|    };\n277|    \n278|    /**\n279|     * Draw the model\n280|     */\n281|    this.draw \u003d function(shaderProgram) {\n282|        // Bind vertex buffer and set attribute pointer\n283|        gl.bindBuffer(gl.ARRAY_BUFFER, this.vertexBuffer);\n284|        gl.vertexAttribPointer(shaderProgram.iAttribVertex, 3, gl.FLOAT, false, 0, 0);\n285|        gl.enableVertexAttribArray(shaderProgram.iAttribVertex);\n286|        \n287|        // Bind normal buffer and set attribute pointer\n288|        gl.bindBuffer(gl.ARRAY_BUFFER, this.normalBuffer);\n289|        gl.vertexAttribPointer(shaderProgram.iAttribNormal, 3, gl.FLOAT, false, 0, 0);\n290|        gl.enableVertexAttribArray(shaderProgram.iAttribNormal);\n291|        \n292|        // Bind index buffer\n293|        gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, this.indexBuffer);\n294|        \n295|        // Set material properties\n296|        gl.uniform3fv(shaderProgram.iMaterialAmbient, [0.2, 0.2, 0.2]);\n297|        gl.uniform3fv(shaderProgram.iMaterialDiffuse, [0.0, 0.8, 0.0]);\n298|        gl.uniform3fv(shaderProgram.iMaterialSpecular, [0.8, 0.8, 0.8]);\n299|        gl.uniform1f(shaderProgram.iShininess, 30.0);\n300|        \n301|        // Draw the triangles\n302|        gl.drawElements(gl.TRIANGLES, this.numIndices, gl.UNSIGNED_SHORT, 0);\n303|    };\n304|}\n305|\n306|/**\n307| * Shader Program constructor\n308| */\n309|function ShaderProgram(name, program) {\n310|    this.name \u003d name;\n311|    this.prog \u003d program;\n312|    this.iAttribVertex \u003d -1;\n313|    this.iAttribNormal \u003d -1;\n314|    this.iModelViewProjectionMatrix \u003d -1;\n315|    this.iModelViewMatrix \u003d -1;\n316|    this.iNormalMatrix \u003d -1;\n317|    this.iLightPosition \u003d -1;\n318|    this.iMaterialAmbient \u003d -1;\n319|    this.iMaterialDiffuse \u003d -1;\n320|    this.iMaterialSpecular \u003d -1;\n321|    this.iShininess \u003d -1;\n322|    \n323|    this.use \u003d function() {\n324|        gl.useProgram(this.prog);\n325|    };\n326|}\n327|\n328|/**\n329| * Calculate the normal matrix from the model-view matrix\n330| * Normal matrix is the transpose of the inverse of the top-left 3x3 of the model-view matrix\n331| */\n332|function calculateNormalMatrix(modelViewMatrix, resultMatrix) {\n333|    // Extract the 3x3 portion\n334|    let a00 \u003d modelViewMatrix[0], a01 \u003d modelViewMatrix[1], a02 \u003d modelViewMatrix[2];\n335|    let a10 \u003d modelViewMatrix[4], a11 \u003d modelViewMatrix[5], a12 \u003d modelViewMatrix[6];\n336|    let a20 \u003d modelViewMatrix[8], a21 \u003d modelViewMatrix[9], a22 \u003d modelViewMatrix[10];\n337|    \n338|    // Calculate the determinant\n339|    let det \u003d a00 * (a11 * a22 - a12 * a21) -\n340|              a01 * (a10 * a22 - a12 * a20) +\n341|              a02 * (a10 * a21 - a11 * a20);\n342|    \n343|    if (!det) {\n344|        return null;\n345|    }\n346|    \n347|    det \u003d 1.0 / det;\n348|    \n349|    // Calculate the inverse\n350|    resultMatrix[0] \u003d (a11 * a22 - a12 * a21) * det;\n351|    resultMatrix[1] \u003d (a02 * a21 - a01 * a22) * det;\n352|    resultMatrix[2] \u003d (a01 * a12 - a02 * a11) * det;\n353|    resultMatrix[3] \u003d (a12 * a20 - a10 * a22) * det;\n354|    resultMatrix[4] \u003d (a00 * a22 - a02 * a20) * det;\n355|    resultMatrix[5] \u003d (a02 * a10 - a00 * a12) * det;\n356|    resultMatrix[6] \u003d (a10 * a21 - a11 * a20) * det;\n357|    resultMatrix[7] \u003d (a01 * a20 - a00 * a21) * det;\n358|    resultMatrix[8] \u003d (a00 * a11 - a01 * a10) * det;\n359|    \n360|    return resultMatrix;\n361|}\n362|\n363|/**\n364| * Update the light position for animation\n365| */\n366|function updateLightPosition() {\n367|    // Rotate light around the surface\n368|    lightAngle +\u003d 0.01;\n369|    if (lightAngle \u003e 2 * Math.PI) {\n370|        lightAngle -\u003d 2 * Math.PI;\n371|    }\n372|    \n373|    // Calculate light position (circular orbit)\n374|    const lightX \u003d lightRadius * Math.cos(lightAngle);\n375|    const lightY \u003d lightRadius * Math.sin(lightAngle);\n376|    const lightZ \u003d 20; // Height of the light\n377|    \n378|    return [lightX, lightY, lightZ];\n379|}\n380|\n381|/**\n382| * Draw function\n383| */\n384|function draw() {\n385|    gl.clearColor(0, 0, 0, 1);\n386|    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);\n387|    \n388|    // Set up viewport\n389|    gl.viewport(0, 0, gl.canvas.width, gl.canvas.height);\n390|    \n391|    // Create custom transformation matrices\n392|    const aspect \u003d gl.canvas.width/gl.canvas.height;\n393|    const znear \u003d 1;\n394|    const zfar \u003d 200;\n395|    const fov \u003d Math.PI/3; // 60 degrees field of view\n396|    \n397|    // Create a projection matrix\n398|    const projectionMatrix \u003d m4.perspective(fov, aspect, znear, zfar);\n399|    \n400|    // Get user rotation from trackball\n401|    let modelViewMatrix \u003d spaceball.getViewMatrix();\n402|    \n403|    // Translate back to see the whole structure\n404|    const moveBack \u003d m4.translation(0, 0, -50);\n405|    \n406|    // Update light position for animation\n407|    const lightPosition \u003d updateLightPosition();\n408|    \n409|    // Apply transformations (right to left)\n410|    modelViewMatrix \u003d m4.multiply(moveBack, modelViewMatrix);\n411|    \n412|    // Calculate the combined model-view-projection matrix\n413|    const mvpMatrix \u003d m4.multiply(projectionMatrix, modelViewMatrix);\n414|    \n415|    // Calculate normal matrix (for transforming normals)\n416|    const normalMatrix \u003d calculateNormalMatrix(modelViewMatrix, []);\n417|    \n418|    // Set shader uniforms\n419|    gl.uniformMatrix4fv(shProgram.iModelViewProjectionMatrix, false, mvpMatrix);\n420|    gl.uniformMatrix4fv(shProgram.iModelViewMatrix, false, modelViewMatrix);\n421|    gl.uniformMatrix3fv(shProgram.iNormalMatrix, false, normalMatrix);\n422|    gl.uniform3fv(shProgram.iLightPosition, lightPosition);\n423|    \n424|    // Draw the model\n425|    surface.draw(shProgram);\n426|    \n427|    // Request next frame for animation\n428|    requestAnimationFrame(draw);\n429|}\n430|\n431|/**\n432| * Create shader program\n433| */\n434|function createProgram(gl, vertexShaderSource, fragmentShaderSource) {\n435|    // Create and compile vertex shader\n436|    let vsh \u003d gl.createShader(gl.VERTEX_SHADER);\n437|    gl.shaderSource(vsh, vertexShaderSource);\n438|    gl.compileShader(vsh);\n439|    if (!gl.getShaderParameter(vsh, gl.COMPILE_STATUS)) {\n440|        throw new Error(\&quot;Error in vertex shader: \&quot; + gl.getShaderInfoLog(vsh));\n441|    }\n442|    \n443|    // Create and compile fragment shader\n444|    let fsh \u003d gl.createShader(gl.FRAGMENT_SHADER);\n445|    gl.shaderSource(fsh, fragmentShaderSource);\n446|    gl.compileShader(fsh);\n447|    if (!gl.getShaderParameter(fsh, gl.COMPILE_STATUS)) {\n448|        throw new Error(\&quot;Error in fragment shader: \&quot; + gl.getShaderInfoLog(fsh));\n449|    }\n450|    \n451|    // Create program and link shaders\n452|    let prog \u003d gl.createProgram();\n453|    gl.attachShader(prog, vsh);\n454|    gl.attachShader(prog, fsh);\n455|    gl.linkProgram(prog);\n456|    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {\n457|        throw new Error(\&quot;Link error in program: \&quot; + gl.getProgramInfoLog(prog));\n458|    }\n459|    \n460|    return prog;\n461|}\n462|\n463|/**\n464| * Initialize WebGL\n465| */\n466|function initGL() {\n467|    // Create shader program\n468|    let prog \u003d createProgram(gl, vertexShaderSource, fragmentShaderSource);\n469|    \n470|    // Create shader program object\n471|    shProgram \u003d new ShaderProgram(\&quot;Basic\&quot;, prog);\n472|    shProgram.use();\n473|    \n474|    // Get attribute and uniform locations\n475|    shProgram.iAttribVertex \u003d gl.getAttribLocation(prog, \&quot;vertex\&quot;);\n476|    shProgram.iAttribNormal \u003d gl.getAttribLocation(prog, \&quot;normal\&quot;);\n477|    shProgram.iModelViewProjectionMatrix \u003d gl.getUniformLocation(prog, \&quot;ModelViewProjectionMatrix\&quot;);\n478|    shProgram.iModelViewMatrix \u003d gl.getUniformLocation(prog, \&quot;ModelViewMatrix\&quot;);\n479|    shProgram.iNormalMatrix \u003d gl.getUniformLocation(prog, \&quot;NormalMatrix\&quot;);\n480|    shProgram.iLightPosition \u003d gl.getUniformLocation(prog, \&quot;lightPosition\&quot;);\n481|    shProgram.iMaterialAmbient \u003d gl.getUniformLocation(prog, \&quot;materialAmbient\&quot;);\n482|    shProgram.iMaterialDiffuse \u003d gl.getUniformLocation(prog, \&quot;materialDiffuse\&quot;);\n483|    shProgram.iMaterialSpecular \u003d gl.getUniformLocation(prog, \&quot;materialSpecular\&quot;);\n484|    shProgram.iShininess \u003d gl.getUniformLocation(prog, \&quot;shininess\&quot;);\n485|    \n486|    // Create model\n487|    surface \u003d new CornucopiaModel();\n488|    surface.initialize();\n489|    \n490|    // Enable depth testing\n491|    gl.enable(gl.DEPTH_TEST);\n492|}\n493|\n494|/**\n495| * Update surface granularity\n496| */\n497|function updateSurfaceGranularity(uSegments, vSegments) {\n498|    if (surface) {\n499|        surface.uSegments \u003d uSegments;\n500|        surface.vSegments \u003d vSegments;\n501|        surface.initialize();\n502|        // Request a redraw\n503|        draw();\n504|    }\n505|}\n506|\n507|/**\n508| * Main initialization function\n509| */\n510|function init() {\n511|    try {\n512|        // Get the canvas and initialize WebGL\n513|        let canvas \u003d document.getElementById(\&quot;webglcanvas\&quot;);\n514|        gl \u003d canvas.getContext(\&quot;webgl\&quot;) || canvas.getContext(\&quot;experimental-webgl\&quot;);\n515|        if (!gl) {\n516|            throw \&quot;Browser doesn\u0027t support WebGL\&quot;;\n517|        }\n518|        \n519|        // Initialize GL and create the scene\n520|        initGL();\n521|        \n522|        // Create trackball for rotation\n523|        spaceball \u003d new TrackballRotator(canvas, draw, 0);\n524|        \n525|        // Add UI slider listeners\n526|        const uGranSlider \u003d document.getElementById(\&quot;u-granularity\&quot;);\n527|        const vGranSlider \u003d document.getElementById(\&quot;v-granularity\&quot;);\n528|        \n529|        if (uGranSlider \u0026\u0026 vGranSlider) {\n530|            // Initialize display values\n531|            document.getElementById(\&quot;u-gran-value\&quot;).textContent \u003d uGranSlider.value;\n532|            document.getElementById(\&quot;v-gran-value\&quot;).textContent \u003d vGranSlider.value;\n533|            \n534|            // Define update function\n535|            const updateGranularity \u003d function() {\n536|                const uSegments \u003d parseInt(uGranSlider.value);\n537|                const vSegments \u003d parseInt(vGranSlider.value);\n538|                \n539|                // Update the display values\n540|                document.getElementById(\&quot;u-gran-value\&quot;).textContent \u003d uSegments;\n541|                document.getElementById(\&quot;v-gran-value\&quot;).textContent \u003d vSegments;\n542|                \n543|                // Log the change for debugging\n544|                console.log(`Updating granularity - U: ${uSegments}, V: ${vSegments}`);\n545|                \n546|                // Update the surface\n547|                updateSurfaceGranularity(uSegments, vSegments);\n548|            };\n549|            \n550|            // Use change event instead of input for better performance\n551|            uGranSlider.addEventListener(\&quot;input\&quot;, updateGranularity);\n552|            vGranSlider.addEventListener(\&quot;input\&quot;, updateGranularity);\n553|            \n554|            console.log(\&quot;Granularity slider event listeners initialized\&quot;);\n555|        } else {\n556|            console.warn(\&quot;Could not find granularity sliders!\&quot;);\n557|        }\n558|        \n559|        // Initial drawing of the scene\n560|        draw();\n561|        \n562|        console.log(\&quot;3D Cornucopia surface initialized successfully with Phong shading and Facet Average normals!\&quot;);\n563|    } catch (e) {\n564|        console.error(\&quot;ERROR: \&quot; + e);\n565|       