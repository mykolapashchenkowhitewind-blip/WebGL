t \u003d `\r\n        position: fixed;\r\n        bottom: 10px;\r\n        right: 10px;\r\n        background-color: black;\r\n        color: lime;\r\n        border: 2px solid lime;\r\n        padding: 10px;\r\n        font-family: monospace;\r\n        font-size: 14px;\r\n        z-index: 9999;\r\n        max-width: 400px;\r\n    `;\r\n    document.body.appendChild(statusDiv);\r\n    return statusDiv;\r\n}\r\n\r\n// Check if files exist and can be loaded\r\nfunction checkFiles() {\r\n    const statusDiv \u003d createStatusElement();\r\n    statusDiv.innerHTML \u003d \&quot;Checking server and files...\&quot;;\r\n    \r\n    const filesToCheck \u003d [\r\n        { name: \u0027index.html\u0027, path: \u0027./index.html\u0027 },\r\n        { name: \u0027main.js\u0027, path: \u0027./main.js\u0027 },\r\n        { name: \u0027model.js\u0027, path: \u0027./model.js\u0027 },\r\n        { name: \u0027shaders.js\u0027, path: \u0027./shaders.js\u0027 },\r\n        { name: \u0027Utils/m4.js\u0027, path: \u0027./Utils/m4.js\u0027 },\r\n        { name: \u0027Utils/trackball-rotator.js\u0027, path: \u0027./Utils/trackball-rotator.js\u0027 }\r\n    ];\r\n    \r\n    let results \u003d \&quot;\u003ch3\u003eServer Status Check\u003c/h3\u003e\&quot;;\r\n    let allPassed \u003d true;\r\n    let checksComplete \u003d 0;\r\n    \r\n    // Log server information\r\n    results +\u003d `\u003cp\u003ePage loaded at: ${new Date().toLocaleTimeString()}\u003c/p\u003e`;\r\n    results +\u003d `\u003cp\u003eURL: ${window.location.href}\u003c/p\u003e`;\r\n    \r\n    filesToCheck.forEach(file \u003d\u003e {\r\n        const xhr \u003d new XMLHttpRequest();\r\n        xhr.onreadystatechange \u003d function() {\r\n            if (xhr.readyState \u003d\u003d\u003d 4) {\r\n                const status \u003d xhr.status \u003d\u003d\u003d 200 ? \r\n                    \u0027\u003cspan style\u003d\&quot;color: lime;\&quot;\u003e✓ OK\u003c/span\u003e\u0027 : \r\n                    `\u003cspan style