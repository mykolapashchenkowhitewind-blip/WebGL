    \n 23|    // Higher segment count for the grid-like appearance\n 24|    this.uSegments \u003d 20; // More segments for the longer shape\n 25|    this.vSegments \u003d 20;  // Increase circular segments for more detail\n 26|\n 27|    /**\n 28|     * Calculate the radius at parameter u\n 29|     * R(u) \u003d e^(p*u) where p \u003d 0.1\n 30|     */\n 31|    this.radius \u003d function(u) {\n 32|        return Math.exp(this.p * u);\n 33|    };\n 34|\n 35|    /**\n 36|     * Calculate the 3D point coordinates for parameters u, v\n 37|     * Modified Cornucopia surface for an elongated, less round shape\n 38|     */\n 39|    this.surfacePoint \u003d function(u, v) {\n 40|        const r \u003d this.radius(u);\n 41|        \n 42|        // Elongation factor - stretches the shape along the spiral\n 43|        const elongationFactor \u003d 3.0;\n 44|        \n 45|        // Scaling factor to make circular cross-section more oval (less round)\n 46|        const ovalFactor \u003d 0.6; // Less than 1.0 makes it more oval\n 47|        \n 48|        // Add stretching along the z-axis as u increases\n 49|        const zStretch \u003d 0.2 * u;\n 50|        \n 51|        return {\n 52|            // Scale x-coordinate to reduce roundness\n 53|            x: r * Math.cos(u) * (1 + this.m * Math.cos(v)) * ovalFactor,\n 54|            \n 55|            // Scale y-coordinate to reduce roundness\n 56|            y: r * Math.sin(u) * (1 + this.m * Math.cos(v)) * ovalFactor,\n 57|            \n 58|            // Elongate the z-axis to create a more stretched shape\n 59|            z: (r * this.m * Math.sin(v) + zStretch) * elongationFactor\n 60|        };\n 61|    };\n 62|    \n 63|    /**\n 64|     * Get color for a point based on its position - CHANGED TO BRIGHT GREEN for easy identification\n 65|     * @param {number} u - The u parameter\n 66|     * @param {number} v - The v parameter \n 67|     * @returns {Array} - RGBA color [r, g, b, 1.0]\n 68|     */\n 69|    this.getColorForPoint \u003d function(u, v) {\n 70|        // BRIGHT GREEN ONLY to make it obvious this is the updated version\n 71|        // This will be very obvious if you\u0027re running the new code\n 72|        return [0.0, 1.0, 0.0, 1.0]; // Bright pure green color\n 73|        \n 74|        /* Original rainbow code (commented out):\n 75|        // Create rainbow effect based on u value (position in spiral)\n 76|        const normalizedU \u003d u / this.uMax; // 0 to 1\n 77|        \n 78|        // Rainbow color calculation\n 79|        const r \u003d Math.sin(normalizedU * Math.PI * 2) * 0.5 + 0.5;\n 80|        const g \u003d Math.sin(normalizedU * Math.PI * 2 + 2 * Math.PI/3) * 0.5 + 0.5;\n 81|        const b \u003d Math.sin(normalizedU * Math.PI * 2 + 4 * Math.PI/3) * 0.5 + 0.5;\n 82|        \n 83|        // Add variation based on v for more color richness\n 84|        const vFactor \u003d (Math.cos(v) * 0.2) + 0.8;\n 85|        \n 86|        return [r * vFactor, g * vFactor, b * vFactor, 1.0];\n 87|        */\n 88|    };\n 89|\n 90|    /**\n 91|     * Generate vertices for U polylines (longitudinal lines along the spiral)\n 92|     */\n 93|    this.generateULines \u003d function() {\n 94|        let vertexList \u003d [];\n 95|        \n 96|        // Generate polylines for different values of v\n 97|        const vStep \u003d (this.vMax - this.vMin) / this.vSegments;\n 98|        for (let vi \u003d 0; vi \u003c\u003d this.vSegments; vi++) {\n 99|            const v \u003d this.vMin + vi * vStep;\n100|            \n101|            // For each v, create a polyline with varying u\n102|            for (let ui \u003d 0; ui \u003c\u003d this.uSegments; ui++) {\n103|                const u \u003d this.uMin + (ui / this.uSegments) * (this.uMax - this.uMin);\n104|                const point \u003d this.surfacePoint(u, v);\n105|                vertexList.push(point.x, point.y, point.z);\n106|            }\n107|        }\n108|        \n109|        this.uLinesCount \u003d vertexList.length / 3;\n110|        gl.bindBuffer(gl.ARRAY_BUFFER, this.uLinesBuffer);\n111|        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(vertexList), gl.STATIC_DRAW);\n112|    };\n113|\n114|    /**\n115|     * Generate vertices for V polylines (circular cross-sections)\n116|     * We\u0027ll generate explicit vertex lists for each cross-section we want to draw\n117|     */\n118|    this.generateVLines \u003d function() {\n119|        // We\u0027ll create separate vertex lists for each circular cross-section\n120|        // This ensures we have complete control over exactly how many circles to draw\n121|        \n122|        // Determine how many circular cross-sections to generate (at least 40)\n123|        const numCircles \u003d 60; // Increased to 60 circles\n124|        \n125|        let circleVertices \u003d [];\n126|        \n127|        // Generate the circular cross-sections at specific u values\n128|        for (let i \u003d 0; i \u003c numCircles; i++) {\n129|            // Distribute circles evenly along the u range\n130|            const u \u003d this.uMin + (i / (numCircles - 1)) * (this.uMax - this.uMin);\n131|            \n132|            // Generate each circle (v varies around the cross-section)\n133|            for (let vi \u003d 0; vi \u003c\u003d this.vSegments; vi++) {\n134|                const v \u003d this.vMin + (vi / this.vSegments) * (this.vMax - this.vMin);\n135|                const point \u003d this.surfacePoint(u, v);\n136|                circleVertices.push(point.x, point.y, point.z);\n137|            }\n138|        }\n139|        \n140|        // Store the vertices and record the count\n141|        this.vLinesCount \u003d circleVertices.length / 3;\n142|        gl.bindBuffer(gl.ARRAY_BUFFER, this.vLinesBuffer);\n143|        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(circleVertices), gl.STATIC_DRAW);\n144|        \n145|        console.log(\&quot;Generated \&quot; + numCircles + \&quot; circular cross-sections\&quot;);\n146|        this.numCircles \u003d numCircles; // Store for drawing\n147|    };\n148|\n149|    /**\n150|     * Initialize the model by generating all vertices\n151|     */\n152|    this.initialize \u003d function() {\n153|        // CLEAR DEBUGGING MESSAGE - This will appear in the console when the updated version is running\n154|        console.log(\&quot;%c UPDATED VERSION - GREEN COLOR MODEL IS RUNNING\&quot;, \&quot;color: lime; font-size: 20px; font-weight: bold; background-color: black;\&quot;);\n155|        console.log(\&quot;%c Check that this is the newer version with p\u003d0.1, m\u003d0.2, uMax\u003d4π\&quot;, \&quot;color: yellow; font-size: 16px;\&quot;);\n156|        \n157|        // Alert to make it very obvious\n158|        if (typeof window !\u003d\u003d \u0027undefined\u0027 \u0026\u0026 window.alert) {\n159|            window.alert(\&quot;RUNNING UPDATED VERSION - You should now see a GREEN ELONGATED model with 40+ circles\&quot;);\n160|        }\n161|        \n162|        // For debugging - output test points to verify calculations\n163|        const testU \u003d 1.0;\n164|        const testV \u003d Math.PI/4;\n165|        const testPoint \u003d this.surfacePoint(testU, testV);\n166|        console.log(\&quot;Model parameters:\&quot;, {\n167|            p: this.p, \n168|            m: this.m, \n169|            uMax: this.uMax / Math.PI + \&quot;π\&quot;,\n170|            segments: this.uSegments + \&quot;×\&quot; + this.vSegments\n171|        });\n172|        console.log(\&quot;Test point at u\u003d\&quot; + testU + \&quot;, v\u003d\&quot; + testV + \&quot;:\&quot;, testPoint);\n173|        \n174|        this.generateULines();\n175|        console.log(\&quot;U lines generated, count:\&quot;, this.uLinesCount);\n176|        \n177|        this.generateVLines();\n178|        console.log(\&quot;V lines generated, count:\&quot;, this.vLinesCount);\n179|        \n180|        // Add a debug message to the page if the debug-info element exists\n181|        if (document.getElementById(\u0027debug-info\u0027)) {\n182|            document.getElementById(\u0027debug-info\u0027).innerHTML \u003d \n183|                \&quot;\u003cstrong style\u003d\u0027color:lime\u0027\u003eUPDATED VERSION RUNNING: GREEN ELONGATED MODEL\u003c/strong\u003e\u003cbr\u003e\&quot; +\n184|                \&quot;Parameters: p\u003d\&quot; + this.p + \&quot;, m\u003d\&quot; + this.m + \&quot;, uMax\u003d\&quot; + (this.uMax/Math.PI) + \&quot;π\u003cbr\u003e\&quot; +\n185|                \&quot;Grid: \&quot; + this.uSegments + \&quot;×\&quot; + this.vSegments + \&quot;\u003cbr\u003e\&quot; +\n186|                \&quot;Circular cross-sections: 40+ (increased from 20)\u003cbr\u003e\&quot; +\n187|                \&quot;Elongation factors: 3.0x length, 0.6x roundness\u003cbr\u003e\&quot;;\n188|            document.getElementById(\u0027debug-info\u0027).style.display \u003d \u0027block\u0027;\n189|        }\n190|    };\n191|\n192|    /**\n193|     * Generate arrays for U and V lines with colors\n194|     */\n195|    this.generateColoredLines \u003d function() {\n196|        // For U lines (constant v, varying u) - store color with each vertex\n197|        let uColoredLines \u003d [];\n198|        const vStep \u003d (this.vMax - this.vMin) / this.vSegments;\n199|        \n200|        for (let vi \u003d 0; vi \u003c\u003d this.vSegments; vi++) {\n201|            const v \u003d this.vMin + vi * vStep;\n202|            let lineVertices \u003d [];\n203|            \n204|            for (let ui \u003d 0; ui \u003c\u003d this.uSegments; ui++) {\n205|                const u \u003d this.uMin + (ui / this.uSegments) * (this.uMax - this.uMin);\n206|                const point \u003d this.surfacePoint(u, v);\n207|                const color \u003d this.getColorForPoint(u, v);\n208|                \n209|                // Store vertex and its color\n210|                lineVertices.push({\n211|                    position: [point.x, point.y, point.z],\n212|                    color: color\n213|                });\n214|            }\n215|            \n216|            uColoredLines.push(lineVertices);\n217|        }\n218|        \n219|        // For V lines (constant u, varying v) - store color with each vertex\n220|        let vColoredLines \u003d [];\n221|        const uStep \u003d (this.uMax - this.uMin) / this.uSegments;\n222|        \n223|        for (let ui \u003d 0; ui \u003c\u003d this.uSegments; ui++) {\n224|            const u \u003d this.uMin + ui * uStep;\n225|            let lineVertices \u003d [];\n226|            \n227|            for (let vi \u003d 0; vi \u003c\u003d this.vSegments; vi++) {\n228|                const v \u003d this.vMin + (vi / this.vSegments) * (this.vMax - this.vMin);\n229|                const point \u003d this.surfacePoint(u, v);\n230|                const color \u003d this.getColorForPoint(u, v);\n231|                \n232|                // Store vertex and its color\n233|                lineVertices.push({\n234|                    position: [point.x, point.y, point.z],\n235|                    color: color\n236|                });\n237|            }\n238|            \n239|            vColoredLines.push(lineVertices);\n240|        }\n241|        \n242|        return { uLines: uColoredLines, vLines: vColoredLines };\n243|    };\n244|\n245|    /**\n246|     * Draw the wireframe model with colors\n247|     */\n248|    this.Draw \u003d function(shaderProgram) {\n249|        // First pass: Draw U polylines (longitudinal lines)\n250|        gl.bindBuffer(gl.ARRAY_BUFFER, this.uLinesBuffer);\n251|        gl.vertexAttribPointer(shaderProgram.iAttribVertex, 3, gl.FLOAT, false, 0, 0);\n252|        gl.enableVertexAttribArray(shaderProgram.iAttribVertex);\n253|        \n254|        const verticesPerULine \u003d this.uSegments + 1;\n255|        for (let i \u003d 0; i \u003c this.uLinesCount / verticesPerULine; i++) {\n256|            // Set color based on position in spiral\n257|            const normalizedI \u003d i / this.vSegments;\n258|            const u \u003d this.uMin + (this.uMax - this.uMin) * 0.5; // Middle of u range\n259|            const v \u003d this.vMin + normalizedI * (this.vMax - this.vMin);\n260|            const color \u003d this.getColorForPoint(u, v);\n261|            gl.uniform4fv(shaderProgram.iColor, color);\n262|            \n263|            gl.drawArrays(gl.LINE_STRIP, i * verticesPerULine, verticesPerULine);\n264|        }\n265|        \n266|        // Second pass: Draw V polylines (circular cross-sections)\n267|        gl.bindBuffer(gl.ARRAY_BUFFER, this.vLinesBuffer);\n268|        gl.vertexAttribPointer(shaderProgram.iAttribVertex, 3, gl.FLOAT, false, 0, 0);\n269|        gl.enableVertexAttribArray(shaderProgram.iAttribVertex);\n270|        \n271|        const verticesPerCircle \u003d this.vSegments + 1;\n272|        \n273|        // Draw each circular cross-section\n274|        for (let i \u003d 0; i \u003c this.numCircles; i++) {\n275|            // Calculate a normalized position for color\n276|            const normalizedI \u003d i / (this.numCircles - 1);\n277|            const u \u003d this.uMin + normalizedI * (this.uMax - this.uMin);\n278|            const color \u003d this.getColorForPoint(u, 0);\n279|            gl.uniform4fv(shaderProgram.iColor, color);\n280|            \n281|            // Draw this circle as a LINE_LOOP (closed loop)\n282|            gl.drawArrays(gl.LINE_LOOP, i * verticesPerCircle, verticesPerCircle);\n283|        }\n284|        \n285|        // Log how many circles we\u0027re drawing on each frame\n286|        if (this.frameCount \u003d\u003d\u003d undefined) {\n287|            this.frameCount \u003d 0;\n288|        }\n289|        \n290|        if (this.frameCount % 60 \u003d\u003d\u003d 0) { // Log once every ~60 frames\n291|            console.log(\&quot;Drawing \&quot; + this.numCircles + \&quot; circular cross-sections\&quot;);\n292|        }\n293|        this.frameCount++;\n294|    };\n295|}&quot;},{&q