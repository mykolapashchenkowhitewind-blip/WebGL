      height: 15px;\n 93|            background: #0f0;\n 94|            border-radius: 50%;\n 95|            cursor: pointer;\n 96|        }\n 97|        .slider::-moz-range-thumb {\n 98|            width: 15px;\n 99|            height: 15px;\n100|            background: #0f0;\n101|            border-radius: 50%;\n102|            cursor: pointer;\n103|        }\n104|        .slider-value {\n105|            width: 40px;\n106|            margin-left: 15px;\n107|            text-align: center;\n108|        }\n109|    \u003c/style\u003e\n110|\n111|    \u003c!-- Core libraries --\u003e\n112|    \u003cscript src\u003d\&quot;./Utils/m4.js\&quot;\u003e\u003c/script\u003e\n113|    \u003cscript src\u003d\&quot;./Utils/trackball-rotator.js\&quot;\u003e\u003c/script\u003e\n114|    \u003cscript src\u003d\&quot;./shaders.js\&quot;\u003e\u003c/script\u003e\n115|    \u003cscript src\u003d\&quot;./cornucopia3.js\&quot;\u003e\u003c/script\u003e\n116|        \n117|    \u003cscript\u003e\n118|        // Add event listener for the refresh button after the page loads\n119|        window.addEventListener(\u0027load\u0027, function() {\n120|            const refreshButton \u003d document.getElementById(\u0027refresh-button\u0027);\n121|            const paramP \u003d document.getElementById(\u0027param-p\u0027);\n122|            const paramM \u003d document.getElementById(\u0027param-m\u0027);\n123|            const paramU \u003d document.getElementById(\u0027param-u\u0027);\n124|            const paramV \u003d document.getElementById(\u0027param-v\u0027);\n125|            \n126|            // Set initial values directly from the mathematical definition\n127|            // These values match exactly what\u0027s shown in the Mathematical Definition section\n128|            paramP.value \u003d 0.15; // p \u003d 0.15\n129|            paramM.value \u003d 0.1;  // m \u003d 0.1\n130|            paramU.value \u003d 5;    // u ≤ 5π\n131|            paramV.value \u003d 2;    // v ≤ 2π\n132|            \n133|            // Also ensure the model uses these exact values\n134|            setTimeout(function() {\n135|                if (surface) {\n136|                    // Verify that the model parameters match the HTML definition\n137|                    if (surface.p !\u003d 0.15 || surface.m !\u003d 0.1 || \n138|                        surface.uMax !\u003d 5 * Math.PI || surface.vMax !\u003d 2 * Math.PI) {\n139|                        console.log(\&quot;Correcting model parameters to match Mathematical Definition\&quot;);\n140|                        surface.p \u003d 0.15;\n141|                        surface.m \u003d 0.1;\n142|                        surface.uMax \u003d 5 * Math.PI;\n143|                        surface.vMax \u003d 2 * Math.PI;\n144|                        surface.initialize();\n145|                        draw();\n146|                    }\n147|                }\n148|            }, 500);\n149|            \n150|            if (refreshButton) {\n151|                refreshButton.addEventListener(\u0027click\u0027, function() {\n152|                    // Get values from inputs\n153|                    if (surface) {\n154|                        // Update parameters\n155|                        surface.p \u003d parseFloat(paramP.value);\n156|                        surface.m \u003d parseFloat(paramM.value);\n157|                        surface.uMax \u003d parseFloat(paramU.value) * Math.PI;\n158|                        surface.vMax \u003d parseFloat(paramV.value) * Math.PI;\n159|                        \n160|                        console.log(\&quot;Applying new parameters:\&quot;);\n161|                        console.log(\&quot;p \u003d\&quot;, surface.p, \&quot;m \u003d\&quot;, surface.m, \&quot;uMax \u003d\&quot;, surface.uMax/Math.PI + \&quot;π\&quot;, \&quot;vMax \u003d\&quot;, surface.vMax/Math.PI + \&quot;π\&quot;);\n162|                        \n163|                        // Update formula display in the info panel\n164|                        const mathFormula \u003d document.querySelector(\u0027.math-formula\u0027);\n165|                        if (mathFormula) {\n166|                            // Find the part after the parametric equations\n167|                            const whereSection \u003d mathFormula.innerHTML.split(\u0027\u003cstrong\u003eWhere:\u003c/strong\u003e\u0027);\n168|                            if (whereSection.length \u003e 1) {\n169|                                mathFormula.innerHTML \u003d whereSection[0] + \n170|                                    \u0027\u003cstrong\u003eWhere:\u003c/strong\u003e\u003cbr\u003e\u0027 +\n171|                                    \u0027- p \u003d \u0027 + surface.p + \u0027 (parameter p)\u003cbr\u003e\u0027 +\n172|                                    \u0027- m \u003d \u0027 + surface.m + \u0027 (parameter m)\u003cbr\u003e\u0027 +\n173|                                    \u0027- 0 ≤ u ≤ \u0027 + (surface.uMax/Math.PI) + \u0027π (lengthwise parameter)\u003cbr\u003e\u0027 +\n174|                                    \u0027- 0 ≤ v ≤ \u0027 + (surface.vMax/Math.PI) + \u0027π (cross-section parameter)\u0027;\n175|                            }\n176|                        }\n177|                        \n178|                        // Reinitialize the model\n179|                        surface.initialize();\n180|                        \n181|                        // Redraw\n182|                        draw();\n183|                        \n184|                        console.log(\&quot;Model updated with new parameters!\&quot;);\n185|                        \n186|                        // Flash confirmation message\n187|                        const button \u003d document.getElementById(\u0027refresh-button\u0027);\n188|                        button.textContent \u003d \&quot;Parameters Applied!\&quot;;\n189|                        button.style.backgroundColor \u003d \&quot;#00ff99\&quot;;\n190|                        setTimeout(function() {\