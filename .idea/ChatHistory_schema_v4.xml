u003c/script\u003e\r\n    \u003cscript src\u003d\&quot;./cornucopia3.js\&quot;\u003e\u003c/script\u003e\r\n        \r\n    \u003cscript\u003e\r\n        // Add event listener for the refresh button after the page loads\r\n        window.addEventListener(\u0027load\u0027, function() {\r\n            const refreshButton \u003d document.getElementById(\u0027refresh-button\u0027);\r\n            const paramP \u003d document.getElementById(\u0027param-p\u0027);\r\n            const paramM \u003d document.getElementById(\u0027param-m\u0027);\r\n            const paramU \u003d document.getElementById(\u0027param-u\u0027);\r\n            const paramV \u003d document.getElementById(\u0027param-v\u0027);\r\n            \r\n            // Set initial values directly from the mathematical definition\r\n            // These values match exactly what\u0027s shown in the Mathematical Definition section\r\n            paramP.value \u003d 0.15; // p \u003d 0.15\r\n            paramM.value \u003d 0.1;  // m \u003d 0.1\r\n            paramU.value \u003d 5;    // u ≤ 5π\r\n            paramV.value \u003d 2;    // v ≤ 2π\r\n            \r\n            // Also ensure the model uses these exact values\r\n            setTimeout(function() {\r\n                if (surface) {\r\n                    // Verify that the model parameters match the HTML definition\r\n                    if (surface.p !\u003d 0.15 || surface.m !\u003d 0.1 || \r\n                        surface.uMax !\u003d 5 * Math.PI || surface.vMax !\u003d 2 * Math.PI) {\r\n                        console.log(\&quot;Correcting model parameters to match Mathematical Definition\&quot;);\r\n                        surface.p \u003d 0.15;\r\n                        surface.m \u003d 0.1;\r\n                        surface.uMax \u003d 5 * Math.PI;\r\n                        surface.vMax \u003d 2 * Math.PI;\r\n                        surface.initialize();\r\n                        draw();\r\n                    }\r\n                }\r\n            }, 500);\r\n            \r\n            if (refreshButton) {\r\n                refreshButton.addEventListener(\u0027click\u0027, function() {\r\n                    // Get values from inputs\r\n                    if (surface) {\r\n                        // Update parameters\r\n                        surface.p \u003d parseFloat(paramP.value);\r\n                        surface.m \u003d parseFloat(paramM.value);\r\n                        surface.uMax \u003d parseFloat(paramU.value) * Math.PI;\r\n                        surface.vMax \u003d parseFloat(paramV.value) * Math.PI;\r\n                        \r\n                        console.log(\&quot;Applying new parameters:\&quot;);\r\n                        console.log(\&quot;p \u003d\&quot;, surface.p, \&quot;m \u003d\&quot;, surface.m, \&quot;uMax \u003d\&quot;, surface.uMax/Math.PI + \&quot;π\&quot;, \&quot;vMax \u003d\&quot;, surface.vMax/Math.PI + \&quot;π\&quot;);\r\n                        \r\n                        // Update formula display in the info panel\r\n                        const mathFormula \u003d document.querySelector(\u0027.math-formula\u0027);\r\n                        if (mathFormula) {\r\n                            // Find the part after the parametric equations\r\n                            const whereSection \u003d mathFormula.innerHTML.split(\u0027\u003cstrong\u003eWhere:\u003c/strong\u003e\u0027);\r\n                            if (whereSection.length \u003e 1) {\r\n                                mathFormula.innerHTML \u003d whereSection[0] + \r\n                                    \u0027\u003cstrong\u003eWhere:\u003c/strong\u003e\u003cbr\u003e\u0027 +\r\n                                    \u0027- p \u003d \u0027 + surface.p + \u0027 (parameter p)\u003cbr\u003e\u0027 +\r\n                                    \u0027- m \u003d \u0027 + surface.m + \u0027 (parameter m)\u003cbr\u003e\u0027 +\r\n                                    \u0027- 0 ≤ u ≤ \u0027 + (surface.uMax/Math.PI) + \u0027π (lengthwise parameter)\u003cbr\u003e\u0027 +\r\n                                    \u0027- 0 ≤ v ≤ \u0027 + (surface.vMax/Math.PI) + \u0027π (cross-section parameter)\u0027;\r\n                            }\r\n                        }\r\n                        \r\n                        // Reinitialize the model\r\n                        surface.initialize();\r\n                        \r\n                        // Redraw\r\n                        draw();\r\n                        \r\n                        console.log(\&quot;Model updated with new parameters!\&quot;);\r\n                        \r\n                        // Flash confirmation message\r\n                        const button \u003d document.getElementById(\u0027refresh-button\u0027);\r\n                        button.textContent \u003d \&quot;Parameters Applied!\&quot;;\r\n                        button.style.backgroundColor \u003d \&quot;#00ff99\&quot;;\r\n                        setTimeout(function() {\r\n                            button.textContent \u003d \&quot;Apply Parameters\&quot;;\r\n                            button.style.backgroundColor \u003d \&quot;#0f0\&quot;;\r\n                        }, 1500);\r\n                    }\r\n                });\r\n            }\r\n\r\n            // Add direct event listeners to granularity sliders\r\n            setupGranularitySliders();\r\n        });\r\n\r\n        // Function to directly update mesh when sliders change\r\n        function updateMeshGranularity() {\r\n            if (!surface) return;\r\n\r\n            const uSlider \u003d document.getElementById(\&quot;u-granularity\&quot;);\r\n            const vSlider \u003d document.getElementById(\&quot;v-granularity\&quot;);\r\n            const uValue \u003d document.getElementById(\&quot;u-gran-value\&quot;);\r\n            const vValue \u003d document.getElementById(\&quot;v-gran-value\&quot;);\r\n\r\n            if (uSlider \u0026\u0026 vSlider \u0026\u0026 uValue \u0026\u0026 vValue) {\r\n                const uSegments \u003d parseInt(uSlider.value);\r\n                const vSegments \u003d parseInt(vSlider.value);\r\n                \r\n                // Update display values\r\n                uValue.textContent \u003d uSegments;\r\n                vValue.textContent \u003d vSegments;\r\n\r\n                // Update the surface\r\n                console.log(\&quot;Direct update from sliders: U\u003d\&quot; + uSegments + \&quot;, V\u003d\&quot; + vSegments);\r\n                surface.uSegments \u003d uSegments;\r\n                surface.vSegments \u003d vSegments;\r\n                surface.initialize();\r\n                draw();\r\n            }\r\n        }\r\n\r\n        // Setup granularity sliders with direct event handlers\r\n        function setupGranularitySliders() {\r\n            const uSlider \u003d document.getElementById(\&quot;u-granularity\&quot;);\r\n            const vSlider \u003d document.getElementById(\&quot;v-granularity\&quot;);\r\n            \r\n            if (uSlider \u0026\u0026 vSlider \u0026\u0026 surface) {\r\n                // Set initial values to match model\r\n                uSlider.value \u003d surface.uSegments;\r\n                vSlider.value \u003d surface.vSegments;\r\n                \r\n                document.getElementById(\&quot;u-gran-value\&quot;).textContent \u003d surface.uSegments;\r\n                document.getElementById(\&quot;v-gran-value\&quot;).textContent \u003d surface.vSegments;\r\n                \r\n                console.log(\&quot;Granularity sliders initialized with values:\&quot;, surface.uSegments, surface.vSegments);\r\n            }\r\n        }\r\n    \u003c/script\u003e\r\n\u003c/head\u003e\r\n\u003cbody onload\u003d\&quot;init()\&quot;\u003e\r\n    \u003cdiv class\u003d\&quot;container\&quot;\u003e\r\n        \u003ch1\u003eCornucopia Surface - WebGL Visualization with Phong Shading\u003c/h1\u003e\r\n        \r\n        \u003cdiv class\u003d\&quot;info-panel\&quot;\u003e\r\n            \u003ch2\u003eProject Description\u003c/h2\u003e\r\n            \u003cp\u003eThis visualization demonstrates a 3D model of a \&quot;Cornucopia\&quot; surface rendered using WebGL with Phong shading and Facet Average normal calculation.\u003c/p\u003e\r\n            \u003cp\u003eThe Cornucopia is a special case of a spiral-shaped surface \&quot;Shell without vertex\&quot;. It\u0027s a cyclic surface with generatrix circles of variable radius that creates the distinctive horn-like shape.\u003c/p\u003e\r\n            \r\n            \u003ch2\u003eMathematical Definition\u003c/h2\u003e\r\n            \u003cp\u003eThe Cornucopia surface is defined by the following parametric equations:\u003c/p\u003e\r\n            \r\n            \u003cdiv class\u003d\&quot;math-formula\&quot;\u003e\r\n                \u003cstrong\u003eParametric Equations:\u003c/strong\u003e\u003cbr\u003e\r\n                x(u,v) \u003d [e\u003csup\u003emu\u003c/sup\u003e + e\u003csup\u003epu\u003c/sup\u003ecos(v)]cos(u)\u003cbr\u003e\r\n                y(u,v) \u003d [e\u003csup\u003emu\u003c/sup\u003e + e\u003csup\u003epu\u003c/sup\u003ecos(v)]sin(u)\u003cbr\u003e\r\n                z(u,v) \u003d e\u003csup\u003epu\u003c/sup\u003esin(v)\u003cbr\u003e\u003cbr\u003e\r\n                \r\n                \u003cstrong\u003eWhere:\u003c/strong\u003e\u003cbr\u003e\r\n                - p \u003d 0.15 (parameter p)\u003cbr\u003e\r\n                - m \u003d 0.1 (parameter m)\u003cbr\u003e\r\n                - 0 ≤ u ≤ 5π (lengthwise parameter)\u003cbr\u003e\r\n                - 0 ≤ v ≤ 2π (cross-section parameter)\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv id\u003d\&quot;canvas-holder\&quot;\u003e\r\n            \u003ccanvas width\u003d\&quot;800\&quot; height\u003d\&quot;600\&quot; id\u003d\&quot;webglcanvas\&quot; style\u003d\&quot;background-color:black\&quot;\u003e\u003c/canvas\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv class\u003d\&quot;controls-panel\&quot;\u003e\r\n            \u003ch3\u003eSurface Parameters\u003c/h3\u003e\r\n            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\r\n                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-p\&quot;\u003ep value:\u003c/label\u003e\r\n                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-p\&quot; value\u003d\&quot;0.15\&quot; step\u003d\&quot;0.01\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\r\n                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-m\&quot;\u003em value:\u003c/label\u003e\r\n                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-m\&quot; value\u003d\&quot;0.1\&quot; step\u003d\&quot;0.01\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\r\n                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-u\&quot;\u003eu max (π):\u003c/label\u003e\r\n                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-u\&quot; value\u003d\&quot;5\&quot; step\u003d\&quot;0.5\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\r\n                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-v\&quot;\u003ev max (π):\u003c/label\u003e\r\n                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-v\&quot; value\u003d\&quot;2\&quot; step\u003d\&quot;0.5\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\r\n            \u003c/div\u003e\r\n            \r\n            \u003cbutton id\u003d\&quot;refresh-button\&quot; style\u003d\&quot;margin-top: 10px; padding: 8px 16px; background-color: #0f0; color: black; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;\&quot;\u003eApply Parameters\u003c/button\u003e\r\n            \r\n            \u003cdiv class\u003d\&quot;granularity-section\&quot;\u003e\r\n                \u003ch3\u003eMesh Granularity\u003c/h3\u003e\r\n                \u003cdiv class\u003d\&quot;slider-container\&quot;\u003e\r\n                    \u003cspan class\u003d\&quot;slider-label\&quot;\u003eU Segments:\u003c/span\u003e\r\n                    \u003cinput type\u003d\&quot;range\&quot; min\u003d\&quot;10\&quot; max\u003d\&quot;200\&quot; value\u003d\&quot;80\&quot; class\u003d\&quot;slider\&quot; id\u003d\&quot;u-granularity\&quot; oninput\u003d\&quot;updateMeshGranularity()\&quot;\u003e\r\n                    \u003cspan class\u003d\&quot;slider-value\&quot; id\u003d\&quot;u-gran-value\&quot;\u003e80\u003c/span\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class\u003d\&quot;slider-container\&quot;\u003e\r\n                    \u003cspan class\u003d\&quot;slider-label\&quot;\u003eV Segments:\u003c/span\u003e\r\n                    \u003cinput type\u003d\&quot;range\&quot; min\u003d\&quot;10\&quot; max\u003d\&quot;100\&quot; value\u003d\&quot;40\&quot; class\u003d\&quot;slider\&quot; id\u003d\&quot;v-granularity\&quot; oninput\u003d\&quot;updateMeshGranularity()\&quot;\u003e\r\n                    \u003cspan class\u003d\&quot;slider-value\&quot; id\u003d\&quot;v-gran-value\&quot;\u003e40\u003c/span\u003e\r\n                \u003c/div\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv class\u003d\&quot;info-panel\&quot;\u003e\r\n            \u003ch2\u003eImplementation Details\u003c/h2\u003e\r\n            \u003cp\u003eThis implementation includes:\u003c/p\u003e\r\n            \u003cul\u003e\r\n                \u003cli\u003e\u003cstrong\u003ePhong Shading:\u003c/strong\u003e Realistic lighting with ambient, diffuse, and specular components\u003c/li\u003e\r\n                \u003cli\u003e\u003cstrong\u003eFacet Average Normal:\u003c/strong\u003e Normals are calculated by averaging adjacent facet normals\u003c/li\u003e\r\n                \u003cli\u003e\u003cstrong\u003eRotating Light Source:\u003c/strong\u003e A moving light that circles around the model\u003c/li\u003e\r\n                \u003cli\u003e\u003cstrong\u003eTriangle Mesh:\u003c/strong\u003e The surface is rendered with filled triangles using VBO with indices\u003c/li\u003e\r\n                \u003cli\u003e\u003cstrong\u003eAdjustable Granularity:\u003c/strong\u003e U and V segment sliders allow controlling the mesh density\u003c/li\u003e\r\n            \u003c/ul\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv class\u003d\&quot;student-info\&quot;\u003e\r\n            \u003ch2\u003eStudent Information\u003c/h2\u003e\r\n            \u003cp\u003e\u003cstrong\u003eName:\u003c/strong\u003e Pashchenko Mykola\u003c/p\u003e\r\n            \u003cp\u003e\u003cstrong\u003eGroup:\u003c/strong\u003e TR-51mp\u003c/p\u003e\r\n            \u003cp\u003e\u003cstrong\u003eCourse:\u003c/strong\u003e WebGL Visualization\u003c/p\u003e\r\n            \u003cp\u003e\u003cstrong\u003eAssignment:\u003c/strong\u003e PA#2 - Cornucopia Surface with Phong Shading\u003c/p\u003e\r\n            \u003cp\u003e\u003cstrong\u003eVariant:\u003c/strong\u003e 23 (Phong Shading, Facet Average Normals)\u003c/p\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv class\u003d\&quot;footer\&quot;\u003e\r\n            \u003cp\u003eInteractive WebGL Visualization - Created using JavaScript and WebGL\u003c/p\u003e\r\n            \u003cp\u003eDrag your mouse on the model to rotate it. On a touch screen, you can use your finger.\u003c/p\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n\u003c/body\u003e\r\n\u003c/html\u003e&quot;,&quot;timestamp&quot;:1766679235568,&quot;ranges&quot;:[],&quot;type&quot;:&quot;recent_file&quot;},{&quot;file_path&quot;:&quot;shader.gpu&quot;,&quot;code_text&quot;:&quot;\r\n\r\n// Vertex shader\r\nconst vertexShaderSource \u003d `\r\nattribute vec3 vertex;\r\nuniform mat4 ModelViewProjectionMatrix;\r\n\r\nvoid main() {\r\n    gl_Position \u003d ModelViewProjectionMatrix * vec4(vertex,1.0);\r\n}`;\r\n\r\n\r\n// Fragment shader\r\nconst fragmentShaderSource \u003d `\r\n#ifdef GL_FRAGMENT_PRECISION_HIGH\r\n   precision highp float;\r\n#else\r\n   precision mediump float;\r\n#endif\r\n\r\nuniform vec4 color;\r\nvoid main() {\r\n    gl_FragColor \u003d color;\r\n}`;&quot;,&quot;timestamp&quot;:1766679232287,&quot;ranges&quot;:[],&quot;type&quot;:&quot;recent_file&quot;},{&quot;mode&quot;:&quot;Write&quot;,&quot;plan_file_path&quot;:&quot;C:\\Users\\Lenovo\\.firebender\\projects\\D:-PROJECT_ME-project_SHAME-INSTITUTKA-Visualisation-WebGL2\\plans\\plan-ceee66.md&quot;,&quot;ranges&quot;:[],&quot;type&quot;:&quot;query_metadata&quot;}]},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;thinking&quot;,&quot;thinking&quot;:&quot;Let me check the current shaders.js file to find where the light is actually used in the calculations, and add some logging to help debug the lighting issue.&quot;,&quot;signature&quot;:&quot;ErcBCkgICxgCIkDo1RAyoX3nPSziMxgFD7kj5UHIJIb5f7I4PJbNEwvfXw6wjyDrfbxCeAwrvO6qxtnxRmbrxsoF8e7fTVagGt70KAESDPBtNoUehlH67u+nPRoMJ6IBZEHa04gs/j2RIjCypbG/ibQihlpXdUlciEZwaHhZSyCWy+Z+E7JK3TZBv8I18FEq08LS9aPBAX2Ac+oqHWI2Avhjb6TLk3ok7WQvS8MEM0z8EwIHxdp6Y3eiGAI\u003d&quot;},{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;Let me modify the shaders.js file to add logging for the lighting calculations. I\u0027ll add console.log statements at key points to help debug the lighting:&quot;}],&quot;tool_calls&quot;:[{&quot;id&quot;:&quot;toolu_01GDPZsRCcMigPW1Jyn7PR2X&quot;,&quot;type&quot;:&quot;function&quot;,&quot;function&quot;:{&quot;name&quot;:&quot;write&quot;,&quot;arguments&quot;:&quot;{\&quot;file_path\&quot;: \&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL2/shaders.js\&quot;, \&quot;content\&quot;: \&quot;\u0027use strict\u0027;\\n\\n// Log light parameters for debugging\\nconsole.log(\\\&quot;Loading Phong shaders with lighting calculations\\\&quot;);\\n\\n// Vertex shader for Phong shading\\nconst vertexShaderSource \u003d `\\nattribute vec3 vertex;\\nattribute vec3 normal;\\nuniform mat4 ModelViewProjectionMatrix;\\nuniform mat4 ModelViewMatrix;\\nuniform mat3 NormalMatrix; // For transforming normals\\nuniform vec3 lightPosition; // In world space\\n\\nvarying vec3 fragNormal;\\nvarying vec3 fragPosition;\\nvarying vec3 fragLightPosition;\\n\\nvoid main() {\\n    // Transform vertex to clip space\\n    gl_Position \u003d ModelViewProjectionMatrix * vec4(vertex, 1.0);\\n    \\n    // Pass transformed normal to fragment shader\\n    fragNormal \u003d NormalMatrix * normal;\\n    \\n    // Pass vertex position in view space for lighting calculations\\n    fragPosition \u003d vec3(ModelViewMatrix * vec4(vertex, 1.0));\\n    \\n    // Pass light position to fragment shader\\n    fragLightPosition \u003d vec3(ModelViewMatrix * vec4(lightPosition, 1.0));\\n}`;\\n\\n// Fragment shader for Phong lighting\\nconst fragmentShaderSource \u003d `\\n#ifdef GL_FRAGMENT_PRECISION_HIGH\\n   precision highp float;\\n#else\\n   precision mediump float;\\n#endif\\n\\nvarying vec3 fragNormal;\\nvarying vec3 fragPosition;\\nvarying vec3 fragLightPosition;\\n\\n// Material properties\\nuniform vec3 materialAmbient;\\nuniform vec3 materialDiffuse;\\nuniform vec3 materialSpecular;\\nuniform float shininess;\\n\\nvoid main() {\\n    // Normalize vectors (required for correct lighting)\\n    vec3 normal \u003d normalize(fragNormal);\\n    \\n    // Calculate vector from fragment to light\\n    vec3 lightDir \u003d normalize(fragLightPosition - fragPosition);\\n    \\n    // Calculate view direction vector (viewer at origin in view space)\\n    // Using global viewer model as per hint - fixed direction (0,0,1)\\n    vec3 viewDir \u003d normalize(vec3(0.0, 0.0, 1.0));\\n    \\n    // Calculate ambient component\\n    vec3 ambient \u003d materialAmbient;\\n    \\n    // Calculate diffuse component\\n    float diffuseFactor \u003d max(dot(normal, lightDir), 0.0);\\n    vec3 diffuse \u003d materialDiffuse * diffuseFactor;\\n    \\n    // Calculate specular component (Phong reflection model)\\n    vec3 reflectDir \u003d reflect(-lightDir, normal);\\n    float specularFactor \u003d pow(max(dot(viewDir, reflectDir), 0.0), shininess);\\n    vec3 specular \u003d materialSpecular * specularFactor;\\n    \\n    // Combine all lighting components\\n    vec3 finalColor \u003d ambient + diffuse + specular;\\n    \\n    // Set final fragment color\\n    gl_FragColor \u003d vec4(finalColor, 1.0);\\n}`;\\n\\n// Add debug function to log light parameters during rendering\\nfunction debugLightParams(lightPos, ambient, diffuse, specular, shininess) {\\n    console.log(\\\&quot;Light Position:\\\&quot;, lightPos);\\n    console.log(\\\&quot;Material Ambient:\\\&quot;, ambient);\\n    console.log(\\\&quot;Material Diffuse:\\\&quot;, diffuse);\\n    console.log(\\\&quot;Material Specular:\\\&quot;, specular);\\n    console.log(\\\&quot;Material Shininess:\\\&quot;, shininess);\\n}\\n\\n// Log when shaders are loaded\\nconsole.log(\\\&quot;Phong shaders loaded and ready. Light will be calculated in fragment shader.\\\&quot;);\\nconsole.log(\\\&quot;Lighting equation: Irgb \u003d Ambient + Diffuse + Specular\\\&quot;);\&quot;}&quot;}}]},{&quot;role&quot;:&quot;tool&quot;,&quot;name&quot;:&quot;write&quot;,&quot;tool_call_id&quot;:&quot;toolu_01GDPZsRCcMigPW1Jyn7PR2X&quot;,&quot;content&quot;:&quot;Wrote contents to D:\\PROJECT_ME\\project_SHAME\\INSTITUTKA\\Visualisation\\WebGL2\\shaders.js.\n\nWhen you\u0027re done with your current set of changes to this file, you should call the read_lints tool with the specific file path and fix any newly introduced errors.&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;Now I\u0027ll add logging in the cornucopia3.js file to show when the lighting parameters are applied:&quot;}],&quot;tool_calls&quot;:[{&quot;id&quot;:&quot;toolu_01ANAzRrmvzSTMyub4RgxJab&quot;,&quot;type&quot;:&quot;function&quot;,&quot;function&quot;:{&quot;name&quot;:&quot;write&quot;,&quot;arguments&quot;:&quot;{\&quot;file_path\&quot;: \&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL2/cornucopia3.js\&quot;, \&quot;offset\&quot;: 322, \&quot;limit\&quot;: 15, \&quot;content\&quot;: \&quot;        // Set material properties with extreme lighting for visibility\\n        const materialAmbient \u003d [0.0, 0.0, 0.0];        // No ambient\\n        const materialDiffuse \u003d [0.9, 0.9, 0.9];        // Bright diffuse\\n        const materialSpecular \u003d [1.0, 1.0, 1.0];      // Full specular\\n        const shininessValue \u003d 20.0;                   // Lower shininess for broader highlight\\n        \\n        // Log light and material properties\\n        console.log(\\\&quot;LIGHTING: Setting material properties for render:\\\&quot;);\\n        console.log(\\\&quot;LIGHTING: Ambient \u003d\\\&quot;, materialAmbient);\\n        console.log(\\\&quot;LIGHTING: Diffuse \u003d\\\&quot;, materialDiffuse);\\n        console.log(\\\&quot;LIGHTING: Specular \u003d\\\&quot;, materialSpecular);\\n        console.log(\\\&quot;LIGHTING: Shininess \u003d\\\&quot;, shininessValue);\\n        \\n        gl.uniform3fv(shaderProgram.iMaterialAmbient, materialAmbient);\\n        gl.uniform3fv(shaderProgram.iMaterialDiffuse, materialDiffuse);\\n        gl.uniform3fv(shaderProgram.iMaterialSpecular, materialSpecular);\\n        gl.uniform1f(shaderProgram.iShininess, shininessValue);\&quot;}&quot;}}]},{&quot;role&quot;:&quot;tool&quot;,&quot;name&quot;:&quot;write&quot;,&quot;tool_call_id&quot;:&quot;toolu_01ANAzRrmvzSTMyub4RgxJab&quot;,&quot;content&quot;:&quot;Wrote contents to D:\\PROJECT_ME\\project_SHAME\\INSTITUTKA\\Visualisation\\WebGL2\\cornucopia3.js.\n\nWhen you\u0027re done with your current set of changes to this file, you should call the read_lints tool with the specific file path and fix any newly introduced errors.&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[],&quot;tool_calls&quot;:[{&quot;id&quot;:&quot;toolu_01H8whAeoBVzmCuorusG6Nqb&quot;,&quot;type&quot;:&quot;function&quot;,&quot;function&quot;:{&quot;name&quot;:&quot;write&quot;,&quot;arguments&quot;:&quot;{\&quot;file_path\&quot;: \&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL2/cornucopia3.js\&quot;, \&quot;offset\&quot;: 400, \&quot;limit\&quot;: 20, \&quot;content\&quot;: \&quot;/**\\n * Update the light position for animation\\n */\\nfunction updateLightPosition() {\\n    // Rotate light around the surface\\n    lightAngle +\u003d 0.03; // Even faster rotation\\n    if (lightAngle \u003e 2 * Math.PI) {\\n        lightAngle -\u003d 2 * Math.PI;\\n    }\\n    \\n    // Calculate light position (circular orbit) - extreme position for visibility\\n    const lightX \u003d lightRadius * Math.cos(lightAngle);\\n    const lightY \u003d lightRadius * Math.sin(lightAngle);\\n    const lightZ \u003d 10; // Much closer to the surface\\n    \\n    const lightPosition \u003d [lightX, lightY, lightZ];\\n    \\n    // Log light position\\n    if (lightAngle \u003c 0.1 || lightAngle \u003e 6.2) {  // Only log occasionally\\n        console.log(\\\&quot;LIGHTING: Light position \u003d\\\&quot;, lightPosition, \\\&quot;at angle\\\&quot;, lightAngle.toFixed(2));\\n    }\\n    \\n    return lightPosition;\\n}\&quot;}&quot;}}]},{&quot;role&quot;:&quot;tool&quot;,&quot;name&quot;:&quot;write&quot;,&quot;tool_call_id&quot;:&quot;toolu_01H8whAeoBVzmCuorusG6Nqb&quot;,&quot;content&quot;:&quot;Wrote contents to D:\\PROJECT_ME\\project_SHAME\\INSTITUTKA\\Visualisation\\WebGL2\\cornucopia3.js.\n\nWhen you\u0027re done with your current set of changes to this file, you should call the read_lints tool with the specific file path and fix any newly introduced errors.&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[],&quot;tool_calls&quot;:[{&quot;id&quot;:&quot;toolu_01HfXBYheR7UZw9AXB3iG94p&quot;,&quot;type&quot;:&quot;function&quot;,&quot;function&quot;:{&quot;name&quot;:&quot;write&quot;,&quot;arguments&quot;:&quot;{\&quot;file_path\&quot;: \&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL2/cornucopia3.js\&quot;, \&quot;offset\&quot;: 450, \&quot;limit\&quot;: 30, \&quot;content\&quot;: \&quot;    // Update light position for animation\\n    const lightPosition \u003d updateLightPosition();\\n    \\n    // Apply transformations (right to left)\\n    modelViewMatrix \u003d m4.multiply(moveBack, modelViewMatrix);\\n    \\n    // Calculate the combined model-view-projection matrix\\n    const mvpMatrix \u003d m4.multiply(projectionMatrix, modelViewMatrix);\\n    \\n    // Calculate normal matrix (for transforming normals)\\n    const normalMatrix \u003d calculateNormalMatrix(modelViewMatrix, new Float32Array(9));\\n    \\n    // Set shader uniforms\\n    gl.uniformMatrix4fv(shProgram.iModelViewProjectionMatrix, false, mvpMatrix);\\n    gl.uniformMatrix4fv(shProgram.iModelViewMatrix, false, modelViewMatrix);\\n    gl.uniformMatrix3fv(shProgram.iNormalMatrix, false, normalMatrix);\\n    \\n    // Set light position - log when changed\\n    gl.uniform3fv(shProgram.iLightPosition, lightPosition);\\n    if (lightAngle \u003c 0.1 || Math.abs(lightAngle - Math.PI) \u003c 0.1) {\\n        console.log(\\\&quot;LIGHTING: Light position uniform set to:\\\&quot;, lightPosition);\\n    }\&quot;}&quot;}}]},{&quot;role&quot;:&quot;tool&quot;,&quot;name&quot;:&quot;write&quot;,&quot;tool_call_id&quot;:&quot;toolu_01HfXBYheR7UZw9AXB3iG94p&quot;,&quot;content&quot;:&quot;Wrote contents to D:\\PROJECT_ME\\project_SHAME\\INSTITUTKA\\Visualisation\\WebGL2\\cornucopia3.js.\n\nWhen you\u0027re done with your current set of changes to this file, you should call the read_lints tool with the specific file path and fix any newly introduced errors.&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[],&quot;tool_calls&quot;:[{&quot;id&quot;:&quot;toolu_01L22QyeuBujwJcPiJWEDkAZ&quot;,&quot;type&quot;:&quot;function&quot;,&quot;function&quot;:{&quot;name&quot;:&quot;read_lints&quot;,&quot;arguments&quot;:&quot;{\&quot;paths\&quot;: [\&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL2/shaders.js\&quot;,\&quot;D:/PROJECT_ME/project_SHAME/INSTITUTKA/Visualisation/WebGL2/cornucopia3.js\&quot;]}&quot;}}]},{&quot;role&quot;:&quot;tool&quot;,&quot;name&quot;:&quot;read_lints&quot;,&quot;tool_call_id&quot;:&quot;toolu_01L22QyeuBujwJcPiJWEDkAZ&quot;,&quot;content&quot;:&quot;No linter errors found in 2 checked files.&quot;},{&quot;role&quot;:&quot;assistant&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;I\u0027ve added extensive logging to track exactly where and how the lighting is being calculated in your code:\n\n### 1. In shaders.js:\n\n- Added initial log messages when the shader file is loaded:\n  ```javascript\n  console.log(\&quot;Loading Phong shaders with lighting calculations\&quot;);\n  ```\n\n- Added a closing message explaining the lighting equation:\n  ```javascript\n  console.log(\&quot;Phong shaders loaded and ready. Light will be calculated in fragment shader.\&quot;);\n  console.log(\&quot;Lighting equation: Irgb \u003d Ambient + Diffuse + Specular\&quot;);\n  ```\n\n- Added a debug helper function that can be called to log lighting parameters:\n  ```javascript\n  function debugLightParams(lightPos, ambient, diffuse, specular, shininess) {\n      console.log(\&quot;Light Position:\&quot;, lightPos);\n      console.log(\&quot;Material Ambient:\&quot;, ambient);\n      console.log(\&quot;Material Diffuse:\&quot;, diffuse);\n      console.log(\&quot;Material Specular:\&quot;, specular);\n      console.log(\&quot;Material Shininess:\&quot;, shininess);\n  }\n  ```\n\n### 2. In cornucopia3.js:\n\n- Added logging for material properties during rendering:\n  ```javascript\n  console.log(\&quot;LIGHTING: Setting material properties for render:\&quot;);\n  console.log(\&quot;LIGHTING: Ambient \u003d\&quot;, materialAmbient);\n  console.log(\&quot;LIGHTING: Diffuse \u003d\&quot;, materialDiffuse);\n  console.log(\&quot;LIGHTING: Specular \u003d\&quot;, materialSpecular);\n  console.log(\&quot;LIGHTING: Shininess \u003d\&quot;, shininessValue);\n  ```\n\n- Added logging for light position updates:\n  ```javascript\n  console.log(\&quot;LIGHTING: Light position \u003d\&quot;, lightPosition, \&quot;at angle\&quot;, lightAngle.toFixed(2));\n  ```\n\n- Added logging for when light position is set as a uniform:\n  ```javascript\n  console.log(\&quot;LIGHTING: Light position uniform set to:\&quot;, lightPosition);\n  ```\n\nThese logs will appear in your browser console and will help you track:\n1. When the shaders are loaded\n2. Where the lighting equation is calculated\n3. What values are being used for material properties and light position\n4. When these values are passed to the GPU\n\nTo see the logs, open your browser\u0027s developer console (usually by pressing F12), then refresh the page. You should see detailed information about the lighting calculations, which will confirm that your code is correctly implementing the `Irgb \u003d Ambient + Diffuse + Specular` equation.&quot;}]},{&quot;role&quot;:&quot;user&quot;,&quot;content&quot;:[{&quot;type&quot;:&quot;text&quot;,&quot;text&quot;:&quot;DO not see the log \ncheck if it actually use because i can not see any light on render&quot;}],&quot;context&quot;:[{&quot;file_path&quot;:&quot;shaders.js&quot;,&quot;code_text&quot;:&quot;\u0027use strict\u0027;\r\n\r\n// Log light parameters for debugging\r\nconsole.log(\&quot;Loading Phong shaders with lighting calculations\&quot;);\r\n\r\n// Vertex shader for Phong shading\r\nconst vertexShaderSource \u003d `\r\nattribute vec3 vertex;\r\nattribute vec3 normal;\r\nuniform mat4 ModelViewProjectionMatrix;\r\nuniform mat4 ModelViewMatrix;\r\nuniform mat3 NormalMatrix; // For transforming normals\r\nuniform vec3 lightPosition; // In world space\r\n\r\nvarying vec3 fragNormal;\r\nvarying vec3 fragPosition;\r\nvarying vec3 fragLightPosition;\r\n\r\nvoid main() {\r\n    // Transform vertex to clip space\r\n    gl_Position \u003d ModelViewProjectionMatrix * vec4(vertex, 1.0);\r\n    \r\n    // Pass transformed normal to fragment shader\r\n    fragNormal \u003d NormalMatrix * normal;\r\n    \r\n    // Pass vertex position in view space for lighting calculations\r\n    fragPosition \u003d vec3(ModelViewMatrix * vec4(vertex, 1.0));\r\n    \r\n    // Pass light position to fragment shader\r\n    fragLightPosition \u003d vec3(ModelViewMatrix * vec4(lightPosition, 1.0));\r\n}`;\r\n\r\n// Fragment shader for Phong lighting\r\nconst fragmentShaderSource \u003d `\r\n#ifdef GL_FRAGMENT_PRECISION_HIGH\r\n   precision highp float;\r\n#else\r\n   precision mediump float;\r\n#endif\r\n\r\nvarying vec3 fragNormal;\r\nvarying vec3 fragPosition;\r\nvarying vec3 fragLightPosition;\r\n\r\n// Material properties\r\nuniform vec3 materialAmbient;\r\nuniform vec3 materialDiffuse;\r\nuniform vec3 materialSpecular;\r\nuniform float shininess;\r\n\r\nvoid main() {\r\n    // Normalize vectors (required for correct lighting)\r\n    vec3 normal \u003d normalize(fragNormal);\r\n    \r\n    // Calculate vector from fragment to light\r\n    vec3 lightDir \u003d normalize(fragLightPosition - fragPosition);\r\n    \r\n    // Calculate view direction vector (viewer at origin in view space)\r\n    // Using global viewer model as per hint - fixed direction (0,0,1)\r\n    vec3 viewDir \u003d normalize(vec3(0.0, 0.0, 1.0));\r\n    \r\n    // Calculate ambient component\r\n    vec3 ambient \u003d materialAmbient;\r\n    \r\n    // Calculate diffuse component\r\n    float diffuseFactor \u003d max(dot(normal, lightDir), 0.0);\r\n    vec3 diffuse \u003d materialDiffuse * diffuseFactor;\r\n    \r\n    // Calculate specular component (Phong reflection model)\r\n    vec3 reflectDir \u003d reflect(-lightDir, normal);\r\n    float specularFactor \u003d pow(max(dot(viewDir, reflectDir), 0.0), shininess);\r\n    vec3 specular \u003d materialSpecular * specularFactor;\r\n    \r\n    // Combine all lighting components\r\n    vec3 finalColor \u003d ambient + diffuse + specular;\r\n    \r\n    // Set final fragment color\r\n    gl_FragColor \u003d vec4(finalColor, 1.0);\r\n}`;\r\n\r\n// Add debug function to log light parameters during rendering\r\nfunction debugLightParams(lightPos, ambient, diffuse, specular, shininess) {\r\n    console.log(\&quot;Light Position:\&quot;, lightPos);\r\n    console.log(\&quot;Material Ambient:\&quot;, ambient);\r\n    console.log(\&quot;Material Diffuse:\&quot;, diffuse);\r\n    console.log(\&quot;Material Specular:\&quot;, specular);\r\n    console.log(\&quot;Material Shininess:\&quot;, shininess);\r\n}\r\n\r\n// Log when shaders are loaded\r\nconsole.log(\&quot;Phong shaders loaded and ready. Light will be calculated in fragment shader.\&quot;);\r\nconsole.log(\&quot;Lighting equation: Irgb \u003d Ambient + Diffuse + Specular\&quot;);&quot;,&quot;ranges&quot;:[],&quot;type&quot;:&quot;current_file&quot;},{&quot;file_path&quot;:&quot;index.html&quot;,&quot;code_text&quot;:&quot;\u003c!DOCTYPE html\u003e\r\n\u003chtml\u003e\r\n\u003chead\u003e\r\n    \u003cmeta http-equiv\u003d\&quot;Content-Type\&quot; content\u003d\&quot;text/html; charset\u003dUTF-8\&quot;\u003e\r\n    \u003ctitle\u003eCornucopia Surface - WebGL Visualization with Phong Shading\u003c/title\u003e\r\n    \u003cstyle\u003e\r\n        body {\r\n            background-color: #111;\r\n            font-family: Arial, sans-serif;\r\n            color: #fff;\r\n            text-align: center;\r\n            margin: 0;\r\n            padding: 20px;\r\n        }\r\n        h1, h2 {\r\n            color: #0f0;\r\n        }\r\n        h1 {\r\n            margin-top: 10px;\r\n            font-size: 28px;\r\n        }\r\n        h2 {\r\n            font-size: 22px;\r\n            margin-top: 25px;\r\n        }\r\n        .container {\r\n            max-width: 1000px;\r\n            margin: 0 auto;\r\n            padding: 20px;\r\n        }\r\n        #canvas-holder {\r\n            margin: 20px auto;\r\n            width: 800px;\r\n        }\r\n        canvas {\r\n            border: 1px solid #0f0;\r\n            display: block;\r\n            margin: 0 auto;\r\n        }\r\n        .info-panel {\r\n            text-align: left;\r\n            background-color: rgba(0, 50, 0, 0.3);\r\n            border: 1px solid #0f0;\r\n            padding: 20px;\r\n            border-radius: 5px;\r\n            margin: 20px auto;\r\n            max-width: 800px;\r\n        }\r\n        .controls-panel {\r\n            margin: 20px auto;\r\n            display: inline-block;\r\n            background-color: rgba(0, 30, 0, 0.7);\r\n            padding: 15px;\r\n            border-radius: 5px;\r\n            text-align: left;\r\n            width: 90%;\r\n            box-sizing: border-box;\r\n        }\r\n        .math-formula {\r\n            background-color: rgba(0, 30, 0, 0.5);\r\n            padding: 15px;\r\n            border-radius: 5px;\r\n            margin: 15px 0;\r\n            font-family: \&quot;Courier New\&quot;, monospace;\r\n        }\r\n        .footer {\r\n            margin-top: 30px;\r\n            font-size: 14px;\r\n            color: #aaa;\r\n            border-top: 1px solid #333;\r\n            padding-top: 15px;\r\n        }\r\n        .student-info {\r\n            text-align: left;\r\n            background-color: rgba(0, 40, 0, 0.3);\r\n            border-left: 3px solid #0f0;\r\n            padding: 10px 20px;\r\n            margin: 25px auto;\r\n            max-width: 600px;\r\n        }\r\n        .slider-container {\r\n            margin: 15px 0;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: space-between;\r\n        }\r\n        .slider-label {\r\n            width: 150px;\r\n            text-align: right;\r\n            margin-right: 15px;\r\n        }\r\n        .slider {\r\n            flex-grow: 1;\r\n            height: 5px;\r\n            background: #333;\r\n            outline: none;\r\n            -webkit-appearance: none;\r\n            cursor: pointer;\r\n        }\r\n        .slider::-webkit-slider-thumb {\r\n            -webkit-appearance: none;\r\n            appearance: none;\r\n            width: 15px;\r\n            height: 15px;\r\n            background: #0f0;\r\n            border-radius: 50%;\r\n            cursor: pointer;\r\n        }\r\n        .slider::-moz-range-thumb {\r\n            width: 15px;\r\n            height: 15px;\r\n            background: #0f0;\r\n            border-radius: 50%;\r\n            cursor: pointer;\r\n        }\r\n        .slider-value {\r\n            width: 40px;\r\n            margin-left: 15px;\r\n            text-align: center;\r\n            font-weight: bold;\r\n            color: #0f0;\r\n        }\r\n        .parameter-row {\r\n            margin-bottom: 8px;\r\n            display: flex;\r\n            align-items: center;\r\n        }\r\n        .parameter-label {\r\n            display: inline-block;\r\n            width: 80px;\r\n        }\r\n        .parameter-input {\r\n            width: 80px;\r\n            background-color: #111;\r\n            color: #0f0;\r\n            border: 1px solid #0f0;\r\n            padding: 4px;\r\n        }\r\n        h3 {\r\n            margin-top: 0;\r\n            color: #0f0;\r\n        }\r\n        ul {\r\n            padding-left: 20px;\r\n        }\r\n        li {\r\n            margin-bottom: 8px;\r\n        }\r\n        .granularity-section {\r\n            border-top: 1px solid #0f0;\r\n            padding-top: 15px;\r\n            margin-top: 20px;\r\n        }\r\n    \u003c/style\u003e\r\n\r\n    \u003c!-- Core libraries --\u003e\r\n    \u003cscript src\u003d\&quot;./Utils/m4.js\&quot;\u003e\u003c/script\u003e\r\n    \u003cscript src\u003d\&quot;./Utils/trackball-rotator.js\&quot;\u003e\u003c/script\u003e\r\n    \u003cscript src\u003d\&quot;./shaders.js\&quot;\u003e\u003c/script\u003e\r\n    \u003cscript src\u003d\&quot;./cornucopia3.js\&quot;\u003e\u003c/script\u003e\r\n        \r\n    \u003cscript\u003e\r\n        // Add event listener for the refresh button after the page loads\r\n        window.addEventListener(\u0027load\u0027, function() {\r\n            const refreshButton \u003d document.getElementById(\u0027refresh-button\u0027);\r\n            const paramP \u003d document.getElementById(\u0027param-p\u0027);\r\n            const paramM \u003d document.getElementById(\u0027param-m\u0027);\r\n            const paramU \u003d document.getElementById(\u0027param-u\u0027);\r\n            const paramV \u003d document.getElementById(\u0027param-v\u0027);\r\n            \r\n            // Set initial values directly from the mathematical definition\r\n            // These values match exactly what\u0027s shown in the Mathematical Definition section\r\n            paramP.value \u003d 0.15; // p \u003d 0.15\r\n            paramM.value \u003d 0.1;  // m \u003d 0.1\r\n            paramU.value \u003d 5;    // u ≤ 5π\r\n            paramV.value \u003d 2;    // v ≤ 2π\r\n            \r\n            // Also ensure the model uses these exact values\r\n            setTimeout(function() {\r\n                if (surface) {\r\n                    // Verify that the model parameters match the HTML definition\r\n                    if (surface.p !\u003d 0.15 || surface.m !\u003d 0.1 || \r\n                        surface.uMax !\u003d 5 * Math.PI || surface.vMax !\u003d 2 * Math.PI) {\r\n                        console.log(\&quot;Correcting model parameters to match Mathematical Definition\&quot;);\r\n                        surface.p \u003d 0.15;\r\n                        surface.m \u003d 0.1;\r\n                        surface.uMax \u003d 5 * Math.PI;\r\n                        surface.vMax \u003d 2 * Math.PI;\r\n                        surface.initialize();\r\n                        draw();\r\n                    }\r\n                }\r\n            }, 500);\r\n            \r\n            if (refreshButton) {\r\n                refreshButton.addEventListener(\u0027click\u0027, function() {\r\n                    // Get values from inputs\r\n                    if (surface) {\r\n                        // Update parameters\r\n                        surface.p \u003d parseFloat(paramP.value);\r\n                        surface.m \u003d parseFloat(paramM.value);\r\n                        surface.uMax \u003d parseFloat(paramU.value) * Math.PI;\r\n                        surface.vMax \u003d parseFloat(paramV.value) * Math.PI;\r\n                        \r\n                        console.log(\&quot;Applying new parameters:\&quot;);\r\n                        console.log(\&quot;p \u003d\&quot;, surface.p, \&quot;m \u003d\&quot;, surface.m, \&quot;uMax \u003d\&quot;, surface.uMax/Math.PI + \&quot;π\&quot;, \&quot;vMax \u003d\&quot;, surface.vMax/Math.PI + \&quot;π\&quot;);\r\n                        \r\n                        // Update formula display in the info panel\r\n                        const mathFormula \u003d document.querySelector(\u0027.math-formula\u0027);\r\n                        if (mathFormula) {\r\n                            // Find the part after the parametric equations\r\n                            const whereSection \u003d mathFormula.innerHTML.split(\u0027\u003cstrong\u003eWhere:\u003c/strong\u003e\u0027);\r\n                            if (whereSection.length \u003e 1) {\r\n                                mathFormula.innerHTML \u003d whereSection[0] + \r\n                                    \u0027\u003cstrong\u003eWhere:\u003c/strong\u003e\u003cbr\u003e\u0027 +\r\n                                    \u0027- p \u003d \u0027 + surface.p + \u0027 (parameter p)\u003cbr\u003e\u0027 +\r\n                                    \u0027- m \u003d \u0027 + surface.m + \u0027 (parameter m)\u003cbr\u003e\u0027 +\r\n                                    \u0027- 0 ≤ u ≤ \u0027 + (surface.uMax/Math.PI) + \u0027π (lengthwise parameter)\u003cbr\u003e\u0027 +\r\n                                    \u0027- 0 ≤ v ≤ \u0027 + (surface.vMax/Math.PI) + \u0027π (cross-section parameter)\u0027;\r\n                            }\r\n                        }\r\n                        \r\n                        // Reinitialize the model\r\n                        surface.initialize();\r\n                        \r\n                        // Redraw\r\n                        draw();\r\n                        \r\n                        console.log(\&quot;Model updated with new parameters!\&quot;);\r\n                        \r\n                        // Flash confirmation message\r\n                        const button \u003d document.getElementById(\u0027refresh-button\u0027);\r\n                        button.textContent \u003d \&quot;Parameters Applied!\&quot;;\r\n                        button.style.backgroundColor \u003d \&quot;#00ff99\&quot;;\r\n                        setTimeout(function() {\r\n                            button.textContent \u003d \&quot;Apply Parameters\&quot;;\r\n                            button.style.backgroundColor \u003d \&quot;#0f0\&quot;;\r\n                        }, 1500);\r\n                    }\r\n                });\r\n            }\r\n\r\n            // Add direct event listeners to granularity sliders\r\n            setupGranularitySliders();\r\n        });\r\n\r\n        // Function to directly update mesh when sliders change\r\n        function updateMeshGranularity() {\r\n            if (!surface) return;\r\n\r\n            const uSlider \u003d document.getElementById(\&quot;u-granularity\&quot;);\r\n            const vSlider \u003d document.getElementById(\&quot;v-granularity\&quot;);\r\n            const uValue \u003d document.getElementById(\&quot;u-gran-value\&quot;);\r\n            const vValue \u003d document.getElementById(\&quot;v-gran-value\&quot;);\r\n\r\n            if (uSlider \u0026\u0026 vSlider \u0026\u0026 uValue \u0026\u0026 vValue) {\r\n                const uSegments \u003d parseInt(uSlider.value);\r\n                const vSegments \u003d parseInt(vSlider.value);\r\n                \r\n                // Update display values\r\n                uValue.textContent \u003d uSegments;\r\n                vValue.textContent \u003d vSegments;\r\n\r\n                // Update the surface\r\n                console.log(\&quot;Direct update from sliders: U\u003d\&quot; + uSegments + \&quot;, V\u003d\&quot; + vSegments);\r\n                surface.uSegments \u003d uSegments;\r\n                surface.vSegments \u003d vSegments;\r\n                surface.initialize();\r\n                draw();\r\n            }\r\n        }\r\n\r\n        // Setup granularity sliders with direct event handlers\r\n        function setupGranularitySliders() {\r\n            const uSlider \u003d document.getElementById(\&quot;u-granularity\&quot;);\r\n            const vSlider \u003d document.getElementById(\&quot;v-granularity\&quot;);\r\n            \r\n            if (uSlider \u0026\u0026 vSlider \u0026\u0026 surface) {\r\n                // Set initial values to match model\r\n                uSlider.value \u003d surface.uSegments;\r\n                vSlider.value \u003d surface.vSegments;\r\n                \r\n                document.getElementById(\&quot;u-gran-value\&quot;).textContent \u003d surface.uSegments;\r\n                document.getElementById(\&quot;v-gran-value\&quot;).textContent \u003d surface.vSegments;\r\n                \r\n                console.log(\&quot;Granularity sliders initialized with values:\&quot;, surface.uSegments, surface.vSegments);\r\n            }\r\n        }\r\n    \u003c/script\u003e\r\n\u003c/head\u003e\r\n\u003cbody onload\u003d\&quot;init()\&quot;\u003e\r\n    \u003cdiv class\u003d\&quot;container\&quot;\u003e\r\n        \u003ch1\u003eCornucopia Surface - WebGL Visualization with Phong Shading\u003c/h1\u003e\r\n        \r\n        \u003cdiv class\u003d\&quot;info-panel\&quot;\u003e\r\n            \u003ch2\u003eProject Description\u003c/h2\u003e\r\n            \u003cp\u003eThis visualization demonstrates a 3D model of a \&quot;Cornucopia\&quot; surface rendered using WebGL with Phong shading and Facet Average normal calculation.\u003c/p\u003e\r\n            \u003cp\u003eThe Cornucopia is a special case of a spiral-shaped surface \&quot;Shell without vertex\&quot;. It\u0027s a cyclic surface with generatrix circles of variable radius that creates the distinctive horn-like shape.\u003c/p\u003e\r\n            \r\n            \u003ch2\u003eMathematical Definition\u003c/h2\u003e\r\n            \u003cp\u003eThe Cornucopia surface is defined by the following parametric equations:\u003c/p\u003e\r\n            \r\n            \u003cdiv class\u003d\&quot;math-formula\&quot;\u003e\r\n                \u003cstrong\u003eParametric Equations:\u003c/strong\u003e\u003cbr\u003e\r\n                x(u,v) \u003d [e\u003csup\u003emu\u003c/sup\u003e + e\u003csup\u003epu\u003c/sup\u003ecos(v)]cos(u)\u003cbr\u003e\r\n                y(u,v) \u003d [e\u003csup\u003emu\u003c/sup\u003e + e\u003csup\u003epu\u003c/sup\u003ecos(v)]sin(u)\u003cbr\u003e\r\n                z(u,v) \u003d e\u003csup\u003epu\u003c/sup\u003esin(v)\u003cbr\u003e\u003cbr\u003e\r\n                \r\n                \u003cstrong\u003eWhere:\u003c/strong\u003e\u003cbr\u003e\r\n                - p \u003d 0.15 (parameter p)\u003cbr\u003e\r\n                - m \u003d 0.1 (parameter m)\u003cbr\u003e\r\n                - 0 ≤ u ≤ 5π (lengthwise parameter)\u003cbr\u003e\r\n                - 0 ≤ v ≤ 2π (cross-section parameter)\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv id\u003d\&quot;canvas-holder\&quot;\u003e\r\n            \u003ccanvas width\u003d\&quot;800\&quot; height\u003d\&quot;600\&quot; id\u003d\&quot;webglcanvas\&quot; style\u003d\&quot;background-color:black\&quot;\u003e\u003c/canvas\u003e\r\n        \u003c/div\u003e\r\n        \r\n        \u003cdiv class\u003d\&quot;controls-panel\&quot;\u003e\r\n            \u003ch3\u003eSurface Parameters\u003c/h3\u003e\r\n            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\r\n                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-p\&quot;\u003ep value:\u003c/label\u003e\r\n                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-p\&quot; value\u003d\&quot;0.15\&quot; step\u003d\&quot;0.01\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\r\n                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-m\&quot;\u003em value:\u003c/label\u003e\r\n                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-m\&quot; value\u003d\&quot;0.1\&quot; step\u003d\&quot;0.01\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\r\n                \u003clabel class\u003d\&quot;parameter-label\&quot; for\u003d\&quot;param-u\&quot;\u003eu max (π):\u003c/label\u003e\r\n                \u003cinput type\u003d\&quot;number\&quot; id\u003d\&quot;param-u\&quot; value\u003d\&quot;5\&quot; step\u003d\&quot;0.5\&quot; class\u003d\&quot;parameter-input\&quot;\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class\u003d\&quot;parameter-row\&quot;\u003e\r\n                \u003clabel class\u003d\&quot;parameter-label