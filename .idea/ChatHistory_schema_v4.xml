lview transformation\n 23|    this.iModelViewMatrix \u003d -1;\n 24|    // Location of the TMU0\n 25|    this.iTMU0 \u003d -1;\n 26|    // Location of the TMU1\n 27|    this.iTMU1 \u003d -1;\n 28|    // Location of the TMU2\n 29|    this.iTMU2 \u003d -1;\n 30|\n 31|    this.Use \u003d function() {\n 32|        gl.useProgram(this.prog);\n 33|    }\n 34|}\n 35|\n 36|\n 37|/* Draws a colored cube, along with a set of coordinate axes.\n 38| * (Note that the use of the above drawPrimitive function is not an efficient\n 39| * way to draw with WebGL.  Here, the geometry is so simple that it doesn\u0027t matter.)\n 40| */\n 41|function draw() { \n 42|    gl.clearColor(0,0,0,1);\n 43|    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);\n 44|    \n 45|    /* Set the values of the projection transformation */\n 46|    let projection \u003d m4.perspective(Math.PI/8, 1, 8, 12); \n 47|    \n 48|    /* Get the view matrix from the SimpleRotator object.*/\n 49|    let modelView \u003d spaceball.getViewMatrix();\n 50|\n 51|    let rotateToPointZero \u003d m4.axisRotation([0.707,0.707,0], 0.7);\n 52|    let translateToPointZero \u003d m4.translation(0,0,-10);\n 53|\n 54|    let matAccum0 \u003d m4.multiply(rotateToPointZero, modelView );\n 55|    let matAccum1 \u003d m4.multiply(translateToPointZero, matAccum0 );\n 56|        \n 57|    /* Multiply the projection matrix times the modelview matrix to give the\n 58|       combined transformation matrix, and send that to the shader program. */\n 59|    let modelViewProjection \u003d m4.multiply(projection, matAccum1 );\n 60|\n 61|    gl.uniformMatrix4fv(shProgram.iModelViewMatrix, false, matAccum1 );\n 62|    gl.uniformMatrix4fv(shProgram.iModelViewProjectionMatrix, false, modelViewProjection );\n 63|    \n 64|    /* Draw the six faces of a cube, with different colors. */\n 65|    gl.uniform4fv(shProgram.iColor, [1,1,0,1] );\n 66|\n 67|    gl.uniform1i(shProgram.iTMU0, 0);\n 68|    gl.uniform1i(shProgram.iTMU1, 1);\n 69|\n 70|    surface.Draw();\n 71|}\n 72|\n 73|\n 74|\n 75|/* Initialize the WebGL context. Called from init() */\n 76|function initGL() {\n 77|    let prog \u003d createProgram( gl, vertexShaderSource, fragmentShaderSource );\n 78|\n 79|    shProgram \u003d new ShaderProgram(\u0027Basic\u0027, prog);\n 80|    shProgram.Use();\n 81|\n 82|    shProgram.iAttribVertex              \u003d gl.getAttribLocation(prog, \&quot;vertex\&quot;);\n 83|    shProgram.iAttribTexCoords           \u003d gl.getAttribLocation(prog, \&quot;tex\&quot;);\n 84|    shProgram.iModelViewProjectionMatrix \u003d gl.getUniformLocation(prog, \&quot;ModelViewProjectionMatrix\&quot;);\n 85|    shProgram.iModelViewMatrix           \u003d gl.getUniformLocation(prog, \&quot;ModelViewMatrix\&quot;);\n 86|    shProgram.iColor                     \u003d gl.getUniformLocation(prog, \&quot;color\&quot;);\n 87|    shProgram.iTMU0                      \u003d gl.getUniformLocation(prog, \&quot;iTMU0\&quot;);\n 88|    shProgram.iTMU1                      \u003d gl.getUniformLocation(prog, \&quot;iTMU1\&quot;);\n 89|    shProgram.iTMU2                      \u003d gl.getUniformLocation(prog, \&quot;iTMU2\&quot;);\n 90|\n 91|    let data \u003d {};\n 92|    \n 93|    CreateSurfaceData(data)\n 94|\n 95|    surface \u003d new Model(\u0027Surface\u0027);\n 96|    surface.BufferData(data.verticesF32, data.indicesU16, data.texcoordsF32);\n 97|\n 98|    surface.idTextureDiffuse  \u003d LoadTexture(\&quot;https://webglfundamentals.org/webgl/resources/f-texture.png\&quot;);\n 99|    surface.idTextureSpecular \u003d LoadTexture(\&quot;https://webglfundamentals.org/webgl/resources/keyboard.jpg\&quot;);\n100|\n101|    gl.enable(gl.DEPTH_TEST);\n102|}\n103|\n104|\n105|/* Creates a program for use in the WebGL context gl, and returns the\n106| * identifier for that program.  If an error occurs while compiling or\n107| * linking the program, an exception of type Error is thrown.  The error\n108| * string contains the compilation or linking er