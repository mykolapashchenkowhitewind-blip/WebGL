54|    \u003cscript\u003e\n155|        // Add event listener for the refresh button after the page loads\n156|        window.addEventListener(\u0027load\u0027, function() {\n157|            const refreshButton \u003d document.getElementById(\u0027refresh-button\u0027);\n158|            const paramP \u003d document.getElementById(\u0027param-p\u0027);\n159|            const paramM \u003d document.getElementById(\u0027param-m\u0027);\n160|            const paramU \u003d document.getElementById(\u0027param-u\u0027);\n161|            const paramV \u003d document.getElementById(\u0027param-v\u0027);\n162|            \n163|            // Set initial values directly from the mathematical definition\n164|            // These values match exactly what\u0027s shown in the Mathematical Definition section\n165|            paramP.value \u003d 0.15; // p \u003d 0.15\n166|            paramM.value \u003d 0.1;  // m \u003d 0.1\n167|            paramU.value \u003d 5;    // u ≤ 5π\n168|            paramV.value \u003d 2;    // v ≤ 2π\n169|            \n170|            // Also ensure the model uses these exact values\n171|            setTimeout(function() {\n172|                if (surface) {\n173|                    // Verify that the model parameters match the HTML definition\n174|                    if (surface.p !\u003d 0.15 || surface.m !\u003d 0.1 || \n175|                        surface.uMax !\u003d 5 * Math.PI || surface.vMax !\u003d 2 * Math.PI) {\n176|                        console.log(\&quot;Correcting model parameters to match Mathematical Definition\&quot;);\n177|                        surface.p \u003d 0.15;\n178|                        surface.m \u003d 0.1;\n179|                        surface.uMax \u003d 5 * Math.PI;\n180|                        surface.vMax \u003d 2 * Math.PI;\n181|                        surface.initialize();\n182|                        draw();\n183|                    }\n184|                }\n185|            }, 500);\n186|            \n187|        